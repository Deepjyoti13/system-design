173.6, "height": 17.5, "text": "(active purge calls)", "originalText": "(active purge calls)", "fontSize": 14, "fontFamily": 3, "textAlign": "center", "verticalAlign": "top", "strokeColor": "#1e3a5f", "backgroundColor": "transparent", "opacity": 100, "seed": 1}, {"id": "a34", "type": "arrow", "x": 1170, "y": 390, "width": 0, "height": 50, "strokeColor": "#1e3a5f", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "seed": 1, "points": [[0, 0], [0, 50]], "startArrowhead": null, "endArrowhead": "arrow"}, {"id": "r35", "type": "rectangle", "x": 40, "y": 470, "width": 900, "height": 140, "strokeColor": "#1e293b", "backgroundColor": "#1e293b", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "seed": 1, "roundness": {"type": 3}}, {"id": "t36", "type": "text", "x": 60, "y": 485, "width": 558.0, "height": 18.75, "text": "Preferred path (no purge call needed): versioned cache keys.", "originalText": "Preferred path (no purge call needed): versioned cache keys.", "fontSize": 15, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#22c55e", "backgroundColor": "transparent", "opacity": 100, "seed": 1}, {"id": "t37", "type": "text", "x": 60, "y": 510, "width": 737.8, "height": 17.5, "text": "product:123:v7  ->  product:123:v8   is a NEW key on every layer at once -- automatic", "originalText": "product:123:v7  ->  product:123:v8   is a NEW key on every layer at once -- automatic", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#22c55e", "backgroundColor": "transparent", "opacity": 100, "seed": 1}, {"id": "t38", "type": "text", "x": 60, "y": 532, "width": 763.84, "height": 17.5, "text": "cache MISS everywhere the instant the version bumps. Old v7 entries just age out on TTL.", "originalText": "cache MISS everywhere the instant the version bumps. Old v7 entries just age out on TTL.", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#22c55e", "backgroundColor": "transparent", "opacity": 100, "seed": 1}, {"id": "t39", "type": "text", "x": 60, "y": 560, "width": 824.6, "height": 17.5, "text": "Active purge (right side of this diagram) is the fallback ONLY for keys that can't be versioned", "originalText": "Active purge (right side of this diagram) is the fallback ONLY for keys that can't be versioned", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#fca5a5", "backgroundColor": "transparent", "opacity": 100, "seed": 1}, {"id": "t40", "type": "text", "x": 60, "y": 582, "width": 772.52, "height": 17.5, "text": "(e.g. \"this user's session\") -- and it's rate-limited, so it's reserved, not the default.", "originalText": "(e.g. \"this user's session\") -- and it's rate-limited, so it's reserved, not the default.", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#fca5a5", "backgroundColor": "transparent", "opacity": 100, "seed": 1}], "appState": {"viewBackgroundColor": "#ffffff"}}