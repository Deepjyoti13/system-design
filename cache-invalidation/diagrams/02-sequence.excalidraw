dColor": "transparent", "opacity": 100, "seed": 1}, {"id": "t40", "type": "text", "x": 235, "y": 630, "width": 178.56, "height": 15.0, "text": "-> gets v7 (now current)", "originalText": "-> gets v7 (now current)", "fontSize": 12, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#64748b", "backgroundColor": "transparent", "opacity": 100, "seed": 1}, {"id": "a41", "type": "arrow", "x": 220, "y": 690, "width": 530, "height": 0, "strokeColor": "#047857", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "seed": 1, "points": [[0, 0], [530, 0]], "startArrowhead": null, "endArrowhead": "arrow"}, {"id": "t42", "type": "text", "x": 235, "y": 672, "width": 161.2, "height": 16.25, "text": "7. putIfNewer(K, v7)", "originalText": "7. putIfNewer(K, v7)", "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#1e3a5f", "backgroundColor": "transparent", "opacity": 100, "seed": 1}, {"id": "r43", "type": "rectangle", "x": 610, "y": 720, "width": 280, "height": 70, "strokeColor": "#047857", "backgroundColor": "#a7f3d0", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "seed": 1, "roundness": {"type": 3}}, {"id": "t44", "type": "text", "x": 653.28, "y": 737.45, "width": 193.44, "height": 16.25, "text": "7 is NOT < 7 -> ACCEPTED", "originalText": "7 is NOT < 7 -> ACCEPTED", "fontSize": 13, "fontFamily": 3, "textAlign": "center", "verticalAlign": "top", "strokeColor": "#047857", "backgroundColor": "transparent", "opacity": 100, "seed": 1}, {"id": "t45", "type": "text", "x": 677.46, "y": 755.0, "width": 145.08, "height": 16.25, "text": "cache now holds v7", "originalText": "cache now holds v7", "fontSize": 13, "fontFamily": 3, "textAlign": "center", "verticalAlign": "top", "strokeColor": "#047857", "backgroundColor": "transparent", "opacity": 100, "seed": 1}, {"id": "r46", "type": "rectangle", "x": 40, "y": 830, "width": 1420, "height": 110, "strokeColor": "#1e293b", "backgroundColor": "#1e293b", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "seed": 1, "roundness": {"type": 3}}, {"id": "t47", "type": "text", "x": 60, "y": 845, "width": 781.2, "height": 17.5, "text": "The check is version < watermark, not <=. A repopulation strictly older than the last-seen", "originalText": "The check is version < watermark, not <=. A repopulation strictly older than the last-seen", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#22c55e", "backgroundColor": "transparent", "opacity": 100, "seed": 1}, {"id": "t48", "type": "text", "x": 60, "y": 867, "width": 824.6, "height": 17.5, "text": "invalidation is discarded (step 4). A fresh re-fetch that matches the current watermark exactly", "originalText": "invalidation is discarded (step 4). A fresh re-fetch that matches the current watermark exactly", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#22c55e", "backgroundColor": "transparent", "opacity": 100, "seed": 1}, {"id": "t49", "type": "text", "x": 60, "y": 889, "width": 668.36, "height": 17.5, "text": "(step 7) is still allowed through -- it's not stale, it IS the current truth.", "originalText": "(step 7) is still allowed through -- it's not stale, it IS the current truth.", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#22c55e", "backgroundColor": "transparent", "opacity": 100, "seed": 1}, {"id": "t50", "type": "text", "x": 60, "y": 915, "width": 781.82, "height": 16.25, "text": "No lock anywhere: this is a compare-then-write, atomic per key at the storage layer, not a mutex.", "originalText": "No lock anywhere: this is a compare-then-write, atomic per key at the storage layer, not a mutex.", "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#fbbf24", "backgroundColor": "transparent", "opacity": 100, "seed": 1}], "appState": {"viewBackgroundColor": "#ffffff"}}