: 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#2f9e44", "backgroundColor": "transparent", "opacity": 100, "seed": 45, "width": 148.8, "height": 15.600000000000001}, {"id": "t46", "type": "text", "x": 560, "y": 336, "text": "(no origin thundering herd)", "originalText": "(no origin thundering herd)", "fontSize": 11, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#666", "backgroundColor": "transparent", "opacity": 100, "seed": 46, "width": 250, "height": 14.3}, {"id": "r47", "type": "rectangle", "x": 40, "y": 550, "width": 1500, "height": 100, "strokeColor": "#1b4332", "backgroundColor": "#0d1117", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "seed": 47, "roundness": {"type": 3}}, {"id": "t48", "type": "text", "x": 60, "y": 570, "text": "200M evals/sec entirely local: ~1us each = ~200 core-seconds/sec, spread across 10,000 already-provisioned instances.", "originalText": "200M evals/sec entirely local: ~1us each = ~200 core-seconds/sec, spread across 10,000 already-provisioned instances.", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#51cf66", "backgroundColor": "transparent", "opacity": 100, "seed": 48, "width": 1015.56, "height": 18.2}, {"id": "t49", "type": "text", "x": 60, "y": 592, "text": "The SAME volume through a network-called flag SERVICE would need that service alone to sustain 200M req/sec -- a bigger system than the one it protects.", "originalText": "The SAME volume through a network-called flag SERVICE would need that service alone to sustain 200M req/sec -- a bigger system than the one it protects.", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#51cf66", "backgroundColor": "transparent", "opacity": 100, "seed": 49, "width": 1319.36, "height": 18.2}, {"id": "t50", "type": "text", "x": 60, "y": 620, "text": "Config changes propagate in seconds via a lightweight pointer + CDN pull, never a synchronous read against the Config Store.", "originalText": "Config changes propagate in seconds via a lightweight pointer + CDN pull, never a synchronous read against the Config Store.", "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#ffa94d", "backgroundColor": "transparent", "opacity": 100, "seed": 50, "width": 999.4399999999999, "height": 16.900000000000002}], "appState": {"viewBackgroundColor": "#ffffff"}}