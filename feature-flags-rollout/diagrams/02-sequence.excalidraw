{"type": "excalidraw", "version": 2, "source": "ff", "elements": [{"id": "t1", "type": "text", "x": 40, "y": 20, "text": "Flag Evaluation Sequence, and the Atomic Snapshot Swap", "originalText": "Flag Evaluation Sequence, and the Atomic Snapshot Swap", "fontSize": 24, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#1e40af", "backgroundColor": "transparent", "opacity": 100, "seed": 1, "width": 803.52, "height": 31.200000000000003}, {"id": "t2", "type": "text", "x": 40, "y": 55, "text": "Left: one evaluate() call. Right: how the SDK swaps its whole config without a half-updated read.", "originalText": "Left: one evaluate() call. Right: how the SDK swaps its whole config without a half-updated read.", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#666", "backgroundColor": "transparent", "opacity": 100, "seed": 2, "width": 841.96, "height": 18.2}, {"id": "t3", "type": "text", "x": 40, "y": 100, "text": "evaluate(flagKey, userContext)", "originalText": "evaluate(flagKey, userContext)", "fontSize": 16, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#1e40af", "backgroundColor": "transparent", "opacity": 100, "seed": 3, "width": 297.6, "height": 20.8}, {"id": "t4", "type": "text", "x": 60, "y": 148, "text": "Application", "originalText": "Application", "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#333", "backgroundColor": "transparent", "opacity": 100, "seed": 4, "width": 88.66, "height": 16.900000000000002}, {"id": "t5", "type": "text", "x": 470, "y": 148, "text": "Evaluator", "originalText": "Evaluator", "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#333", "backgroundColor": "transparent", "opacity": 100, "seed": 5, "width": 72.54, "height": 16.900000000000002}, {"id": "a6", "type": "arrow", "x": 100, "y": 180, "width": 1, "height": 440, "points": [[0, 0], [0, 440]], "