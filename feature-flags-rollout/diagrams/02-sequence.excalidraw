: "top", "strokeColor": "#666", "backgroundColor": "transparent", "opacity": 100, "seed": 12, "width": 143.22, "height": 14.3}, {"id": "r13", "type": "rectangle", "x": 500, "y": 320, "width": 260, "height": 50, "strokeColor": "#1e1e1e", "backgroundColor": "#ffe8cc", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "seed": 13, "roundness": {"type": 3}}, {"id": "t14", "type": "text", "x": 515, "y": 330, "text": "bucket = hash(key+userId)", "originalText": "bucket = hash(key+userId)", "fontSize": 12, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "opacity": 100, "seed": 14, "width": 186.0, "height": 15.600000000000001}, {"id": "t15", "type": "text", "x": 515, "y": 348, "text": "% 100  ->  deterministic", "originalText": "% 100  ->  deterministic", "fontSize": 11, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#666", "backgroundColor": "transparent", "opacity": 100, "seed": 15, "width": 163.68, "height": 14.3}, {"id": "a16", "type": "arrow", "x": 500, "y": 420, "width": 400, "height": 0, "points": [[0, 0], [-400, 0]], "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "seed": 16, "startArrowhead": null, "endArrowhead": "arrow"}, {"id": "t17", "type": "text", "x": 110, "y": 384, "text": "return bucket < flag.rolloutPercentage", "originalText": "return bucket < flag.rolloutPercentage", "fontSize": 12, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#2f9e44", "backgroundColor": "transparent", "opacity": 100, "seed": 17, "width": 300, "height": 15.600000000000001}, {"id": "t18", "type": "text", "x": 110, "y": 402, "text": "(boolean, never throws)", "originalText": "(boolean, never throws)", "fontSize": 11, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#666", "backgroundColor": "transparent", "opacity": 100, "seed": 18, "width": 156.85999999999999, "height": 14.3}, {"id": "r19", "type": "rectangle", "x": 100, "y": 470, "width": 660, "height": 90, "strokeColor": "#5f3dc4", "backgroundColor": "#f3f0ff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "seed": 19, "roundness": {"type": 3}}, {"id": "t20", "type": "text", "x": 115, "y": 485, "text": "Unknown flag key -> return false.", "originalText": "Unknown flag key -> return false.", "fontSize": 12, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#5f3dc4", "backgroundColor": "transparent", "opacity": 100, "seed": 20, "width": 245.52, "height": 15.600000000000001}, {"id": "t21", "type": "text", "x": 115, "y": 505, "text": "Unresolvable targeting rule -> fall through", "originalText": "Unresolvable targeting rule -> fall through", "fontSize": 12, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#5f3dc4", "backgroundColor": "transparent", "opacity": 100, "seed": 21, "width": 319.92, "height": 15.600000000000001}, {"id": "t22", "type": "text", "x": 115, "y": 523, "text": "to the percentage bucket, never error the call.", "originalText": "to the percentage bucket, never error the call.", "fontSize": 12, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#5f3dc4", "backgroundColor": "transparent", "opacity": 100, "seed": 22, "width": 349.68, "height": 15.600000000000001}, {"id": "t23", "type": "text", "x": 1000, "y": 110, "text": "Atomic snapshot swap (no lock needed)", "originalText": "Atomic snapshot swap (no lock needed)", "fontSize": 16, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#1e40af", "backgroundColor": "transparent", "opacity": 100, "seed": 23, "width": 367.04, "height": 20.8}, {"id": "r24", "type": "rectangle", "x": 1000, "y": 170, "width": 260, "height": 80, "strokeColor": "#1e1e1e", "backgroundColor": "#a5d8ff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "seed": 24, "roundness": {"type": 3}}, {"id": "t25", "type": "text", "x": 1015, "y": 195, "text": "Snapshot v1", "originalText": "Snapshot v1", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "opacity": 100, "seed": 25, "width": 95.48, "height": 18.2}, {"id": "t26", "type": "text", "x": 1015, "y": 215, "text": "(currently live)", "originalText": "(currently live)", "fontSize": 11, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#555", "backgroundColor": "transparent", "opacity": 100, "seed": 26, "width": 109.12, "height": 14.3}, {"id": "r27", "type": "rectangle", "x": 1000, "y": 320, "width": 260, "height": 80, "strokeColor": "#1e1e1e", "backgroundColor": "#b2f2bb", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "seed": 27, "roundness": {"type": 3}}, {"id": "t28", "type": "text", "x": 1015, "y": 345, "text": "Snapshot v2", "originalText": "Snapshot v2", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "opacity": 100, "seed": 28, "width": 95.48, "height": 18.2}, {"id": "t29", "type": "text", "x": 1015, "y": 365, "text": "(fully built, not yet live)", "originalText": "(fully built, not yet live)", "fontSize": 11, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#555", "backgroundColor": "transparent", "opacity": 100, "seed": 29, "width": 184.14, "height": 14.3}, {"id": "r30", "type": "rectangle", "x": 1340, "y": 170, "width": 220, "height": 80, "strokeColor": "#1e1e1e", "backgroundColor": "#ffd8a8", "fillStyle": "solid", "strokeWidth": 3, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "seed": 30, "roundness": {"type": 3}}, {"id": "t31", "type": "text", "x": 1355, "y": 195, "text": "currentSnapshotRef", "originalText": "currentSnapshotRef", "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "opacity": 100, "seed": 31, "width": 145.08, "height": 16.900000000000002}, {"id": "t32", "type": "text", "x": 1355, "y": 215, "text": "-> v1", "originalText": "-> v1", "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#c92a2a", "backgroundColor": "transparent", "opacity": 100, "seed": 32, "width": 40.3, "height": 16.900000000000002}, {"id": "a33", "type": "arrow", "x": 1260, "y": 210, "width": 80, "height": 1, "points": [[0, 0], [80, 0]], "strokeColor": "#c92a2a", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "seed": 33, "startArrowhead": null, "endArrowhead": "arrow"}, {"id": "t34", "type": "text", "x": 1000, "y": 430, "text": "Reader in flight when the swap happens keeps its OWN", "originalText": "Reader in flight when the swap happens keeps its OWN", "fontSize": 12, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#666", "backgroundColor": "transparent", "opacity": 100, "seed": 34, "width": 560, "height": 15.600000000000001}, {"id": "t35", "type": "text", "x": 1000, "y": 448, "text": "already-fetched reference -- reads v1 to completion, or v2 if it", "originalText": "already-fetched reference -- reads v1 to completion, or v2 if it", "fontSize": 12, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#666", "backgroundColor": "transparent", "opacity": 100, "seed": 35, "width": 560, "height": 15.600000000000001}, {"id": "t36", "type": "text", "x": 1000, "y": 466, "text": "started after the swap. Never a mix of the two.", "originalText": "started after the swap. Never a mix of the two.", "fontSize": 12, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#666", "backgroundColor": "transparent", "opacity": 100, "seed": 36, "width": 560, "height": 15.600000000000001}, {"id": "r37", "type": "rectangle", "x": 40, "y": 590, "width": 1440, "height": 100, "strokeColor": "#1b4332", "backgroundColor": "#0d1117", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "seed": 37, "roundness": {"type": 3}}, {"id": "t38", "type": "text", "x": 60, "y": 610, "text": "The swap is ONE reference assignment (currentSnapshotRef = newSnapshot) -- not a mutation of fields inside a shared object.", "originalText": "The swap is ONE reference assignment (currentSnapshotRef = newSnapshot) -- not a mutation of fields inside a shared object.", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#51cf66", "backgroundColor": "transparent", "opacity": 100, "seed": 38, "width": 1067.64, "height": 18.2}, {"id": "t39", "type": "text", "x": 60, "y": 632, "text": "That's the whole concurrency story: nothing is ever partially updated, so nothing needs a lock to read safely.", "originalText": "That's the whole concurrency story: nothing is ever partially updated, so nothing needs a lock to read safely.", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#51cf66", "backgroundColor": "transparent", "opacity": 100, "seed": 39, "width": 954.8, "height": 18.2}, {"id": "t40", "type": "text", "x": 60, "y": 660, "text": "Two instances evaluating the identical (flagKey, userId) always compute the identical bucket -- consistency by determinism, not coordination.", "originalText": "Two instances evaluating the identical (flagKey, userId) always compute the identical bucket -- consistency by determinism, not coordination.", "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#ffa94d", "backgroundColor": "transparent", "opacity": 100, "seed": 40, "width": 1136.46, "height": 16.900000000000002}], "appState": {"viewBackgroundColor": "#ffffff"}}