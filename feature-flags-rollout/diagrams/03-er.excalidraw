 "height": 16.900000000000002}, {"id": "t25", "type": "text", "x": 575, "y": 532, "text": "partitioned by (flag_id, day)", "originalText": "partitioned by (flag_id, day)", "fontSize": 11, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#666", "backgroundColor": "transparent", "opacity": 100, "seed": 25, "width": 197.78, "height": 14.3}, {"id": "a26", "type": "arrow", "x": 380, "y": 250, "width": 180, "height": 0, "points": [[0, 0], [180, 0]], "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "seed": 26, "startArrowhead": null, "endArrowhead": "arrow"}, {"id": "t27", "type": "text", "x": 395, "y": 228, "text": "1 -> many", "originalText": "1 -> many", "fontSize": 11, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#555", "backgroundColor": "transparent", "opacity": 100, "seed": 27, "width": 61.38, "height": 14.3}, {"id": "a28", "type": "arrow", "x": 380, "y": 310, "width": 180, "height": 130, "points": [[0, 0], [110, 0], [110, 130], [180, 130]], "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "seed": 28, "startArrowhead": null, "endArrowhead": "arrow"}, {"id": "t29", "type": "text", "x": 395, "y": 318, "text": "1 -> many", "originalText": "1 -> many", "fontSize": 11, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#555", "backgroundColor": "transparent", "opacity": 100, "seed": 29, "width": 61.38, "height": 14.3}, {"id": "r30", "type": "rectangle", "x": 60, "y": 610, "width": 860, "height": 90, "strokeColor": "#5f3dc4", "backgroundColor": "#f3f0ff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "seed": 30, "roundness": {"type": 3}}, {"id": "t31", "type": "text", "x": 75, "y": 628, "text": "targeting_rules is read on every config PUBLISH (rare) to build the immutable", "originalText": "targeting_rules is read on every config PUBLISH (rare) to build the immutable", "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#5f3dc4", "backgroundColor": "transparent", "opacity": 100, "seed": 31, "width": 620.62, "height": 16.900000000000002}, {"id": "t32", "type": "text", "x": 75, "y": 648, "text": "snapshot -- never read live during the 200M/sec evaluation path itself.", "originalText": "snapshot -- never read live during the 200M/sec evaluation path itself.", "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#5f3dc4", "backgroundColor": "transparent", "opacity": 100, "seed": 32, "width": 572.26, "height": 16.900000000000002}, {"id": "t33", "type": "text", "x": 75, "y": 668, "text": "evaluation_events is written far more than read: no index beyond the day-partition key.", "originalText": "evaluation_events is written far more than read: no index beyond the day-partition key.", "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#5f3dc4", "backgroundColor": "transparent", "opacity": 100, "seed": 33, "width": 701.22, "height": 16.900000000000002}, {"id": "r34", "type": "rectangle", "x": 60, "y": 730, "width": 860, "height": 100, "strokeColor": "#1b4332", "backgroundColor": "#0d1117", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "seed": 34, "roundness": {"type": 3}}, {"id": "t35", "type": "text", "x": 80, "y": 748, "text": "This is one of the few schemas in this guide that barely needs to scale: thousands", "originalText": "This is one of the few schemas in this guide that barely needs to scale: thousands", "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#51cf66", "backgroundColor": "transparent", "opacity": 100, "seed": 35, "width": 660.92, "height": 16.900000000000002}, {"id": "t36", "type": "text", "x": 80, "y": 770, "text": "of flags, a few edits/day. Only evaluation_events grows fast -- and it belongs in a", "originalText": "of flags, a few edits/day. Only evaluation_events grows fast -- and it belongs in a", "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#51cf66", "backgroundColor": "transparent", "opacity": 100, "seed": 36, "width": 668.98, "height": 16.900000000000002}, {"id": "t37", "type": "text", "x": 80, "y": 794, "text": "separate analytics store, not the config database, the moment it becomes hot.", "originalText": "separate analytics store, not the config database, the moment it becomes hot.", "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#ffa94d", "backgroundColor": "transparent", "opacity": 100, "seed": 37, "width": 620.62, "height": 16.900000000000002}], "appState": {"viewBackgroundColor": "#ffffff"}}