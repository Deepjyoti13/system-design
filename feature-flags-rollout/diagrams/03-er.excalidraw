{"type": "excalidraw", "version": 2, "source": "ff", "elements": [{"id": "t1", "type": "text", "x": 40, "y": 20, "text": "Feature Flag Schema: One Small Control Plane, One High-Volume Log", "originalText": "Feature Flag Schema: One Small Control Plane, One High-Volume Log", "fontSize": 22, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#1e40af", "backgroundColor": "transparent", "opacity": 100, "seed": 1, "width": 886.6, "height": 28.6}, {"id": "t2", "type": "text", "x": 40, "y": 55, "text": "flags -> targeting_rules is the config an admin edits; flags -> evaluation_events is write-heavy analytics, kept separate.", "originalText": "flags -> targeting_rules is the config an admin edits; flags -> evaluation_events is write-heavy analytics, kept separate.", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#666", "backgroundColor": "transparent", "opacity": 100, "seed": 2, "width": 1058.96, "height": 18.2}, {"id": "r3", "type": "rectangle", "x": 60, "y": 160, "width": 320, "height": 190, "strokeColor": "#1e1e1e", "backgroundColor": "#a5d8ff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "seed": 3, "roundness": {"type": 3}}, {"id": "t4", "type": "text", "x": 75, "y": 172, "text": "flags", "originalText": "flags", "fontSize": 16, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "opacity": 100, "seed": 4, "width": 49.6, "height": 20.8}, {"id": "t5", "type": "text", "x": 75, "y": 202, "text": "id (PK)", "originalText": "id (PK)", "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "opacity": 100, "seed": 5, "width": 56.42, "height": 16.900000000000002}, {"id": "t6", "type": "text", "x": 75, "y": 224, "text": "key (UNIQUE, indexed)", "originalText": "key (UNIQUE, indexed)", "fontSize": 13, "fon