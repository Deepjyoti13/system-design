{"type": "excalidraw", "version": 2, "source": "field-guide-fraud", "elements": [{"id": "t1", "type": "text", "x": 40, "y": 30, "width": 1009, "height": 28, "text": "One Trace, Twenty Services: Propagation Across Sync Calls and Async Queues", "originalText": "One Trace, Twenty Services: Propagation Across Sync Calls and Async Queues", "fontSize": 22, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#1e40af", "backgroundColor": "transparent", "opacity": 100, "seed": 2}, {"id": "t2", "type": "text", "x": 40, "y": 65, "width": 870, "height": 16, "text": "The async/queue hop is the one most systems get wrong -- no header exists to carry the context automatically", "originalText": "The async/queue hop is the one most systems get wrong -- no header exists to carry the context automatically", "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#64748b", "backgroundColor": "transparent", "opacity": 100, "seed": 3}, {"id": "t3", "type": "text", "x": 60, "y": 105, "width": 556, "height": 16, "text": "Synchronous chain -- HTTP headers carry the trace context, hop to hop", "originalText": "Synchronous chain -- HTTP headers carry the trace context, hop to hop", "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#64748b", "backgroundColor": "transparent", "opacity": 100, "seed": 4}, {"id": "r4", "type": "rectangle", "x": 60, "y": 140, "width": 200, "height": 80, "strokeColor": "#1e40af", "backgroundColor": "#dbeafe", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "seed": 5, "roundness": {"type": 3}}, {"id": "t5", "type": "text", "x": 132.0, "y": 158.5, "width": 60, "height": 16, "text": "Gateway", "originalText": "Gateway", "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "opacity": 100, "seed": 6}, {"id": "t6", "type": "text", "x":