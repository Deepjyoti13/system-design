{"type": "excalidraw", "version": 2, "source": "acid-vs-base", "elements": [{"id": "title", "type": "text", "x": 40, "y": 30, "text": "ACID vs BASE: two paths through one social app", "originalText": "ACID vs BASE: two paths through one social app", "fontSize": 26, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#1e40af", "backgroundColor": "transparent", "opacity": 100, "seed": 2, "width": 741.52, "height": 33.800000000000004}, {"id": "subtitle", "type": "text", "x": 40, "y": 68, "text": "Same app, same database technology -- the letters describe the operation, not the system", "originalText": "Same app, same database technology -- the letters describe the operation, not the system", "fontSize": 15, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#64748b", "backgroundColor": "transparent", "opacity": 100, "seed": 3, "width": 818.4, "height": 19.5}, {"id": "left_header", "type": "text", "x": 60, "y": 140, "text": "Like Count -- BASE", "originalText": "Like Count -- BASE", "fontSize": 20, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#1e40af", "backgroundColor": "transparent", "opacity": 100, "seed": 4, "width": 223.2, "height": 26.0}, {"id": "post_box", "type": "rectangle", "x": 60, "y": 190, "width": 340, "height": 60, "strokeColor": "#1e3a5f", "backgroundColor": "#3b82f6", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "seed": 5, "roundness": {"type": 3}}, {"id": "post_label", "type": "text", "x": 80, "y": 208, "text": "Post #482: user taps Like", "originalText": "Post #482: user taps Like", "fontSize": 15, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#ffffff", "backgroundColor": "transparent", "opacity": 100, "seed": 6, "width": 232.5, "height": 19.5}, {"id": "a1", "type": "arrow", "x": 230, "y": 250, "width": -100, "height": 70, "points": [[0, 0], [-100, 70]], "strokeColor": "#1e3a5f", "back