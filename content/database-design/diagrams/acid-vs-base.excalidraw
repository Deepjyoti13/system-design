15, "y": 335, "text": "Replica B", "originalText": "Replica B", "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#374151", "backgroundColor": "transparent", "opacity": 100, "seed": 14, "width": 72.54, "height": 16.900000000000002}, {"id": "rep_b_l2", "type": "text", "x": 215, "y": 358, "text": "count = 1041", "originalText": "count = 1041", "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#374151", "backgroundColor": "transparent", "opacity": 100, "seed": 15, "width": 96.72, "height": 16.900000000000002}, {"id": "rep_c", "type": "rectangle", "x": 340, "y": 320, "width": 130, "height": 70, "strokeColor": "#1e3a5f", "backgroundColor": "#93c5fd", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "seed": 16, "roundness": {"type": 3}}, {"id": "rep_c_l1", "type": "text", "x": 355, "y": 335, "text": "Replica C", "originalText": "Replica C", "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#374151", "backgroundColor": "transparent", "opacity": 100, "seed": 17, "width": 72.54, "height": 16.900000000000002}, {"id": "rep_c_l2", "type": "text", "x": 355, "y": 358, "text": "count = 1043", "originalText": "count = 1043", "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#374151", "backgroundColor": "transparent", "opacity": 100, "seed": 18, "width": 96.72, "height": 16.900000000000002}, {"id": "converge1", "type": "arrow", "x": 125, "y": 390, "width": 105, "height": 50, "points": [[0, 0], [105, 50]], "strokeColor": "#047857", "backgroundColor": "transparent", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "seed": 19, "startArrowhead": null, "endArrowhead": "arrow"}, {"id": "converge2", "type": "arrow", "x": 265, "y": 390, "width": -35, "height": 50, "points": [[0, 0], [-35, 50]], "strokeColor": "#047857", "backgroundColor": "transparent", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "seed": 20, "startArrowhead": null, "endArrowhead": "arrow"}, {"id": "converge3", "type": "arrow", "x": 405, "y": 390, "width": -175, "height": 50, "points": [[0, 0], [-175, 50]], "strokeColor": "#047857", "backgroundColor": "transparent", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "seed": 21, "startArrowhead": null, "endArrowhead": "arrow"}, {"id": "converged", "type": "rectangle", "x": 130, "y": 440, "width": 200, "height": 60, "strokeColor": "#047857", "backgroundColor": "#a7f3d0", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "seed": 22, "roundness": {"type": 3}}, {"id": "converged_l1", "type": "text", "x": 145, "y": 452, "text": "no new writes:", "originalText": "no new writes:", "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#065f46", "backgroundColor": "transparent", "opacity": 100, "seed": 23, "width": 112.84, "height": 16.900000000000002}, {"id": "converged_l2", "type": "text", "x": 145, "y": 472, "text": "all converge to 1043", "originalText": "all converge to 1043", "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#065f46", "backgroundColor": "transparent", "opacity": 100, "seed": 24, "width": 161.2, "height": 16.900000000000002}, {"id": "left_evidence", "type": "rectangle", "x": 60, "y": 550, "width": 850, "height": 180, "strokeColor": "#1e3a5f", "backgroundColor": "#1e293b", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "seed": 25, "roundness": {"type": 3}}, {"id": "le1", "type": "text", "x": 80, "y": 570, "text": "Basically available: the like is accepted and shown to the user instantly,", "originalText": "Basically available: the like is accepted and shown to the user instantly,", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#22c55e", "backgroundColor": "transparent", "opacity": 100, "seed": 26, "width": 642.32, "height": 18.2}, {"id": "le2", "type": "text", "x": 80, "y": 592, "text": "no coordination wait across replicas.", "originalText": "no coordination wait across replicas.", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#22c55e", "backgroundColor": "transparent", "opacity": 100, "seed": 27, "width": 321.16, "height": 18.2}, {"id": "le3", "type": "text", "x": 80, "y": 622, "text": "Soft state: replicas can disagree for a moment; the count itself can drift", "originalText": "Soft state: replicas can disagree for a moment; the count itself can drift", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#22c55e", "backgroundColor": "transparent", "opacity": 100, "seed": 28, "width": 642.32, "height": 18.2}, {"id": "le4", "type": "text", "x": 80, "y": 644, "text": "even with no new likes, as the write keeps propagating.", "originalText": "even with no new likes, as the write keeps propagating.", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#22c55e", "backgroundColor": "transparent", "opacity": 100, "seed": 29, "width": 477.4, "height": 18.2}, {"id": "le5", "type": "text", "x": 80, "y": 674, "text": "Eventually consistent: once writes stop, every replica converges -- and", "originalText": "Eventually consistent: once writes stop, every replica converges -- and", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#22c55e", "backgroundColor": "transparent", "opacity": 100, "seed": 30, "width": 616.28, "height": 18.2}, {"id": "le6", "type": "text", "x": 80, "y": 696, "text": "nobody scrolling past the post ever notices the gap.", "originalText": "nobody scrolling past the post ever notices the gap.", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#22c55e", "backgroundColor": "transparent", "opacity": 100, "seed": 31, "width": 451.36, "height": 18.2}, {"id": "right_header", "type": "text", "x": 1050, "y": 140, "text": "Account Deletion -- ACID", "originalText": "Account Deletion -- ACID", "fontSize": 20, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#1e40af", "backgroundColor": "transparent", "opacity": 100, "seed": 32, "width": 297.6, "height": 26.0}, {"id": "txn_outer", "type": "rectangle", "x": 1050, "y": 190, "width": 500, "height": 320, "strokeColor": "#b45309", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "dashed", "roughness": 1, "opacity": 100, "seed": 33, "roundness": {"type": 3}}, {"id": "txn_label", "type": "text", "x": 1070, "y": 200, "text": "one atomic transaction", "originalText": "one atomic transaction", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#b45309", "backgroundColor": "transparent", "opacity": 100, "seed": 34, "width": 190.96, "height": 18.2}, {"id": "step1", "type": "rectangle", "x": 1090, "y": 240, "width": 420, "height": 60, "strokeColor": "#1e3a5f", "backgroundColor": "#3b82f6", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "seed": 35, "roundness": {"type": 3}}, {"id": "step1_l", "type": "text", "x": 1110, "y": 258, "text": "DELETE FROM accounts WHERE id = 482", "originalText": "DELETE FROM accounts WHERE id = 482", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#ffffff", "backgroundColor": "transparent", "opacity": 100, "seed": 36, "width": 303.8, "height": 18.2}, {"id": "s1s2", "type": "arrow", "x": 1300, "y": 300, "width": 0, "height": 40, "points": [[0, 0], [0, 40]], "strokeColor": "#1e3a5f", "backgroundColor": "transparent", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "seed": 37, "startArrowhead": null, "endArrowhead": "arrow"}, {"id": "step2", "type": "rectangle", "x": 1090, "y": 340, "width": 420, "height": 60, "strokeColor": "#1e3a5f", "backgroundColor": "#3b82f6", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "seed": 38, "roundness": {"type": 3}}, {"id": "step2_l", "type": "text", "x": 1110, "y": 358, "text": "DELETE FROM posts WHERE account_id = 482", "originalText": "DELETE FROM posts WHERE account_id = 482", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#ffffff", "backgroundColor": "transparent", "opacity": 100, "seed": 39, "width": 347.2, "height": 18.2}, {"id": "s2s3", "type": "arrow", "x": 1300, "y": 400, "width": 0, "height": 40, "points": [[0, 0], [0, 40]], "strokeColor": "#1e3a5f", "backgroundColor": "transparent", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "seed": 40, "startArrowhead": null, "endArrowhead": "arrow"}, {"id": "step3", "type": "rectangle", "x": 1090, "y": 440, "width": 420, "height": 60, "strokeColor": "#1e3a5f", "backgroundColor": "#60a5fa", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "seed": 41, "roundness": {"type": 3}}, {"id": "step3_l", "type": "text", "x": 1110, "y": 458, "text": "purge profile cache entry", "originalText": "purge profile cache entry", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#ffffff", "backgroundColor": "transparent", "opacity": 100, "seed": 42, "width": 217.0, "height": 18.2}, {"id": "committed_arrow", "type": "arrow", "x": 1300, "y": 500, "width": 0, "height": 50, "points": [[0, 0], [0, 50]], "strokeColor": "#047857", "backgroundColor": "transparent", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "seed": 43, "startArrowhead": null, "endArrowhead": "arrow"}, {"id": "committed", "type": "rectangle", "x": 1150, "y": 550, "width": 300, "height": 60, "strokeColor": "#047857", "backgroundColor": "#a7f3d0", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "seed": 44, "roundness": {"type": 3}}, {"id": "committed_l", "type": "text", "x": 1170, "y": 568, "text": "COMMIT: all 3, or none", "originalText": "COMMIT: all 3, or none", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#065f46", "backgroundColor": "transparent", "opacity": 100, "seed": 45, "width": 190.96, "height": 18.2}, {"id": "right_evidence", "type": "rectangle", "x": 1050, "y": 650, "width": 900, "height": 170, "strokeColor": "#1e3a5f", "backgroundColor": "#1e293b", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "seed": 46, "roundness": {"type": 3}}, {"id": "re1", "type": "text", "x": 1070, "y": 670, "text": "Atomic: a reader can never see the account gone but its posts still", "originalText": "Atomic: a reader can never see the account gone but its posts still", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#22c55e", "backgroundColor": "transparent", "opacity": 100, "seed": 47, "width": 581.56, "height": 18.2}, {"id": "re2", "type": "text", "x": 1070, "y": 692, "text": "present, or the reverse.", "originalText": "present, or the reverse.", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#22c55e", "backgroundColor": "transparent", "opacity": 100, "seed": 48, "width": 208.32, "height": 18.2}, {"id": "re3", "type": "text", "x": 1070, "y": 722, "text": "Isolated: no other transaction sees this account mid-deletion.", "originalText": "Isolated: no other transaction sees this account mid-deletion.", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#22c55e", "backgroundColor": "transparent", "opacity": 100, "seed": 49, "width": 538.16, "height": 18.2}, {"id": "re4", "type": "text", "x": 1070, "y": 752, "text": "Durable: once COMMIT returns, the deletion survives a crash the very", "originalText": "Durable: once COMMIT returns, the deletion survives a crash the very", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#22c55e", "backgroundColor": "transparent", "opacity": 100, "seed": 50, "width": 590.24, "height": 18.2}, {"id": "re5", "type": "text", "x": 1070, "y": 774, "text": "next instant -- it does not un-happen.", "originalText": "next instant -- it does not un-happen.", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#22c55e", "backgroundColor": "transparent", "opacity": 100, "seed": 51, "width": 329.84, "height": 18.2}], "appState": {"viewBackgroundColor": "#ffffff"}}