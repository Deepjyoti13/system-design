46", "backgroundColor": "transparent", "opacity": 100, "seed": 1, "width": 500, "height": 18.2}, {"id": "comp_good_t3", "type": "text", "x": 60, "y": 735, "text": "Narrows to one link's rows FIRST, then the date range within them.", "originalText": "Narrows to one link's rows FIRST, then the date range within them.", "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#065f46", "backgroundColor": "transparent", "opacity": 100, "seed": 1, "width": 600, "height": 16.900000000000002}, {"id": "comp_good_ok", "type": "text", "x": 560, "y": 685, "text": "USES INDEX", "originalText": "USES INDEX", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#047857", "backgroundColor": "transparent", "opacity": 100, "seed": 1, "width": 150, "height": 18.2}, {"id": "comp_bad", "type": "rectangle", "x": 40, "y": 800, "width": 660, "height": 110, "strokeColor": "#b91c1c", "backgroundColor": "#fecaca", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "seed": 1, "roundness": {"type": 3}}, {"id": "comp_bad_t1", "type": "text", "x": 60, "y": 815, "text": "Index: (occurred_at, url_id) -- order flipped", "originalText": "Index: (occurred_at, url_id) -- order flipped", "fontSize": 15, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#7f1d1d", "backgroundColor": "transparent", "opacity": 100, "seed": 1, "width": 420, "height": 19.5}, {"id": "comp_bad_t2", "type": "text", "x": 60, "y": 840, "text": "Query: WHERE url_id = ? AND occurred_at > ?", "originalText": "Query: WHERE url_id = ? AND occurred_at > ?", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#7f1d1d", "backgroundColor": "transparent", "opacity": 100, "seed": 1, "width": 500, "height": 18.2}, {"id": "comp_bad_t3", "type": "text", "x": 60, "y": 865, "text": "Can't narrow by url_id first -- scans every link's rows in the date range.