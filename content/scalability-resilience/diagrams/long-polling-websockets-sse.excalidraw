ize": 11, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#64748b", "backgroundColor": "transparent", "opacity": 100, "seed": 21, "width": 33.0, "height": 14.3}, {"id": "r22", "type": "rectangle", "x": 535, "y": 190, "width": 34, "height": 34, "strokeColor": "#1e40af", "backgroundColor": "#dbeafe", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "seed": 22, "roundness": {"type": 3}}, {"id": "t23", "type": "text", "x": 535, "y": 232, "text": "empty", "originalText": "empty", "fontSize": 11, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#64748b", "backgroundColor": "transparent", "opacity": 100, "seed": 23, "width": 33.0, "height": 14.3}, {"id": "r24", "type": "rectangle", "x": 740, "y": 190, "width": 34, "height": 34, "strokeColor": "#1e40af", "backgroundColor": "#dbeafe", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "seed": 24, "roundness": {"type": 3}}, {"id": "t25", "type": "text", "x": 740, "y": 232, "text": "empty", "originalText": "empty", "fontSize": 11, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#64748b", "backgroundColor": "transparent", "opacity": 100, "seed": 25, "width": 33.0, "height": 14.3}, {"id": "r26", "type": "rectangle", "x": 945, "y": 190, "width": 34, "height": 34, "strokeColor": "#1e40af", "backgroundColor": "#dbeafe", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "seed": 26, "roundness": {"type": 3}}, {"id": "t27", "type": "text", "x": 945, "y": 232, "text": "empty", "originalText": "empty", "fontSize": 11, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#64748b", "backgroundColor": "transparent", "opacity": 100, "seed": 27, "width": 33.0, "height": 14.3}, {"id": "r28", "type": "rectangle", "x": 1150, "y": 190, "width": 34, "height": 34, "strokeColor": "#1e40af", "backgroundColor": "#dbeafe", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "seed": 28, "roundness": {"type": 3}}, {"id": "t29", "type": "text", "x": 1150, "y": 232, "text": "empty", "originalText": "empty", "fontSize": 11, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#64748b", "backgroundColor": "transparent", "opacity": 100, "seed": 29, "width": 33.0, "height": 14.3}, {"id": "r30", "type": "rectangle", "x": 1355, "y": 190, "width": 34, "height": 34, "strokeColor": "#047857", "backgroundColor": "#a7f3d0", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "seed": 30, "roundness": {"type": 3}}, {"id": "t31", "type": "text", "x": 1357, "y": 232, "text": "data!", "originalText": "data!", "fontSize": 11, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#047857", "backgroundColor": "transparent", "opacity": 100, "seed": 31, "width": 33.0, "height": 14.3}, {"id": "r32", "type": "rectangle", "x": 1560, "y": 190, "width": 34, "height": 34, "strokeColor": "#1e40af", "backgroundColor": "#dbeafe", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "seed": 32, "roundness": {"type": 3}}, {"id": "t33", "type": "text", "x": 1560, "y": 232, "text": "empty", "originalText": "empty", "fontSize": 11, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#64748b", "backgroundColor": "transparent", "opacity": 100, "seed": 33, "width": 33.0, "height": 14.3}, {"id": "t34", "type": "text", "x": 330, "y": 262, "text": "7 requests in 10s, 6 of them wasted -- latency on the 6th poll's update is up to ~1.7s", "originalText": "7 requests in 10s, 6 of them wasted -- latency on the 6th poll's update is up to ~1.7s", "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#64748b", "backgroundColor": "transparent", "opacity": 100, "seed": 34, "width": 670.8, "height": 16.900000000000002}, {"id": "t35", "type": "text", "x": 40, "y": 340, "text": "Long Polling", "originalText": "Long Polling", "fontSize": 18, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#1e40af", "backgroundColor": "transparent", "opacity": 100, "seed": 35, "width": 129.6, "height": 23.400000000000002}, {"id": "t36", "type": "text", "x": 40, "y": 364, "text": "held open until", "originalText": "held open until", "fontSize": 12, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#64748b", "backgroundColor": "transparent", "opacity": 100, "seed": 36, "width": 108.0, "height": 15.600000000000001}, {"id": "t37", "type": "text", "x": 40, "y": 380, "text": "data or timeout", "originalText": "data or timeout", "fontSize": 12, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#64748b", "backgroundColor": "transparent", "opacity": 100, "seed": 37, "width": 108.0, "height": 15.600000000000001}, {"id": "l38", "type": "line", "x": 330, "y": 360, "width": 1230, "height": 0, "points": [[0, 0], [1230, 0]], "strokeColor": "#cbd5e1", "backgroundColor": "transparent", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "seed": 38}, {"id": "r39", "type": "rectangle", "x": 330, "y": 335, "width": 380, "height": 44, "strokeColor": "#1e40af", "backgroundColor": "#dbeafe", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "seed": 39, "roundness": {"type": 3}}, {"id": "t40", "type": "text", "x": 340, "y": 350, "text": "held open -> timeout, re-ask", "originalText": "held open -> timeout, re-ask", "fontSize": 12, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#1e3a5f", "backgroundColor": "transparent", "opacity": 100, "seed": 40, "width": 201.6, "height": 15.600000000000001}, {"id": "r41", "type": "rectangle", "x": 720, "y": 335, "width": 380, "height": 44, "strokeColor": "#1e40af", "backgroundColor": "#dbeafe", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "seed": 41, "roundness": {"type": 3}}, {"id": "t42", "type": "text", "x": 730, "y": 350, "text": "held open -> timeout, re-ask", "originalText": "held open -> timeout, re-ask", "fontSize": 12, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#1e3a5f", "backgroundColor": "transparent", "opacity": 100, "seed": 42, "width": 201.6, "height": 15.600000000000001}, {"id": "r43", "type": "rectangle", "x": 1120, "y": 335, "width": 300, "height": 44, "strokeColor": "#047857", "backgroundColor": "#a7f3d0", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "seed": 43, "roundness": {"type": 3}}, {"id": "t44", "type": "text", "x": 1130, "y": 350, "text": "held -> data!", "originalText": "held -> data!", "fontSize": 12, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#047857", "backgroundColor": "transparent", "opacity": 100, "seed": 44, "width": 93.6, "height": 15.600000000000001}, {"id": "t45", "type": "text", "x": 330, "y": 398, "text": "3 round trips in 10s instead of 7, near-immediate delivery -- but each hold ties up a server-side connection the whole time", "originalText": "3 round trips in 10s instead of 7, near-immediate delivery -- but each hold ties up a server-side connection the whole time", "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#64748b", "backgroundColor": "transparent", "opacity": 100, "seed": 45, "width": 959.4, "height": 16.900000000000002}, {"id": "t46", "type": "text", "x": 40, "y": 490, "text": "WebSocket", "originalText": "WebSocket", "fontSize": 18, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#1e40af", "backgroundColor": "transparent", "opacity": 100, "seed": 46, "width": 97.2, "height": 23.400000000000002}, {"id": "t47", "type": "text", "x": 40, "y": 514, "text": "one connection,", "originalText": "one connection,", "fontSize": 12, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#64748b", "backgroundColor": "transparent", "opacity": 100, "seed": 47, "width": 108.0, "height": 15.600000000000001}, {"id": "t48", "type": "text", "x": 40, "y": 530, "text": "open the whole time", "originalText": "open the whole time", "fontSize": 12, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#64748b", "backgroundColor": "transparent", "opacity": 100, "seed": 48, "width": 136.79999999999998, "height": 15.600000000000001}, {"id": "l49", "type": "line", "x": 330, "y": 510, "width": 1230, "height": 0, "points": [[0, 0], [1230, 0]], "strokeColor": "#cbd5e1", "backgroundColor": "transparent", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "seed": 49}, {"id": "r50", "type": "rectangle", "x": 330, "y": 485, "width": 1230, "height": 44, "strokeColor": "#6d28d9", "backgroundColor": "#ddd6fe", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "seed": 50, "roundness": {"type": 3}}, {"id": "t51", "type": "text", "x": 340, "y": 500, "text": "single upgraded TCP connection stays open, full-duplex", "originalText": "single upgraded TCP connection stays open, full-duplex", "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#4c1d95", "backgroundColor": "transparent", "opacity": 100, "seed": 51, "width": 421.2, "height": 16.900000000000002}, {"id": "a52", "type": "arrow", "x": 450, "y": 468, "width": 0, "height": 15, "points": [[0, 0], [0, 15]], "strokeColor": "#6d28d9", "backgroundColor": "transparent", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "seed": 52, "startArrowhead": null, "endArrowhead": "triangle"}, {"id": "a53", "type": "arrow", "x": 670, "y": 536, "width": 0, "height": -15, "points": [[0, 0], [0, -15]], "strokeColor": "#6d28d9", "backgroundColor": "transparent", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "seed": 53, "startArrowhead": null, "endArrowhead": "triangle"}, {"id": "a54", "type": "arrow", "x": 890, "y": 468, "width": 0, "height": 15, "points": [[0, 0], [0, 15]], "strokeColor": "#6d28d9", "backgroundColor": "transparent", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "seed": 54, "startArrowhead": null, "endArrowhead": "triangle"}, {"id": "a55", "type": "arrow", "x": 1230, "y": 468, "width": 0, "height": 15, "points": [[0, 0], [0, 15]], "strokeColor": "#6d28d9", "backgroundColor": "transparent", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "seed": 55, "startArrowhead": null, "endArrowhead": "triangle"}, {"id": "a56", "type": "arrow", "x": 1410, "y": 536, "width": 0, "height": -15, "points": [[0, 0], [0, -15]], "strokeColor": "#6d28d9", "backgroundColor": "transparent", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "seed": 56, "startArrowhead": null, "endArrowhead": "triangle"}, {"id": "t57", "type": "text", "x": 330, "y": 562, "text": "messages flow either direction at any moment -- no request has to precede a response", "originalText": "messages flow either direction at any moment -- no request has to precede a response", "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#64748b", "backgroundColor": "transparent", "opacity": 100, "seed": 57, "width": 655.1999999999999, "height": 16.900000000000002}, {"id": "r58", "type": "rectangle", "x": 40, "y": 600, "width": 1520, "height": 110, "strokeColor": "#1e293b", "backgroundColor": "#1e293b", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "seed": 58, "roundness": {"type": 3}}, {"id": "t59", "type": "text", "x": 60, "y": 616, "text": "Round trips for the same 10s window: short polling 7, long polling 3, WebSocket 0 (one connection, not a request).", "originalText": "Round trips for the same 10s window: short polling 7, long polling 3, WebSocket 0 (one connection, not a request).", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#22c55e", "backgroundColor": "transparent", "opacity": 100, "seed": 59, "width": 957.5999999999999, "height": 18.2}, {"id": "t60", "type": "text", "x": 60, "y": 640, "text": "Server-side cost shifts the other way: short polling holds nothing between polls; long polling holds one connection per", "originalText": "Server-side cost shifts the other way: short polling holds nothing between polls; long polling holds one connection per", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#22c55e", "backgroundColor": "transparent", "opacity": 100, "seed": 60, "width": 999.5999999999999, "height": 18.2}, {"id": "t61", "type": "text", "x": 60, "y": 664, "text": "waiting client for the hold duration; a WebSocket holds one connection per client for as long as they're connected, period.", "originalText": "waiting client for the hold duration; a WebSocket holds one connection per client for as long as they're connected, period.", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#22c55e", "backgroundColor": "transparent", "opacity": 100, "seed": 61, "width": 1033.2, "height": 18.2}, {"id": "t62", "type": "text", "x": 60, "y": 688, "text": "That's why WebSocket load balancing has to be sticky -- see load-balancing.md -- while stateless HTTP polling never needed to care.", "originalText": "That's why WebSocket load balancing has to be sticky -- see load-balancing.md -- while stateless HTTP polling never needed to care.", "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#f472b6", "backgroundColor": "transparent", "opacity": 100, "seed": 62, "width": 1021.8, "height": 16.900000000000002}], "appState": {"viewBackgroundColor": "#ffffff"}}