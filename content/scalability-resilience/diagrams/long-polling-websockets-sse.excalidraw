, "fontSize": 11, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#94a3b8", "backgroundColor": "transparent", "opacity": 100, "seed": 7, "width": 13.2, "height": 14.3}, {"id": "l8", "type": "line", "x": 822.0, "y": 104, "width": 0.0, "height": 8, "points": [[0, 0], [0.0, 8]], "strokeColor": "#94a3b8", "backgroundColor": "transparent", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "seed": 8}, {"id": "t9", "type": "text", "x": 814.0, "y": 116, "text": "4s", "originalText": "4s", "fontSize": 11, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#94a3b8", "backgroundColor": "transparent", "opacity": 100, "seed": 9, "width": 13.2, "height": 14.3}, {"id": "l10", "type": "line", "x": 1068.0, "y": 104, "width": 0.0, "height": 8, "points": [[0, 0], [0.0, 8]], "strokeColor": "#94a3b8", "backgroundColor": "transparent", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "seed": 10}, {"id": "t11", "type": "text", "x": 1060.0, "y": 116, "text": "6s", "originalText": "6s", "fontSize": 11, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#94a3b8", "backgroundColor": "transparent", "opacity": 100, "seed": 11, "width": 13.2, "height": 14.3}, {"id": "l12", "type": "line", "x": 1314.0, "y": 104, "width": 0.0, "height": 8, "points": [[0, 0], [0.0, 8]], "strokeColor": "#94a3b8", "backgroundColor": "transparent", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "seed": 12}, {"id": "t13", "type": "text", "x": 1306.0, "y": 116, "text": "8s", "originalText": "8s", "fontSize": 11, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#94a3b8", "backgroundColor": "transparent", "opacity": 100, "seed": 13, "width": 13.2, "height": 14.3}, {"id": "l14", "type": "line", "x": 1560.0, "y": 104, "width": 0.0, "height": 8, "points": [[0, 0], [0.0, 8]], "strokeColor": "#94a3b8", "backgroundColor": "transparent", "stro