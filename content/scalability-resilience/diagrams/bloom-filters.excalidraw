"verticalAlign": "middle", "strokeColor": "#b91c1c", "backgroundColor": "transparent", "opacity": 100, "seed": 1123, "width": 900, "height": 18.2}, {"id": "evidence_box", "type": "rectangle", "x": 40, "y": 490, "width": 900, "height": 92, "strokeColor": "#1e293b", "backgroundColor": "#1e293b", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "seed": 1124, "roundness": {"type": 3}}, {"id": "evidence1", "type": "text", "x": 60, "y": 508, "text": "More bits per item = lower false-positive rate. ~10 bits/item tunes to well under 1% FP rate --", "originalText": "More bits per item = lower false-positive rate. ~10 bits/item tunes to well under 1% FP rate --", "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "middle", "strokeColor": "#22c55e", "backgroundColor": "transparent", "opacity": 100, "seed": 1125, "width": 860, "height": 16.900000000000002}, {"id": "evidence2", "type": "text", "x": 60, "y": 530, "text": "a memory win that's the same whether each item is 8 bytes or 8 kilobytes, since only bits are stored.", "originalText": "a memory win that's the same whether each item is 8 bytes or 8 kilobytes, since only bits are stored.", "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "middle", "strokeColor": "#22c55e", "backgroundColor": "transparent", "opacity": 100, "seed": 1126, "width": 860, "height": 16.900000000000002}, {"id": "evidence3", "type": "text", "x": 60, "y": 555, "text": "No deletion: clearing a bit for one item can un-set it for another that hashed to the same position.", "originalText": "No deletion: clearing a bit for one item can un-set it for another that hashed to the same position.", "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "middle", "strokeColor": "#22c55e", "backgroundColor": "transparent", "opacity": 100, "seed": 1127, "width": 860, "height": 16.900000000000002}], "appState": {"viewBackgroundColor": "#ffffff"}}