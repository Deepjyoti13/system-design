{"type": "excalidraw", "version": 2, "source": "backpressure-load-shedding", "elements": [{"id": "e1", "type": "text", "x": 40, "y": 30, "text": "Backpressure, Load Shedding & Bulkheads", "originalText": "Backpressure, Load Shedding & Bulkheads", "fontSize": 26, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#1e40af", "backgroundColor": "transparent", "opacity": 100, "seed": 1, "width": 608.4, "height": 33.800000000000004}, {"id": "e2", "type": "text", "x": 40, "y": 75, "text": "Left: a full bounded queue signals the producer to slow down. Right: two isolated pools -- one overloaded, one unaffected.", "originalText": "Left: a full bounded queue signals the producer to slow down. Right: two isolated pools -- one overloaded, one unaffected.", "fontSize": 15, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#64748b", "backgroundColor": "transparent", "opacity": 100, "seed": 2, "width": 1500, "height": 19.5}, {"id": "e3", "type": "text", "x": 40, "y": 140, "text": "Backpressure", "originalText": "Backpressure", "fontSize": 20, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#1e40af", "backgroundColor": "transparent", "opacity": 100, "seed": 3, "width": 144.0, "height": 26.0}, {"id": "e4", "type": "rectangle", "x": 40, "y": 200, "width": 160, "height": 70, "strokeColor": "#1e3a5f", "backgroundColor": "#60a5fa", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "seed": 4, "roundness": {"type": 3}}, {"id": "e5", "type": "text", "x": 69.0, "y": 225.25, "text": "Producer", "originalText": "Producer", "fontSize": 15, "fontFamily": 3, "textAlign": "center", "verticalAlign": "middle", "strokeColor": "#ffffff", "backgroundColor": "transparent", "opacity": 100, "seed": 5, "width": 102.0, "height": 19.5}, {"id": "e6", "type": "rectangle", "x": 280, "y": 190, "width": 300, "height": 90, "strokeColor": "#1e3a5f", "backgroundColor": "#dbeafe", "fillS