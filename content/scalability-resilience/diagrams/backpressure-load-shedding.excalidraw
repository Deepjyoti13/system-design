th it, not just the new load.", "fontSize": 15, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#22c55e", "backgroundColor": "transparent", "opacity": 100, "seed": 25, "width": 720, "height": 19.5}, {"id": "e26", "type": "text", "x": 960, "y": 140, "text": "Bulkheads", "originalText": "Bulkheads", "fontSize": 20, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#1e40af", "backgroundColor": "transparent", "opacity": 100, "seed": 26, "width": 108.0, "height": 26.0}, {"id": "e27", "type": "rectangle", "x": 960, "y": 200, "width": 170, "height": 60, "strokeColor": "#1e3a5f", "backgroundColor": "#60a5fa", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "seed": 27, "roundness": {"type": 3}}, {"id": "e28", "type": "text", "x": 949.8, "y": 220.9, "text": "Checkout traffic", "originalText": "Checkout traffic", "fontSize": 14, "fontFamily": 3, "textAlign": "center", "verticalAlign": "middle", "strokeColor": "#ffffff", "backgroundColor": "transparent", "opacity": 100, "seed": 28, "width": 190.4, "height": 18.2}, {"id": "e29", "type": "rectangle", "x": 1180, "y": 190, "width": 240, "height": 80, "strokeColor": "#047857", "backgroundColor": "#a7f3d0", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "seed": 29, "roundness": {"type": 3}}, {"id": "e30", "type": "text", "x": 1217.125, "y": 210.25, "text": "Checkout pool", "originalText": "Checkout pool", "fontSize": 15, "fontFamily": 3, "textAlign": "center", "verticalAlign": "middle", "strokeColor": "#047857", "backgroundColor": "transparent", "opacity": 100, "seed": 30, "width": 165.75, "height": 19.5}, {"id": "e31", "type": "text", "x": 1178.45, "y": 236.55, "text": "8 / 20 busy -- healthy", "originalText": "8 / 20 busy -- healthy", "fontSize": 13, "fontFamily": 3, "textAlign": "center", "verticalAlign": "middle", "strokeColor": "#047857", "backgroundColor": "transparent", "opa