{"type": "excalidraw", "version": 2, "source": "idempotency-keys", "elements": [{"id": "e1", "type": "text", "x": 40, "y": 20, "text": "Idempotency Keys: a lost response doesn't mean a repeated charge", "originalText": "Idempotency Keys: a lost response doesn't mean a repeated charge", "fontSize": 26, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#1e40af", "backgroundColor": "transparent", "opacity": 100, "seed": 1, "width": 1031.68, "height": 33.800000000000004}, {"id": "e2", "type": "text", "x": 40, "y": 60, "text": "Same key K, two attempts by the client -- only one charge ever happens", "originalText": "Same key K, two attempts by the client -- only one charge ever happens", "fontSize": 16, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#3b82f6", "backgroundColor": "transparent", "opacity": 100, "seed": 1, "width": 694.4, "height": 20.8}, {"id": "e3", "type": "ellipse", "x": 140, "y": 110, "width": 160, "height": 70, "strokeColor": "#c2410c", "backgroundColor": "#fed7aa", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "seed": 1}, {"id": "e4", "type": "text", "x": 180, "y": 133, "text": "Client", "originalText": "Client", "fontSize": 20, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#374151", "backgroundColor": "transparent", "opacity": 100, "seed": 1, "width": 74.4, "height": 26.0}, {"id": "e5", "type": "ellipse", "x": 1000, "y": 110, "width": 160, "height": 70, "strokeColor": "#1e3a5f", "backgroundColor": "#3b82f6", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "seed": 1}, {"id": "e6", "type": "text", "x": 1045, "y": 133, "text": "Server", "originalText": "Server", "fontSize": 20, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#ffffff", "backgroundColor": "transparent", "opacity": 100, "seed": 1, "width": 74.4, "height": 26.0}, {"id": "e7", "type": "text", "x": 230, "y": 214, "text": "1) POST /charge  key=K  amount=$50", "originalText": "1) POST /charge  key=K  amount=$50", "fontSize": 15, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#1e3a5f", "backgroundColor": "transparent", "opacity": 100, "seed": 1, "width": 316.2, "height": 19.5}, {"id": "e8", "type": "arrow", "x": 220, "y": 240, "width": 800, "height": 0, "points": [[0, 0], [800, 0]], "strokeColor": "#1e3a5f", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "seed": 1, "startArrowhead": null, "endArrowhead": "arrow"}, {"id": "e9", "type": "rectangle", "x": 920, "y": 280, "width": 320, "height": 60, "strokeColor": "#047857", "backgroundColor": "#a7f3d0", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "seed": 1, "roundness": {"type": 3}}, {"id": "e10", "type": "text", "x": 940, "y": 290, "text": "charge $50 -> SUCCESS", "originalText": "charge $50 -> SUCCESS", "fontSize": 15, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#374151", "backgroundColor": "transparent", "opacity": 100, "seed": 1, "width": 195.3, "height": 19.5}, {"id": "e11", "type": "text", "x": 940, "y": 312, "text": "commits row: K -> success", "originalText": "commits row: K -> success", "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#047857", "backgroundColor": "transparent", "opacity": 100, "seed": 1, "width": 201.5, "height": 16.900000000000002}, {"id": "e12", "type": "text", "x": 660, "y": 394, "text": "response (200 OK)", "originalText": "response (200 OK)", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#dc2626", "backgroundColor": "transparent", "opacity": 100, "seed": 1, "width": 147.56, "height": 18.2}, {"id": "e13", "type": "arrow", "x": 1020, "y": 420, "width": -380, "height": 0, "points": [[0, 0], [-380, 0]], "strokeColor": "#dc2626", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "dashed", "roughness": 1, "opacity": 100, "seed": 1, "startArrowhead": null, "endArrowhead": "arrow"}, {"id": "e14", "type": "text", "x": 600, "y": 434, "text": "X LOST IN TRANSIT -- never reaches the client", "originalText": "X LOST IN TRANSIT -- never reaches the client", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#dc2626", "backgroundColor": "transparent", "opacity": 100, "seed": 1, "width": 390.6, "height": 18.2}, {"id": "e15", "type": "text", "x": 120, "y": 510, "text": "timeout -- client has NO response,", "originalText": "timeout -- client has NO response,", "fontSize": 15, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#dc2626", "backgroundColor": "transparent", "opacity": 100, "seed": 1, "width": 316.2, "height": 19.5}, {"id": "e16", "type": "text", "x": 120, "y": 532, "text": "cannot tell success from failure", "originalText": "cannot tell success from failure", "fontSize": 15, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#dc2626", "backgroundColor": "transparent", "opacity": 100, "seed": 1, "width": 297.6, "height": 19.5}, {"id": "e17", "type": "text", "x": 120, "y": 560, "text": "retries with the SAME key K", "originalText": "retries with the SAME key K", "fontSize": 15, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#374151", "backgroundColor": "transparent", "opacity": 100, "seed": 1, "width": 251.1, "height": 19.5}, {"id": "e18", "type": "text", "x": 230, "y": 594, "text": "2) POST /charge  key=K  amount=$50 (retry)", "originalText": "2) POST /charge  key=K  amount=$50 (retry)", "fontSize": 15, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#1e3a5f", "backgroundColor": "transparent", "opacity": 100, "seed": 1, "width": 390.6, "height": 19.5}, {"id": "e19", "type": "arrow", "x": 220, "y": 620, "width": 800, "height": 0, "points": [[0, 0], [800, 0]], "strokeColor": "#1e3a5f", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "seed": 1, "startArrowhead": null, "endArrowhead": "arrow"}, {"id": "e20", "type": "rectangle", "x": 920, "y": 660, "width": 340, "height": 60, "strokeColor": "#b45309", "backgroundColor": "#fef3c7", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "seed": 1, "roundness": {"type": 3}}, {"id": "e21", "type": "text", "x": 940, "y": 670, "text": "lookup K -> found existing result", "originalText": "lookup K -> found existing result", "fontSize": 15, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#374151", "backgroundColor": "transparent", "opacity": 100, "seed": 1, "width": 306.9, "height": 19.5}, {"id": "e22", "type": "text", "x": 940, "y": 692, "text": "charge logic is NOT re-run", "originalText": "charge logic is NOT re-run", "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#b45309", "backgroundColor": "transparent", "opacity": 100, "seed": 1, "width": 209.56, "height": 16.900000000000002}, {"id": "e23", "type": "text", "x": 230, "y": 774, "text": "return STORED result (200 OK) -- charge NOT repeated", "originalText": "return STORED result (200 OK) -- charge NOT repeated", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#047857", "backgroundColor": "transparent", "opacity": 100, "seed": 1, "width": 451.36, "height": 18.2}, {"id": "e24", "type": "arrow", "x": 1020, "y": 800, "width": -800, "height": 0, "points": [[0, 0], [-800, 0]], "strokeColor": "#047857", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "seed": 1, "startArrowhead": null, "endArrowhead": "arrow"}, {"id": "e25", "type": "rectangle", "x": 60, "y": 870, "width": 1360, "height": 110, "strokeColor": "#1e293b", "backgroundColor": "#1e293b", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "seed": 1, "roundness": {"type": 3}}, {"id": "e26", "type": "text", "x": 90, "y": 885, "text": "The charge happens exactly once -- inside step 1, the very first time key K is seen.", "originalText": "The charge happens exactly once -- inside step 1, the very first time key K is seen.", "fontSize": 15, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#22c55e", "backgroundColor": "transparent", "opacity": 100, "seed": 1, "width": 781.2, "height": 19.5}, {"id": "e27", "type": "text", "x": 90, "y": 912, "text": "Step 2's retry never touches the charge logic again -- it only reads back the result step 1 already stored.", "originalText": "Step 2's retry never touches the charge logic again -- it only reads back the result step 1 already stored.", "fontSize": 15, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#22c55e", "backgroundColor": "transparent", "opacity": 100, "seed": 1, "width": 995.1, "height": 19.5}, {"id": "e28", "type": "text", "x": 90, "y": 939, "text": "The client's uncertainty was only ever about the RESPONSE. The operation itself was never in doubt.", "originalText": "The client's uncertainty was only ever about the RESPONSE. The operation itself was never in doubt.", "fontSize": 15, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#93c5fd", "backgroundColor": "transparent", "opacity": 100, "seed": 1, "width": 920.7, "height": 19.5}], "appState": {"viewBackgroundColor": "#ffffff"}}