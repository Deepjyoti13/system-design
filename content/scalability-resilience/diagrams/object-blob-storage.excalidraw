ts": [[0, 0], [130, 0]], "startArrowhead": null, "endArrowhead": "triangle"}, {"id": "e1013", "type": "text", "x": 215, "y": 200, "text": "PUT photo.jpg", "originalText": "PUT photo.jpg", "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#1e3a5f", "backgroundColor": "transparent", "opacity": 100, "seed": 1013, "width": 101.39999999999999, "height": 16.900000000000002}, {"id": "e1014", "type": "text", "x": 215, "y": 214, "text": "(500MB, hop 1)", "originalText": "(500MB, hop 1)", "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#1e3a5f", "backgroundColor": "transparent", "opacity": 100, "seed": 1014, "width": 109.2, "height": 16.900000000000002}, {"id": "e1015", "type": "arrow", "x": 560, "y": 225, "width": 130, "height": 1, "strokeColor": "#dc2626", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "seed": 1015, "points": [[0, 0], [130, 0]], "startArrowhead": null, "endArrowhead": "triangle"}, {"id": "e1016", "type": "text", "x": 565, "y": 200, "text": "PUT photo.jpg", "originalText": "PUT photo.jpg", "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#dc2626", "backgroundColor": "transparent", "opacity": 100, "seed": 1016, "width": 101.39999999999999, "height": 16.900000000000002}, {"id": "e1017", "type": "text", "x": 565, "y": 214, "text": "(500MB, hop 2)", "originalText": "(500MB, hop 2)", "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#dc2626", "backgroundColor": "transparent", "opacity": 100, "seed": 1017, "width": 109.2, "height": 16.900000000000002}, {"id": "e1018", "type": "rectangle", "x": 60, "y": 360, "width": 850, "height": 110, "strokeColor": "#0f172a", "backgroundColor": "#1e293b", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "seed": 1018, "groupIds": [], "roundness": {"type": 3}}, {"id": "e1019", "type": "text", "x": 78, "y": 378, "text": "500MB in from the client, then 500MB back out to storage --", "originalText": "500MB in from the client, then 500MB back out to storage --", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#f87171", "backgroundColor": "transparent", "opacity": 100, "seed": 1019, "width": 495.59999999999997, "height": 18.2}, {"id": "e1020", "type": "text", "x": 78, "y": 400, "text": "your API server pays double bandwidth AND holds one process/thread", "originalText": "your API server pays double bandwidth AND holds one process/thread", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#f87171", "backgroundColor": "transparent", "opacity": 100, "seed": 1020, "width": 554.4, "height": 18.2}, {"id": "e1021", "type": "text", "x": 78, "y": 422, "text": "open for the entire transfer. A handful of large uploads at once", "originalText": "open for the entire transfer. A handful of large uploads at once", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#f87171", "backgroundColor": "transparent", "opacity": 100, "seed": 1021, "width": 537.6, "height": 18.2}, {"id": "e1022", "type": "text", "x": 78, "y": 444, "text": "can exhaust the tier that's also serving every small unrelated request.", "originalText": "can exhaust the tier that's also serving every small unrelated request.", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#f87171", "backgroundColor": "transparent", "opacity": 100, "seed": 1022, "width": 596.4, "height": 18.2}, {"id": "e1023", "type": "text", "x": 1000, "y": 130, "text": "Pre-Signed URL", "originalText": "Pre-Signed URL", "fontSize": 19, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#1e40af", "backgroundColor": "transparent", "opacity": 100, "seed": 1023, "width": 159.6, "height": 24.7}, {"id": "e1024", "type": "ellipse", "x": 1000, "y": 300, "width": 150, "height": 90, "strokeColor": "#c2410c", "backgroundColor": "#fed7aa", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "seed": 1024}, {"id": "e1025", "type": "text", "x": 1048.0, "y": 335.25, "text": "Client", "originalText": "Client", "fontSize": 15, "fontFamily": 3, "textAlign": "center", "verticalAlign": "top", "strokeColor": "#7c2d12", "backgroundColor": "transparent", "opacity": 100, "seed": 1025, "width": 54.0, "height": 19.5}, {"id": "e1026", "type": "rectangle", "x": 1350, "y": 150, "width": 220, "height": 90, "strokeColor": "#1e3a5f", "backgroundColor": "#3b82f6", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "seed": 1026, "groupIds": [], "roundness": {"type": 3}}, {"id": "e1027", "type": "text", "x": 1370.0, "y": 185.25, "text": "API (signs URL only)", "originalText": "API (signs URL only)", "fontSize": 15, "fontFamily": 3, "textAlign": "center", "verticalAlign": "top", "strokeColor": "#ffffff", "backgroundColor": "transparent", "opacity": 100, "seed": 1027, "width": 180.0, "height": 19.5}, {"id": "e1028", "type": "rectangle", "x": 1350, "y": 470, "width": 220, "height": 90, "strokeColor": "#1e3a5f", "backgroundColor": "#93c5fd", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "seed": 1028, "groupIds": [], "roundness": {"type": 3}}, {"id": "e1029", "type": "text", "x": 1397.0, "y": 505.25, "text": "Object storage", "originalText": "Object storage", "fontSize": 15, "fontFamily": 3, "textAlign": "center", "verticalAlign": "top", "strokeColor": "#1e3a5f", "backgroundColor": "transparent", "opacity": 100, "seed": 1029, "width": 126.0, "height": 19.5}, {"id": "e1030", "type": "text", "x": 1010, "y": 163, "text": "1. \"I want to upload photo.jpg\" (tiny)", "originalText": "1. \"I want to upload photo.jpg\" (tiny)", "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#1e3a5f", "backgroundColor": "transparent", "opacity": 100, "seed": 1030, "width": 296.4, "height": 16.900000000000002}, {"id": "e1031", "type": "arrow", "x": 1075, "y": 300, "width": 1, "height": 105, "strokeColor": "#1e3a5f", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "seed": 1031, "points": [[0, 0], [0, -105]], "startArrowhead": null, "endArrowhead": "triangle"}, {"id": "e1032", "type": "arrow", "x": 1075, "y": 195, "width": 275, "height": 1, "strokeColor": "#1e3a5f", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "seed": 1032, "points": [[0, 0], [275, 0]], "startArrowhead": null, "endArrowhead": "triangle"}, {"id": "e1033", "type": "text", "x": 1010, "y": 415, "text": "2. pre-signed PUT URL (expires in 5 min)", "originalText": "2. pre-signed PUT URL (expires in 5 min)", "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#16a34a", "backgroundColor": "transparent", "opacity": 100, "seed": 1033, "width": 312.0, "height": 16.900000000000002}, {"id": "e1034", "type": "arrow", "x": 1350, "y": 225, "width": 210, "height": 1, "strokeColor": "#16a34a", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "seed": 1034, "points": [[0, 0], [-210, 0]], "startArrowhead": null, "endArrowhead": "triangle"}, {"id": "e1035", "type": "arrow", "x": 1140, "y": 225, "width": 1, "height": 115, "strokeColor": "#16a34a", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "seed": 1035, "points": [[0, 0], [0, 115]], "startArrowhead": null, "endArrowhead": "triangle"}, {"id": "e1036", "type": "text", "x": 1010, "y": 555, "text": "3. PUT photo.jpg (500MB) DIRECT to storage", "originalText": "3. PUT photo.jpg (500MB) DIRECT to storage", "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#b45309", "backgroundColor": "transparent", "opacity": 100, "seed": 1036, "width": 327.59999999999997, "height": 16.900000000000002}, {"id": "e1037", "type": "text", "x": 1010, "y": 571, "text": "-- the API is never touched by these bytes", "originalText": "-- the API is never touched by these bytes", "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#b45309", "backgroundColor": "transparent", "opacity": 100, "seed": 1037, "width": 327.59999999999997, "height": 16.900000000000002}, {"id": "e1038", "type": "arrow", "x": 1150, "y": 345, "width": 1, "height": 170, "strokeColor": "#b45309", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "seed": 1038, "points": [[0, 0], [0, 170]], "startArrowhead": null, "endArrowhead": "triangle"}, {"id": "e1039", "type": "arrow", "x": 1150, "y": 515, "width": 200, "height": 1, "strokeColor": "#b45309", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "seed": 1039, "points": [[0, 0], [200, 0]], "startArrowhead": null, "endArrowhead": "triangle"}, {"id": "e1040", "type": "rectangle", "x": 1000, "y": 640, "width": 610, "height": 90, "strokeColor": "#0f172a", "backgroundColor": "#1e293b", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "seed": 1040, "groupIds": [], "roundness": {"type": 3}}, {"id": "e1041", "type": "text", "x": 1018, "y": 658, "text": "Only two tiny signed-URL messages pass through the API.", "originalText": "Only two tiny signed-URL messages pass through the API.", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#4ade80", "backgroundColor": "transpare