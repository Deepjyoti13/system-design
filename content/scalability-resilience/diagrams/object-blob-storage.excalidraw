{"type": "excalidraw", "version": 2, "source": "blob-storage-diagram", "elements": [{"id": "e1001", "type": "text", "x": 40, "y": 30, "text": "Object Storage: Proxying an Upload vs. a Pre-Signed URL", "originalText": "Object Storage: Proxying an Upload vs. a Pre-Signed URL", "fontSize": 26, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#1e40af", "backgroundColor": "transparent", "opacity": 100, "seed": 1001, "width": 858.0, "height": 33.800000000000004}, {"id": "e1002", "type": "text", "x": 40, "y": 68, "text": "Same 500MB upload, two paths -- only one keeps your API server out of the byte stream", "originalText": "Same 500MB upload, two paths -- only one keeps your API server out of the byte stream", "fontSize": 15, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#64748b", "backgroundColor": "transparent", "opacity": 100, "seed": 1002, "width": 765.0, "height": 19.5}, {"id": "e1003", "type": "text", "x": 60, "y": 130, "text": "Proxied Through Your API", "originalText": "Proxied Through Your API", "fontSize": 19, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#1e40af", "backgroundColor": "transparent", "opacity": 100, "seed": 1003, "width": 273.59999999999997, "height": 24.7}, {"id": "e1004", "type": "ellipse", "x": 60, "y": 190, "width": 150, "height": 90, "strokeColor": "#c2410c", "backgroundColor": "#fed7aa", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "seed": 1004}, {"id": "e1005", "type": "text", "x": 108.0, "y": 225.25, "text": "Client", "originalText": "Client", "fontSize": 15, "fontFamily": 3, "textAlign": "center", "verticalAlign": "top", "strokeColor": "#7c2d12", "backgroundColor": "transparent", "opacity": 100, "seed": 1005, "width": 54.0, "height": 19.5}, {"id": "e1006", "type": "rectangle", "x": 340, "y": 190, "width": 220, "height": 90, "strokeColor": "#1e3a5f", "backgroundColor": "#3b82f6", "fillStyle": "soli