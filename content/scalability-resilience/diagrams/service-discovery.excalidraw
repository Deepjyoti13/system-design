 "roughness": 0, "opacity": 100, "angle": 0, "seed": 589901, "version": 1, "versionNonce": 923659, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "roundness": {"type": 3}}, {"type": "text", "id": "e41", "x": 84, "y": 820, "width": 1520, "height": 19.5, "text": "Getting INTO the registry: self-registration (instance calls the registry on startup -- simple, but a crash", "originalText": "Getting INTO the registry: self-registration (instance calls the registry on startup -- simple, but a crash", "fontSize": 15, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#22c55e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 736360, "version": 1, "versionNonce": 906646, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25}, {"type": "text", "id": "e42", "x": 84, "y": 842, "width": 1520, "height": 19.5, "text": "that skips deregistration leaves a stale entry) vs. third-party registration (an orchestrator like Kubernetes", "originalText": "that skips deregistration leaves a stale entry) vs. third-party registration (an orchestrator like Kubernetes", "fontSize": 15, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#22c55e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 570814, "version": 1, "versionNonce": 941232, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25}, {"type": "text", "id": "e43", "x": 84, "y": 864, "width": 1520, "height": 19.5, "text": "registers instances for you, based on what it already knows it deployed -- no instance-side code needed).", "originalText": "registers instances for you, based on what it already knows it deployed -- no instance-side code needed).", "fontSize": 15, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#22c55e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 196845, "version": 1, "versionNonce": 527251, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25}, {"type": "text", "id": "e44", "x": 84, "y": 900, "width": 1520, "height": 19.5, "text": "Health checking keeps the registry honest: a HEARTBEAT/TTL entry expires if not renewed (Instance 3, above),", "originalText": "Health checking keeps the registry honest: a HEARTBEAT/TTL entry expires if not renewed (Instance 3, above),", "fontSize": 15, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#fca5a5", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 429911, "version": 1, "versionNonce": 301729, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25}, {"type": "text", "id": "e45", "x": 84, "y": 922, "width": 1520, "height": 19.5, "text": "or an active check polls each instance directly. Without this, callers keep getting routed to an instance", "originalText": "or an active check polls each instance directly. Without this, callers keep getting routed to an instance", "fontSize": 15, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#fca5a5", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 91, "version": 1, "versionNonce": 537079, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25}, {"type": "text", "id": "e46", "x": 84, "y": 944, "width": 1520, "height": 19.5, "text": "that's still 'registered' but has actually stopped working.", "originalText": "that's still 'registered' but has actually stopped working.", "fontSize": 15, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#fca5a5", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 73725, "version": 1, "versionNonce": 847329, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25}], "appState": {"viewBackgroundColor": "#ffffff"}}