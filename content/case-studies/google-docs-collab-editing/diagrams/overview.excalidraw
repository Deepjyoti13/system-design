    { "type": "text", "id": "ov_outcome_correct_desc", "x": 498, "y": 570, "width": 300, "height": 105,
      "text": "B's delete position is shifted\nby +2, since A's insert landed\nbefore it -- now targets\nposition 5, which is 'D'.\n\nResult: \"ABXYCE\" -- both\nedits survive, correctly.",
      "originalText": "B's delete position is shifted\nby +2, since A's insert landed\nbefore it -- now targets\nposition 5, which is 'D'.\n\nResult: \"ABXYCE\" -- both\nedits survive, correctly.",
