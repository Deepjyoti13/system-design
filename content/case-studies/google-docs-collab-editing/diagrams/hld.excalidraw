{"type": "excalidraw", "version": 2, "source": "gdocs-diagram-gen", "elements": [{"id": "t1", "type": "text", "x": 40, "y": 24, "width": 1021, "height": 30, "text": "Operational Transformation: why a concurrent delete shifts an insert", "originalText": "Operational Transformation: why a concurrent delete shifts an insert", "fontSize": 24, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#1e40af", "backgroundColor": "transparent", "opacity": 100, "seed": 1}, {"id": "t2", "type": "text", "x": 40, "y": 58, "width": 568, "height": 21, "text": "User A and User B edit the same document at the same instant", "originalText": "User A and User B edit the same document at the same instant", "fontSize": 15, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#64748b", "backgroundColor": "transparent", "opacity": 100, "seed": 2}, {"id": "e3", "type": "ellipse", "x": 40, "y": 120, "width": 220, "height": 80, "strokeColor": "#1e3a5f", "backgroundColor": "#60a5fa", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "seed": 3}, {"id": "t4", "type": "text", "x": 60, "y": 148, "width": 76, "height": 24, "text": "User A", "originalText": "User A", "fontSize": 18, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#1e40af", "backgroundColor": "transparent", "opacity": 100, "seed": 4}, {"id": "t5", "type": "text", "x": 60, "y": 175, "width": 195, "height": 19, "text": "types 'x' at position 5", "originalText": "types 'x' at position 5", "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#374151", "backgroundColor": "transparent", "opacity": 100, "seed": 5}, {"id": "r6", "type": "rectangle", "x": 40, "y": 240, "width": 300, "height": 70, "strokeColor": "#1e3a5f", "backgroundColor": "#93c5fd", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "seed": 6, "roundness": {"type": 3}}, {"id": "t7", "type": "text", "x": 60, "y": 265, "width": 178, "height": 22, "text": "insert('x', at=5)", "originalText": "insert('x', at=5)", "fontSize": 16, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#1e293b", "backgroundColor": "transparent", "opacity": 100, "seed": 7}, {"id": "e8", "type": "ellipse", "x": 40, "y": 400, "width": 220, "height": 80, "strokeColor": "#1e3a5f", "backgroundColor": "#60a5fa", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "seed": 8}, {"id": "t9", "type": "text", "x": 60, "y": 428, "width": 76, "height": 24, "text": "User B", "originalText": "User B", "fontSize": 18, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#1e40af", "backgroundColor": "transparent", "opacity": 100, "seed": 9}, {"id": "t10", "type": "text", "x": 60, "y": 455, "width": 235, "height": 19, "text": "deletes 1 char at position 3", "originalText": "deletes 1 char at position 3", "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#374151", "backgroundColor": "transparent", "opacity": 100, "seed": 10}, {"id": "r11", "type": "rectangle", "x": 40, "y": 520, "width": 300, "height": 70, "strokeColor": "#1e3a5f", "backgroundColor": "#93c5fd", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "seed": 11, "roundness": {"type": 3}}, {"id": "t12", "type": "text", "x": 60, "y": 545, "width": 198, "height": 22, "text": "delete(at=3, len=1)", "originalText": "delete(at=3, len=1)", "fontSize": 16, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#1e293b", "backgroundColor": "transparent", "opacity": 100, "seed": 12}, {"id": "a13", "type": "arrow", "x": 340, "y": 275, "width": 130, "height": 65, "points": [[0, 0], [130, 65]], "strokeColor": "#1e3a5f", "backgroundColor": "transparent", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "seed": 13, "startArrowhead": null, "endArrowhead": "triangle"}, {"id": "a14", "type": "arrow", "x": 340, "y": 555, "width": 130, "height": -65, "points": [[0, 0], [130, -65]], "strokeColor": "#1e3a5f", "backgroundColor": "transparent", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "seed": 14, "startArrowhead": null, "endArrowhead": "triangle"}, {"id": "r15", "type": "rectangle", "x": 470, "y": 260, "width": 480, "height": 340, "strokeColor": "#1e40af", "backgroundColor": "#dbeafe", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "seed": 15, "roundness": {"type": 3}}, {"id": "t16", "type": "text", "x": 495, "y": 275, "width": 333, "height": 24, "text": "Server: Operational Transform", "originalText": "Server: Operational Transform", "fontSize": 18, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#1e40af", "backgroundColor": "transparent", "opacity": 100, "seed": 16}, {"id": "t17", "type": "text", "x": 495, "y": 310, "width": 279, "height": 20, "text": "1. Apply B's delete(at=3) first", "originalText": "1. Apply B's delete(at=3) first", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#374151", "backgroundColor": "transparent", "opacity": 100, "seed": 17}, {"id": "t18", "type": "text", "x": 495, "y": 334, "width": 444, "height": 20, "text": "   -> everything after position 3 shifts left by 1", "originalText": "   -> everything after position 3 shifts left by 1", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#374151", "backgroundColor": "transparent", "opacity": 100, "seed": 18}, {"id": "t19", "type": "text", "x": 495, "y": 358, "width": 287, "height": 20, "text": "2. Transform A's op against B's:", "originalText": "2. Transform A's op against B's:", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#374151", "backgroundColor": "transparent", "opacity": 100, "seed": 19}, {"id": "t20", "type": "text", "x": 495, "y": 382, "width": 313, "height": 20, "text": "   insert(at=5)  --->  insert(at=4)", "originalText": "   insert(at=5)  --->  insert(at=4)", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#047857", "backgroundColor": "transparent", "opacity": 100, "seed": 20}, {"id": "t21", "type": "text", "x": 495, "y": 406, "width": 279, "height": 20, "text": "3. Apply A's transformed insert", "originalText": "3. Apply A's transformed insert", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#374151", "backgroundColor": "transparent", "opacity": 100, "seed": 21}, {"id": "t22", "type": "text", "x": 495, "y": 454, "width": 339, "height": 20, "text": "Why: B's delete was BEFORE position 5,", "originalText": "Why: B's delete was BEFORE position 5,", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#374151", "backgroundColor": "transparent", "opacity": 100, "seed": 22}, {"id": "t23", "type": "text", "x": 495, "y": 478, "width": 339, "height": 20, "text": "so A's target position must shift too.", "originalText": "so A's target position must shift too.", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#374151", "backgroundColor": "transparent", "opacity": 100, "seed": 23}, {"id": "a24", "type": "arrow", "x": 950, "y": 400, "width": 110, "height": 0, "points": [[0, 0], [110, 0]], "strokeColor": "#1e3a5f", "backgroundColor": "transparent", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "seed": 24, "startArrowhead": null, "endArrowhead": "triangle"}, {"id": "r25", "type": "rectangle", "x": 1060, "y": 340, "width": 300, "height": 120, "strokeColor": "#047857", "backgroundColor": "#a7f3d0", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "seed": 25, "roundness": {"type": 3}}, {"id": "t26", "type": "text", "x": 1080, "y": 360, "width": 196, "height": 21, "text": "Broadcast, in order:", "originalText": "Broadcast, in order:", "fontSize": 15, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#047857", "backgroundColor": "transparent", "opacity": 100, "seed": 26}, {"id": "t27", "type": "text", "x": 1080, "y": 386, "width": 174, "height": 20, "text": "1) B's delete(at=3)", "originalText": "1) B's delete(at=3)", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#1e293b", "backgroundColor": "transparent", "opacity": 100, "seed": 27}, {"id": "t28", "type": "text", "x": 1080, "y": 410, "width": 305, "height": 20, "text": "2) A's insert(at=4)  (transformed)", "originalText": "2) A's insert(at=4)  (transformed)", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#1e293b", "backgroundColor": "transparent", "opacity": 100, "seed": 28}, {"id": "a29", "type": "arrow", "x": 1100, "y": 460, "width": -250, "height": 160, "points": [[0, 0], [-250, 160]], "strokeColor": "#1e3a5f", "backgroundColor": "transparent", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "seed": 29, "startArrowhead": null, "endArrowhead": "triangle"}, {"id": "a30", "type": "arrow", "x": 1220, "y": 460, "width": 0, "height": 160, "points": [[0, 0], [0, 160]], "strokeColor": "#1e3a5f", "backgroundColor": "transparent", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "seed": 30, "startArrowhead": null, "endArrowhead": "triangle"}, {"id": "r31", "type": "rectangle", "x": 700, "y": 620, "width": 300, "height": 110, "strokeColor": "#047857", "backgroundColor": "#a7f3d0", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "seed": 31, "roundness": {"type": 3}}, {"id": "t32", "type": "text", "x": 720, "y": 640, "width": 130, "height": 21, "text": "User A's view", "originalText": "User A's view", "fontSize": 15, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#047857", "backgroundColor": "transparent", "opacity": 100, "seed": 32}, {"id": "t33", "type": "text", "x": 720, "y": 666, "width": 163, "height": 19, "text": "same final document", "originalText": "same final document", "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#374151", "backgroundColor": "transparent", "opacity": 100, "seed": 33}, {"id": "t34", "type": "text", "x": 720, "y": 690, "width": 122, "height": 19, "text": "as User B sees", "originalText": "as User B sees", "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#374151", "backgroundColor": "transparent", "opacity": 100, "seed": 34}, {"id": "r35", "type": "rectangle", "x": 1080, "y": 620, "width": 300, "height": 110, "strokeColor": "#047857", "backgroundColor": "#a7f3d0", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "seed": 35, "roundness": {"type": 3}}, {"id": "t36", "type": "text", "x": 1100, "y": 640, "width": 130, "height": 21, "text": "User B's view", "originalText": "User B's view", "fontSize": 15, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#047857", "backgroundColor": "transparent", "opacity": 100, "seed": 36}, {"id": "t37", "type": "text", "x": 1100, "y": 666, "width": 163, "height": 19, "text": "same final document", "originalText": "same final document", "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#374151", "backgroundColor": "transparent", "opacity": 100, "seed": 37}, {"id": "t38", "type": "text", "x": 1100, "y": 690, "width": 122, "height": 19, "text": "as User A sees", "originalText": "as User A sees", "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#374151", "backgroundColor": "transparent", "opacity": 100, "seed": 38}, {"id": "r39", "type": "rectangle", "x": 40, "y": 780, "width": 1340, "height": 110, "strokeColor": "#1e293b", "backgroundColor": "#1e293b", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "seed": 39, "roundness": {"type": 3}}, {"id": "t40", "type": "text", "x": 60, "y": 800, "width": 799, "height": 20, "text": "Without the transform: applying A's insert(at=5) directly onto B's already-shifted document", "originalText": "Without the transform: applying A's insert(at=5) directly onto B's already-shifted document", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#22c55e", "backgroundColor": "transparent", "opacity": 100, "seed": 40}, {"id": "t41", "type": "text", "x": 60, "y": 824, "width": 1025, "height": 20, "text": "would land the new character one position too far right -- User A and User B would end up seeing DIFFERENT documents.", "originalText": "would land the new character one position too far right -- User A and User B would end up seeing DIFFERENT documents.", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#22c55e", "backgroundColor": "transparent", "opacity": 100, "seed": 41}, {"id": "t42", "type": "text", "x": 60, "y": 852, "width": 860, "height": 20, "text": "This is why a naive \"just apply operations in arrival order\" scheme breaks under real concurrency.", "originalText": "This is why a naive \"just apply operations in arrival order\" scheme breaks under real concurrency.", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#fca5a5", "backgroundColor": "transparent", "opacity": 100, "seed": 42}], "appState": {"viewBackgroundColor": "#ffffff"}}