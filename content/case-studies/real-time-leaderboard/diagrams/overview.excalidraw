    { "type": "text", "id": "idempotent_desc", "x": 480, "y": 448, "width": 280, "height": 100,
      "text": "Checks event_id before\napplying. The redelivered\nevent is a no-op -- Alex's\nscore stays exactly 490.",
      "originalText": "Checks event_id before\napplying. The redelivered\nevent is a no-op -- Alex's\nscore stays exactly 490.",
      "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#065f46", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 20082, "version": 1, "versionNonce": 30082, "isDeleted": false, "groupIds": [],
      "boundElements": null, "link": null, "locked": false, "lineHeight": 1.25 },

    { "type": "text", "id": "final_caption", "x": 60, "y": 600, "width": 820, "height": 44,
      "text": "The dedupe check ahead of the increment is what makes \"delivered twice\" and \"delivered once\"\nproduce the exact same leaderboard.",
      "originalText": "The dedupe check ahead of the increment is what makes \"delivered twice\" and \"delivered once\"\nproduce the exact same leaderboard.",
      "fontSize": 14, "fontFamily": 3, "textAlign": "center", "verticalAlign": "top",
