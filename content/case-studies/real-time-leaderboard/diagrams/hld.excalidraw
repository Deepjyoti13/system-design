", "fontSize": 15, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#7a5c00", "backgroundColor": "transparent", "opacity": 100, "seed": 39823}, {"id": "eventlog_t2", "type": "text", "x": 316, "y": 366, "width": 230, "height": 17, "text": "(leaderboard_id, user_id,", "originalText": "(leaderboard_id, user_id,", "fontSize": 11, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#7a5c00", "backgroundColor": "transparent", "opacity": 100, "seed": 76415}, {"id": "eventlog_t3", "type": "text", "x": 316, "y": 384, "width": 238, "height": 17, "text": "match_id, delta) -- replay", "originalText": "match_id, delta) -- replay", "fontSize": 11, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#7a5c00", "backgroundColor": "transparent", "opacity": 100, "seed": 32208}, {"id": "a_svc_log", "type": "arrow", "x": 420, "y": 240, "width": 1, "height": 80, "points": [[0, 0], [0, 80]], "strokeColor": "#e0a930", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "seed": 70417, "startArrowhead": null, "endArrowhead": "triangle"}, {"id": "a_svc_log_label", "type": "text", "x": 428, "y": 260, "width": 73, "height": 17, "text": "append", "originalText": "append", "fontSize": 11, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#a17700", "backgroundColor": "transparent", "opacity": 100, "seed": 64400}, {"id": "a_log_zset", "type": "arrow", "x": 540, "y": 365, "width": 220, "height": 155, "points": [[0, 0], [220, -155]], "strokeColor": "#e0a930", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "dashed", "roughness": 1, "opacity": 100, "seed": 38432, "startArrowhead": null, "endArrowhead": null}, {"id": "a_log_zset_label", "type": "text", "x": 546, "y": 262, "width": 91, "height": 16, "text": "replay on", "originalText": "replay on", "fontSize": 10, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#a17700", "backgroundColor": "transparent", "opacity": 100, "seed": 5663}, {"id": "a_log_zset_label2", "type": "text", "x": 546, "y": 275, "width": 99, "height": 16, "text": "cold start", "originalText": "cold start", "fontSize": 10, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#a17700", "backgroundColor": "transparent", "opacity": 100, "seed": 88641}, {"id": "evidence_box", "type": "rectangle", "x": 40, "y": 440, "width": 1649, "height": 80, "strokeColor": "#1e1e1e", "backgroundColor": "#0d1117", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "seed": 15270, "roundness": {"type": 3}}, {"id": "evidence_l0", "type": "text", "x": 60, "y": 456, "width": 1420, "height": 20, "text": "The sorted-set store answers every read directly -- it is not a cache in front of a database, it IS the low-latency system of record.", "originalText": "The sorted-set store answers every read directly -- it is not a cache in front of a database, it IS the low-latency system of record.", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#7ee787", "backgroundColor": "transparent", "opacity": 100, "seed": 66885}, {"id": "evidence_l1", "type": "text", "x": 60, "y": 484, "width": 1609, "height": 20, "text": "The event log exists purely so a shard can be rebuilt after total replica-set loss; replication alone protects against a single node failing, not that.", "originalText": "The event log exists purely so a shard can be rebuilt after total replica-set loss; replication alone protects against a single node failing, not that.", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#7ee787", "backgroundColor": "transparent", "opacity": 100, "seed": 39128}], "appState": {"viewBackgroundColor": "#ffffff"}}