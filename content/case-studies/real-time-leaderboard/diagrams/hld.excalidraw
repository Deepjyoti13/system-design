{"type": "excalidraw", "version": 2, "source": "field-guide", "elements": [{"id": "title", "type": "text", "x": 40, "y": 30, "width": 1047, "height": 28, "text": "The Sorted Set IS the Leaderboard, Not a Cache in Front of One", "originalText": "The Sorted Set IS the Leaderboard, Not a Cache in Front of One", "fontSize": 22, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#1971c2", "backgroundColor": "transparent", "opacity": 100, "seed": 61060}, {"id": "subtitle", "type": "text", "x": 40, "y": 66, "width": 1105, "height": 20, "text": "An idempotency check gates every write; the event log is what makes the in-memory structure recoverable", "originalText": "An idempotency check gates every write; the event log is what makes the in-memory structure recoverable", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#5c6470", "backgroundColor": "transparent", "opacity": 100, "seed": 41296}, {"id": "client", "type": "rectangle", "x": 40, "y": 150, "width": 200, "height": 70, "strokeColor": "#5c6470", "backgroundColor": "#f1f3f5", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "seed": 79038, "roundness": {"type": 3}}, {"id": "client_t", "type": "text", "x": 56, "y": 168, "width": 147, "height": 21, "text": "Game Server", "originalText": "Game Server", "fontSize": 15, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#33373d", "backgroundColor": "transparent", "opacity": 100, "seed": 57544}, {"id": "client_t2", "type": "text", "x": 56, "y": 194, "width": 139, "height": 17, "text": "match finished", "originalText": "match finished", "fontSize": 11, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#33373d", "backgroundColor": "transparent", "opacity": 100, "seed": 52341}, {"id": "svc", "type": "rectangle", "x": 300, "y": 130, "width": 240, "height": 110, "strokeColor": "#1971c2", "backgroundColor": "#e