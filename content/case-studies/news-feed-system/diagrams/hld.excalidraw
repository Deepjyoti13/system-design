y:", "originalText": "Feed Assembly:", "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#ffffff", "backgroundColor": "transparent", "opacity": 100, "seed": 1}, {"id": "t39", "type": "text", "x": 1200, "y": 544, "width": 153.14, "height": 16.900000000000002, "text": "merge cached + live", "originalText": "merge cached + live", "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#dbeafe", "backgroundColor": "transparent", "opacity": 100, "seed": 1}, {"id": "r40", "type": "rectangle", "x": 820, "y": 600, "width": 620, "height": 110, "strokeColor": "#1e293b", "backgroundColor": "#1e293b", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "seed": 1, "roundness": {"type": 3}}, {"id": "t41", "type": "text", "x": 840, "y": 618, "width": 321.16, "height": 18.2, "text": "10M followers, 0 writes at post time.", "originalText": "10M followers, 0 writes at post time.", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#22c55e", "backgroundColor": "transparent", "opacity": 100, "seed": 1}, {"id": "t42", "type": "text", "x": 840, "y": 644, "width": 468.71999999999997, "height": 18.2, "text": "Cost paid lazily -- once per reader who actually opens", "originalText": "Cost paid lazily -- once per reader who actually opens", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#22c55e", "backgroundColor": "transparent", "opacity": 100, "seed": 1}, {"id": "t43", "type": "text", "x": 840, "y": 668, "width": 434.0, "height": 18.2, "text": "their feed, never upfront for followers who don't.", "originalText": "their feed, never upfront for followers who don't.", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#22c55e", "backgroundColor": "transparent", "opacity": 100, "seed": 1}, {"id": "t44", "type": "text", "x": 60, "y": 740, "width": 1400, "height": 16.900000000000002, "text": "Threshold (e.g. 100K followers) decides which path a given author's posts take -- Post Service asks a FanoutStrategy, never branches on follower count itself.", "originalText": "Threshold (e.g. 100K followers) decides which path a given author's posts take -- Post Service asks a FanoutStrategy, never branches on follower count itself.", "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#64748b", "backgroundColor": "transparent", "opacity": 100, "seed": 1}], "appState": {"viewBackgroundColor": "#ffffff"}, "files": {}}