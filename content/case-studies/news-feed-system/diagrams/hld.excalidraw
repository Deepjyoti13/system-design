le": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "seed": 1, "roundness": {"type": 3}}, {"id": "t20", "type": "text", "x": 80, "y": 618, "width": 347.2, "height": 18.2, "text": "300 followers = 300 writes at post time.", "originalText": "300 followers = 300 writes at post time.", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#22c55e", "backgroundColor": "transparent", "opacity": 100, "seed": 1}, {"id": "t21", "type": "text", "x": 80, "y": 644, "width": 451.36, "height": 18.2, "text": "Bounded and cheap -- the read side later is a single", "originalText": "Bounded and cheap -- the read side later is a single", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#22c55e", "backgroundColor": "transparent", "opacity": 100, "seed": 1}, {"id": "t22", "type": "text", "x": 80, "y": 668, "width": 355.88, "height": 18.2, "text": "cache lookup, no per-request computation.", "originalText": "cache lookup, no per-request computation.", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#22c55e", "backgroundColor": "transparent", "opacity": 100, "seed": 1}, {"id": "t23", "type": "text", "x": 820, "y": 130, "width": 424.08, "height": 23.400000000000002, "text": "Celebrity post -- 10,000,000 followers", "originalText": "Celebrity post -- 10,000,000 followers", "fontSize": 18, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#1e40af", "backgroundColor": "transparent", "opacity": 100, "seed": 1}, {"id": "r24", "type": "rectangle", "x": 820, "y": 175, "width": 260, "height": 80, "strokeColor": "#c2410c", "backgroundColor": "#fed7aa", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "seed": 1, "roundness": {"type": 3}}, {"id": "t25", "type": "text", "x": 840, "y": 200, "width": 130.2, "height": 54.599999999999994, "text": "New Post\n(author has 10M\nfollowers)", "originalText": "New Post\n(author has 10M\nfollowers)", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#374151", "backgroundColor": "transparent", "opacity": 100, "seed": 1}, {"id": "a26", "type": "arrow", "x": 950, "y": 255, "width": 0, "height": 75, "points": [[0, 0], [0, 75]], "strokeColor": "#dc2626", "backgroundColor": "transparent", "strokeWidth": 2, "strokeStyle": "dashed", "roughness": 1, "opacity": 100, "seed": 1, "startArrowhead": null, "endArrowhead": "arrow"}, {"id": "t27", "type": "text", "x": 965, "y": 280, "width": 112.84, "height": 16.900000000000002, "text": "NOT fanned out", "originalText": "NOT fanned out", "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#dc2626", "backgroundColor": "transparent", "opacity": 100, "seed": 1}, {"id": "r28", "type": "rectangle", "x": 820, "y": 335, "width": 260, "height": 80, "strokeColor": "#047857", "backgroundColor": "#a7f3d0", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "seed": 1, "roundness": {"type": 3}}, {"id": "t29", "type": "text", "x": 840, "y": 358, "width": 93.0, "height": 19.5, "text": "Post Store", "originalText": "Post Store", "fontSize": 15, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#065f46", "backgroundColor": "transparent", "opacity": 100, "seed": 1}, {"id": "t30", "type": "text", "x": 840, "y": 380, "width": 148.8, "height": 15.600000000000001, "text": "(durable write only)", "originalText": "(durable write only)", "fontSize": 12, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#065f46", "backgroundColor": "transparent", "opacity": 100, "seed": 1}, {"id": "r31", "type": "rectangle", "x": 1180, "y": 335, "width": 260, "height": 80, "strokeColor": "#1e3a5f", "backgroundColor": "#93c5fd", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opaci