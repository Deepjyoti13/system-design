{"type": "excalidraw", "version": 2, "source": "field-guide", "elements": [{"id": "t1", "type": "text", "x": 40, "y": 30, "width": 996.96, "height": 31.200000000000003, "text": "Fan-out-on-Write (normal post) vs. Fan-out-on-Read (celebrity post)", "originalText": "Fan-out-on-Write (normal post) vs. Fan-out-on-Read (celebrity post)", "fontSize": 24, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#1e40af", "backgroundColor": "transparent", "opacity": 100, "seed": 1}, {"id": "t2", "type": "text", "x": 40, "y": 68, "width": 558.0, "height": 19.5, "text": "Same system, two paths chosen by the author's follower count", "originalText": "Same system, two paths chosen by the author's follower count", "fontSize": 15, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#64748b", "backgroundColor": "transparent", "opacity": 100, "seed": 1}, {"id": "t3", "type": "text", "x": 60, "y": 130, "width": 312.48, "height": 23.400000000000002, "text": "Normal post -- 300 followers", "originalText": "Normal post -- 300 followers", "fontSize": 18, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#1e40af", "backgroundColor": "transparent", "opacity": 100, "seed": 1}, {"id": "r4", "type": "rectangle", "x": 60, "y": 175, "width": 260, "height": 80, "strokeColor": "#c2410c", "backgroundColor": "#fed7aa", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "seed": 1, "roundness": {"type": 3}}, {"id": "t5", "type": "text", "x": 80, "y": 200, "width": 130.2, "height": 54.599999999999994, "text": "New Post\n(author has 300\nfollowers)", "originalText": "New Post\n(author has 300\nfollowers)", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#374151", "backgroundColor": "transparent", "opacity": 100, "seed": 1}, {"id": "a6", "type": "arrow", "x": 190, "y": 255, "width": 0, "height": 75, "points": [[0, 0], [0, 75]], "strokeColo