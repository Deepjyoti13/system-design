{"type": "excalidraw", "version": 2, "source": "field-guide", "elements": [{"id": "t1", "type": "text", "x": 40, "y": 30, "width": 833.28, "height": 31.200000000000003, "text": "FanoutStrategy: a Strategy, not a branch in Post Service", "originalText": "FanoutStrategy: a Strategy, not a branch in Post Service", "fontSize": 24, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#1e40af", "backgroundColor": "transparent", "opacity": 100, "seed": 1}, {"id": "t2", "type": "text", "x": 40, "y": 68, "width": 790.5, "height": 19.5, "text": "Post Service always calls strategy.deliver() -- it never checks follower count itself", "originalText": "Post Service always calls strategy.deliver() -- it never checks follower count itself", "fontSize": 15, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#64748b", "backgroundColor": "transparent", "opacity": 100, "seed": 1}, {"id": "r3", "type": "rectangle", "x": 760, "y": 130, "width": 380, "height": 90, "strokeColor": "#6d28d9", "backgroundColor": "#ddd6fe", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "seed": 1, "roundness": {"type": 3}}, {"id": "t4", "type": "text", "x": 790, "y": 150, "width": 96.72, "height": 15.600000000000001, "text": "<<interface>>", "originalText": "<<interface>>", "fontSize": 12, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#6d28d9", "backgroundColor": "transparent", "opacity": 100, "seed": 1}, {"id": "t5", "type": "text", "x": 790, "y": 170, "width": 147.56, "height": 22.1, "text": "FanoutStrategy", "originalText": "FanoutStrategy", "fontSize": 17, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#4c1d95", "backgroundColor": "transparent", "opacity": 100, "seed": 1}, {"id": "t6", "type": "text", "x": 790, "y": 195, "width": 217.62, "height": 16.900000000000002, "text": "deliver(author_id, post_id)", "originalText": "deliver(author_id, post