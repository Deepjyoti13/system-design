    ],
    [
     1680,
     0
    ]
   ],
   "roundness": null
  },
  {
   "id": "el",
   "type": "text",
   "x": 30,
   "y": 1338,
   "width": 488,
   "height": 21,
   "strokeColor": "#1e40af",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100074,
   "version": 1,
   "versionNonce": 700518,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "Two map concepts that carry real design weight",
   "originalText": "Two map concepts that carry real design weight",
   "fontSize": 17,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "e1",
   "type": "text",
   "x": 30,
   "y": 1376,
   "width": 637,
   "height": 17,
   "strokeColor": "#1e40af",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100075,
   "version": 1,
   "versionNonce": 700525,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "a degree of latitude is ~111 km everywhere. A degree of longitude is not.",
   "originalText": "a degree of latitude is ~111 km everywhere. A degree of longitude is not.",
   "fontSize": 14,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "e1n",
   "type": "text",
   "x": 30,
   "y": 1402,
   "width": 941,
   "height": 45,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100076,
   "version": 1,
   "versionNonce": 700532,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "Longitude shrinks from 111 km at the equator to ZERO at the poles. So a naive bounding box of +/-0.01 degrees is a square in\nKenya and a tall thin rectangle in Norway - which is why distance filtering needs the haversine formula rather than coordinate\narithmetic. The asymmetry is the reason, not a detail.",
   "originalText": "Longitude shrinks from 111 km at the equator to ZERO at the poles. So a naive bounding box of +/-0.01 degrees is a square in\nKenya and a tall thin rectangle in Norway - which is why distance filtering needs the haversine formula rather than coordinate\narithmetic. The asymmetry is the reason, not a detail.",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "e2",
   "type": "text",
   "x": 30,
   "y": 1476,
   "width": 620,
   "height": 17,
   "strokeColor": "#1e40af",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100077,
   "version": 1,
   "versionNonce": 700539,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "Web Mercator preserves local SHAPE and angles, and wildly distorts AREA",
   "originalText": "Web Mercator preserves local SHAPE and angles, and wildly distorts AREA",
   "fontSize": 14,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "e2n",
   "type": "text",
   "x": 30,
   "y": 1502,
   "width": 934,
   "height": 60,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100078,
   "version": 1,
   "versionNonce": 700546,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "Flattening a sphere always distorts something - area, shape, distance or direction - and you cannot preserve all four. Web\nMercator keeps roads meeting at the correct angles (so the map looks right when you zoom in) at the cost of Greenland looking\nthe size of Africa. Correct for a navigation product: nobody navigates by comparing the areas of countries, and everybody\nnavigates by following the shape of a junction.",
   "originalText": "Flattening a sphere always distorts something - area, shape, distance or direction - and you cannot preserve all four. Web\nMercator keeps roads meeting at the correct angles (so the map looks right when you zoom in) at the cost of Greenland looking\nthe size of Africa. Correct for a navigation product: nobody navigates by comparing the areas of countries, and everybody\nnavigates by following the shape of a junction.",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "d6",
   "type": "line",
   "x": 30,
   "y": 1588,
   "width": 1680,
   "height": 0,
   "strokeColor": "#cbd5e1",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100079,
