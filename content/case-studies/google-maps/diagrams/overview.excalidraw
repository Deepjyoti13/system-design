   "opacity": 100,
   "angle": 0,
   "seed": 100059,
   "version": 1,
   "versionNonce": 700413,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "46,000/sec        peak 5x = 231,000/sec",
   "originalText": "46,000/sec        peak 5x = 231,000/sec",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "cn",
   "type": "text",
   "x": 30,
   "y": 934,
   "width": 1019,
   "height": 65,
   "strokeColor": "#1e40af",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100060,
   "version": 1,
   "versionNonce": 700420,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "Batching 15 samples - 75 seconds of movement - cuts request volume 15x. But the number that matters is not requests/sec: on a\nphone it is the difference between the cellular radio being CONTINUOUSLY AWAKE and waking briefly once a minute. ON MOBILE THE\nRADIO IS USUALLY THE LARGEST SINGLE CONSUMER OF BATTERY, so this serves the 'data and battery frugality' requirement, and the\ncapacity saving is a side effect. History is ~40 bytes per sample = 2.4 TB/day, append-only, retained for traffic modelling.",
   "originalText": "Batching 15 samples - 75 seconds of movement - cuts request volume 15x. But the number that matters is not requests/sec: on a\nphone it is the difference between the cellular radio being CONTINUOUSLY AWAKE and waking briefly once a minute. ON MOBILE THE\nRADIO IS USUALLY THE LARGEST SINGLE CONSUMER OF BATTERY, so this serves the 'data and battery frugality' requirement, and the\ncapacity saving is a side effect. History is ~40 bytes per sample = 2.4 TB/day, append-only, retained for traffic modelling.",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "d4",
   "type": "line",
