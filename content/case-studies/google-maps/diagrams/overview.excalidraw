  {
   "id": "dedup_t",
   "type": "text",
   "x": 38,
   "y": 620,
   "width": 764,
   "height": 45,
   "strokeColor": "#ffffff",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
