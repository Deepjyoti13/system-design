  {
   "id": "cv2",
   "type": "text",
   "x": 1274,
   "y": 892,
   "width": 294,
   "height": 15,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
