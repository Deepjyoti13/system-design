   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "a cross-country route has thousands of points; as JSON\nthat is hundreds of kilobytes. Encoded polyline stores\nsuccessive DELTAS in a variable-length encoding,\ntypically cutting the payload 8-10x - the\nbattery-and-data requirement showing up somewhere\nunexpected.",
   "originalText": "a cross-country route has thousands of points; as JSON\nthat is hundreds of kilobytes. Encoded polyline stores\nsuccessive DELTAS in a variable-length encoding,\ntypically cutting the payload 8-10x - the\nbattery-and-data requirement showing up somewhere\nunexpected.",
   "fontSize": 12,
   "fontFamily": 3,
