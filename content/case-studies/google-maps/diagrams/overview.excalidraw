   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "694,000 GPS samples/sec - and the fix is a battery decision that happens to also be a capacity one",
   "originalText": "694,000 GPS samples/sec - and the fix is a battery decision that happens to also be a capacity one",
   "fontSize": 17,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "cc",
   "type": "text",
   "x": 30,
   "y": 768,
   "width": 938,
   "height": 16,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100047,
   "version": 1,
   "versionNonce": 700329,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "1B DAU x 35 min/week / 7  =  5 billion navigation-minutes/day.   A sample every 5 seconds  =  6 x 10^10 samples/day.",
   "originalText": "1B DAU x 35 min/week / 7  =  5 billion navigation-minutes/day.   A sample every 5 seconds  =  6 x 10^10 samples/day.",
   "fontSize": 13,
