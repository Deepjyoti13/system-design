   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "~10 GB   -   50M intersections, 100M road segments at ~100 bytes/edge",
   "originalText": "~10 GB   -   50M intersections, 100M road segments at ~100 bytes/edge",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "bn",
   "type": "text",
   "x": 30,
   "y": 534,
   "width": 1019,
   "height": 48,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100041,
   "version": 1,
   "versionNonce": 700287,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "The dataset people assume is the hard part - routing - fits in a single machine's RAM. The dataset nobody thinks about needs a\nglobal CDN. That inversion is the single most useful thing to establish early, and it explains why the two subsystems look\nnothing alike.",
   "originalText": "The dataset people assume is the hard part - routing - fits in a single machine's RAM. The dataset nobody thinks about needs a\nglobal CDN. That inversion is the single most useful thing to establish early, and it explains why the two subsystems look\nnothing alike.",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "dedup",
   "type": "rectangle",
