   "roundness": null
  },
  {
   "id": "dl",
   "type": "text",
   "x": 30,
   "y": 1050,
   "width": 478,
   "height": 21,
   "strokeColor": "#1e40af",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100062,
   "version": 1,
   "versionNonce": 700434,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "Three subsystems, deliberately barely coupled",
   "originalText": "Three subsystems, deliberately barely coupled",
   "fontSize": 17,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "s_30",
   "type": "ellipse",
   "x": 30,
   "y": 1090,
   "width": 12,
   "height": 12,
   "strokeColor": "#1e40af",
   "backgroundColor": "#1e40af",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100063,
   "version": 1,
   "versionNonce": 700441,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false
  },
  {
   "id": "sn_30",
   "type": "text",
   "x": 56,
   "y": 1086,
   "width": 455,
   "height": 16,
   "strokeColor": "#1e40af",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100064,
   "version": 1,
   "versionNonce": 700448,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "1  rendering: precompute everything, serve it from a CDN",
   "originalText": "1  rendering: precompute everything, serve it from a CDN",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "sd_30",
   "type": "text",
   "x": 56,
   "y": 1112,
   "width": 457,
   "height": 90,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100065,
   "version": 1,
   "versionNonce": 700455,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "Tiles are IMMUTABLE and their URL is COMPUTABLE from the\nclient's position and zoom - so the client needs no API call\nto know what to fetch, and every tile is cacheable forever at\nthe edge. That is what turns 60 PB into a static-asset\nproblem, and why the largest dataset needs the least\ninfrastructure.",
   "originalText": "Tiles are IMMUTABLE and their URL is COMPUTABLE from the\nclient's position and zoom - so the client needs no API call\nto know what to fetch, and every tile is cacheable forever at\nthe edge. That is what turns 60 PB into a static-asset\nproblem, and why the largest dataset needs the least\ninfrastructure.",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "s_580",
   "type": "ellipse",
   "x": 580,
   "y": 1090,
   "width": 12,
   "height": 12,
   "strokeColor": "#047857",
   "backgroundColor": "#047857",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100066,
   "version": 1,
   "versionNonce": 700462,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false
  },
  {
   "id": "sn_580",
   "type": "text",
   "x": 606,
   "y": 1086,
   "width": 358,
   "height": 16,
   "strokeColor": "#047857",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100067,
   "version": 1,
   "versionNonce": 700469,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "2  navigation: apply tiling to the GRAPH too",
   "originalText": "2  navigation: apply tiling to the GRAPH too",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "sd_580",
   "type": "text",
   "x": 606,
   "y": 1112,
   "width": 465,
   "height": 105,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100068,
   "version": 1,
   "versionNonce": 700476,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "The road graph is small in bytes, but a shortest-path search\nover 100 million edges is far too slow interactively. So the\ngraph is cut into ROUTING TILES - subgraphs with references to\ntheir neighbours - and the search loads only the tiles it\ntraverses. Crucially they exist at MULTIPLE LEVELS OF DETAIL:\na cross-country route uses coarse motorway-only tiles and\nswitches to fine-grained ones near the endpoints.",
   "originalText": "The road graph is small in bytes, but a shortest-path search\nover 100 million edges is far too slow interactively. So the\ngraph is cut into ROUTING TILES - subgraphs with references to\ntheir neighbours - and the search loads only the tiles it\ntraverses. Crucially they exist at MULTIPLE LEVELS OF DETAIL:\na cross-country route uses coarse motorway-only tiles and\nswitches to fine-grained ones near the endpoints.",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "s_1130",
   "type": "ellipse",
   "x": 1130,
   "y": 1090,
   "width": 12,
   "height": 12,
   "strokeColor": "#b45309",
   "backgroundColor": "#b45309",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100069,
   "version": 1,
   "versionNonce": 700483,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false
  },
  {
   "id": "sn_1130",
   "type": "text",
   "x": 1156,
   "y": 1086,
   "width": 358,
   "height": 16,
   "strokeColor": "#b45309",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100070,
   "version": 1,
   "versionNonce": 700490,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "3  location: fire-and-forget, then stream it",
   "originalText": "3  location: fire-and-forget, then stream it",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "sd_1130",
   "type": "text",
   "x": 1156,
   "y": 1112,
   "width": 465,
   "height": 75,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100071,
   "version": 1,
   "versionNonce": 700497,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "Batched samples land in Cassandra for history and Kafka for\nreal-time consumers. Traffic conditions are derived from the\naggregate and fed back into routing-tile edge weights. And the\nclient's own position is NEVER READ BACK from the server - the\nphone already knows where it is.",
   "originalText": "Batched samples land in Cassandra for history and Kafka for\nreal-time consumers. Traffic conditions are derived from the\naggregate and fed back into routing-tile edge weights. And the\nclient's own position is NEVER READ BACK from the server - the\nphone already knows where it is.",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "dn",
   "type": "text",
   "x": 30,
   "y": 1226,
   "width": 987,
   "height": 65,
   "strokeColor": "#1e40af",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100072,
   "version": 1,
   "versionNonce": 700504,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "The elegant part: THE SAME TILING IDEA SOLVES TWO OF THE THREE PROBLEMS, for two different reasons. Map tiles exist so the\nclient downloads only what it can SEE; routing tiles exist so the search algorithm loads only what it TRAVERSES. Same\ntechnique, different motivation - and recognising the reuse is what makes the design feel coherent rather than like three\nunrelated systems.",
   "originalText": "The elegant part: THE SAME TILING IDEA SOLVES TWO OF THE THREE PROBLEMS, for two different reasons. Map tiles exist so the\nclient downloads only what it can SEE; routing tiles exist so the search algorithm loads only what it TRAVERSES. Same\ntechnique, different motivation - and recognising the reuse is what makes the design feel coherent rather than like three\nunrelated systems.",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "d5",
   "type": "line",
   "x": 30,
   "y": 1320,
   "width": 1680,
   "height": 0,
   "strokeColor": "#cbd5e1",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100073,
   "version": 1,
   "versionNonce": 700511,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "points": [
    [
     0,
