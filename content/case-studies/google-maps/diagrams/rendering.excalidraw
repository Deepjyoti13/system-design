     1680,
     0
    ]
   ],
   "roundness": null
  },
  {
   "id": "fl",
   "type": "text",
   "x": 30,
   "y": 2148,
   "width": 878,
   "height": 21,
   "strokeColor": "#1e40af",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100089,
   "version": 1,
   "versionNonce": 700623,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "Roads change - and purging trillions of cached objects is not a realistic operation",
   "originalText": "Roads change - and purging trillions of cached objects is not a realistic operation",
   "fontSize": 17,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "ver",
   "type": "rectangle",
   "x": 30,
   "y": 2186,
   "width": 820,
   "height": 110,
   "strokeColor": "#1e293b",
   "backgroundColor": "#1e293b",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100090,
   "version": 1,
   "versionNonce": 700630,
   "isDeleted": false,
   "groupIds": [],
