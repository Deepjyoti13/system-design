  {
   "id": "conv_t",
   "type": "text",
   "x": 38,
   "y": 642,
   "width": 684,
   "height": 45,
   "strokeColor": "#ffffff",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100031,
   "version": 1,
   "versionNonce": 700217,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "n = 2^z\nx = floor( n * (lng + 180) / 360 )\ny = floor( n * (1 - ln(tan(lat) + sec(lat)) / pi) / 2 )",
   "originalText": "n = 2^z\nx = floor( n * (lng + 180) / 360 )\ny = floor( n * (1 - ln(tan(lat) + sec(lat)) / pi) / 2 )",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "conv",
   "lineHeight": 1.25
  },
  {
   "id": "bn",
   "type": "text",
   "x": 760,
   "y": 620,
   "width": 614,
   "height": 45,
   "strokeColor": "#047857",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100032,
   "version": 1,
   "versionNonce": 700224,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "Ugly, deterministic, and CHEAP ENOUGH TO RUN ON THE CLIENT - which is the property\nthat matters, because it removes a round trip from the most frequent operation in\nthe product.",
   "originalText": "Ugly, deterministic, and CHEAP ENOUGH TO RUN ON THE CLIENT - which is the property\nthat matters, because it removes a round trip from the most frequent operation in\nthe product.",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "bn2",
   "type": "text",
   "x": 760,
   "y": 690,
   "width": 606,
   "height": 90,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100033,
   "version": 1,
   "versionNonce": 700231,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "What a viewport actually costs: a 1080x1920 phone screen at 256-pixel tiles needs\nabout 5 x 8 = 40 TILES, and fewer in practice with device pixel ratios and\n512-pixel variants. So a full map view is a few dozen small PARALLEL requests,\nall independently cacheable - and a partially-loaded map still renders usefully.\nThat graceful degradation comes free from tiles being independent, and it is why\na map on a poor connection fills in progressively rather than blocking.",
   "originalText": "What a viewport actually costs: a 1080x1920 phone screen at 256-pixel tiles needs\nabout 5 x 8 = 40 TILES, and fewer in practice with device pixel ratios and\n512-pixel variants. So a full map view is a few dozen small PARALLEL requests,\nall independently cacheable - and a partially-loaded map still renders usefully.\nThat graceful degradation comes free from tiles being independent, and it is why\na map on a poor connection fills in progressively rather than blocking.",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "d3",
   "type": "line",
   "x": 30,
   "y": 800,
   "width": 1680,
   "height": 0,
   "strokeColor": "#cbd5e1",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
