   "versionNonce": 700007,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "Tiling quantizes space - which is what converts a compute problem into a static-asset problem",
   "originalText": "Tiling quantizes space - which is what converts a compute problem into a static-asset problem",
   "fontSize": 22,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "s",
   "type": "text",
   "x": 30,
   "y": 52,
   "width": 1418,
   "height": 17,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100002,
   "version": 1,
   "versionNonce": 700014,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "An on-demand render is keyed by an arbitrary bounding box, so no two users request the same one, the cache hit rate is ~zero, and EVERY request reaches the origin.",
   "originalText": "An on-demand render is keyed by an arbitrary bounding box, so no two users request the same one, the cache hit rate is ~zero, and EVERY request reaches the origin.",
   "fontSize": 14,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
