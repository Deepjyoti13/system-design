  {
   "id": "al",
   "type": "text",
   "x": 30,
   "y": 108,
   "width": 162,
   "height": 21,
   "strokeColor": "#1e40af",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
