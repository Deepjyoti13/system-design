  },
  {
   "id": "od_t",
   "type": "text",
   "x": 38,
   "y": 166,
   "width": 744,
   "height": 30,
   "strokeColor": "#ffffff",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100006,
   "version": 1,
   "versionNonce": 700042,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "on demand:  render (37.7749,-122.4194) to (37.7849,-122.4094)\n            -> an arbitrary key nobody else will ever request",
   "originalText": "on demand:  render (37.7749,-122.4194) to (37.7849,-122.4094)\n            -> an arbitrary key nobody else will ever request",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "od",
   "lineHeight": 1.25
  },
  {
   "id": "tl",
   "type": "rectangle",
   "x": 30,
   "y": 236,
   "width": 760,
   "height": 70,
   "strokeColor": "#1e293b",
   "backgroundColor": "#1e293b",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100007,
   "version": 1,
   "versionNonce": 700049,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": [
    {
     "id": "tl_t",
     "type": "text"
    }
   ],
   "link": null,
   "locked": false,
   "roundness": {
    "type": 3
   }
  },
  {
   "id": "tl_t",
   "type": "text",
   "x": 38,
   "y": 256,
   "width": 744,
   "height": 30,
   "strokeColor": "#ffffff",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100008,
   "version": 1,
   "versionNonce": 700056,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "tiled:      GET /{z}/{x}/{y}.mvt\n            -> a key EVERY client in that area computes identically",
   "originalText": "tiled:      GET /{z}/{x}/{y}.mvt\n            -> a key EVERY client in that area computes identically",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "tl",
   "lineHeight": 1.25
  },
  {
   "id": "an",
   "type": "text",
   "x": 830,
   "y": 146,
   "width": 599,
   "height": 150,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100009,
   "version": 1,
   "versionNonce": 700063,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "The naive alternative - take vector road data, draw it at the requested zoom,\nreturn an image - is flexible and wrong for two reasons that compound.\n\nIt puts COMPUTE IN FRONT OF IMMUTABLE DATA: the map of San Francisco does not\nchange between requests, so rendering it per request recomputes an identical\nanswer millions of times a day.\n\nAnd it DESTROYS CACHEABILITY, which is the fatal one. At 1 billion DAU, a design\nwhere every request reaches the origin is not a scaling problem you can buy your\nway out of.",
   "originalText": "The naive alternative - take vector road data, draw it at the requested zoom,\nreturn an image - is flexible and wrong for two reasons that compound.\n\nIt puts COMPUTE IN FRONT OF IMMUTABLE DATA: the map of San Francisco does not\nchange between requests, so rendering it per request recomputes an identical\nanswer millions of times a day.\n\nAnd it DESTROYS CACHEABILITY, which is the fatal one. At 1 billion DAU, a design\nwhere every request reaches the origin is not a scaling problem you can buy your\nway out of.",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "an2",
   "type": "text",
   "x": 30,
   "y": 326,
   "width": 1019,
   "height": 32,
   "strokeColor": "#1e40af",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100010,
   "version": 1,
   "versionNonce": 700070,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "Tiling fixes both by quantizing space into a fixed grid: there are only so many tiles, every client asking about the same area\nasks for the SAME tile, and the answer never changes. Static assets at global scale is a solved problem with a name.",
   "originalText": "Tiling fixes both by quantizing space into a fixed grid: there are only so many tiles, every client asking about the same area\nasks for the SAME tile, and the answer never changes. Static assets at global scale is a solved problem with a name.",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "d2",
