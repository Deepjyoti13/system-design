   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "GET /v1/tiles/resolve?lat=..&lng=..&zoom=..  ->  { urls: [...] }",
   "originalText": "GET /v1/tiles/resolve?lat=..&lng=..&zoom=..  ->  { urls: [...] }",
