  },
  {
   "id": "cn2",
   "type": "text",
   "x": 30,
   "y": 996,
   "width": 1019,
   "height": 65,
   "strokeColor": "#b45309",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100041,
   "version": 1,
   "versionNonce": 700287,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "Old app versions keep computing old URLs for years and you cannot force an upgrade. The standard hedge is to ALSO offer a\nserver-side resolution API that clients may opt into: newer clients get flexibility (the server could switch schemes, serve a\ndifferent projection, or A/B test tile sizes) at the cost of one extra call. Not a solution so much as an escape hatch - worth\nhaving, and worth being honest that the default path is the frozen one.",
   "originalText": "Old app versions keep computing old URLs for years and you cannot force an upgrade. The standard hedge is to ALSO offer a\nserver-side resolution API that clients may opt into: newer clients get flexibility (the server could switch schemes, serve a\ndifferent projection, or A/B test tile sizes) at the cost of one extra call. Not a solution so much as an escape hatch - worth\nhaving, and worth being honest that the default path is the frozen one.",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
