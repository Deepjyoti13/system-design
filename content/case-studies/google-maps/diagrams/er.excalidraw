   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "Two directions of one product feature, two entirely unrelated index structures",
   "originalText": "Two directions of one product feature, two entirely unrelated index structures",
   "fontSize": 17,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
