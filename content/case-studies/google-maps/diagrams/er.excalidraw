  {
   "id": "gl",
   "type": "text",
   "x": 30,
   "y": 2234,
   "width": 1163,
   "height": 21,
   "strokeColor": "#1e40af",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100093,
