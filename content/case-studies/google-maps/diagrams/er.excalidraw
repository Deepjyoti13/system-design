   "versionNonce": 700525,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "2.4 TB/day of raw traces exist to produce a 2 TB table that never grows",
   "originalText": "2.4 TB/day of raw traces exist to produce a 2 TB table that never grows",
   "fontSize": 17,
   "fontFamily": 3,
