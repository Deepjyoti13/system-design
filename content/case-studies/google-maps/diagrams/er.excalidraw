   "versionNonce": 700693,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "segment_speed_history has a feedback loop nobody has modelled",
   "originalText": "segment_speed_history has a feedback loop nobody has modelled",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "gd0",
   "type": "text",
   "x": 56,
   "y": 2778,
   "width": 926,
   "height": 45,
   "strokeColor": "#64748b",
