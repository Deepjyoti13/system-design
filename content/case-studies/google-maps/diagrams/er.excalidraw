   "versionNonce": 700700,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "it is trained on observed speeds, and those speeds were shaped by past routing decisions - so the model partly predicts its\nown behaviour. Routing everyone around congestion creates congestion on the alternative, which the next aggregation observes\nas newly slow. Real deployments split traffic across alternatives to damp this; that mechanism is absent from this schema.",
   "originalText": "it is trained on observed speeds, and those speeds were shaped by past routing decisions - so the model partly predicts its\nown behaviour. Routing everyone around congestion creates congestion on the alternative, which the next aggregation observes\nas newly slow. Real deployments split traffic across alternatives to damp this; that mechanism is absent from this schema.",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
