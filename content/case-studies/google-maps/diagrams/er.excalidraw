  {
   "id": "gn0",
   "type": "text",
   "x": 56,
   "y": 2756,
   "width": 495,
   "height": 16,
   "strokeColor": "#b91c1c",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100099,
