  {
   "id": "el",
   "type": "text",
   "x": 30,
   "y": 1234,
   "width": 752,
   "height": 21,
   "strokeColor": "#1e40af",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
