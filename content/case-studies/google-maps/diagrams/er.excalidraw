  },
  {
   "id": "lh_t",
   "type": "text",
   "x": 38,
   "y": 1279,
   "width": 784,
   "height": 195,
   "strokeColor": "#ffffff",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
