   "text": "turn restrictions and road attributes are underspecified",
   "originalText": "turn restrictions and road attributes are underspecified",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
