   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "real routing needs time-of-day restrictions, vehicle-class restrictions (weight, height, hazmat), seasonal closures and bus\nlanes. Each expands the edge record, and some make edge weights CONDITIONAL ON THE QUERY - which complicates the hierarchy's\nassumption that a coarse tile's weights are usable by any route.",
   "originalText": "real routing needs time-of-day restrictions, vehicle-class restrictions (weight, height, hazmat), seasonal closures and bus\nlanes. Each expands the edge record, and some make edge weights CONDITIONAL ON THE QUERY - which complicates the hierarchy's\nassumption that a coarse tile's weights are usable by any route.",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
