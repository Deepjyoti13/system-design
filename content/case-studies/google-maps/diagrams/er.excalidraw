   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "a deletion request must also reach the Kafka backlog, the analytics warehouse and any object-storage archive. Cassandra\ndeletes are tombstones that reclaim no space until compaction, so 'deleted' and 'gone' differ by a compaction cycle.",
   "originalText": "a deletion request must also reach the Kafka backlog, the analytics warehouse and any object-storage archive. Cassandra\ndeletes are tombstones that reclaim no space until compaction, so 'deleted' and 'gone' differ by a compaction cycle.",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
