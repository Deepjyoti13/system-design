  {
   "id": "fwd_t",
   "type": "text",
   "x": 38,
   "y": 1929,
   "width": 804,
   "height": 75,
   "strokeColor": "#ffffff",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100087,
   "version": 1,
   "versionNonce": 700609,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "FORWARD   '1600 Amphitheatre Parkway, Mountain View, CA'\n  -> tokenize, normalize ('Pkwy'->'Parkway', case, accents)\n  -> inverted index lookup + fuzzy matching for typos\n  -> candidates ranked by prominence + query proximity\n  -> (lat, lng), place_id, precision level",
   "originalText": "FORWARD   '1600 Amphitheatre Parkway, Mountain View, CA'\n  -> tokenize, normalize ('Pkwy'->'Parkway', case, accents)\n  -> inverted index lookup + fuzzy matching for typos\n  -> candidates ranked by prominence + query proximity\n  -> (lat, lng), place_id, precision level",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "fwd",
   "lineHeight": 1.25
  },
  {
   "id": "rev",
