   "locked": false,
   "text": "the 90-day TTL is a policy assertion with no enforcement beyond Cassandra",
   "originalText": "the 90-day TTL is a policy assertion with no enforcement beyond Cassandra",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "gd1",
   "type": "text",
   "x": 56,
   "y": 2872,
   "width": 889,
   "height": 30,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
