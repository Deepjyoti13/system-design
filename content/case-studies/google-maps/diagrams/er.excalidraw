   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "v42 shares every unchanged content_hash with v41, so publishing a version is a\nsmall delta rather than a 60 PB copy - which is what makes versioning-over-purging\naffordable in the first place.",
