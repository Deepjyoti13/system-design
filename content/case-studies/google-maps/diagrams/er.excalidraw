   }
  },
  {
   "id": "lt_t",
   "type": "text",
   "x": 38,
   "y": 1064,
   "width": 784,
   "height": 45,
   "strokeColor": "#ffffff",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100071,
   "version": 1,
   "versionNonce": 700497,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "KEY    speed:{segment_id}\nVALUE  (current_speed_mps: f32, sample_count: u16, updated_at: u32)\nTTL    900 seconds",
   "originalText": "KEY    speed:{segment_id}\nVALUE  (current_speed_mps: f32, sample_count: u16, updated_at: u32)\nTTL    900 seconds",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "lt",
   "lineHeight": 1.25
  },
  {
   "id": "dn",
   "type": "text",
   "x": 870,
   "y": 1042,
   "width": 606,
   "height": 90,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100072,
   "version": 1,
   "versionNonce": 700504,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "100M segments x ~16 bytes is about 1.6 GB - read on every route computation,\nwritten continuously by the traffic aggregator. The TTL does the same triple duty\nas in nearby friends: it bounds memory, bounds staleness, and - most usefully -\nmakes 'no recent data for this segment' an AUTOMATIC state rather than something\nto detect. When a key expires, the ETA service falls back to historical or\nspeed-limit estimates with no explicit 'is this stale?' check anywhere.",
   "originalText": "100M segments x ~16 bytes is about 1.6 GB - read on every route computation,\nwritten continuously by the traffic aggregator. The TTL does the same triple duty\nas in nearby friends: it bounds memory, bounds staleness, and - most usefully -\nmakes 'no recent data for this segment' an AUTOMATIC state rather than something\nto detect. When a key expires, the ETA service falls back to historical or\nspeed-limit estimates with no explicit 'is this stale?' check anywhere.",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "dn2",
   "type": "text",
   "x": 30,
   "y": 1148,
   "width": 1011,
   "height": 48,
   "strokeColor": "#047857",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100073,
   "version": 1,
   "versionNonce": 700511,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "sample_count is carried because a speed derived from 3 vehicles deserves less confidence than one from 300, and the ETA model\nweights it accordingly. Storing the aggregate without its sample size would throw away the information needed to know whether\nto trust it.",
   "originalText": "sample_count is carried because a speed derived from 3 vehicles deserves less confidence than one from 300, and the ETA model\nweights it accordingly. Storing the aggregate without its sample size would throw away the information needed to know whether\nto trust it.",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "d5",
