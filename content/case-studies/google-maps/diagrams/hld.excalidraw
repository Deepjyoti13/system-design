   "versionNonce": 700679,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "the multi-resolution tile approach is an approximation - it identifies users whose route MIGHT pass through an incident, then\nmust recompute to know. At millions of concurrent navigators, the recomputation cost of a major motorway closure is\nsubstantial and unbudgeted here.",
   "originalText": "the multi-resolution tile approach is an approximation - it identifies users whose route MIGHT pass through an incident, then\nmust recompute to know. At millions of concurrent navigators, the recomputation cost of a major motorway closure is\nsubstantial and unbudgeted here.",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
