   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "NEVER shed an initial route request, or tile serving",
   "originalText": "NEVER shed an initial route request, or tile serving",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "sd4",
   "type": "text",
   "x": 60,
   "y": 1282,
   "width": 636,
   "height": 30,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
