   "versionNonce": 700490,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "nothing - both get the tile and the origin sees one\nrequest. Without collapsing, a viral location delivers\nthousands of identical origin fetches.",
   "originalText": "nothing - both get the tile and the origin sees one\nrequest. Without collapsing, a viral location delivers\nthousands of identical origin fetches.",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "ra1",
