   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "nothing. THERE IS NO MOMENT OF INCONSISTENCY to\nmanage - which is the whole argument for versioning\nover purging.",
   "originalText": "nothing. THERE IS NO MOMENT OF INCONSISTENCY to\nmanage - which is the whole argument for versioning\nover purging.",
