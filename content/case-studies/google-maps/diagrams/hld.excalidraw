   "versionNonce": 700483,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "the CDN COLLAPSES concurrent origin requests\ninto one fetch",
   "originalText": "the CDN COLLAPSES concurrent origin requests\ninto one fetch",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "rc0",
   "type": "text",
   "x": 1030,
   "y": 1700,
   "width": 405,
   "height": 45,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
