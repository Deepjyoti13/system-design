   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "new version, new path prefix; old tiles stay\nvalid and cached",
   "originalText": "new version, new path prefix; old tiles stay\nvalid and cached",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
