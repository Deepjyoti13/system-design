   "version": 1,
   "versionNonce": 700392,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "a user staring at a blank map, or unable to start navigating, experiences the product\nas broken.",
   "originalText": "a user staring at a blank map, or unable to start navigating, experiences the product\nas broken.",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "cn",
   "type": "text",
   "x": 30,
   "y": 1326,
   "width": 1019,
   "height": 48,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100057,
   "version": 1,
   "versionNonce": 700399,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "Tile serving essentially cannot be overloaded - the CDN absorbs it - and ingest is trivially parallel. Load is sharply diurnal\nbut GEOGRAPHICALLY STAGGERED: rush hour rolls around the planet, so global load is far flatter than any single region's, with\nregional peaks about 5x the regional average.",
   "originalText": "Tile serving essentially cannot be overloaded - the CDN absorbs it - and ingest is trivially parallel. Load is sharply diurnal\nbut GEOGRAPHICALLY STAGGERED: rush hour rolls around the planet, so global load is far flatter than any single region's, with\nregional peaks about 5x the regional average.",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "d4",
   "type": "line",
   "x": 30,
   "y": 1400,
   "width": 1680,
   "height": 0,
   "strokeColor": "#cbd5e1",
