   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "routing everyone around congestion CREATES congestion on the alternative - and because the ETA model trains on observed\nspeeds that were themselves shaped by past routing decisions, the system is partly predicting its own behaviour. Real\ndeployments deliberately split traffic across alternatives to damp this; that mechanism is absent.",
   "originalText": "routing everyone around congestion CREATES congestion on the alternative - and because the ETA model trains on observed\nspeeds that were themselves shaped by past routing decisions, the system is partly predicting its own behaviour. Real\ndeployments deliberately split traffic across alternatives to damp this; that mechanism is absent.",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
