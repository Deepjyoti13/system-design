   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "Degradation, in order of user impact - and note where the worst one is",
   "originalText": "Degradation, in order of user impact - and note where the worst one is",
   "fontSize": 17,
   "fontFamily": 3,
   "textAlign": "left",
