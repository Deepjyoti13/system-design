   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "because clients compute (z,x,y) themselves, changing the scheme means old app versions keep requesting old URLs for years.\nThe honest position: this saves a round trip in exchange for a decision you cannot revisit.",
   "originalText": "because clients compute (z,x,y) themselves, changing the scheme means old app versions keep requesting old URLs for years.\nThe honest position: this saves a round trip in exchange for a decision you cannot revisit.",
   "fontSize": 12,
