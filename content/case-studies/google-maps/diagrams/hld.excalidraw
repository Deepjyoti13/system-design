   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "'who is affected' by an incident is the least-solved piece",
   "originalText": "'who is affected' by an incident is the least-solved piece",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "gd1",
   "type": "text",
   "x": 56,
   "y": 2576,
   "width": 934,
   "height": 45,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
