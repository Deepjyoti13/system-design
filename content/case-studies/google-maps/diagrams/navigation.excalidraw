   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "so they cache trivially - in the navigation service's memory and in object\nstorage behind it. Which is why the store is object storage rather than a graph\ndatabase: the access pattern is 'fetch blob 9q8yy', not a query.",
   "originalText": "so they cache trivially - in the navigation service's memory and in object\nstorage behind it. Which is why the store is object storage rather than a graph\ndatabase: the access pattern is 'fetch blob 9q8yy', not a query.",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
