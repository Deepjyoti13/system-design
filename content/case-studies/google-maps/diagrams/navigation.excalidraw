  {
   "id": "gn2",
   "type": "text",
   "x": 30,
   "y": 2266,
   "width": 1011,
   "height": 65,
   "strokeColor": "#1e40af",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100083,
   "version": 1,
   "versionNonce": 700581,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "'Turn right in 100 metres' is useless three seconds late - so the fact that it never touches the network is not a nicety. The\nserver is needed only to START a journey or to OFFER a reroute, and both are interruptible. That is a rare and valuable\nproperty. It is also half of offline navigation, the other half being pre-downloaded tiles and on-device pathfinding, which\nremains an unbuilt gap.",
   "originalText": "'Turn right in 100 metres' is useless three seconds late - so the fact that it never touches the network is not a nicety. The\nserver is needed only to START a journey or to OFFER a reroute, and both are interruptible. That is a rare and valuable\nproperty. It is also half of offline navigation, the other half being pre-downloaded tiles and on-device pathfinding, which\nremains an unbuilt gap.",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  }
