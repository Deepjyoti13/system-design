  {
   "id": "el",
   "type": "text",
   "x": 30,
   "y": 1438,
   "width": 1015,
   "height": 21,
   "strokeColor": "#1e40af",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100056,
   "version": 1,
   "versionNonce": 700392,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "ETA is a separate service because the graph and its weights change at completely different rates",
