   "versionNonce": 700406,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "the GRAPH   which roads exist, how they connect   ->   changes RARELY, days to weeks",
   "originalText": "the GRAPH   which roads exist, how they connect   ->   changes RARELY, days to weeks",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "center",
