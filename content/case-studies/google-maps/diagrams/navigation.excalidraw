   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "routing tile 9q8yy:\n   nodes:    intersections inside this geohash cell\n   edges:    road segments between them, with weights\n   boundary: references to neighbouring tiles, and the nodes\n             where roads cross out",
   "originalText": "routing tile 9q8yy:\n   nodes:    intersections inside this geohash cell\n   edges:    road segments between them, with weights\n   boundary: references to neighbouring tiles, and the nodes\n             where roads cross out",
