   "locked": false,
   "text": "The route is returned in FULL - which moves the most latency-sensitive part of the product off the network",
   "originalText": "The route is returned in FULL - which moves the most latency-sensitive part of the product off the network",
   "fontSize": 17,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "gn",
