    { "type": "text", "id": "green_body_l1", "x": 100, "y": 860, "width": 480, "height": 18,
      "text": "The gap is unlikely to be chance --", "originalText": "The gap is unlikely to be chance --",
      "fontSize": 13, "fontFamily": 3, "textAlign": "center", "verticalAlign": "top",
      "strokeColor": "#065f46", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 1102, "version": 1, "versionNonce": 2102, "isDeleted": false, "groupIds": [],
      "boundElements": null, "link": null, "locked": false, "lineHeight": 1.25 },
    { "type": "text", "id": "green_body_l2", "x": 100, "y": 878, "width": 480, "height": 18,
      "text": "reject the null, treat the effect as real.", "originalText": "reject the null, treat the effect as real.",
      "fontSize": 13, "fontFamily": 3, "textAlign": "center", "verticalAlign": "top",
      "strokeColor": "#065f46", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 1103, "version": 1, "versionNonce": 2103, "isDeleted": false, "groupIds": [],
