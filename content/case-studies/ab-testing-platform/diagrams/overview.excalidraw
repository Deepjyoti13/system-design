    { "type": "text", "id": "subtitle_l1", "x": 20, "y": 62, "width": 1100, "height": 20,
      "text": "Control and treatment each produce a distribution of outcomes across users --",
      "originalText": "Control and treatment each produce a distribution of outcomes across users --",
      "fontSize": 15, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
