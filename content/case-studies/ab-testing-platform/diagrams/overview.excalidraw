    { "type": "text", "id": "red_title", "x": 620, "y": 826, "width": 480, "height": 26,
      "text": "p >= 0.05", "originalText": "p >= 0.05",
      "fontSize": 18, "fontFamily": 3, "textAlign": "center", "verticalAlign": "top",
      "strokeColor": "#7f1d1d", "backgroundColor": "transparent", "fillStyle": "solid",
