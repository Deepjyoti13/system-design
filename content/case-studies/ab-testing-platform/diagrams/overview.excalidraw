    { "type": "rectangle", "id": "peeking_box", "x": 100, "y": 950, "width": 1000, "height": 90,
      "strokeColor": "#c2410c", "backgroundColor": "#fed7aa", "fillStyle": "solid",
      "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 1120, "version": 1, "versionNonce": 2120, "isDeleted": false, "groupIds": [],
      "boundElements": null, "link": null, "locked": false, "roundness": {"type": 3} },
    { "type": "text", "id": "peeking_title", "x": 100, "y": 960, "width": 1000, "height": 22,
      "text": "The hardest part isn't the test -- it's when you're allowed to look at it.",
      "originalText": "The hardest part isn't the test -- it's when you're allowed to look at it.",
      "fontSize": 15, "fontFamily": 3, "textAlign": "center", "verticalAlign": "top",
      "strokeColor": "#c2410c", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 1121, "version": 1, "versionNonce": 2121, "isDeleted": false, "groupIds": [],
      "boundElements": null, "link": null, "locked": false, "lineHeight": 1.25 },
    { "type": "text", "id": "peeking_body_l1", "x": 100, "y": 990, "width": 1000, "height": 18,
      "text": "Checking this p-value every day while the experiment is still running inflates the false-positive rate far past 5%.",
      "originalText": "Checking this p-value every day while the experiment is still running inflates the false-positive rate far past 5%.",
      "fontSize": 13, "fontFamily": 3, "textAlign": "center", "verticalAlign": "top",
      "strokeColor": "#7c2d12", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 1122, "version": 1, "versionNonce": 2122, "isDeleted": false, "groupIds": [],
      "boundElements": null, "link": null, "locked": false, "lineHeight": 1.25 },
    { "type": "text", "id": "peeking_body_l2", "x": 100, "y": 1008, "width": 1000, "height": 18,
      "text": "Real platforms fix the sample size upfront and check once, or use a sequential test built for continuous peeking.",
      "originalText": "Real platforms fix the sample size upfront and check once, or use a sequential test built for continuous peeking.",
      "fontSize": 13, "fontFamily": 3, "textAlign": "center", "verticalAlign": "top",
      "strokeColor": "#7c2d12", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 1123, "version": 1, "versionNonce": 2123, "isDeleted": false, "groupIds": [],
