      "boundElements": null, "link": null, "locked": false, "lineHeight": 1.25 },
    { "type": "text", "id": "red_body_l1", "x": 620, "y": 860, "width": 480, "height": 18,
      "text": "Indistinguishable from noise --", "originalText": "Indistinguishable from noise --",
      "fontSize": 13, "fontFamily": 3, "textAlign": "center", "verticalAlign": "top",
      "strokeColor": "#7f1d1d", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 1112, "version": 1, "versionNonce": 2112, "isDeleted": false, "groupIds": [],
      "boundElements": null, "link": null, "locked": false, "lineHeight": 1.25 },
    { "type": "text", "id": "red_body_l2", "x": 620, "y": 878, "width": 480, "height": 18,
      "text": "fail to reject, don't ship on this alone.", "originalText": "fail to reject, don't ship on this alone.",
