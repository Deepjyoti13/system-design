      "boundElements": null, "link": null, "locked": false, "lineHeight": 1.25 },
    { "type": "text", "id": "overlap_text_l2", "x": 200, "y": 490, "width": 640, "height": 18,
      "text": "individual outcomes vary far more than the two means do,", "originalText": "individual outcomes vary far more than the two means do,",
      "fontSize": 13, "fontFamily": 3, "textAlign": "center", "verticalAlign": "top",
      "strokeColor": "#64748b", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 1042, "version": 1, "versionNonce": 2042, "isDeleted": false, "groupIds": [],
      "boundElements": null, "link": null, "locked": false, "lineHeight": 1.25 },
    { "type": "text", "id": "overlap_text_l3", "x": 160, "y": 508, "width": 720, "height": 18,
      "text": "which is exactly why this needs a statistical test, not a glance.", "originalText": "which is exactly why this needs a statistical test, not a glance.",
