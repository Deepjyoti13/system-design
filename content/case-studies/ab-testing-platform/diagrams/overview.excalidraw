    { "type": "text", "id": "green_title", "x": 100, "y": 826, "width": 480, "height": 26,
      "text": "p < 0.05", "originalText": "p < 0.05",
      "fontSize": 18, "fontFamily": 3, "textAlign": "center", "verticalAlign": "top",
      "strokeColor": "#047857", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
