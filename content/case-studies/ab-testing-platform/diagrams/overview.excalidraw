      "boundElements": null, "link": null, "locked": false, "lineHeight": 1.25 },
    { "type": "text", "id": "subtitle_l2", "x": 20, "y": 80, "width": 1200, "height": 20,
      "text": "the platform's only job is deciding whether their means actually differ, or just look different by chance.",
