   "versionNonce": 700308,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "neither silently dropping it nor silently folding it into an already-computed summary is acceptable, so it is routed to a\ndistinct 'late, unattributed' record - the same instinct as a late-arriving ad click, against a window measured in days\nrather than seconds.",
   "originalText": "neither silently dropping it nor silently folding it into an already-computed summary is acceptable, so it is routed to a\ndistinct 'late, unattributed' record - the same instinct as a late-arriving ad click, against a window measured in days\nrather than seconds.",
   "fontSize": 12,
