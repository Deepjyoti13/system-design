   "version": 1,
   "versionNonce": 700406,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "Strategy              SignificanceTest - z-test for a binary metric, Welch's t-test for a continuous one, and a future\n                      sequential test, all interchangeable behind one interface\nImmutable snapshot    the aggregator's atomic reference swap for its per-variant triples\nRepository            MetricAggregator and SrmChecker hide their storage and their math; the analyzer touches neither a\n                      database nor a formula directly\nGuard clause / gate   committedHorizonReached() is a single NAMED checkpoint that every path to a 'final' verdict has to\n                      pass through - rather than a discipline every caller has to remember on their own",
   "originalText": "Strategy              SignificanceTest - z-test for a binary metric, Welch's t-test for a continuous one, and a future\n                      sequential test, all interchangeable behind one interface\nImmutable snapshot    the aggregator's atomic reference swap for its per-variant triples\nRepository            MetricAggregator and SrmChecker hide their storage and their math; the analyzer touches neither a\n                      database nor a formula directly\nGuard clause / gate   committedHorizonReached() is a single NAMED checkpoint that every path to a 'final' verdict has to\n                      pass through - rather than a discipline every caller has to remember on their own",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
