  },
  {
   "id": "erd1",
   "type": "text",
   "x": 56,
   "y": 1522,
   "width": 904,
   "height": 45,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
