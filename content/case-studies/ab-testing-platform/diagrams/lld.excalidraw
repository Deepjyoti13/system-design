   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "The one piece of code between 'a p-value exists' and 'a p-value is allowed to mean anything'",
   "originalText": "The one piece of code between 'a p-value exists' and 'a p-value is allowed to mean anything'",
   "fontSize": 17,
   "fontFamily": 3,
