   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "Correctness here is not a lock that is fast enough - it is an operation that was never order-dependent",
   "originalText": "Correctness here is not a lock that is fast enough - it is an operation that was never order-dependent",
   "fontSize": 22,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "s",
   "type": "text",
   "x": 30,
   "y": 52,
   "width": 1488,
   "height": 17,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100002,
   "version": 1,
   "versionNonce": 700014,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "Two components in this design are not 'compute a hash' or 'store a row': the metric aggregator, and the gate between a p-value existing and being allowed to mean anything.",
   "originalText": "Two components in this design are not 'compute a hash' or 'store a row': the metric aggregator, and the gate between a p-value existing and being allowed to mean anything.",
   "fontSize": 14,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
