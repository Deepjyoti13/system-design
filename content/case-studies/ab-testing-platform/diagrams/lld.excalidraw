   "link": null,
   "locked": false,
   "text": "merge(a, b):\n    n     = a.n + b.n\n    delta = b.mean - a.mean\n    mean  = a.mean + delta * b.n / n\n    M2    = a.M2 + b.M2\n            + delta * delta * a.n * b.n / n\n    return (n, mean, M2)",
   "originalText": "merge(a, b):\n    n     = a.n + b.n\n    delta = b.mean - a.mean\n    mean  = a.mean + delta * b.n / n\n    M2    = a.M2 + b.M2\n            + delta * delta * a.n * b.n / n\n    return (n, mean, M2)",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "mg",
