   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "partition 1     sharded by user_id\n  state.n    += 1\n  delta       = value - state.mean\n  state.mean += delta / state.n\n  state.M2   += delta * (value - state.mean)\n\n  -> its OWN (n, mean, M2)",
   "originalText": "partition 1     sharded by user_id\n  state.n    += 1\n  delta       = value - state.mean\n  state.mean += delta / state.n\n  state.M2   += delta * (value - state.mean)\n\n  -> its OWN (n, mean, M2)",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "p1",
   "lineHeight": 1.25
