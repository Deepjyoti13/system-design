{"type": "excalidraw", "version": 2, "source": "field-guide", "elements": [{"id": "title", "type": "text", "x": 40, "y": 30, "width": 1000, "height": 27, "text": "One Ephemeral, One Durable -- Same Shape, Different Guarantees", "originalText": "One Ephemeral, One Durable -- Same Shape, Different Guarantees", "fontSize": 21, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#1971c2", "backgroundColor": "transparent", "opacity": 100, "seed": 64138}, {"id": "subtitle", "type": "text", "x": 40, "y": 66, "width": 822, "height": 20, "text": "Both are indexed on geohash, but only one of them needs to survive a restart", "originalText": "Both are indexed on geohash, but only one of them needs to survive a restart", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#5c6470", "backgroundColor": "transparent", "opacity": 100, "seed": 78155}, {"id": "dynamic", "type": "rectangle", "x": 40, "y": 140, "width": 460, "height": 200, "strokeColor": "#2f9e44", "backgroundColor": "#d3f9d8", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "seed": 89485, "roundness": {"type": 3}}, {"id": "dynamic_t", "type": "text", "x": 60, "y": 156, "width": 350, "height": 21, "text": "dynamic_locations (in-memory)", "originalText": "dynamic_locations (in-memory)", "fontSize": 15, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#1a5c2e", "backgroundColor": "transparent", "opacity": 100, "seed": 80116}, {"id": "dynamic_r1", "type": "text", "x": 60, "y": 190, "width": 160, "height": 19, "text": "entity_id (PK)", "originalText": "entity_id (PK)", "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "opacity": 100, "seed": 76675}, {"id": "dynamic_r2", "type": "text", "x": 60, "y": 214, "width": 92, "height": 19, "text": "geohash", "originalText": "geohash", "fontSize": 13, "f