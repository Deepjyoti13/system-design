ackgroundColor": "#0d1117", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "seed": 89548, "roundness": {"type": 3}}, {"id": "evidence_l0", "type": "text", "x": 60, "y": 416, "width": 1347, "height": 20, "text": "Both tables key off the same geohash concept -- a query fans out to both and merges by distance, but they scale independently.", "originalText": "Both tables key off the same geohash concept -- a query fans out to both and merges by distance, but they scale independently.", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#7ee787", "backgroundColor": "transparent", "opacity": 100, "seed": 2660}, {"id": "evidence_l1", "type": "text", "x": 60, "y": 444, "width": 1525, "height": 20, "text": "dynamic_locations optimizes purely for write throughput and staleness-tolerance; static_pois optimizes for durability and read-through caching.", "originalText": "dynamic_locations optimizes purely for write throughput and staleness-tolerance; static_pois optimizes for durability and read-through caching.", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#7ee787", "backgroundColor": "transparent", "opacity": 100, "seed": 11578}], "appState": {"viewBackgroundColor": "#ffffff"}}