{"type": "excalidraw", "version": 2, "source": "field-guide", "elements": [{"id": "title", "type": "text", "x": 40, "y": 30, "width": 1016, "height": 27, "text": "Search the Own Cell's 8 Neighbors First -- Widen Only If Needed", "originalText": "Search the Own Cell's 8 Neighbors First -- Widen Only If Needed", "fontSize": 21, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#1971c2", "backgroundColor": "transparent", "opacity": 100, "seed": 29704}, {"id": "subtitle", "type": "text", "x": 40, "y": 66, "width": 1053, "height": 20, "text": "A point near a cell edge can be closer to a neighboring cell's contents than its own cell's center", "originalText": "A point near a cell edge can be closer to a neighboring cell's contents than its own cell's center", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#5c6470", "backgroundColor": "transparent", "opacity": 100, "seed": 63562}, {"id": "cell_nw", "type": "rectangle", "x": 260, "y": 260, "width": 100, "height": 100, "strokeColor": "#2f9e44", "backgroundColor": "#d3f9d8", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "seed": 74369, "roundness": {"type": 3}}, {"id": "cell_n", "type": "rectangle", "x": 360, "y": 260, "width": 100, "height": 100, "strokeColor": "#2f9e44", "backgroundColor": "#d3f9d8", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "seed": 19715, "roundness": {"type": 3}}, {"id": "cell_ne", "type": "rectangle", "x": 460, "y": 260, "width": 100, "height": 100, "strokeColor": "#2f9e44", "backgroundColor": "#d3f9d8", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "seed": 47473, "roundness": {"type": 3}}, {"id": "cell_w", "type": "rectangle", "x": 260, "y": 360, "width": 100, "height": 100, "strokeColor": "#2f9e44", "backgroundColor": "#d3f9d8", "fillStyle": "solid", "strokeWidth": 2, "strokeSty