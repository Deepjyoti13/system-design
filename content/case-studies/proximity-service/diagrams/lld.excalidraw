0, "seed": 3937, "roundness": {"type": 3}}, {"id": "evidence_l0", "type": "text", "x": 60, "y": 696, "width": 1609, "height": 20, "text": "The query point sits near its own cell's NE corner -- the closest real candidates may actually live in the 'n', 'ne', or 'e' neighbor cells, not 'own'.", "originalText": "The query point sits near its own cell's NE corner -- the closest real candidates may actually live in the 'n', 'ne', or 'e' neighbor cells, not 'own'.", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#7ee787", "backgroundColor": "transparent", "opacity": 100, "seed": 20571}, {"id": "evidence_l1", "type": "text", "x": 60, "y": 724, "width": 1462, "height": 20, "text": "Searching only the 'own' cell would silently miss them; the 8-neighbor search is a correctness fix, not just a completeness optimization.", "originalText": "Searching only the 'own' cell would silently miss them; the 8-neighbor search is a correctness fix, not just a completeness optimization.", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#7ee787", "backgroundColor": "transparent", "opacity": 100, "seed": 72235}], "appState": {"viewBackgroundColor": "#ffffff"}}