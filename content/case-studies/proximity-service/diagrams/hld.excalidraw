{"type": "excalidraw", "version": 2, "source": "field-guide", "elements": [{"id": "title", "type": "text", "x": 40, "y": 30, "width": 898, "height": 28, "text": "Two Stores, Split by Churn Rate -- Not by Entity Type", "originalText": "Two Stores, Split by Churn Rate -- Not by Entity Type", "fontSize": 22, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#1971c2", "backgroundColor": "transparent", "opacity": 100, "seed": 67068}, {"id": "subtitle", "type": "text", "x": 40, "y": 66, "width": 1137, "height": 20, "text": "Driver pings need write throughput with no durability; restaurant listings need durability, not throughput", "originalText": "Driver pings need write throughput with no durability; restaurant listings need durability, not throughput", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#5c6470", "backgroundColor": "transparent", "opacity": 100, "seed": 19740}, {"id": "driver", "type": "rectangle", "x": 40, "y": 150, "width": 240, "height": 90, "strokeColor": "#5c6470", "backgroundColor": "#f1f3f5", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "seed": 57793, "roundness": {"type": 3}}, {"id": "driver_t", "type": "text", "x": 56, "y": 168, "width": 136, "height": 21, "text": "Driver App", "originalText": "Driver App", "fontSize": 15, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#33373d", "backgroundColor": "transparent", "opacity": 100, "seed": 34426}, {"id": "driver_t2", "type": "text", "x": 56, "y": 196, "width": 205, "height": 17, "text": "location ping every 4s", "originalText": "location ping every 4s", "fontSize": 11, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#33373d", "backgroundColor": "transparent", "opacity": 100, "seed": 72821}, {"id": "driver_t3", "type": "text", "x": 56, "y": 214, "width": 172, "height": 17, "text": "(~250K writes/sec)", "originalText": "(