idth": 186, "height": 18, "text": "GEOADD / GEOSEARCH", "originalText": "GEOADD / GEOSEARCH", "fontSize": 12, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#1a5c2e", "backgroundColor": "transparent", "opacity": 100, "seed": 10882}, {"id": "dynamic_t4", "type": "text", "x": 696, "y": 218, "width": 255, "height": 17, "text": "no durability -- TTL-expires", "originalText": "no durability -- TTL-expires", "fontSize": 11, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#1a5c2e", "backgroundColor": "transparent", "opacity": 100, "seed": 68086}, {"id": "static", "type": "rectangle", "x": 680, "y": 290, "width": 280, "height": 110, "strokeColor": "#e0a930", "backgroundColor": "#fff3bf", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "seed": 16068, "roundness": {"type": 3}}, {"id": "static_t", "type": "text", "x": 696, "y": 306, "width": 192, "height": 20, "text": "Static POI Store", "originalText": "Static POI Store", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#7a5c00", "backgroundColor": "transparent", "opacity": 100, "seed": 46938}, {"id": "static_t2", "type": "text", "x": 696, "y": 336, "width": 238, "height": 17, "text": "(durable, geohash-indexed)", "originalText": "(durable, geohash-indexed)", "fontSize": 11, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#7a5c00", "backgroundColor": "transparent", "opacity": 100, "seed": 36788}, {"id": "static_t3", "type": "text", "x": 696, "y": 358, "width": 222, "height": 18, "text": "restaurants, landmarks", "originalText": "restaurants, landmarks", "fontSize": 12, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#7a5c00", "backgroundColor": "transparent", "opacity": 100, "seed": 14442}, {"id": "static_t4", "type": "text", "x": 696, "y": 378, "width": 238, "height": 17, "text": "read-heavy, rarely written", "originalText": "read-heavy, rarely written", "fontSize": 11, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#7a5c00", "backgroundColor": "transparent", "opacity": 100, "seed": 34796}, {"id": "a_svc_dynamic", "type": "arrow", "x": 600, "y": 245, "width": 80, "height": 60, "points": [[0, 0], [80, -60]], "strokeColor": "#2f9e44", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "seed": 18964, "startArrowhead": null, "endArrowhead": "triangle"}, {"id": "a_svc_static", "type": "arrow", "x": 600, "y": 265, "width": 80, "height": 80, "points": [[0, 0], [80, 80]], "strokeColor": "#e0a930", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "seed": 19044, "startArrowhead": null, "endArrowhead": "triangle"}, {"id": "evidence_box", "type": "rectangle", "x": 40, "y": 440, "width": 1670, "height": 80, "strokeColor": "#1e1e1e", "backgroundColor": "#0d1117", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "seed": 90080, "roundness": {"type": 3}}, {"id": "evidence_l0", "type": "text", "x": 60, "y": 456, "width": 1305, "height": 20, "text": "Same query path fans out to both stores and merges results -- the split is an implementation detail the caller never sees.", "originalText": "Same query path fans out to both stores and merges results -- the split is an implementation detail the caller never sees.", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#7ee787", "backgroundColor": "transparent", "opacity": 100, "seed": 21172}, {"id": "evidence_l1", "type": "text", "x": 60, "y": 484, "width": 1630, "height": 20, "text": "The dynamic store trades durability for write throughput; the static store makes the opposite trade -- neither setting is right for the other's workload.", "originalText": "The dynamic store trades durability for write throughput; the static store makes the opposite trade -- neither setting is right for the other's workload.", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#7ee787", "backgroundColor": "transparent", "opacity": 100, "seed": 83190}], "appState": {"viewBackgroundColor": "#ffffff"}}