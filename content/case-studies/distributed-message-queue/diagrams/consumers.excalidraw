   "versionNonce": 700574,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "Assignment strategy is application POLICY - range, round-robin, sticky, rack-aware, or something bespoke that\nco-locates related partitions. Putting the planner in the client lets a team ship a custom assignor without\nupgrading the cluster. The broker's job reduces to membership and distribution - the part that must be consistent.",
   "originalText": "Assignment strategy is application POLICY - range, round-robin, sticky, rack-aware, or something bespoke that\nco-locates related partitions. Putting the planner in the client lets a team ship a custom assignor without\nupgrading the cluster. The broker's job reduces to membership and distribution - the part that must be consistent.",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
