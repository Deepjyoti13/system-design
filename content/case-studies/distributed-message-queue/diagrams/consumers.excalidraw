   "versionNonce": 700413,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "Why not let two consumers share a partition? Ordering would break - two readers process nondeterministically, and there is no\nway to track a single offset for two independent readers. Per-partition ordering and one-consumer-per-partition are the SAME\nconstraint viewed from two sides. Partitions are the knob that lets you choose the granularity of that trade.",
   "originalText": "Why not let two consumers share a partition? Ordering would break - two readers process nondeterministically, and there is no\nway to track a single offset for two independent readers. Per-partition ordering and one-consumer-per-partition are the SAME\nconstraint viewed from two sides. Partitions are the knob that lets you choose the granularity of that trade.",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
