  {
   "id": "an",
   "type": "text",
   "x": 30,
   "y": 330,
   "width": 1011,
   "height": 48,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
