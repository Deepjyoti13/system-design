   "versionNonce": 700343,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "makes writes truly sequential",
   "originalText": "makes writes truly sequential",
   "fontSize": 14,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "jd_600",
   "type": "text",
   "x": 626,
   "y": 696,
   "width": 279,
   "height": 30,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100050,
   "version": 1,
   "versionNonce": 700350,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "16 KB lands as one contiguous extent;\n1 KB writes interleave and fragment.",
   "originalText": "16 KB lands as one contiguous extent;\n1 KB writes interleave and fragment.",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
