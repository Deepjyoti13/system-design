  {
   "id": "dn",
   "type": "text",
   "x": 30,
   "y": 1040,
   "width": 1011,
   "height": 65,
   "strokeColor": "#1e40af",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100066,
   "version": 1,
   "versionNonce": 700462,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "The architectural consequence matters more than the performance one: the broker CANNOT decompress, re-frame or transform a\nmessage - the moment it touches the payload it must copy into user space and the optimization is gone. So the message format\nis IDENTICAL for producer, broker storage and consumer; compression is end-to-end; and the broker is deliberately ignorant of\nmessage contents. That is why broker-side filtering is awkward and why poison-message policy has to live in the consumer.",
   "originalText": "The architectural consequence matters more than the performance one: the broker CANNOT decompress, re-frame or transform a\nmessage - the moment it touches the payload it must copy into user space and the optimization is gone. So the message format\nis IDENTICAL for producer, broker storage and consumer; compression is end-to-end; and the broker is deliberately ignorant of\nmessage contents. That is why broker-side filtering is awkward and why poison-message policy has to live in the consumer.",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  }
