   "locked": false
  },
  {
   "id": "jn_600",
   "type": "text",
   "x": 626,
   "y": 672,
   "width": 255,
   "height": 17,
   "strokeColor": "#047857",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
