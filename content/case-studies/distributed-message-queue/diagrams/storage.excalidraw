   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "Batching is the primary dial - and it does THREE jobs at once",
   "originalText": "Batching is the primary dial - and it does THREE jobs at once",
   "fontSize": 17,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
