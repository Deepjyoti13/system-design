  },
  {
   "id": "jn_1150",
   "type": "text",
   "x": 1176,
   "y": 672,
   "width": 290,
   "height": 17,
   "strokeColor": "#047857",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
