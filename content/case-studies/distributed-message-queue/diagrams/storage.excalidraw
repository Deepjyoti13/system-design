  },
  {
   "id": "jn_30",
   "type": "text",
   "x": 56,
   "y": 672,
   "width": 238,
   "height": 17,
   "strokeColor": "#047857",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
