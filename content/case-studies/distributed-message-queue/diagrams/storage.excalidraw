  {
   "id": "an",
   "type": "text",
   "x": 30,
   "y": 262,
   "width": 1003,
   "height": 32,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100026,
   "version": 1,
   "versionNonce": 700182,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "Retention becomes unlink() - an O(1) syscall reclaiming a gigabyte. One giant file would mean copying the surviving tail\nforward to release the head. That alone justifies segmenting; finding an offset then becomes a binary search over filenames.",
   "originalText": "Retention becomes unlink() - an O(1) syscall reclaiming a gigabyte. One giant file would mean copying the surviving tail\nforward to release the head. That alone justifies segmenting; finding an offset then becomes a binary search over filenames.",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
