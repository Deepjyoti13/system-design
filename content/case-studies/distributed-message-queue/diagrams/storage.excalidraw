   "versionNonce": 700364,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "enables cross-message compression",
   "originalText": "enables cross-message compression",
   "fontSize": 14,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "jd_1150",
   "type": "text",
   "x": 1176,
   "y": 696,
   "width": 264,
   "height": 30,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100053,
   "version": 1,
   "versionNonce": 700371,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "shared dictionary: 5-10x as a batch\nversus ~2x individually.",
   "originalText": "shared dictionary: 5-10x as a batch\nversus ~2x individually.",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "cn",
   "type": "text",
   "x": 30,
   "y": 744,
   "width": 1035,
   "height": 32,
   "strokeColor": "#1e40af",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100054,
   "version": 1,
   "versionNonce": 700378,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "The third is easy to miss and often the biggest: the batch is stored AND replicated compressed, so batching cuts disk usage,\nreplication bandwidth and consumer fetch bandwidth simultaneously. A 500 MB/sec ingest at 5x is 100 MB/sec of real disk traffic.",
   "originalText": "The third is easy to miss and often the biggest: the batch is stored AND replicated compressed, so batching cuts disk usage,\nreplication bandwidth and consumer fetch bandwidth simultaneously. A 500 MB/sec ingest at 5x is 100 MB/sec of real disk traffic.",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
