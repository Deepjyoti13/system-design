   "version": 1,
   "versionNonce": 700231,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "Storing offsets in a plain append-only log would mean the log grows without bound while holding one useful value per key -\nyou would retain a million historical positions for a group that only needs its current one.",
   "originalText": "Storing offsets in a plain append-only log would mean the log grows without bound while holding one useful value per key -\nyou would retain a million historical positions for a group that only needs its current one.",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
