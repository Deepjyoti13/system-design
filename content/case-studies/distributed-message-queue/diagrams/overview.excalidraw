   "versionNonce": 700014,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "Consuming a message mutates nothing; it moves an integer. That one substitution is what makes sequential-only I/O possible.",
   "originalText": "Consuming a message mutates nothing; it moves an integer. That one substitution is what makes sequential-only I/O possible.",
   "fontSize": 14,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
