   "versionNonce": 700175,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "Per-message MUTABLE state: small, and randomly\naccessed. So every acknowledgement is a RANDOM\nWRITE - which locks you into 0.61 MB/sec.",
   "originalText": "Per-message MUTABLE state: small, and randomly\naccessed. So every acknowledgement is a RANDOM\nWRITE - which locks you into 0.61 MB/sec.",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
