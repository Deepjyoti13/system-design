   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "Not a tuning difference - a different regime.\n500 MB/sec needs ~800 drives with random I/O,\nand about four with sequential.",
   "originalText": "Not a tuning difference - a different regime.\n500 MB/sec needs ~800 drives with random I/O,\nand about four with sequential.",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "mn",
   "type": "text",
   "x": 30,
   "y": 664,
   "width": 979,
   "height": 32,
   "strokeColor": "#1e40af",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100066,
   "version": 1,
   "versionNonce": 700462,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "\"Disk is slow\" is one of the most misleading pieces of received wisdom in systems design. Disk is slow FOR RANDOM ACCESS.\nSo the whole storage engine is organised around one rule: never do a random write, and avoid random reads.",
   "originalText": "\"Disk is slow\" is one of the most misleading pieces of received wisdom in systems design. Disk is slow FOR RANDOM ACCESS.\nSo the whole storage engine is organised around one rule: never do a random write, and avoid random reads.",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
