  },
  {
   "id": "s",
   "type": "text",
   "x": 30,
   "y": 52,
   "width": 1071,
   "height": 17,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
