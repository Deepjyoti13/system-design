   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "It is not a queue - it is a log with a cursor per reader",
   "originalText": "It is not a queue - it is a log with a cursor per reader",
   "fontSize": 22,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
