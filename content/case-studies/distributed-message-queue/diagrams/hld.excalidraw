   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "Raft / ZAB, 3-5 nodes\n\nbroker membership\ntopic -> partition -> replicas\nwho leads each partition\nthe ISR per partition",
   "originalText": "Raft / ZAB, 3-5 nodes\n\nbroker membership\ntopic -> partition -> replicas\nwho leads each partition\nthe ISR per partition",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "zk",
   "lineHeight": 1.25
  },
