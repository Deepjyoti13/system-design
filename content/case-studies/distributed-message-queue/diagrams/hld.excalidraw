   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "The client holds the partition->leader map (cached, refreshed\non error) and buffers per-partition to batch. Fewer hops, and\nthe producer controls which partition a message lands in.",
   "originalText": "The client holds the partition->leader map (cached, refreshed\non error) and buffers per-partition to batch. Fewer hops, and\nthe producer controls which partition a message lands in.",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "cn2",
   "type": "text",
   "x": 620,
   "y": 258,
   "width": 472,
   "height": 45,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100021,
   "version": 1,
   "versionNonce": 700147,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "The honest cost: the client library is now part of the system's\nsurface area. A protocol change means shipping new clients to\nevery team, and a client bug cannot be hotfixed centrally.",
   "originalText": "The honest cost: the client library is now part of the system's\nsurface area. A protocol change means shipping new clients to\nevery team, and a client bug cannot be hotfixed centrally.",
   "fontSize": 12,
   "fontFamily": 3,
