   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "Why the coordination service is separate, and the broker is not",
   "originalText": "Why the coordination service is separate, and the broker is not",
   "fontSize": 17,
   "fontFamily": 3,
