  },
  {
   "id": "w1_t",
   "type": "text",
   "x": 38,
   "y": 721,
   "width": 764,
   "height": 45,
   "strokeColor": "#374151",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100055,
   "version": 1,
   "versionNonce": 700385,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "The broker is deliberately a MONOLITH\naccept appends, serve fetches, replicate, enforce retention - all four touch\nthe same bytes on the same local disk, and one page cache",
   "originalText": "The broker is deliberately a MONOLITH\naccept appends, serve fetches, replicate, enforce retention - all four touch\nthe same bytes on the same local disk, and one page cache",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "w1",
   "lineHeight": 1.25
  },
  {
   "id": "w2",
