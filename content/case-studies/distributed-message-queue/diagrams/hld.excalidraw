   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "1. an extra hop on every one of 488k messages/sec\n2. FATAL: it receives messages one at a time from many\n   producers, so it can never batch messages from the\n   same producer for the same partition - it never sees\n   them together.",
   "originalText": "1. an extra hop on every one of 488k messages/sec\n2. FATAL: it receives messages one at a time from many\n   producers, so it can never batch messages from the\n   same producer for the same partition - it never sees\n   them together.",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
