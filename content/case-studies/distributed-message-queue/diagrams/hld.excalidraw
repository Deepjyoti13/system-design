  {
   "id": "bn",
   "type": "text",
   "x": 30,
   "y": 556,
   "width": 922,
   "height": 65,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100048,
   "version": 1,
   "versionNonce": 700336,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "Leadership is spread evenly on purpose: producers AND consumers talk only to leaders, so a broker leading\ndisproportionately many partitions absorbs disproportionate traffic while its followers idle. And after a failover\nleadership is by definition unbalanced, so a preferred-leader election must run periodically to restore it -\nforget that step and the cluster gets progressively more lopsided with every failure it survives.",
   "originalText": "Leadership is spread evenly on purpose: producers AND consumers talk only to leaders, so a broker leading\ndisproportionately many partitions absorbs disproportionate traffic while its followers idle. And after a failover\nleadership is by definition unbalanced, so a preferred-leader election must run periodically to restore it -\nforget that step and the cluster gets progressively more lopsided with every failure it survives.",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "kl",
   "type": "text",
   "x": 1300,
   "y": 338,
   "width": 202,
   "height": 20,
   "strokeColor": "#047857",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100049,
   "version": 1,
   "versionNonce": 700343,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "Coordination service",
   "originalText": "Coordination service",
   "fontSize": 16,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
