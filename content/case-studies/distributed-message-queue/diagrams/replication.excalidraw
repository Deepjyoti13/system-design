   "opacity": 100,
   "angle": 0,
   "seed": 100086,
   "version": 1,
   "versionNonce": 700602,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "and 104/105 get REASSIGNED",
   "originalText": "and 104/105 get REASSIGNED",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "bn",
   "type": "text",
   "x": 30,
   "y": 600,
   "width": 1003,
   "height": 113,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100087,
   "version": 1,
   "versionNonce": 700609,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "The consumer has processed and committed a message the system now says was never written - and if it was 'charge this card',\nthat has already happened and is unrecoverable from the log. Worse, offsets 104 and 105 will be REASSIGNED to different\nfuture messages, so the log's history has changed underneath every consumer tracking positions.\n\nRestricting reads to the high watermark means a consumer can NEVER observe a message that might later vanish. The HW is\nexactly the boundary of 'this message survives any single-leader failure' - which is also why consumers read from the leader\nand not a follower: a follower's view of the HW lags by one fetch round trip.",
   "originalText": "The consumer has processed and committed a message the system now says was never written - and if it was 'charge this card',\nthat has already happened and is unrecoverable from the log. Worse, offsets 104 and 105 will be REASSIGNED to different\nfuture messages, so the log's history has changed underneath every consumer tracking positions.\n\nRestricting reads to the high watermark means a consumer can NEVER observe a message that might later vanish. The HW is\nexactly the boundary of 'this message survives any single-leader failure' - which is also why consumers read from the leader\nand not a follower: a follower's view of the HW lags by one fetch round trip.",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
