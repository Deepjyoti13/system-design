  {
   "id": "minisr_t",
   "type": "text",
   "x": 38,
   "y": 990,
   "width": 784,
   "height": 48,
   "strokeColor": "#374151",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
