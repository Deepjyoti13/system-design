   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "wait for a FIXED quorum (2 of 3)\n\ncannot tell '5ms behind' from 'dead for an hour'",
   "originalText": "wait for a FIXED quorum (2 of 3)\n\ncannot tell '5ms behind' from 'dead for an hour'",
   "fontSize": 13,
