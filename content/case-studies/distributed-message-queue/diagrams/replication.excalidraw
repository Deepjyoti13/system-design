   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100098,
   "version": 1,
   "versionNonce": 700686,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "replication.factor = 3      min.insync.replicas = 2      acks = all\n\nISR of 3 -> succeed.    ISR of 2 -> succeed.    ISR of 1 -> WRITES FAIL",
   "originalText": "replication.factor = 3      min.insync.replicas = 2      acks = all\n\nISR of 3 -> succeed.    ISR of 2 -> succeed.    ISR of 1 -> WRITES FAIL",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "minisr",
   "lineHeight": 1.25
  },
  {
   "id": "mn",
   "type": "text",
   "x": 860,
   "y": 968,
   "width": 672,
   "height": 65,
   "strokeColor": "#1e40af",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100099,
   "version": 1,
   "versionNonce": 700693,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "That last line is the design deliberately choosing UNAVAILABILITY over silent\ndurability loss - and it is the most commonly mis-set option in real deployments.\nacks=all alone gives a guarantee that quietly evaporates precisely when the cluster\nis unhealthy, because 'all' can shrink to one.",
   "originalText": "That last line is the design deliberately choosing UNAVAILABILITY over silent\ndurability loss - and it is the most commonly mis-set option in real deployments.\nacks=all alone gives a guarantee that quietly evaporates precisely when the cluster\nis unhealthy, because 'all' can shrink to one.",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  }
