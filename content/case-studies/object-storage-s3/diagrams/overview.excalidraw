   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "Buying bigger drives adds bytes but NOT IOPS - capacity per drive has grown ~100x in\ntwenty years while random IOPS has barely moved. So you cannot afford one filesystem\nfile per object, and that single conclusion is what forces the packed-file design.",
   "originalText": "Buying bigger drives adds bytes but NOT IOPS - capacity per drive has grown ~100x in\ntwenty years while random IOPS has barely moved. So you cannot afford one filesystem\nfile per object, and that single conclusion is what forces the packed-file design.",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
