   "versionNonce": 700511,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "Giving up in-place mutation and low latency is exactly what buys a flat namespace, an\nHTTP interface, and the freedom to pack bytes however durability prefers rather than\nhowever a filesystem demands.",
   "originalText": "Giving up in-place mutation and low latency is exactly what buys a flat namespace, an\nHTTP interface, and the freedom to pack bytes however durability prefers rather than\nhowever a filesystem demands.",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
