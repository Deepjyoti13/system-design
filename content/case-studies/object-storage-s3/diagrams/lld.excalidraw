  {
   "id": "dn2",
   "type": "text",
   "x": 900,
   "y": 720,
   "width": 560,
   "height": 65,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100070,
   "version": 1,
   "versionNonce": 700490,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "Only SEALED files are compacted - the active file has a moving tail.\nThe index update is ONE transaction, and the source is unlinked only\nafter it commits, so a crash mid-compaction leaves the index pointing\nat the old file, which still exists. Crash-safe by construction.",
   "originalText": "Only SEALED files are compacted - the active file has a moving tail.\nThe index update is ONE transaction, and the source is unlinked only\nafter it commits, so a crash mid-compaction leaves the index pointing\nat the old file, which still exists. Crash-safe by construction.",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  }
