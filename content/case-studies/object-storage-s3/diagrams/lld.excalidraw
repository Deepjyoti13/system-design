   "versionNonce": 700441,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "Record the location first and a crash leaves an index\nentry pointing at bytes that never landed - a dangling\npointer that reads as corruption. This way a crash leaves\nbytes nothing references: harmless, reclaimed next pass.",
   "originalText": "Record the location first and a crash leaves an index\nentry pointing at bytes that never landed - a dangling\npointer that reads as corruption. This way a crash leaves\nbytes nothing references: harmless, reclaimed next pass.",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
