     1680,
     0
    ]
   ],
   "roundness": null
  },
  {
   "id": "cl",
   "type": "text",
   "x": 30,
   "y": 622,
   "width": 404,
   "height": 21,
   "strokeColor": "#1e40af",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
