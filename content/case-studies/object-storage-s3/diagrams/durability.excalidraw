  },
  {
   "id": "naive_t",
   "type": "text",
   "x": 38,
   "y": 434,
   "width": 504,
   "height": 52,
   "strokeColor": "#374151",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100042,
   "version": 1,
   "versionNonce": 700294,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "P(loss) = 0.0081 ^ 3 = 5.3e-7   ->   6.3 nines\n\nassumes a dead drive is NEVER replaced",
   "originalText": "P(loss) = 0.0081 ^ 3 = 5.3e-7   ->   6.3 nines\n\nassumes a dead drive is NEVER replaced",
   "fontSize": 14,
   "fontFamily": 3,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "naive",
   "lineHeight": 1.25
  },
  {
   "id": "naivel",
   "type": "text",
   "x": 30,
   "y": 520,
   "width": 374,
   "height": 48,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100043,
   "version": 1,
   "versionNonce": 700301,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "This asks: what is the chance all three drives\ndie at some point this year? Only the right\nquestion if nothing is ever repaired.",
   "originalText": "This asks: what is the chance all three drives\ndie at some point this year? Only the right\nquestion if nothing is ever repaired.",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "real",
   "type": "rectangle",
   "x": 610,
   "y": 412,
   "width": 520,
   "height": 96,
   "strokeColor": "#047857",
   "backgroundColor": "#a7f3d0",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
