   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "d = data fragment\np = parity fragment",
   "originalText": "d = data fragment\np = parity fragment",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "legend2",
   "type": "text",
   "x": 1340,
   "y": 214,
   "width": 245,
   "height": 65,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100036,
   "version": 1,
   "versionNonce": 700252,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "8 data + 4 parity, INTERLEAVED\nso no DC holds only parity.\nParity is as good as data:\nany 8 will do.",
   "originalText": "8 data + 4 parity, INTERLEAVED\nso no DC holds only parity.\nParity is as good as data:\nany 8 will do.",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "an",
   "type": "text",
   "x": 30,
   "y": 252,
   "width": 1002,
   "height": 35,
   "strokeColor": "#b91c1c",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100037,
   "version": 1,
   "versionNonce": 700259,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "Lose any 4 fragments -> reconstruct.        Lose one entire DC (4 fragments) -> SURVIVES, with EXACTLY ZERO MARGIN.\nLose one DC plus any single further drive -> DATA LOSS.",
   "originalText": "Lose any 4 fragments -> reconstruct.        Lose one entire DC (4 fragments) -> SURVIVES, with EXACTLY ZERO MARGIN.\nLose one DC plus any single further drive -> DATA LOSS.",
   "fontSize": 14,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "an2",
   "type": "text",
   "x": 30,
   "y": 300,
   "width": 1043,
   "height": 32,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100038,
   "version": 1,
   "versionNonce": 700266,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "\"Survives the loss of a datacentre\" and \"survives it with headroom\" are different promises, and this layout only makes the first.\nThat is why repair becomes the highest-priority workload in the cluster the moment a DC drops.",
   "originalText": "\"Survives the loss of a datacentre\" and \"survives it with headroom\" are different promises, and this layout only makes the first.\nThat is why repair becomes the highest-priority workload in the cluster the moment a DC drops.",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
