   }
  },
  {
   "id": "real_t",
   "type": "text",
   "x": 618,
   "y": 434,
   "width": 504,
   "height": 52,
   "strokeColor": "#374151",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100045,
   "version": 1,
   "versionNonce": 700315,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "P(loss) ~ 6 * lambda^3 * T^2\n\nT = mean time to repair",
   "originalText": "P(loss) ~ 6 * lambda^3 * T^2\n\nT = mean time to repair",
   "fontSize": 14,
   "fontFamily": 3,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "real",
   "lineHeight": 1.25
  },
  {
   "id": "reall",
   "type": "text",
   "x": 610,
   "y": 520,
   "width": 407,
   "height": 48,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100046,
   "version": 1,
   "versionNonce": 700322,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "Data is lost only if the REMAINING copies fail\ninside the repair window. Each extra copy adds\nanother factor of lambda*T - and lambda*T is tiny.",
   "originalText": "Data is lost only if the REMAINING copies fail\ninside the repair window. Each extra copy adds\nanother factor of lambda*T - and lambda*T is tiny.",
   "fontSize": 13,
   "fontFamily": 3,
