  {
   "id": "k1",
   "type": "text",
   "x": 900,
   "y": 644,
   "width": 208,
   "height": 18,
   "strokeColor": "#047857",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100069,
   "version": 1,
   "versionNonce": 700483,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "Repair speed dominates",
   "originalText": "Repair speed dominates",
   "fontSize": 15,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "k1b",
   "type": "text",
   "x": 900,
   "y": 670,
   "width": 398,
   "height": 65,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100070,
   "version": 1,
   "versionNonce": 700490,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "6 hours to 7 days costs THREE FULL NINES. T is\nsquared for replication and raised to the 4th for\n8+4 - so halving repair time is worth 4x to 16x.\nRepair bandwidth is a durability budget line.",
   "originalText": "6 hours to 7 days costs THREE FULL NINES. T is\nsquared for replication and raised to the 4th for\n8+4 - so halving repair time is worth 4x to 16x.\nRepair bandwidth is a durability budget line.",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "k2",
   "type": "text",
   "x": 900,
   "y": 762,
   "width": 394,
   "height": 18,
   "strokeColor": "#b45309",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100071,
   "version": 1,
   "versionNonce": 700497,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "The catch that stops EC winning everywhere",
   "originalText": "The catch that stops EC winning everywhere",
   "fontSize": 15,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "k2b",
   "type": "text",
   "x": 900,
   "y": 788,
   "width": 390,
   "height": 65,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100072,
   "version": 1,
   "versionNonce": 700504,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "Rebuilding one lost 10 MB fragment means READING\n8 fragments - 80 MB. So EC repair costs 8x the\nbandwidth, which lengthens MTTR, which REDUCES\ndurability. The two effects fight each other.",
   "originalText": "Rebuilding one lost 10 MB fragment means READING\n8 fragments - 80 MB. So EC repair costs 8x the\nbandwidth, which lengthens MTTR, which REDUCES\ndurability. The two effects fight each other.",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "k3",
   "type": "text",
   "x": 30,
   "y": 878,
   "width": 955,
   "height": 32,
   "strokeColor": "#1e40af",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100073,
   "version": 1,
   "versionNonce": 700511,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "So: 3x replication under 1 MB (8 seeks to read 500 KB is unaffordable against a 150-IOPS budget), EC 8+4 above it.\nSmall objects are 20% of the COUNT but under 1% of the BYTES - so replicating them costs a rounding error of capacity.",
   "originalText": "So: 3x replication under 1 MB (8 seeks to read 500 KB is unaffordable against a 150-IOPS budget), EC 8+4 above it.\nSmall objects are 20% of the COUNT but under 1% of the BYTES - so replicating them costs a rounding error of capacity.",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  }
 ],
