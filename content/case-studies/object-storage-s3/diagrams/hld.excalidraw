   "versionNonce": 700196,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "A split-brain cluster map lets two halves place the same UUID - divergence no later\nreconciliation can fix, because both are internally consistent. That is why consensus\nis spent on a component touched by every write.",
   "originalText": "A split-brain cluster map lets two halves place the same UUID - divergence no later\nreconciliation can fix, because both are internally consistent. That is why consensus\nis spent on a component touched by every write.",
   "fontSize": 12,
