  {
   "id": "goodl",
   "type": "text",
   "x": 30,
   "y": 594,
   "width": 307,
   "height": 17,
   "strokeColor": "#047857",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100042,
   "version": 1,
   "versionNonce": 700294,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "Costs disk. Cheap, and recoverable.",
   "originalText": "Costs disk. Cheap, and recoverable.",
   "fontSize": 14,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "badl",
   "type": "text",
   "x": 880,
   "y": 594,
   "width": 602,
   "height": 35,
   "strokeColor": "#b91c1c",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100043,
   "version": 1,
   "versionNonce": 700301,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "The user got a 200, sees the object listed, and gets a 500 or corrupt\ndata on read. Silent data loss reported as success. Unrecoverable.",
   "originalText": "The user got a 200, sees the object listed, and gets a 500 or corrupt\ndata on read. Silent data loss reported as success. Unrecoverable.",
   "fontSize": 14,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "orule",
   "type": "text",
   "x": 30,
   "y": 648,
   "width": 1097,
   "height": 35,
   "strokeColor": "#1e40af",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100044,
   "version": 1,
   "versionNonce": 700308,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "Garbage is cheap; dangling pointers are data loss. The same rule recurs one layer down - a data node fsyncs the packed file\nBEFORE recording the offset in its local index, so a crash there also leaves unreferenced bytes rather than a bad index entry.",
   "originalText": "Garbage is cheap; dangling pointers are data loss. The same rule recurs one layer down - a data node fsyncs the packed file\nBEFORE recording the offset in its local index, so a crash there also leaves unreferenced bytes rather than a bad index entry.",
   "fontSize": 14,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
