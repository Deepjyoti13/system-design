   "versionNonce": 700371,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "bucket_id and object_key are REDUNDANT here - they\nexist purely so this co-shards with objects, making\n'row + ordered part list' a single-shard two-table\nread rather than a cross-shard join.\n\nAn object's data is legitimately NON-CONTIGUOUS:\nmultipart assembly is a metadata stitch, not a copy.",
   "originalText": "bucket_id and object_key are REDUNDANT here - they\nexist purely so this co-shards with objects, making\n'row + ordered part list' a single-shard two-table\nread rather than a cross-shard join.\n\nAn object's data is legitimately NON-CONTIGUOUS:\nmultipart assembly is a metadata stitch, not a copy.",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
