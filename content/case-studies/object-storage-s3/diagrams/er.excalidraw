  {
   "id": "opn",
   "type": "text",
   "x": 470,
   "y": 560,
   "width": 390,
   "height": 105,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
