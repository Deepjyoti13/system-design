  {
   "id": "cl",
   "type": "text",
   "x": 30,
   "y": 798,
   "width": 436,
   "height": 21,
   "strokeColor": "#1e40af",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100089,
   "version": 1,
   "versionNonce": 700623,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "Only the pointer needs strong consistency",
   "originalText": "Only the pointer needs strong consistency",
   "fontSize": 17,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "cl2",
   "type": "text",
   "x": 30,
   "y": 826,
   "width": 1027,
   "height": 65,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100090,
   "version": 1,
   "versionNonce": 700630,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "objects (one row)   strong, read-after-write - but the shard key is derivable from (bucket, key), so no distributed transaction\nis_latest invariant  strong, single-shard, two rows in one partition - guaranteed by key column order, not by a commit protocol\nobject_listing       eventual, CDC-fed, seconds behind\nobject BYTES         written and confirmed durable BEFORE metadata commits, then immutable - so no consistency question arises",
   "originalText": "objects (one row)   strong, read-after-write - but the shard key is derivable from (bucket, key), so no distributed transaction\nis_latest invariant  strong, single-shard, two rows in one partition - guaranteed by key column order, not by a commit protocol\nobject_listing       eventual, CDC-fed, seconds behind\nobject BYTES         written and confirmed durable BEFORE metadata commits, then immutable - so no consistency question arises",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "cl3",
   "type": "text",
   "x": 30,
   "y": 916,
   "width": 1075,
   "height": 48,
   "strokeColor": "#1e40af",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100091,
   "version": 1,
   "versionNonce": 700637,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "S3 was eventually consistent for overwrites until 2020, and this schema shows why: strong read-after-write needs a key's reads routed\nto a replica holding its latest commit. That expensive guarantee is bought on a 0.7 TB store rather than a 100 PB one - three orders\nof magnitude cheaper, and the payoff of splitting name from bytes showing up somewhere non-obvious.",
   "originalText": "S3 was eventually consistent for overwrites until 2020, and this schema shows why: strong read-after-write needs a key's reads routed\nto a replica holding its latest commit. That expensive guarantee is bought on a 0.7 TB store rather than a 100 PB one - three orders\nof magnitude cheaper, and the payoff of splitting name from bytes showing up somewhere non-obvious.",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  }
