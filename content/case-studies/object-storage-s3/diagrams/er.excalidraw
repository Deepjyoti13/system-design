   "versionNonce": 700259,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "version_id is a TIMEUUID - unique AND sortable at once.\nIt is LAST in the key, so all versions of one object\nshare a partition: flipping is_latest is a single-shard,\ntwo-row transaction with no distributed commit.",
   "originalText": "version_id is a TIMEUUID - unique AND sortable at once.\nIt is LAST in the key, so all versions of one object\nshare a partition: flipping is_latest is a single-shard,\ntwo-row transaction with no distributed commit.",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
