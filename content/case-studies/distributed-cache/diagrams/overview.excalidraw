{"id": "evidence1", "type": "text", "x": 120, "y": 666, "text": "Four concurrent readers miss the same expiring key at the same instant.", "originalText": "Four concurrent readers miss the same expiring key at the same instant.", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#22c55e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "seed": 141, "width": 1360, "height": 18},
{"id": "evidence2", "type": "text", "x": 120, "y": 692, "text": "Without coalescing, every reader queries the database independently -- 4 queries for 1 key.", "originalText": "Without coalescing, every reader queries the database independently -- 4 queries for 1 key.", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#22c55e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "seed": 142, "width": 1360, "height": 18},
{"id": "evidence3", "type": "text", "x": 120, "y": 718, "text": "With a cluster-wide fetching marker, only the first reader queries the database -- the other 3 wait and share its result.", "originalText": "With a cluster-wide fetching marker, only the first reader queries the database -- the other 3 wait and share its result.", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#22c55e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "seed": 143, "width": 1360, "height": 18}
