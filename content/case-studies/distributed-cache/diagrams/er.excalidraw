{"id": "evidence1", "type": "text", "x": 170, "y": 446, "text": "No version vector, no tombstone: a key lives on exactly one node, so there's nothing to reconcile.", "originalText": "No version vector, no tombstone: a key lives on exactly one node, so there's nothing to reconcile.", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#22c55e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "seed": 81, "width": 1070, "height": 18},
{"id": "evidence2", "type": "text", "x": 170, "y": 472, "text": "A delete just removes the record outright -- there's no second replica around to \"resurrect\" it later.", "originalText": "A delete just removes the record outright -- there's no second replica around to \"resurrect\" it later.", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#22c55e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "seed": 82, "width": 1070, "height": 18}
