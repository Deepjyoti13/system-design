    { "type": "text", "id": "caption1", "x": 60, "y": 766, "width": 860, "height": 22,
      "text": "No application lock anywhere: Redis's single-threaded script execution IS the atomicity.",
      "originalText": "No application lock anywhere: Redis's single-threaded script execution IS the atomicity.",
      "fontSize": 14, "fontFamily": 3, "textAlign": "center", "verticalAlign": "top",
      "strokeColor": "#1e40af", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid",
      "roughness": 0, "opacity": 100, "angle": 0, "seed": 5091, "version": 1, "versionNonce": 6091, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false, "lineHeight": 1.25 },
    { "type": "text", "id": "caption2", "x": 60, "y": 790, "width": 860, "height": 22,
      "text": "Two concurrent calls can never both observe remaining > 0 and both decrement past zero.",
      "originalText": "Two concurrent calls can never both observe remaining > 0 and both decrement past zero.",
      "fontSize": 14, "fontFamily": 3, "textAlign": "center", "verticalAlign": "top",
      "strokeColor": "#1e40af", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid",
      "roughness": 0, "opacity": 100, "angle": 0, "seed": 5092, "version": 1, "versionNonce": 6092, "isDeleted": false,
