    { "type": "text", "id": "ev_header", "x": 165, "y": 344, "width": 670, "height": 20,
      "text": "Redis: tryClaim() -- the entire script runs as ONE atomic unit", "originalText": "Redis: tryClaim() -- the entire script runs as ONE atomic unit",
      "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#93c5fd", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid",
      "roughness": 0, "opacity": 100, "angle": 0, "seed": 5051, "version": 1, "versionNonce": 6051, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false, "lineHeight": 1.25 },
    { "type": "text", "id": "ev_1", "x": 165, "y": 372, "width": 670, "height": 18,
      "text": "local remaining = tonumber(redis.call('GET', KEYS[1]))", "originalText": "local remaining = tonumber(redis.call('GET', KEYS[1]))",
      "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#22c55e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid",
      "roughness": 0, "opacity": 100, "angle": 0, "seed": 5052, "version": 1, "versionNonce": 6052, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false, "lineHeight": 1.25 },
    { "type": "text", "id": "ev_2", "x": 165, "y": 393, "width": 670, "height": 18,
      "text": "if remaining > 0 then", "originalText": "if remaining > 0 then",
      "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#22c55e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid",
      "roughness": 0, "opacity": 100, "angle": 0, "seed": 5053, "version": 1, "versionNonce": 6053, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false, "lineHeight": 1.25 },
    { "type": "text", "id": "ev_3", "x": 195, "y": 414, "width": 670, "height": 18,
      "text": "redis.call('DECR', KEYS[1])", "originalText": "redis.call('DECR', KEYS[1])",
      "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#22c55e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid",
      "roughness": 0, "opacity": 100, "angle": 0, "seed": 5054, "version": 1, "versionNonce": 6054, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false, "lineHeight": 1.25 },
    { "type": "text", "id": "ev_4", "x": 195, "y": 435, "width": 670, "height": 18,
      "text": "return 1   -- claimed", "originalText": "return 1   -- claimed",
      "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#22c55e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid",
      "roughness": 0, "opacity": 100, "angle": 0, "seed": 5055, "version": 1, "versionNonce": 6055, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false, "lineHeight": 1.25 },
    { "type": "text", "id": "ev_5", "x": 165, "y": 456, "width": 670, "height": 18,
      "text": "else", "originalText": "else",
      "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#22c55e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid",
      "roughness": 0, "opacity": 100, "angle": 0, "seed": 5056, "version": 1, "versionNonce": 6056, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false, "lineHeight": 1.25 },
    { "type": "text", "id": "ev_6", "x": 195, "y": 477, "width": 670, "height": 18,
