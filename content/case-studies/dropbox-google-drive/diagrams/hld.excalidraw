red", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#6741d9", "backgroundColor": "transparent", "opacity": 100, "seed": 30840}, {"id": "deduplabel_l1", "type": "text", "x": 210, "y": 588, "width": 201.6, "height": 18.2, "text": "chunk, not a second copy", "originalText": "chunk, not a second copy", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#6741d9", "backgroundColor": "transparent", "opacity": 100, "seed": 86744}, {"id": "evidence", "type": "rectangle", "x": 40, "y": 690, "width": 900, "height": 110, "strokeColor": "#1e2126", "backgroundColor": "#1e2126", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "seed": 34238, "roundness": {"type": 3}}, {"id": "ev1", "type": "text", "x": 60, "y": 706, "width": 729.0, "height": 19.5, "text": "Only C3 gets re-uploaded and pushed to other devices -- C1, C2, C4 are untouched.", "originalText": "Only C3 gets re-uploaded and pushed to other devices -- C1, C2, C4 are untouched.", "fontSize": 15, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#51cf66", "backgroundColor": "transparent", "opacity": 100, "seed": 1065}, {"id": "ev2", "type": "text", "x": 60, "y": 732, "width": 891.0, "height": 19.5, "text": "File B's C1' hashes the same as File A's C1, so the storage layer keeps ONE copy, referenced twice.", "originalText": "File B's C1' hashes the same as File A's C1, so the storage layer keeps ONE copy, referenced twice.", "fontSize": 15, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#51cf66", "backgroundColor": "transparent", "opacity": 100, "seed": 32481}, {"id": "ev3", "type": "text", "x": 60, "y": 758, "width": 1035.0, "height": 19.5, "text": "The metadata service tracks each file's chunk-hash list; the chunk store never knows which files reference a chunk.", "originalText": "The metadata service tracks each file's chunk-hash list; the chunk store never knows which files reference a chunk.", "fontSize": 15, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#8a97a6", "backgroundColor": "transparent", "opacity": 100, "seed": 92652}], "appState": {"viewBackgroundColor": "#ffffff"}}