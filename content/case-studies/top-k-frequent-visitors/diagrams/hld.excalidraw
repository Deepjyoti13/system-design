    { "type": "text", "id": "evidence_1", "x": 280, "y": 748, "width": 860, "height": 20,
      "text": "If the Merge Coordinator summed sketches before every partition finished,",
      "originalText": "If the Merge Coordinator summed sketches before every partition finished,",
      "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#f87171", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 41003, "version": 1, "versionNonce": 51003, "isDeleted": false, "groupIds": [],
      "boundElements": null, "link": null, "locked": false, "lineHeight": 1.25 },
    { "type": "text", "id": "evidence_2", "x": 280, "y": 772, "width": 860, "height": 20,
      "text": "the merge would run against an incomplete sketch -- a silently wrong top-K.",
      "originalText": "the merge would run against an incomplete sketch -- a silently wrong top-K.",
      "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
