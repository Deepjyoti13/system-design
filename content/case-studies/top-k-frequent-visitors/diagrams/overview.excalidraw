    { "type": "text", "id": "final_caption_1", "x": 100, "y": 930, "width": 700, "height": 20, "text": "d x w counters, total -- never one per visitor.", "originalText": "d x w counters, total -- never one per visitor.", "fontSize": 14, "fontFamily": 3, "textAlign": "center", "verticalAlign": "top", "strokeColor": "#1e40af", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 10510, "version": 1, "versionNonce": 20510, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "lineHeight": 1.25 },
    { "type": "text", "id": "final_caption_2", "x": 100, "y": 950, "width": 700, "height": 20, "text": "The minimum cancels collision noise; the heap keeps only the K biggest seen so far.", "originalText": "The minimum cancels collision noise; the heap keeps only the K biggest seen so far.", "fontSize": 14, "fontFamily": 3, "textAlign": "center", "verticalAlign": "top", "strokeColor": "#1e40af", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 10511, "version": 1, "versionNonce": 20511, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "lineHeight": 1.25 }
