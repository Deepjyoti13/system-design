   "link": null,
   "locked": false,
   "text": "a subscriber that receives 10,041 after\n10,039 knows 10,040 is missing - at once,\nwith no round trip to ask.",
   "originalText": "a subscriber that receives 10,041 after\n10,039 knows 10,040 is missing - at once,\nwith no round trip to ask.",
