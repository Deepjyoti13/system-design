  },
  {
   "id": "ring",
   "type": "rectangle",
   "x": 30,
   "y": 1000,
   "width": 700,
   "height": 90,
   "strokeColor": "#1e293b",
   "backgroundColor": "#1e293b",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
