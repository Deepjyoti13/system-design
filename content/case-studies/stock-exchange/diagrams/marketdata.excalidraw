   "versionNonce": 700042,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "for s in subscribers:          # 300 iterations\n    socket[s].write(update)    # 1-5 us of syscall + kernel work EACH",
