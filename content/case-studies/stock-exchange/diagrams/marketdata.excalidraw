   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "The publisher takes 215,000 executions/sec and must not allocate",
   "originalText": "The publisher takes 215,000 executions/sec and must not allocate",
   "fontSize": 17,
   "fontFamily": 3,
   "textAlign": "left",
