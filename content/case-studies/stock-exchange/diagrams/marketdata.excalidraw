   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "subscribers report only what is MISSING.\nAcking every message from 300 subscribers\nis 300x the reverse traffic - and a\nper-subscriber loop all over again.",
   "originalText": "subscribers report only what is MISSING.\nAcking every message from 300 subscribers\nis 300x the reverse traffic - and a\nper-subscriber loop all over again.",
