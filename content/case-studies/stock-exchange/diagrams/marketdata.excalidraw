     "id": "ring_t",
     "type": "text"
    }
   ],
   "link": null,
   "locked": false,
   "roundness": {
    "type": 3
   }
  },
  {
   "id": "ring_t",
   "type": "text",
   "x": 38,
   "y": 1015,
   "width": 684,
   "height": 60,
   "strokeColor": "#ffffff",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100080,
   "version": 1,
   "versionNonce": 700560,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "class CandlestickChart:\n    sticks: Candlestick[N]   # PRE-ALLOCATED, fixed size\n    head: int                # newest; release-store\n    tail: int                # oldest; overwritten on wrap",
   "originalText": "class CandlestickChart:\n    sticks: Candlestick[N]   # PRE-ALLOCATED, fixed size\n    head: int                # newest; release-store\n    tail: int                # oldest; overwritten on wrap",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "ring",
   "lineHeight": 1.25
  },
  {
   "id": "en",
   "type": "text",
   "x": 770,
   "y": 1000,
   "width": 643,
   "height": 90,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100081,
   "version": 1,
   "versionNonce": 700567,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "no allocation at runtime    a malloc in a 215k/sec path is an unbounded-latency\n                            event and a GC trigger - the same discipline as the engine\nbounded memory              the ring overwrites the oldest entry; older candles were\n                            already persisted off-path by the reporter\nlock-free, 1 writer / N readers   readers acquire-load head and read up to head - 1,\n                            so a torn view of the newest entry is never observed",
   "originalText": "no allocation at runtime    a malloc in a 215k/sec path is an unbounded-latency\n                            event and a GC trigger - the same discipline as the engine\nbounded memory              the ring overwrites the oldest entry; older candles were\n                            already persisted off-path by the reporter\nlock-free, 1 writer / N readers   readers acquire-load head and read up to head - 1,\n                            so a torn view of the newest entry is never observed",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "efs",
   "type": "text",
   "x": 30,
   "y": 1106,
   "width": 1019,
   "height": 48,
   "strokeColor": "#b45309",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100082,
   "version": 1,
   "versionNonce": 700574,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "And the classic: pad head and tail onto SEPARATE CACHE LINES. Sharing a 64-byte line means the writer's store to head\ninvalidates that line in every reader's cache - FALSE SHARING - costing up to an order of magnitude in throughput even though\nthe two variables are logically independent. A one-line fix for a bug that is invisible in the code and obvious in a profiler.",
   "originalText": "And the classic: pad head and tail onto SEPARATE CACHE LINES. Sharing a 64-byte line means the writer's store to head\ninvalidates that line in every reader's cache - FALSE SHARING - costing up to an order of magnitude in throughput even though\nthe two variables are logically independent. A one-line fix for a bug that is invisible in the code and obvious in a profiler.",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
