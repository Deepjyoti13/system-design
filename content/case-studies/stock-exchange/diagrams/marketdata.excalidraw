   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "Multicast means UDP - and a dropped update leaves a subscriber with a WRONG book, not a slow one",
   "originalText": "Multicast means UDP - and a dropped update leaves a subscriber with a WRONG book, not a slow one",
   "fontSize": 17,
