   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "MSFT   415.00 -> [#1: 500] [#2: 300] [#3: 400]\n                  ^ FIFO queue position, VISIBLE",
   "originalText": "MSFT   415.00 -> [#1: 500] [#2: 300] [#3: 400]\n                  ^ FIFO queue position, VISIBLE",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "l3",
   "lineHeight": 1.25
  },
  {
   "id": "l3n",
   "type": "text",
   "x": 1120,
   "y": 802,
   "width": 316,
   "height": 90,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100075,
   "version": 1,
   "versionNonce": 700525,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "Exposes the queue position that price-time\npriority depends on, so a participant can\nsee where they stand. Highest bandwidth by\na wide margin - and where iceberg orders\nget awkward, since hidden quantity must\nnot appear.",
   "originalText": "Exposes the queue position that price-time\npriority depends on, so a participant can\nsee where they stand. Highest bandwidth by\na wide margin - and where iceberg orders\nget awkward, since hidden quantity must\nnot appear.",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "dn",
   "type": "text",
   "x": 30,
   "y": 892,
   "width": 971,
   "height": 32,
   "strokeColor": "#1e40af",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100076,
   "version": 1,
   "versionNonce": 700532,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "Candlesticks are DERIVED, not published from the book: the publisher builds them from the EXECUTION stream, because only\nactual trades count, not quotes. Many intervals (1s, 1m, 5m, 1h, 1d) are maintained in parallel from that one stream.",
   "originalText": "Candlesticks are DERIVED, not published from the book: the publisher builds them from the EXECUTION stream, because only\nactual trades count, not quotes. Many intervals (1s, 1m, 5m, 1h, 1d) are maintained in parallel from that one stream.",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "d4",
