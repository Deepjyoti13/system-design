   "versionNonce": 700007,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "A for-loop over 300 sockets is a machine for transferring money to whoever is first",
   "originalText": "A for-loop over 300 sockets is a machine for transferring money to whoever is first",
   "fontSize": 22,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "s",
   "type": "text",
   "x": 30,
   "y": 52,
   "width": 1071,
   "height": 17,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100002,
   "version": 1,
   "versionNonce": 700014,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "Which is why 'every subscriber receives the update at the same instant' is a technical constraint, not an ethics statement.",
   "originalText": "Which is why 'every subscriber receives the update at the same instant' is a technical constraint, not an ethics statement.",
   "fontSize": 14,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
