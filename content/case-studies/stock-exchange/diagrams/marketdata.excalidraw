   "text": "tens of NANOSECONDS. Physics, not software.",
   "originalText": "tens of NANOSECONDS. Physics, not software.",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
