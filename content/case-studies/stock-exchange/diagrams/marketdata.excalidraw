  {
   "id": "an",
   "type": "text",
   "x": 30,
   "y": 274,
   "width": 664,
   "height": 81,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100023,
   "version": 1,
   "versionNonce": 700161,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "Subscriber 1 knows the new price while subscriber 300 is still acting on a stale\nview - so subscriber 1 can trade against subscriber 300's resting orders at prices\nthat are no longer correct, and profit systematically from POSITION IN A LOOP.\nAn implementation detail nobody agreed to, and in most jurisdictions the VENUE's\nproblem rather than the participant's.",
   "originalText": "Subscriber 1 knows the new price while subscriber 300 is still acting on a stale\nview - so subscriber 1 can trade against subscriber 300's resting orders at prices\nthat are no longer correct, and profit systematically from POSITION IN A LOOP.\nAn implementation detail nobody agreed to, and in most jurisdictions the VENUE's\nproblem rather than the participant's.",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
