   "versionNonce": 700497,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "Each level's totalVolume, maintained\nincrementally - so it is O(depth), not\nO(orders). Shows the SHAPE of liquidity:\nhow far a large order moves the price.",
   "originalText": "Each level's totalVolume, maintained\nincrementally - so it is O(depth), not\nO(orders). Shows the SHAPE of liquidity:\nhow far a large order moves the price.",
