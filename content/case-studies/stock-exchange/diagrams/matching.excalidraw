  {
   "id": "an",
   "type": "text",
   "x": 30,
   "y": 522,
   "width": 955,
   "height": 32,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100046,
   "version": 1,
   "versionNonce": 700322,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "The price level, then a FIFO queue within it, IS price-time priority - encoded as the SHAPE of the data rather than as\ncomparator logic, so a bug cannot violate the fairness rule.",
   "originalText": "The price level, then a FIFO queue within it, IS price-time priority - encoded as the SHAPE of the data rather than as\ncomparator logic, so a bug cannot violate the fairness rule.",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "bl",
