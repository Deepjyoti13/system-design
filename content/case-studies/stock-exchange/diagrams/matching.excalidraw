   }
  },
  {
   "id": "obj_t",
   "type": "text",
   "x": 908,
   "y": 247,
   "width": 444,
   "height": 45,
   "strokeColor": "#374151",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100052,
   "version": 1,
   "versionNonce": 700364,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "Order { id, price, qty, filledQty,\n        prev, next,          <- INTRUSIVE links\n        parentLevel }",
   "originalText": "Order { id, price, qty, filledQty,\n        prev, next,          <- INTRUSIVE links\n        parentLevel }",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "obj",
   "lineHeight": 1.25
  },
  {
   "id": "bn",
   "type": "text",
   "x": 900,
   "y": 328,
   "width": 544,
   "height": 130,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100053,
   "version": 1,
   "versionNonce": 700371,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "Given an id you get the object; the object holds prev/next, so\nunlinking it from its FIFO queue is a constant-time pointer update.\nNO SEARCH OF ANY KIND. This is the heap's fatal flaw solved.\n\nIntrusive means links live INSIDE Order - one allocation, and the\ndata plus its links share a cache line. Doubly-linked means\nunlinking needs no predecessor search; singly-linked would make\ncancel O(n) again, which is exactly the mistake to avoid.",
   "originalText": "Given an id you get the object; the object holds prev/next, so\nunlinking it from its FIFO queue is a constant-time pointer update.\nNO SEARCH OF ANY KIND. This is the heap's fatal flaw solved.\n\nIntrusive means links live INSIDE Order - one allocation, and the\ndata plus its links share a cache line. Doubly-linked means\nunlinking needs no predecessor search; singly-linked would make\ncancel O(n) again, which is exactly the mistake to avoid.",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
