   }
  },
  {
   "id": "rec_t",
   "type": "text",
   "x": 38,
   "y": 448,
   "width": 684,
   "height": 192,
   "strokeColor": "#ffffff",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100035,
   "version": 1,
   "versionNonce": 700245,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "struct SequencedEvent {            // fixed 64 bytes = ONE cache line\n    uint64  sequence;              // monotonic, from the sequencer\n    uint32  epoch;                 // leadership epoch (fencing)\n    uint8   eventType;             // NEW_ORDER | CANCEL | FILL | HALT\n    uint8   side;\n    uint16  symbolId;              // interned integer, never a string\n    uint64  orderId;\n    uint64  clientId;\n    int64   price;                 // INTEGER: 41500 == $415.00\n    int64   quantity;\n    int64   filledQuantity;\n    uint64  gatewayTimestampNanos; // stamped ONCE, at the gateway\n    uint64  matchedOrderId;        // fills only\n}",
   "originalText": "struct SequencedEvent {            // fixed 64 bytes = ONE cache line\n    uint64  sequence;              // monotonic, from the sequencer\n    uint32  epoch;                 // leadership epoch (fencing)\n    uint8   eventType;             // NEW_ORDER | CANCEL | FILL | HALT\n    uint8   side;\n    uint16  symbolId;              // interned integer, never a string\n    uint64  orderId;\n    uint64  clientId;\n    int64   price;                 // INTEGER: 41500 == $415.00\n    int64   quantity;\n    int64   filledQuantity;\n    uint64  gatewayTimestampNanos; // stamped ONCE, at the gateway\n    uint64  matchedOrderId;        // fills only\n}",
   "fontSize": 11,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "rec",
   "lineHeight": 1.25
  },
