   }
  },
  {
   "id": "mds_t",
   "type": "text",
   "x": 1398,
   "y": 885,
   "width": 284,
   "height": 96,
   "strokeColor": "#ffffff",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100151,
   "version": 1,
   "versionNonce": 701057,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "in-memory columnar (KDB+):\n  book snapshots at intervals\n  candles 1s/1m/5m/1h/1d\n  tick-by-tick executions\n\nafter close -> Parquet in\nobject storage",
   "originalText": "in-memory columnar (KDB+):\n  book snapshots at intervals\n  candles 1s/1m/5m/1h/1d\n  tick-by-tick executions\n\nafter close -> Parquet in\nobject storage",
   "fontSize": 11,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "mds",
   "lineHeight": 1.25
  },
  {
   "id": "mdn",
   "type": "text",
   "x": 1390,
   "y": 1010,
   "width": 263,
   "height": 220,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100152,
   "version": 1,
   "versionNonce": 701064,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "Columnar because every query is an\naggregate over one or two columns\nacross a huge row count - 'average\nprice of MSFT, 10:00 to 10:05'. It\nreads only the columns involved,\ndelta-encodes near-identical prices,\nand vectorizes the aggregation. A row\nstore reads every field of every row\nto sum one column.\n\nIn memory during the session because\nintraday queries are latency-sensitive\nand one day of 100 symbols fits in\nRAM. After close it is cold - and cold\ncolumnar data belongs in object\nstorage.",
   "originalText": "Columnar because every query is an\naggregate over one or two columns\nacross a huge row count - 'average\nprice of MSFT, 10:00 to 10:05'. It\nreads only the columns involved,\ndelta-encodes near-identical prices,\nand vectorizes the aggregation. A row\nstore reads every field of every row\nto sum one column.\n\nIn memory during the session because\nintraday queries are latency-sensitive\nand one day of 100 symbols fits in\nRAM. After close it is cold - and cold\ncolumnar data belongs in object\nstorage.",
   "fontSize": 11,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
