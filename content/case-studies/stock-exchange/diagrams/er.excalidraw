  {
   "id": "an",
   "type": "text",
   "x": 30,
   "y": 300,
   "width": 1003,
   "height": 48,
   "strokeColor": "#1e40af",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100031,
   "version": 1,
   "versionNonce": 700217,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "The structural claim: the EVENT STREAM is the source of truth and the relational store is a PROJECTION of it - the same CQRS\nshape as the digital wallet, arrived at from a latency requirement rather than an audit one. And the order book, the thing\neveryone calls 'the data', is deliberately NOT durable, because it is derivable.",
   "originalText": "The structural claim: the EVENT STREAM is the source of truth and the relational store is a PROJECTION of it - the same CQRS\nshape as the digital wallet, arrived at from a latency requirement rather than an audit one. And the order book, the thing\neveryone calls 'the data', is deliberately NOT durable, because it is derivable.",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
