  {
   "id": "bl",
   "type": "text",
   "x": 30,
   "y": 398,
   "width": 899,
   "height": 21,
   "strokeColor": "#1e40af",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
