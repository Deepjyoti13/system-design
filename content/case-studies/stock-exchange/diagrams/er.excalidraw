  {
   "id": "wyn0",
   "type": "text",
   "x": 56,
   "y": 1364,
   "width": 245,
   "height": 16,
   "strokeColor": "#1e40af",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
