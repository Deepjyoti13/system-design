  {
   "id": "ofn",
   "type": "text",
   "x": 770,
   "y": 508,
   "width": 695,
   "height": 30,
   "strokeColor": "#047857",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100048,
   "version": 1,
   "versionNonce": 700336,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "The record at sequence N lives at byte offset N x 64, so random access by sequence is POINTER\nARITHMETIC - no index, no parse, nothing to look up.",
   "originalText": "The record at sequence N lives at byte offset N x 64, so random access by sequence is POINTER\nARITHMETIC - no index, no parse, nothing to look up.",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "dc0",
   "type": "ellipse",
   "x": 770,
   "y": 556,
   "width": 12,
   "height": 12,
   "strokeColor": "#1e40af",
   "backgroundColor": "#1e40af",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100049,
   "version": 1,
   "versionNonce": 700343,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false
  },
  {
   "id": "dcn0",
   "type": "text",
   "x": 796,
   "y": 556,
   "width": 213,
   "height": 16,
   "strokeColor": "#1e40af",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100050,
   "version": 1,
   "versionNonce": 700350,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "fixed size, one cache line",
   "originalText": "fixed size, one cache line",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "dcd0",
   "type": "text",
   "x": 796,
   "y": 578,
   "width": 681,
   "height": 30,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100051,
   "version": 1,
   "versionNonce": 700357,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "one cache line means reading a record is ONE memory fetch, not two. A variable-length\nformat (protobuf, JSON) would need an offset index AND a parse step - both on the hot path.",
   "originalText": "one cache line means reading a record is ONE memory fetch, not two. A variable-length\nformat (protobuf, JSON) would need an offset index AND a parse step - both on the hot path.",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "dc1",
   "type": "ellipse",
   "x": 770,
   "y": 614,
   "width": 12,
   "height": 12,
   "strokeColor": "#1e40af",
   "backgroundColor": "#1e40af",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100052,
   "version": 1,
   "versionNonce": 700364,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false
  },
  {
   "id": "dcn1",
   "type": "text",
   "x": 796,
   "y": 614,
   "width": 278,
   "height": 16,
   "strokeColor": "#1e40af",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100053,
   "version": 1,
   "versionNonce": 700371,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "symbolId is a uint16, not a string",
   "originalText": "symbolId is a uint16, not a string",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "dcd1",
   "type": "text",
   "x": 796,
   "y": 636,
   "width": 673,
   "height": 30,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100054,
   "version": 1,
   "versionNonce": 700378,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "symbols are interned once at startup. Comparing and hashing a 2-byte integer is free;\ncomparing 'MSFT' is a length check plus a memcmp, and storing it blows the 64-byte budget.",
   "originalText": "symbols are interned once at startup. Comparing and hashing a 2-byte integer is free;\ncomparing 'MSFT' is a length check plus a memcmp, and storing it blows the 64-byte budget.",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "dc2",
   "type": "ellipse",
   "x": 770,
   "y": 672,
   "width": 12,
   "height": 12,
   "strokeColor": "#1e40af",
   "backgroundColor": "#1e40af",
   "fillStyle": "solid",
