   "versionNonce": 701092,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "partitioning by date is native",
   "originalText": "partitioning by date is native",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "wyd0",
   "type": "text",
   "x": 56,
   "y": 1390,
   "width": 495,
   "height": 45,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100157,
   "version": 1,
   "versionNonce": 701099,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "a day's data is one partition, so dropping data past its retention\nwindow is a DROP PARTITION - O(1) - not a DELETE of hundreds of\nmillions of rows.",
   "originalText": "a day's data is one partition, so dropping data past its retention\nwindow is a DROP PARTITION - O(1) - not a DELETE of hundreds of\nmillions of rows.",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "wy1",
   "type": "ellipse",
   "x": 590,
   "y": 1368,
   "width": 12,
   "height": 12,
   "strokeColor": "#1e40af",
   "backgroundColor": "#1e40af",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100158,
   "version": 1,
   "versionNonce": 701106,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false
  },
  {
   "id": "wyn1",
   "type": "text",
   "x": 616,
   "y": 1364,
   "width": 326,
   "height": 16,
   "strokeColor": "#1e40af",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100159,
   "version": 1,
   "versionNonce": 701113,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "every real query prunes to one partition",
   "originalText": "every real query prunes to one partition",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "wyd1",
   "type": "text",
   "x": 616,
   "y": 1390,
   "width": 517,
   "height": 45,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100160,
   "version": 1,
   "versionNonce": 701120,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "1B orders/day x 7 years is ~2.5 TRILLION rows. Without a date-leading\nkey, 'this client's orders today' scans an index spanning all of\nhistory.",
   "originalText": "1B orders/day x 7 years is ~2.5 TRILLION rows. Without a date-leading\nkey, 'this client's orders today' scans an index spanning all of\nhistory.",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "wy2",
   "type": "ellipse",
   "x": 1150,
   "y": 1368,
   "width": 12,
   "height": 12,
   "strokeColor": "#1e40af",
   "backgroundColor": "#1e40af",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100161,
   "version": 1,
   "versionNonce": 701127,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false
  },
  {
   "id": "wyn2",
   "type": "text",
   "x": 1176,
   "y": 1364,
   "width": 205,
   "height": 16,
   "strokeColor": "#1e40af",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100162,
   "version": 1,
   "versionNonce": 701134,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "inserts are append-mostly",
   "originalText": "inserts are append-mostly",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "wyd2",
   "type": "text",
   "x": 1176,
   "y": 1390,
   "width": 509,
   "height": 30,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100163,
   "version": 1,
   "versionNonce": 701141,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "all of today's inserts land at the tail of one partition's index, so\nthere are no page splits across historical data.",
   "originalText": "all of today's inserts land at the tail of one partition's index, so\nthere are no page splits across historical data.",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "dn",
   "type": "text",
   "x": 30,
   "y": 1462,
   "width": 1019,
   "height": 81,
   "strokeColor": "#1e40af",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100164,
   "version": 1,
   "versionNonce": 701148,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "This is the ONE place in this guide where time-based partitioning is right - the URL shortener, object storage and the message\nqueue all call it a write-hotspot mistake. The difference is the READ TAIL: there, a five-year-old short link is read as often\nas a new one; here, yesterday's orders are essentially never read on the hot path. A write hotspot on the newest partition is\nONLY A PROBLEM IF THE OLD PARTITIONS WERE DOING USEFUL WORK. Being able to say why the usual advice inverts beats either\nfollowing it or ignoring it.",
   "originalText": "This is the ONE place in this guide where time-based partitioning is right - the URL shortener, object storage and the message\nqueue all call it a write-hotspot mistake. The difference is the READ TAIL: there, a five-year-old short link is read as often\nas a new one; here, yesterday's orders are essentially never read on the hot path. A write hotspot on the newest partition is\nONLY A PROBLEM IF THE OLD PARTITIONS WERE DOING USEFUL WORK. Being able to say why the usual advice inverts beats either\nfollowing it or ignoring it.",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
