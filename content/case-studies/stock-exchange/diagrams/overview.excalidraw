  {
   "id": "rel",
   "type": "text",
   "x": 1130,
   "y": 822,
   "width": 390,
   "height": 65,
   "strokeColor": "#047857",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100076,
   "version": 1,
   "versionNonce": 700532,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "Not a large number - the message queue in this\nguide handles twice that PER NODE. Nobody needs\nto shard for capacity, and volume splits cleanly\nacross 100 independent symbol books.",
   "originalText": "Not a large number - the message queue in this\nguide handles twice that PER NODE. Nobody needs\nto shard for capacity, and volume splits cleanly\nacross 100 independent symbol books.",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "rel2",
   "type": "text",
   "x": 30,
   "y": 900,
   "width": 1071,
   "height": 17,
   "strokeColor": "#1e40af",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100077,
   "version": 1,
   "versionNonce": 700539,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "So: this is not a throughput design, it is a LATENCY design - and that reframe is the most useful thing to establish early.",
   "originalText": "So: this is not a throughput design, it is a LATENCY design - and that reframe is the most useful thing to establish early.",
   "fontSize": 14,
