  {
   "id": "prd_1130",
   "type": "text",
   "x": 1156,
   "y": 646,
   "width": 346,
   "height": 75,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
