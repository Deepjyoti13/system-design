   "versionNonce": 700462,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "a LATENCY property in disguise: if two\nsubscribers get the same update at measurably\ndifferent times, the earlier one can trade\nagainst the later one's stale view.",
   "originalText": "a LATENCY property in disguise: if two\nsubscribers get the same update at measurably\ndifferent times, the earlier one can trade\nagainst the later one's stale view.",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
