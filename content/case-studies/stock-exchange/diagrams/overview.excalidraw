   "versionNonce": 700406,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "Read down that column and the architecture writes itself. ONE same-rack hop\nconsumes the entire budget; a same-datacentre hop exceeds it by an order of\nmagnitude. So anything involving a network or a disk is excluded from the\ncritical path - not as an optimization, but because a single instance of it\nexceeds the whole envelope. What survives: memory, and shared memory.",
   "originalText": "Read down that column and the architecture writes itself. ONE same-rack hop\nconsumes the entire budget; a same-datacentre hop exceeds it by an order of\nmagnitude. So anything involving a network or a disk is excluded from the\ncritical path - not as an optimization, but because a single instance of it\nexceeds the whole envelope. What survives: memory, and shared memory.",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
