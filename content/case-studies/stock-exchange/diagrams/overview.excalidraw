   "versionNonce": 700483,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "two parties whose orders crossed must agree,\nafterwards and forever, on exactly what\nhappened and in what order - and after a crash\nthe exchange must reconstruct the IDENTICAL\nsequence, not an equivalent one.",
   "originalText": "two parties whose orders crossed must agree,\nafterwards and forever, on exactly what\nhappened and in what order - and after a crash\nthe exchange must reconstruct the IDENTICAL\nsequence, not an equivalent one.",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "cn",
   "type": "text",
   "x": 30,
   "y": 740,
   "width": 995,
   "height": 32,
   "strokeColor": "#b91c1c",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100070,
   "version": 1,
   "versionNonce": 700490,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "Fairness is not a nicety - with unicast to 300 subscribers, whoever is early in your iteration order can extract money from\nwhoever is late, based on an implementation detail nobody agreed to. In most jurisdictions that is the VENUE's problem.",
   "originalText": "Fairness is not a nicety - with unicast to 300 subscribers, whoever is early in your iteration order can extract money from\nwhoever is late, based on an implementation detail nobody agreed to. In most jurisdictions that is the VENUE's problem.",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
