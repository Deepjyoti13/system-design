  {
   "id": "bn",
   "type": "text",
   "x": 830,
   "y": 470,
   "width": 608,
   "height": 81,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
