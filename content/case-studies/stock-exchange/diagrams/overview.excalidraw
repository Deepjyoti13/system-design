   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "a trading strategy's profitability is a\nfunction of how fast it can react. A 100us\nimprovement is worth money.",
   "originalText": "a trading strategy's profitability is a\nfunction of how fast it can react. A 100us\nimprovement is worth money.",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
