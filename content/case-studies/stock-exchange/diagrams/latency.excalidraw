   "versionNonce": 700189,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "The sequencer does almost nothing - and solves three requirements at once",
   "originalText": "The sequencer does almost nothing - and solves three requirements at once",
   "fontSize": 17,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "j_30",
   "type": "ellipse",
   "x": 30,
   "y": 608,
   "width": 12,
   "height": 12,
   "strokeColor": "#047857",
   "backgroundColor": "#047857",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
