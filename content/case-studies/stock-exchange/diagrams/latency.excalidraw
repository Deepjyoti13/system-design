  },
  {
   "id": "en",
   "type": "text",
   "x": 30,
   "y": 1116,
   "width": 971,
   "height": 81,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100047,
   "version": 1,
   "versionNonce": 700329,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "recovery without a database   load a snapshot, replay the sequence. The ONLY reason it is acceptable for the hot path to\n                              touch no disk - persistence is replaced by REPLAYABILITY.\nhot standby in lockstep       a standby consuming the same stream reaches byte-identical state, so promotion is instant\ndispute resolution            replay to sequence N and observe exactly what the engine saw and did. A legal requirement.\ntesting against production    replay a real trading day through a new build and diff the outputs.",
   "originalText": "recovery without a database   load a snapshot, replay the sequence. The ONLY reason it is acceptable for the hot path to\n                              touch no disk - persistence is replaced by REPLAYABILITY.\nhot standby in lockstep       a standby consuming the same stream reaches byte-identical state, so promotion is instant\ndispute resolution            replay to sequence N and observe exactly what the engine saw and did. A legal requirement.\ntesting against production    replay a real trading day through a new build and diff the outputs.",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  }
