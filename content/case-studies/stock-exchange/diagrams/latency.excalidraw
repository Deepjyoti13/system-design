  },
  {
   "id": "loop",
   "type": "rectangle",
   "x": 30,
   "y": 146,
   "width": 620,
   "height": 150,
   "strokeColor": "#1e293b",
   "backgroundColor": "#1e293b",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100005,
   "version": 1,
   "versionNonce": 700035,
   "isDeleted": false,
   "groupIds": [],
