  },
  {
   "id": "fd_t",
   "type": "text",
   "x": 38,
   "y": 885,
   "width": 764,
   "height": 32,
   "strokeColor": "#374151",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100041,
