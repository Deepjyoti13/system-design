  },
  {
   "id": "dl",
   "type": "text",
   "x": 30,
   "y": 830,
   "width": 636,
   "height": 21,
   "strokeColor": "#1e40af",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100039,
   "version": 1,
   "versionNonce": 700273,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "Two kinds of determinism - and interviewers probe the second",
   "originalText": "Two kinds of determinism - and interviewers probe the second",
   "fontSize": 17,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
