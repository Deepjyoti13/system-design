  {
   "id": "bn",
   "type": "text",
   "x": 750,
   "y": 404,
   "width": 656,
   "height": 97,
   "strokeColor": "#b91c1c",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100025,
   "version": 1,
   "versionNonce": 700175,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "GC deserves separate emphasis, because it cannot be worked around by discipline\nalone. A 1 ms pause is 33x the ENTIRE budget, and it arrives unpredictably,\nlanding on whichever unlucky order was being processed. So the consequences are\narchitectural, not stylistic: C++/Rust, OR a managed language in a strictly\nallocation-free style (essentially writing C in that syntax), OR a collector with\nhard pause guarantees. It is a language-selection decision, not a test criterion.",
   "originalText": "GC deserves separate emphasis, because it cannot be worked around by discipline\nalone. A 1 ms pause is 33x the ENTIRE budget, and it arrives unpredictably,\nlanding on whichever unlucky order was being processed. So the consequences are\narchitectural, not stylistic: C++/Rust, OR a managed language in a strictly\nallocation-free style (essentially writing C in that syntax), OR a collector with\nhard pause guarantees. It is a language-selection decision, not a test criterion.",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "d2",
   "type": "line",
   "x": 30,
   "y": 550,
   "width": 1670,
   "height": 0,
   "strokeColor": "#cbd5e1",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
