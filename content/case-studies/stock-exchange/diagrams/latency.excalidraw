   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "Determinism is what BUYS the latency - not a nice property alongside it",
   "originalText": "Determinism is what BUYS the latency - not a nice property alongside it",
   "fontSize": 22,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "s",
   "type": "text",
   "x": 30,
   "y": 52,
   "width": 1097,
   "height": 17,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100002,
   "version": 1,
   "versionNonce": 700014,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "A non-deterministic engine would have to persist its state to recover, putting a write on the hot path and blowing the budget.",
   "originalText": "A non-deterministic engine would have to persist its state to recover, putting a write on the hot path and blowing the budget.",
   "fontSize": 14,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
