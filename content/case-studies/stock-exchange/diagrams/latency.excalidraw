   "locked": false,
   "text": "One thread, one core, busy-spinning",
   "originalText": "One thread, one core, busy-spinning",
   "fontSize": 17,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
