}, {"id": "e38", "type": "text", "x": 44, "y": 502, "text": "in the Notification Service -- not re-implemented separately inside each channel worker.", "originalText": "in the Notification Service -- not re-implemented separately inside each channel worker.", "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#63e6be", "backgroundColor": "transparent", "opacity": 100, "seed": 1, "width": 709.28, "height": 16.900000000000002}, {"id": "e39", "type": "text", "x": 44, "y": 522, "text": "A channel that's down (e.g. email provider outage) retries independently and never blocks the others.", "originalText": "A channel that's down (e.g. email provider outage) retries independently and never blocks the others.", "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#ff8787", "backgroundColor": "transparent", "opacity": 100, "seed": 1, "width": 814.06, "height": 16.900000000000002}], "appState": {"viewBackgroundColor": "#ffffff"}}