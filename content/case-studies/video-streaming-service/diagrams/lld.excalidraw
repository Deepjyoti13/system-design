{"type": "excalidraw", "version": 2, "source": "vs", "elements": [{"id": "t1", "type": "text", "x": 40, "y": 30, "width": 996, "height": 31, "text": "Two State Machines: a Worker Claims a Job, a Player Picks a Quality", "originalText": "Two State Machines: a Worker Claims a Job, a Player Picks a Quality", "fontSize": 24, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#1e3a5f", "backgroundColor": "transparent", "roughness": 0, "opacity": 100, "seed": 2}, {"id": "t2", "type": "text", "x": 40, "y": 64, "width": 1024, "height": 18, "text": "Left: RenditionStatus never shows a half-finished state. Right: buffer health is checked before throughput, not after.", "originalText": "Left: RenditionStatus never shows a half-finished state. Right: buffer health is checked before throughput, not after.", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#64748b", "backgroundColor": "transparent", "roughness": 0, "opacity": 100, "seed": 2}, {"id": "t3", "type": "text", "x": 40, "y": 140, "width": 326, "height": 22, "text": "RenditionStatus (per rendition)", "originalText": "RenditionStatus (per rendition)", "fontSize": 17, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#1e3a5f", "backgroundColor": "transparent", "roughness": 0, "opacity": 100, "seed": 2}, {"id": "r4", "type": "rectangle", "x": 40, "y": 250, "width": 160, "height": 80, "strokeColor": "#64748b", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "seed": 1, "roundness": {"type": 3}}, {"id": "t5", "type": "text", "x": 54, "y": 278, "width": 69, "height": 20, "text": "pending", "originalText": "pending", "fontSize": 16, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "roughness": 0, "opacity": 100, "seed": 2}, {"id": "r6", "type": "rectangle", "x": 280, "y": 250, "widt