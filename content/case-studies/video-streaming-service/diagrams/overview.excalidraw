{"type": "excalidraw", "version": 2, "source": "vs", "elements": [{"id": "t1", "type": "text", "x": 40, "y": 30, "width": 386, "height": 33, "text": "One Video, Many Networks", "originalText": "One Video, Many Networks", "fontSize": 26, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#1e3a5f", "backgroundColor": "transparent", "roughness": 0, "opacity": 100, "seed": 2}, {"id": "t2", "type": "text", "x": 40, "y": 65, "width": 1004, "height": 19, "text": "Same file, same segment order -- quality steps up between segments as the network improves. Never a restart.", "originalText": "Same file, same segment order -- quality steps up between segments as the network improves. Never a restart.", "fontSize": 15, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#64748b", "backgroundColor": "transparent", "roughness": 0, "opacity": 100, "seed": 2}, {"id": "r3", "type": "rectangle", "x": 40, "y": 150, "width": 220, "height": 110, "strokeColor": "#f87171", "backgroundColor": "#fecaca", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "seed": 1, "roundness": {"type": 3}}, {"id": "t4", "type": "text", "x": 56, "y": 166, "width": 89, "height": 20, "text": "Segment 1", "originalText": "Segment 1", "fontSize": 16, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "roughness": 0, "opacity": 100, "seed": 2}, {"id": "t5", "type": "text", "x": 56, "y": 196, "width": 60, "height": 28, "text": "240p", "originalText": "240p", "fontSize": 22, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "roughness": 0, "opacity": 100, "seed": 2}, {"id": "t6", "type": "text", "x": 40, "y": 274, "width": 220, "height": 16, "text": "connection is slow here", "originalText": "connection is slow here", "fontSize": 13, "fontFamily": 3, "textAlign": "left", "vertic