": 475, "y": 555, "width": 530, "height": 65, "text": "No lookup, no lock spanning I/O, no request to the registrar.\nThe only shared state is (last_timestamp, sequence), guarded\nby a single in-process atomic update.", "originalText": "No lookup, no lock spanning I/O, no request to the registrar.\nThe only shared state is (last_timestamp, sequence), guarded\nby a single in-process atomic update.", "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "opacity": 100, "seed": 31, "containerId": null, "fontWeight": "normal"}], "appState": {"viewBackgroundColor": "#ffffff"}}