, "backgroundColor": "#ebfbee", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "seed": 48412, "roundness": {"type": 3}}, {"id": "r430_seq_t", "type": "text", "x": 1002, "y": 450, "width": 93.0, "height": 19.5, "text": "seq = 0000", "originalText": "seq = 0000", "fontSize": 15, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#2f9e44", "backgroundColor": "transparent", "opacity": 100, "seed": 95764}, {"id": "r430_label", "type": "text", "x": 40, "y": 406, "width": 104.16, "height": 18.2, "text": "Machine 002:", "originalText": "Machine 002:", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "opacity": 100, "seed": 98538}, {"id": "ex_note", "type": "text", "x": 40, "y": 506, "width": 894.04, "height": 18.2, "text": "Identical timestamp, but the machine-ID field differs -> the final 64-bit IDs are guaranteed different.", "originalText": "Identical timestamp, but the machine-ID field differs -> the final 64-bit IDs are guaranteed different.", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#2f9e44", "backgroundColor": "transparent", "opacity": 100, "seed": 425}, {"id": "evidence", "type": "rectangle", "x": 40, "y": 550, "width": 1180, "height": 130, "strokeColor": "#0b0f14", "backgroundColor": "#1a2129", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "seed": 20813, "roundness": {"type": 3}}, {"id": "ev_line0", "type": "text", "x": 60, "y": 568, "width": 581.56, "height": 18.2, "text": "10 bits machine ID  ->  max 1,024 concurrently-registered machines.", "originalText": "10 bits machine ID  ->  max 1,024 concurrently-registered machines.", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#51cf66", "backgroundColor": "transparent", "opacity": 100, "seed": 69830}, {"id": "ev_line1", "type": "text", "x": 60, "y": 600, "width": 937.4399999999999, "height": 18.2, "text": "12 bits sequence    ->  max 4,096 IDs/ms per machine (4.096M/sec/machine) before stalling for the next tick.", "originalText": "12 bits sequence    ->  max 4,096 IDs/ms per machine (4.096M/sec/machine) before stalling for the next tick.", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#51cf66", "backgroundColor": "transparent", "opacity": 100, "seed": 1524}, {"id": "ev_line2", "type": "text", "x": 60, "y": 632, "width": 781.2, "height": 18.2, "text": "41 bits timestamp   ->  ~69 years of range from a custom epoch before the field overflows.", "originalText": "41 bits timestamp   ->  ~69 years of range from a custom epoch before the field overflows.", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#51cf66", "backgroundColor": "transparent", "opacity": 100, "seed": 67381}], "appState": {"viewBackgroundColor": "#ffffff"}}