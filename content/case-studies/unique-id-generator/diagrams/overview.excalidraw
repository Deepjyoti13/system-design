": "left", "verticalAlign": "middle", "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "opacity": 100, "seed": 12, "containerId": null, "fontWeight": "bold"}, {"id": "capA_ts", "type": "text", "x": 40, "y": 174, "width": 340, "height": 22, "text": "SAME", "originalText": "SAME", "fontSize": 13, "fontFamily": 3, "textAlign": "center", "verticalAlign": "top", "strokeColor": "#1e3a5f", "backgroundColor": "transparent", "opacity": 100, "seed": 13, "containerId": null, "fontWeight": "bold"}, {"id": "capA_mid", "type": "text", "x": 400, "y": 174, "width": 230, "height": 22, "text": "DIFFERENT", "originalText": "DIFFERENT", "fontSize": 13, "fontFamily": 3, "textAlign": "center", "verticalAlign": "top", "strokeColor": "#c2410c", "backgroundColor": "transparent", "opacity": 100, "seed": 14, "containerId": null, "fontWeight": "bold"}, {"id": "labelB", "type": "text", "x": 40, "y": 290, "width": 300, "height": 24, "text": "Machine B", "originalText": "Machine B", "fontSize": 18, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#1e3a5f", "backgroundColor": "transparent", "opacity": 100, "seed": 15, "containerId": null, "fontWeight": "bold"}, {"id": "b_tsr", "type": "rectangle", "x": 40, "y": 330, "width": 340, "height": 70, "strokeColor": "#1e3a5f", "backgroundColor": "#93c5fd", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "seed": 16, "roundness": {"type": 3}, "boundElements": [{"type": "text", "id": "b_tst"}]}, {"id": "b_tst", "type": "text", "x": 40, "y": 330, "width": 340, "height": 70, "text": "timestamp\n1738271900123", "originalText": "timestamp\n1738271900123", "fontSize": 15, "fontFamily": 3, "textAlign": "center", "verticalAlign": "middle", "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "opacity": 100, "seed": 17, "containerId": "b_tsr", "fontWeight": "normal"}, {"id": "b_midr", "type": "rectangle", "x": 400, "y": 330, "width": 230, "height": 70, "strokeColor": "#c2410c", "backgroundColor": "#fed7aa", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "seed": 18, "roundness": {"type": 3}, "boundElements": [{"type": "text", "id": "b_midt"}]}, {"id": "b_midt", "type": "text", "x": 400, "y": 330, "width": 230, "height": 70, "text": "machine_id\n0000000010", "originalText": "machine_id\n0000000010", "fontSize": 15, "fontFamily": 3, "textAlign": "center", "verticalAlign": "middle", "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "opacity": 100, "seed": 19, "containerId": "b_midr", "fontWeight": "normal"}, {"id": "b_seqr", "type": "rectangle", "x": 650, "y": 330, "width": 230, "height": 70, "strokeColor": "#1e3a5f", "backgroundColor": "#93c5fd", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "seed": 20, "roundness": {"type": 3}, "boundElements": [{"type": "text", "id": "b_seqt"}]}, {"id": "b_seqt", "type": "text", "x": 650, "y": 330, "width": 230, "height": 70, "text": "sequence\n000000000000", "originalText": "sequence\n000000000000", "fontSize": 15, "fontFamily": 3, "textAlign": "center", "verticalAlign": "middle", "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "opacity": 100, "seed": 21, "containerId": "b_seqr", "fontWeight": "normal"}, {"id": "b_eq", "type": "text", "x": 900, "y": 345, "width": 340, "height": 40, "text": "=  7302345678900225282", "originalText": "=  7302345678900225282", "fontSize": 16, "fontFamily": 3, "textAlign": "left", "verticalAlign": "middle", "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "opacity": 100, "seed": 22, "containerId": null, "fontWeight": "bold"}, {"id": "capB_ts", "type": "text", "x": 40, "y": 304, "width": 340, "height": 22, "text": "SAME", "originalText": "SAME", "fontSize": 13, "fontFamily": 3, "textAlign": "center", "verticalAlign": "top", "strokeColor": "#1e3a5f", "backgroundColor": "transparent", "opacity": 100, "seed": 23, "containerId": null, "fontWeight": "bold"}, {"id": "capB_mid", "type": "text", "x": 400, "y": 304, "width": 230, "height": 22, "text": "DIFFERENT", "originalText": "DIFFERENT", "fontSize": 13, "fontFamily": 3, "textAlign": "center", "verticalAlign": "top", "strokeColor": "#c2410c", "backgroundColor": "transparent", "opacity": 100, "seed": 24, "containerId": null, "fontWeight": "bold"}, {"id": "ev", "type": "rectangle", "x": 40, "y": 460, "width": 1220, "height": 90, "strokeColor": "#64748b", "backgroundColor": "#f1f5f9", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "seed": 25, "roundness": {"type": 3}}, {"id": "evt", "type": "text", "x": 60, "y": 475, "width": 1180, "height": 60, "text": "No lookup, no lock, no network call between A and B. Each machine only ever needs its own clock and its own\nleased machine_id -- the two fields never have to agree on anything to guarantee the final 64-bit IDs differ.", "originalText": "No lookup, no lock, no network call between A and B. Each machine only ever needs its own clock and its own\nleased machine_id -- the two fields never have to agree on anything to guarantee the final 64-bit IDs differ.", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "opacity": 100, "seed": 26, "containerId": null, "fontWeight": "normal"}], "appState": {"viewBackgroundColor": "#ffffff"}}