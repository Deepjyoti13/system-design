{"type": "excalidraw", "version": 2, "source": "uid-gen", "elements": [{"id": "title", "type": "text", "x": 40, "y": 30, "width": 1300, "height": 40, "text": "Two Machines, Same Millisecond, No Collision", "originalText": "Two Machines, Same Millisecond, No Collision", "fontSize": 26, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#1e3a5f", "backgroundColor": "transparent", "opacity": 100, "seed": 2, "containerId": null, "fontWeight": "bold"}, {"id": "subtitle", "type": "text", "x": 40, "y": 75, "width": 1300, "height": 24, "text": "Identical timestamp bits. Different machine-ID bits. The 64-bit IDs can never collide -- with zero communication between the machines.", "originalText": "Identical timestamp bits. Different machine-ID bits. The 64-bit IDs can never collide -- with zero communication between the machines.", "fontSize": 15, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#64748b", "backgroundColor": "transparent", "opacity": 100, "seed": 3, "containerId": null, "fontWeight": "normal"}, {"id": "div1", "type": "rectangle", "x": 40, "y": 115, "width": 1300, "height": 2, "strokeColor": "#cbd5e1", "backgroundColor": "#cbd5e1", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "seed": 4, "roundness": {"type": 3}}, {"id": "labelA", "type": "text", "x": 40, "y": 160, "width": 300, "height": 24, "text": "Machine A", "originalText": "Machine A", "fontSize": 18, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#1e3a5f", "backgroundColor": "transparent", "opacity": 100, "seed": 5, "containerId": null, "fontWeight": "bold"}, {"id": "a_tsr", "type": "rectangle", "x": 40, "y": 200, "width": 340, "height": 70, "strokeColor": "#1e3a5f", "backgroundColor": "#93c5fd", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "seed": 6, "roundness": {"type": 3}, "boundElements": [{"type": "text", "id": "a