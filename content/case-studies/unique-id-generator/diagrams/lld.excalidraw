"opacity": 100, "seed": 42, "startArrowhead": null, "endArrowhead": "triangle"}, {"id": "retr", "type": "rectangle", "x": 500, "y": 970, "width": 400, "height": 70, "strokeColor": "#047857", "backgroundColor": "#a7f3d0", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "seed": 43, "roundness": {"type": 3}, "boundElements": [{"type": "text", "id": "rett"}]}, {"id": "rett", "type": "text", "x": 500, "y": 970, "width": 400, "height": 70, "text": "return (ts<<22) | (machine_id<<12) | sequence", "originalText": "return (ts<<22) | (machine_id<<12) | sequence", "fontSize": 14, "fontFamily": 3, "textAlign": "center", "verticalAlign": "middle", "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "opacity": 100, "seed": 44, "containerId": "retr", "fontWeight": "normal"}, {"id": "ev", "type": "rectangle", "x": 40, "y": 1070, "width": 1320, "height": 80, "strokeColor": "#64748b", "backgroundColor": "#f1f5f9", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "seed": 45, "roundness": {"type": 3}}, {"id": "evt", "type": "text", "x": 60, "y": 1085, "width": 1280, "height": 55, "text": "No lock ever waits on I/O -- every branch above is pure CPU and memory. The only slow path is wait_until_next_millis,\nwhich spins for at most a fraction of a millisecond, and only when a single machine exhausts 4,096 IDs in one ms.", "originalText": "No lock ever waits on I/O -- every branch above is pure CPU and memory. The only slow path is wait_until_next_millis,\nwhich spins for at most a fraction of a millisecond, and only when a single machine exhausts 4,096 IDs in one ms.", "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "opacity": 100, "seed": 46, "containerId": null, "fontWeight": "normal"}], "appState": {"viewBackgroundColor": "#ffffff"}}