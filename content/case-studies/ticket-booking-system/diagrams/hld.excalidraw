    {"id":"txt_gate2","type":"text","x":1190,"y":218,"text":"admits N/sec","fontSize":13,"fontFamily":3,"strokeColor":"#3c3c3c","backgroundColor":"transparent","textAlign":"left","verticalAlign":"top","width":150,"height":18,"opacity":100},
    {"id":"txt_gate3","type":"text","x":1190,"y":240,"text":"rest: queued w/ position","fontSize":13,"fontFamily":3,"strokeColor":"#3c3c3c","backgroundColor":"transparent","textAlign":"left","verticalAlign":"top","width":230,"height":18,"opacity":100},

    {"id":"arrow_gate_flow","type":"arrow","x":1170,"y":300,"width":-90,"height":80,"points":[[0,0],[-90,0],[-90,80]],"strokeColor":"#1e1e1e","strokeWidth":2,"roughness":1,"opacity":100,"startArrowhead":null,"endArrowhead":"triangle"},

    {"id":"box_flow","type":"rectangle","x":880,"y":380,"width":300,"height":90,"strokeColor":"#1864ab","backgroundColor":"#a5d8ff","fillStyle":"solid","strokeWidth":2,"roughness":1,"opacity":100},
    {"id":"txt_flow1","type":"text","x":900,"y":398,"text":"seat selection + hold + pay","fontSize":15,"fontFamily":3,"strokeColor":"#1e1e1e","backgroundColor":"transparent","textAlign":"left","verticalAlign":"top","width":260,"height":20,"opacity":100},
    {"id":"txt_flow2","type":"text","x":900,"y":423,"text":"only admitted users reach here", "fontSize":13,"fontFamily":3,"strokeColor":"#1e3a5f","backgroundColor":"transparent","textAlign":"left","verticalAlign":"top","width":270,"height":18,"opacity":100},
    {"id":"txt_flow3","type":"text","x":900,"y":445,"text":"-> the seat state machine, left","fontSize":13,"fontFamily":3,"strokeColor":"#1e3a5f","backgroundColor":"transparent","textAlign":"left","verticalAlign":"top","width":270,"height":18,"opacity":100},

    {"id":"evidence_wr","type":"rectangle","x":880,"y":505,"width":540,"height":65,"strokeColor":"#1a2129","backgroundColor":"#15171a","fillStyle":"solid","strokeWidth":2,"roughness":0,"opacity":100},
    {"id":"ev_wr_1","type":"text","x":900,"y":518,"text":"Without a gate: 100K browsers all race the same few thousand", "fontSize":13,"fontFamily":3,"strokeColor":"#ff8787","backgroundColor":"transparent","textAlign":"left","verticalAlign":"top","width":500,"height":18,"opacity":100},
    {"id":"ev_wr_2","type":"text","x":900,"y":540,"text":"rows -- the gate protects the EXPERIENCE, not just one endpoint.", "fontSize":13,"fontFamily":3,"strokeColor":"#ff8787","backgroundColor":"transparent","textAlign":"left","verticalAlign":"top","width":500,"height":18,"opacity":100}
