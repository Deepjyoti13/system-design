    {"id":"txt_crowd2","type":"text","x":900,"y":225,"text":"arrive in seconds","fontSize":13,"fontFamily":3,"strokeColor":"#5c5f66","backgroundColor":"transparent","textAlign":"left","verticalAlign":"top","width":150,"height":18,"opacity":100},

