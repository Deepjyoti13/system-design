  "elements": [
    {"id":"title","type":"text","x":40,"y":30,"text":"Ticket Booking: Seat Holds & the On-Sale Waiting Room","fontSize":24,"fontFamily":3,"strokeColor":"#1864ab","backgroundColor":"transparent","textAlign":"left","verticalAlign":"top","width":900,"height":30,"opacity":100},
    {"id":"subtitle","type":"text","x":40,"y":68,"text":"Left: the per-seat state machine. Right: why the waiting room exists at all.","fontSize":15,"fontFamily":3,"strokeColor":"#495057","backgroundColor":"transparent","textAlign":"left","verticalAlign":"top","width":900,"height":20,"opacity":100},

    {"id":"sm_header","type":"text","x":40,"y":130,"text":"Seat State Machine","fontSize":18,"fontFamily":3,"strokeColor":"#1864ab","backgroundColor":"transparent","textAlign":"left","verticalAlign":"top","width":300,"height":24,"opacity":100},

