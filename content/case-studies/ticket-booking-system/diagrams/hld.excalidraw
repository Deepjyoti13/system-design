    {"id":"ev_sm_1","type":"text","x":60,"y":465,"text":"UPDATE seats SET status='held', hold_expires_at=NOW()+'8 min' WHERE seat_id=? AND status='available'","fontSize":13,"fontFamily":3,"strokeColor":"#69db7c","backgroundColor":"transparent","textAlign":"left","verticalAlign":"top","width":720,"height":18,"opacity":100},
    {"id":"ev_sm_2","type":"text","x":60,"y":490,"text":"0 rows affected = someone else already holds or booked it -- same row-level race fix as the e-commerce inventory decrement.","fontSize":13,"fontFamily":3,"strokeColor":"#69db7c","backgroundColor":"transparent","textAlign":"left","verticalAlign":"top","width":720,"height":18,"opacity":100},
    {"id":"ev_sm_3","type":"text","x":60,"y":513,"text":"Sweep or lazy-expiry finds stale holds and flips them back -- nobody has to wait on a human to give up.","fontSize":13,"fontFamily":3,"strokeColor":"#69db7c","backgroundColor":"transparent","textAlign":"left","verticalAlign":"top","width":720,"height":18,"opacity":100},

    {"id":"wr_header","type":"text","x":880,"y":130,"text":"On-Sale Waiting Room","fontSize":18,"fontFamily":3,"strokeColor":"#1864ab","backgroundColor":"transparent","textAlign":"left","verticalAlign":"top","width":300,"height":24,"opacity":100},

