   "locked": false,
   "text": "deliveries + delivery_attempts  ->  by subscription_id",
   "originalText": "deliveries + delivery_attempts  ->  by subscription_id",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "shd_30",
   "type": "text",
   "x": 56,
   "y": 1700,
   "width": 435,
   "height": 90,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100118,
   "version": 1,
   "versionNonce": 700826,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "this keeps one subscriber's ENTIRE ordered queue on a\nsingle shard, so the sequence gate's 'is the prior\nsequence terminal' check is always a single-shard lookup -\nnever a cross-shard fan-out-and-merge. The same principle\nas payments' account-scoped ledger sharding and the\nscheduler's per-shard leader election.",
   "originalText": "this keeps one subscriber's ENTIRE ordered queue on a\nsingle shard, so the sequence gate's 'is the prior\nsequence terminal' check is always a single-shard lookup -\nnever a cross-shard fan-out-and-merge. The same principle\nas payments' account-scoped ledger sharding and the\nscheduler's per-shard leader election.",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "sh_600",
