   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "a rotated secret or an updated endpoint URL must be visible to the VERY NEXT delivery attempt, not eventually. A stale read\nhere is not cosmetic - it is signature verification failing against a secret that was supposed to be revoked, or a delivery\nstill hitting a URL the customer just disabled.",
   "originalText": "a rotated secret or an updated endpoint URL must be visible to the VERY NEXT delivery attempt, not eventually. A stale read\nhere is not cosmetic - it is signature verification failing against a secret that was supposed to be revoked, or a delivery\nstill hitting a URL the customer just disabled.",
