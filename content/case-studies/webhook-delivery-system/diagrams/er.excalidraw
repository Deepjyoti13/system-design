   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "UNIQUE (subscription_id, sequence_number)",
   "originalText": "UNIQUE (subscription_id, sequence_number)",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "u2",
   "lineHeight": 1.25
  },
  {
   "id": "u2n",
   "type": "text",
   "x": 880,
   "y": 838,
   "width": 599,
   "height": 105,
   "strokeColor": "#047857",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100092,
   "version": 1,
   "versionNonce": 700644,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "The ordering guarantee's actual enforcement point. sequence_number is assigned\nmonotonically PER SUBSCRIPTION at fan-out time, and the claim query's NOT EXISTS\ngate checks the IMMEDIATELY PRECEDING number for the same subscription - a query\nthat is only fast, and only correct against concurrent writers, because this\ncomposite index turns 'is sequence N-1 for this subscriber still pending' into a\nsingle indexed row lookup rather than a scan. It also prevents two rows ever\nclaiming the same position in one subscriber's queue.",
   "originalText": "The ordering guarantee's actual enforcement point. sequence_number is assigned\nmonotonically PER SUBSCRIPTION at fan-out time, and the claim query's NOT EXISTS\ngate checks the IMMEDIATELY PRECEDING number for the same subscription - a query\nthat is only fast, and only correct against concurrent writers, because this\ncomposite index turns 'is sequence N-1 for this subscriber still pending' into a\nsingle indexed row lookup rather than a scan. It also prevents two rows ever\nclaiming the same position in one subscriber's queue.",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
