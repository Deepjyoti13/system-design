   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "event_subscriptions  ->  a different axis entirely",
   "originalText": "event_subscriptions  ->  a different axis entirely",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "shd_600",
   "type": "text",
   "x": 626,
   "y": 1700,
   "width": 435,
   "height": 60,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100121,
   "version": 1,
   "versionNonce": 700847,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "bounded by the number of registered ENDPOINTS, which grows\nfar slower than delivery volume - so it can stay unsharded\n(or shard by tenant_id independently) far longer than\ndeliveries needs to.",
   "originalText": "bounded by the number of registered ENDPOINTS, which grows\nfar slower than delivery volume - so it can stay unsharded\n(or shard by tenant_id independently) far longer than\ndeliveries needs to.",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "sh_1170",
