  },
  {
   "id": "shn_1170",
   "type": "text",
   "x": 1196,
   "y": 1674,
   "width": 431,
   "height": 16,
   "strokeColor": "#1e40af",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
