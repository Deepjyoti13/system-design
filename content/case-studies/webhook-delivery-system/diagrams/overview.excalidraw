    { "type": "text", "id": "final_caption", "x": 60, "y": 650, "width": 1280, "height": 24,
      "text": "Subscriber B's retries never touch A's or C's worker capacity -- A and C were done in milliseconds while B was still failing its third attempt.",
      "originalText": "Subscriber B's retries never touch A's or C's worker capacity -- A and C were done in milliseconds while B was still failing its third attempt.",
      "fontSize": 14, "fontFamily": 3, "textAlign": "center", "verticalAlign": "top",
