  },
  {
   "id": "erd2",
   "type": "text",
   "x": 56,
   "y": 1492,
   "width": 934,
   "height": 45,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100044,
   "version": 1,
   "versionNonce": 700308,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "the customer changed their subscribed event types after this event was ingested. The delivery row is HONOURED AS A COMMITMENT\nALREADY MADE at fan-out time, not retroactively cancelled - the config that mattered was the config at ingestion, and\nre-checking it at delivery time would make 'did this get sent' depend on exactly when a worker got to it.",
   "originalText": "the customer changed their subscribed event types after this event was ingested. The delivery row is HONOURED AS A COMMITMENT\nALREADY MADE at fan-out time, not retroactively cancelled - the config that mattered was the config at ingestion, and\nre-checking it at delivery time would make 'did this get sent' depend on exactly when a worker got to it.",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "er3",
   "type": "ellipse",
   "x": 30,
   "y": 1564,
   "width": 12,
