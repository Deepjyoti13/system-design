   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "the endpoint returns a 3xx redirect",
   "originalText": "the endpoint returns a 3xx redirect",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "erd1",
   "type": "text",
   "x": 56,
   "y": 1398,
   "width": 919,
   "height": 45,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100041,
   "version": 1,
   "versionNonce": 700287,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "NEVER follow it. Treat it as a failure and retry against the original URL. Following a redirect would forward the signed\npayload - and implicitly, evidence of the signing secret's effect - to a host the subscriber never explicitly registered: a\nreal SSRF-adjacent risk this design closes by refusing the hop entirely.",
   "originalText": "NEVER follow it. Treat it as a failure and retry against the original URL. Following a redirect would forward the signed\npayload - and implicitly, evidence of the signing secret's effect - to a host the subscriber never explicitly registered: a\nreal SSRF-adjacent risk this design closes by refusing the hop entirely.",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "er2",
   "type": "ellipse",
   "x": 30,
   "y": 1470,
   "width": 12,
   "height": 12,
   "strokeColor": "#b45309",
   "backgroundColor": "#b45309",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100042,
   "version": 1,
   "versionNonce": 700294,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false
  },
  {
   "id": "ern2",
   "type": "text",
   "x": 56,
   "y": 1470,
   "width": 600,
   "height": 16,
   "strokeColor": "#b45309",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
