   "versionNonce": 700259,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "the subscriber processed the request, but the response never came back",
   "originalText": "the subscriber processed the request, but the response never came back",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "erd0",
   "type": "text",
   "x": 56,
   "y": 1268,
   "width": 926,
   "height": 75,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100038,
   "version": 1,
   "versionNonce": 700266,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "a dropped connection, or a read timeout after they had already returned 200 - genuinely ambiguous from this side, and unlike\na payments processor there is NO STATUS API to query for the true outcome: the subscriber's server IS the ground truth, and\nit is not queryable after the fact. So the deliberate choice is to retry anyway and rely on their idempotent handling of\nWebhook-Id - favouring at-least-once over risking at-most-once, because a silently dropped event is worse than a harmless\nduplicate.",
   "originalText": "a dropped connection, or a read timeout after they had already returned 200 - genuinely ambiguous from this side, and unlike\na payments processor there is NO STATUS API to query for the true outcome: the subscriber's server IS the ground truth, and\nit is not queryable after the fact. So the deliberate choice is to retry anyway and rely on their idempotent handling of\nWebhook-Id - favouring at-least-once over risking at-most-once, because a silently dropped event is worse than a harmless\nduplicate.",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "er1",
   "type": "ellipse",
   "x": 30,
   "y": 1376,
   "width": 12,
   "height": 12,
   "strokeColor": "#b91c1c",
   "backgroundColor": "#b91c1c",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
