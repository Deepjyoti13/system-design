   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "Four error cases designed for deliberately",
   "originalText": "Four error cases designed for deliberately",
   "fontSize": 17,
   "fontFamily": 3,
