  },
  {
   "id": "an",
   "type": "text",
   "x": 970,
   "y": 226,
   "width": 614,
   "height": 45,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100018,
   "version": 1,
   "versionNonce": 700126,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "ONE predicate, whether this is a delivery's first attempt or its ninth. A distinct\n'retrying' state would mean the claim query had to enumerate which states are\nclaimable - and every new state would be a new place to forget one.",
   "originalText": "ONE predicate, whether this is a delivery's first attempt or its ninth. A distinct\n'retrying' state would mean the claim query had to enumerate which states are\nclaimable - and every new state would be a new place to forget one.",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "ifc",
   "type": "rectangle",
   "x": 30,
   "y": 330,
   "width": 940,
   "height": 210,
   "strokeColor": "#1e293b",
   "backgroundColor": "#1e293b",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100019,
   "version": 1,
   "versionNonce": 700133,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": [
