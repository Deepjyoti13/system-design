   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "the endpoint is slow but eventually returns 2xx, right against the timeout",
   "originalText": "the endpoint is slow but eventually returns 2xx, right against the timeout",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "erd3",
   "type": "text",
   "x": 56,
   "y": 1586,
   "width": 896,
   "height": 30,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100047,
   "version": 1,
   "versionNonce": 700329,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "SUBSCRIBER_TIMEOUT has to sit well below the smallest gap in the retry schedule - the one-second first-retry gap - or a\nhandful of slow-but-alive endpoints tie up worker capacity for longer than an entire early retry cycle is meant to take.",
   "originalText": "SUBSCRIBER_TIMEOUT has to sit well below the smallest gap in the retry schedule - the one-second first-retry gap - or a\nhandful of slow-but-alive endpoints tie up worker capacity for longer than an entire early retry cycle is meant to take.",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "d4",
   "type": "line",
   "x": 30,
   "y": 1646,
   "width": 1680,
   "height": 0,
   "strokeColor": "#cbd5e1",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
