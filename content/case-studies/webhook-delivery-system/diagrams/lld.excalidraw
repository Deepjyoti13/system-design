   "versionNonce": 700301,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "a subscription's filter no longer matches by the time a worker attempts it",
   "originalText": "a subscription's filter no longer matches by the time a worker attempts it",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
