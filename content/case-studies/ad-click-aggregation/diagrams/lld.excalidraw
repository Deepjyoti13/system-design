{"type": "excalidraw", "version": 2, "source": "field-guide", "elements": [{"id": "title", "type": "text", "x": 40, "y": 30, "width": 661, "height": 31, "text": "Tumbling Windows and the Watermark", "originalText": "Tumbling Windows and the Watermark", "fontSize": 25, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#1971c2", "backgroundColor": "transparent", "opacity": 100, "seed": 28459}, {"id": "subtitle", "type": "text", "x": 40, "y": 70, "width": 1179, "height": 20, "text": "The watermark trails real time by the allowed lateness -- a window only finalizes once the watermark passes it", "originalText": "The watermark trails real time by the allowed lateness -- a window only finalizes once the watermark passes it", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#5c6470", "backgroundColor": "transparent", "opacity": 100, "seed": 1403}, {"id": "axis", "type": "arrow", "x": 60, "y": 300, "width": 1340, "height": 1, "points": [[0, 0], [1340, 0]], "strokeColor": "#5c6470", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "seed": 56473, "startArrowhead": null, "endArrowhead": "triangle"}, {"id": "axis_label", "type": "text", "x": 1360, "y": 310, "width": 63, "height": 19, "text": "time", "originalText": "time", "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#5c6470", "backgroundColor": "transparent", "opacity": 100, "seed": 12710}, {"id": "tick_0", "type": "arrow", "x": 60, "y": 290, "width": 1, "height": 20, "points": [[0, 0], [0, 20]], "strokeColor": "#5c6470", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "seed": 34092, "startArrowhead": null, "endArrowhead": null}, {"id": "win_label_0", "type": "text", "x": 170.0, "y": 320, "width": 102, "height": 19, "text": "Window 1", "originalTe