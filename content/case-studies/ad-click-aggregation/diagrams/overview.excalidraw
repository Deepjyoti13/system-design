    { "type": "text", "id": "final_caption", "x": 80, "y": 560, "width": 760, "height": 54,
      "text": "Tumbling windows give every click exactly one home. The watermark decides when a window\nis done waiting for late neighbors. The dedup cache makes sure no click ever gets two homes.",
      "originalText": "Tumbling windows give every click exactly one home. The watermark decides when a window\nis done waiting for late neighbors. The dedup cache makes sure no click ever gets two homes.",
      "fontSize": 14, "fontFamily": 3, "textAlign": "center", "verticalAlign": "top",
      "strokeColor": "#1e40af", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 20100, "version": 1, "versionNonce": 30100, "isDeleted": false, "groupIds": [],
