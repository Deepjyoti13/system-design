   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "dedup beyond the recipient list",
   "originalText": "dedup beyond the recipient list",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "pd_450",
   "type": "text",
   "x": 476,
   "y": 1660,
   "width": 376,
   "height": 60,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100124,
   "version": 1,
   "versionNonce": 700868,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "the same corporate slide deck forwarded around a\ncompany is stored once regardless of how many\ndistinct emails carry it - so the saving is larger\nthan 4x in practice.",
   "originalText": "the same corporate slide deck forwarded around a\ncompany is stored once regardless of how many\ndistinct emails carry it - so the saving is larger\nthan 4x in practice.",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "p_1000",
