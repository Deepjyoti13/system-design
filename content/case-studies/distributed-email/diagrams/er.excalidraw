  {
   "id": "fl",
   "type": "text",
   "x": 30,
   "y": 1864,
   "width": 467,
   "height": 21,
   "strokeColor": "#1e40af",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100130,
   "version": 1,
   "versionNonce": 700910,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "Threading is best-effort, and always will be",
   "originalText": "Threading is best-effort, and always will be",
   "fontSize": 17,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "th",
   "type": "rectangle",
   "x": 30,
   "y": 1902,
   "width": 820,
   "height": 90,
   "strokeColor": "#1e293b",
   "backgroundColor": "#1e293b",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100131,
   "version": 1,
   "versionNonce": 700917,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": [
    {
     "id": "th_t",
     "type": "text"
    }
   ],
   "link": null,
