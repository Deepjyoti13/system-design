   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "bodies       2.0 PB/day, 730 PB/yr   ->   0.50 PB/day, 182 PB/yr\nattachments  4.0 PB/day, 1,460 PB/yr ->   1.0 PB/day, 365 PB/yr\n\n~1,640 PB / YEAR saved, from one modelling decision.",
   "originalText": "bodies       2.0 PB/day, 730 PB/yr   ->   0.50 PB/day, 182 PB/yr\nattachments  4.0 PB/day, 1,460 PB/yr ->   1.0 PB/day, 365 PB/yr\n\n~1,640 PB / YEAR saved, from one modelling decision.",
   "fontSize": 12,
