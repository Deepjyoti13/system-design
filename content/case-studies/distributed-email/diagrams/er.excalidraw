   "versionNonce": 700665,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "CLUSTERING ORDER BY (message_uuid DESC) means the\nnewest messages are physically first in the partition,\nso 'most recent 50' is a range scan that stops\nimmediately. No sort, no separate index.",
   "originalText": "CLUSTERING ORDER BY (message_uuid DESC) means the\nnewest messages are physically first in the partition,\nso 'most recent 50' is a range scan that stops\nimmediately. No sort, no separate index.",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
