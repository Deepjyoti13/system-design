   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "any web server or processing worker generates one\nlocally - no counter, no allocator, no round trip.",
   "originalText": "any web server or processing worker generates one\nlocally - no counter, no allocator, no round trip.",
