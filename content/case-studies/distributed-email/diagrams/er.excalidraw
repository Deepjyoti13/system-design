  },
  {
   "id": "hn",
   "type": "text",
   "x": 30,
   "y": 2704,
   "width": 1011,
   "height": 146,
   "strokeColor": "#b45309",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100150,
   "version": 1,
   "versionNonce": 701050,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "Two structural gaps worth naming as gaps rather than as backlog. A GENUINELY SHARED MAILBOX DOES NOT FIT: support@company.com\nread by twelve people is one mailbox with twelve readers, and user_id partitioning assumes an email belongs to one user. The\npseudo-user workaround breaks per-user read state, which is exactly what a shared inbox needs most. And END-TO-END ENCRYPTION\nIS STRUCTURALLY INCOMPATIBLE WITH THIS SCHEMA, not merely unbuilt: content-addressed dedup requires the server to see\nidentical plaintext to compute identical hashes, search indexing requires reading bodies, threading requires reading headers,\nand spam filtering requires reading everything. E2EE would forfeit the 1,640 PB/year saving, server-side search and spam\nfiltering simultaneously. Alongside them: content reference counting is unresolved (no sweep interval, and no answer for an\nattachment whose reference set spans millions of users' partitions), and unread drift has a repair but no DETECTION - a\nsystematic bug in the dual write would be invisible until users complained about badges.",
   "originalText": "Two structural gaps worth naming as gaps rather than as backlog. A GENUINELY SHARED MAILBOX DOES NOT FIT: support@company.com\nread by twelve people is one mailbox with twelve readers, and user_id partitioning assumes an email belongs to one user. The\npseudo-user workaround breaks per-user read state, which is exactly what a shared inbox needs most. And END-TO-END ENCRYPTION\nIS STRUCTURALLY INCOMPATIBLE WITH THIS SCHEMA, not merely unbuilt: content-addressed dedup requires the server to see\nidentical plaintext to compute identical hashes, search indexing requires reading bodies, threading requires reading headers,\nand spam filtering requires reading everything. E2EE would forfeit the 1,640 PB/year saving, server-side search and spam\nfiltering simultaneously. Alongside them: content reference counting is unresolved (no sweep interval, and no answer for an\nattachment whose reference set spans millions of users' partitions), and unread drift has a repair but no DETECTION - a\nsystematic bug in the dual write would be invisible until users complained about badges.",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  }
