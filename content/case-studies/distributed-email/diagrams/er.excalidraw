   }
  },
  {
   "id": "th_t",
   "type": "text",
   "x": 38,
   "y": 1924,
   "width": 804,
   "height": 45,
   "strokeColor": "#ffffff",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100132,
   "version": 1,
   "versionNonce": 700924,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "Message-Id:  <7BA04B2A-430C-4D12-8B57-862103C34501@gmail.com>\nIn-Reply-To: <CAEWTXuPfN=LzECjDJtgY9Vu03kgFvJnJUSHTt6TW@gmail.com>\nReferences:  [<original@...>, <reply1@...>, <reply2@...>]",
   "originalText": "Message-Id:  <7BA04B2A-430C-4D12-8B57-862103C34501@gmail.com>\nIn-Reply-To: <CAEWTXuPfN=LzECjDJtgY9Vu03kgFvJnJUSHTt6TW@gmail.com>\nReferences:  [<original@...>, <reply1@...>, <reply2@...>]",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "th",
   "lineHeight": 1.25
  },
  {
   "id": "fn",
   "type": "text",
   "x": 880,
   "y": 1902,
   "width": 599,
   "height": 45,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100133,
   "version": 1,
   "versionNonce": 700931,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "References carries the whole ancestry, so a thread_id can be assigned by looking\nup whether any referenced Message-Id already belongs to a thread - and if so,\njoining it.",
   "originalText": "References carries the whole ancestry, so a thread_id can be assigned by looking\nup whether any referenced Message-Id already belongs to a thread - and if so,\njoining it.",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "fn2",
   "type": "text",
   "x": 880,
   "y": 1962,
   "width": 599,
   "height": 90,
   "strokeColor": "#b45309",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100134,
   "version": 1,
   "versionNonce": 700938,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "But some clients omit References, some mangle it, and mailing lists rewrite\nheaders - so providers fall back on heuristics: normalized subject matching\n(stripping Re:/Fwd:), participant overlap, time proximity. Which means threading\noccasionally merges unrelated conversations or splits one. Inherent to a\nfederated protocol where you do not control the sender, and the reason threading\nis a BONUS requirement rather than a guarantee.",
   "originalText": "But some clients omit References, some mangle it, and mailing lists rewrite\nheaders - so providers fall back on heuristics: normalized subject matching\n(stripping Re:/Fwd:), participant overlap, time proximity. Which means threading\noccasionally merges unrelated conversations or splits one. Inherent to a\nfederated protocol where you do not control the sender, and the reason threading\nis a BONUS requirement rather than a guarantee.",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
