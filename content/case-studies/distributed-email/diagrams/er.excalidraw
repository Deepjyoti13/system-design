   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "pagination is a cursor, not an offset",
   "originalText": "pagination is a cursor, not an offset",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
