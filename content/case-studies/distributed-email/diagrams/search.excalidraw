   }
  },
  {
   "id": "fr_t",
   "type": "text",
   "x": 38,
   "y": 1596,
   "width": 804,
   "height": 45,
   "strokeColor": "#ffffff",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100061,
   "version": 1,
   "versionNonce": 700427,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "mail processing worker\n  -> INSERT the metadata row       (SYNCHRONOUS - the mail exists now)\n  -> enqueue a search-index write  (async, seconds behind)",
   "originalText": "mail processing worker\n  -> INSERT the metadata row       (SYNCHRONOUS - the mail exists now)\n  -> enqueue a search-index write  (async, seconds behind)",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "fr",
   "lineHeight": 1.25
  },
  {
   "id": "dn",
   "type": "text",
   "x": 900,
   "y": 1582,
   "width": 584,
   "height": 60,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100062,
   "version": 1,
   "versionNonce": 700434,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "Asynchronous indexing means a brief window where a message is in the inbox but\nnot in the index. Usually invisible - users read new mail from the inbox and\nsearch it days later - and noticeable in exactly one case: searching for\nsomething that arrived moments ago.",
   "originalText": "Asynchronous indexing means a brief window where a message is in the inbox but\nnot in the index. Usually invisible - users read new mail from the inbox and\nsearch it days later - and noticeable in exactly one case: searching for\nsomething that arrived moments ago.",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "hy",
   "type": "rectangle",
   "x": 30,
   "y": 1682,
   "width": 820,
   "height": 74,
   "strokeColor": "#1e293b",
   "backgroundColor": "#1e293b",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100063,
   "version": 1,
   "versionNonce": 700441,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": [
    {
     "id": "hy_t",
     "type": "text"
    }
   ],
   "link": null,
   "locked": false,
   "roundness": {
    "type": 3
   }
  },
  {
   "id": "hy_t",
   "type": "text",
   "x": 38,
   "y": 1689,
   "width": 804,
   "height": 60,
   "strokeColor": "#ffffff",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100064,
   "version": 1,
   "versionNonce": 700448,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "the hybrid query\n  index      ->  older matches\n  metadata   ->  scan the user's most recent N messages directly\n  union the two",
   "originalText": "the hybrid query\n  index      ->  older matches\n  metadata   ->  scan the user's most recent N messages directly\n  union the two",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "hy",
   "lineHeight": 1.25
  },
  {
   "id": "dn2",
   "type": "text",
   "x": 900,
   "y": 1682,
   "width": 584,
   "height": 120,
   "strokeColor": "#1e40af",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100065,
   "version": 1,
   "versionNonce": 700455,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "Recent mail is a tiny set and already cached, since access is heavily\nrecency-skewed, so scanning it is cheap. This is the same\nFILTER-THEN-VERIFY / index-plus-recent-scan shape that recurs across this\nguide: the index handles the bulk, and a cheap exact pass handles the part the\nindex has not caught up with.\n\nStrictly better than tightening the index refresh interval, which would\nincrease merge pressure to fix a problem affecting a narrow slice of queries.",
   "originalText": "Recent mail is a tiny set and already cached, since access is heavily\nrecency-skewed, so scanning it is cheap. This is the same\nFILTER-THEN-VERIFY / index-plus-recent-scan shape that recurs across this\nguide: the index handles the bulk, and a cheap exact pass handles the part the\nindex has not caught up with.\n\nStrictly better than tightening the index refresh interval, which would\nincrease merge pressure to fix a problem affecting a narrow slice of queries.",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "d5",
   "type": "line",
   "x": 30,
   "y": 1790,
   "width": 1680,
   "height": 0,
   "strokeColor": "#cbd5e1",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100066,
   "version": 1,
   "versionNonce": 700462,
   "isDeleted": false,
