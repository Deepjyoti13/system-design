  {
   "id": "fr",
   "type": "rectangle",
   "x": 30,
   "y": 1582,
   "width": 820,
   "height": 74,
   "strokeColor": "#1e293b",
   "backgroundColor": "#1e293b",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
