   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "10 billion - only genuinely new messages",
   "originalText": "10 billion - only genuinely new messages",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "bn3",
   "type": "text",
   "x": 30,
   "y": 858,
   "width": 1019,
   "height": 48,
   "strokeColor": "#1e40af",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100044,
   "version": 1,
   "versionNonce": 700308,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "A 4x cut, and metadata changes no longer touch the index at all. Doing this reduction well is most of the engineering - and it\nworks regardless of which engine you pick, so do it FIRST. Reaching for a custom store before doing it would have solved the\nwrong problem expensively.",
   "originalText": "A 4x cut, and metadata changes no longer touch the index at all. Doing this reduction well is most of the engineering - and it\nworks regardless of which engine you pick, so do it FIRST. Reaching for a custom store before doing it would have solved the\nwrong problem expensively.",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
