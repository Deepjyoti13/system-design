   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "Seconds of freshness, without tightening the refresh interval",
   "originalText": "Seconds of freshness, without tightening the refresh interval",
   "fontSize": 17,
   "fontFamily": 3,
