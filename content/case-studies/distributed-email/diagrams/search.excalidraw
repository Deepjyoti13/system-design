  {
   "id": "es_t",
   "type": "text",
   "x": 38,
   "y": 1024,
   "width": 784,
   "height": 82,
   "strokeColor": "#ffffff",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100049,
   "version": 1,
   "versionNonce": 700343,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "POST /emails/_doc     { user_id, message_id, subject, body, from,\n                        to, attachment_names, date }\nGET  /emails/_search  { query: { bool: {\n                          filter: [ {term: {user_id: 12345}} ],\n                          must:   [ {match: {body: 'invoice'}} ] } },\n                        sort: [ {date: 'desc'} ] }",
   "originalText": "POST /emails/_doc     { user_id, message_id, subject, body, from,\n                        to, attachment_names, date }\nGET  /emails/_search  { query: { bool: {\n                          filter: [ {term: {user_id: 12345}} ],\n                          must:   [ {match: {body: 'invoice'}} ] } },\n                        sort: [ {date: 'desc'} ] }",
   "fontSize": 11,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "es",
   "lineHeight": 1.25
  },
  {
   "id": "o1n",
   "type": "text",
   "x": 30,
   "y": 1136,
   "width": 532,
   "height": 180,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100050,
   "version": 1,
   "versionNonce": 700350,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "Full-text search that works out of the box: stemming, tokenization for\nmany languages, phrase queries, fuzzy matching, faceting, and mature\noperational tooling. Sharding by user_id makes routing trivial and\nmeans queries never fan out.\n\nWhere it struggles is specifically the WRITE path. Each write is a\ndocument insert into a segment, and Lucene periodically MERGES segments\n- read-and-rewrite amplification competing with ingest for the same\ndisk. At sustained high write rates, merge pressure becomes the binding\nconstraint. It is also a second system to operate, with its own\ncluster, replication, backups and failure modes, alongside a metadata\nstore that already holds the same data.",
   "originalText": "Full-text search that works out of the box: stemming, tokenization for\nmany languages, phrase queries, fuzzy matching, faceting, and mature\noperational tooling. Sharding by user_id makes routing trivial and\nmeans queries never fan out.\n\nWhere it struggles is specifically the WRITE path. Each write is a\ndocument insert into a segment, and Lucene periodically MERGES segments\n- read-and-rewrite amplification competing with ingest for the same\ndisk. At sustained high write rates, merge pressure becomes the binding\nconstraint. It is also a second system to operate, with its own\ncluster, replication, backups and failure modes, alongside a metadata\nstore that already holds the same data.",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "o2",
   "type": "text",
   "x": 880,
   "y": 982,
   "width": 394,
   "height": 18,
   "strokeColor": "#b45309",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100051,
   "version": 1,
   "versionNonce": 700357,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "a custom LSM-based per-user inverted index",
   "originalText": "a custom LSM-based per-user inverted index",
   "fontSize": 15,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "lsm",
