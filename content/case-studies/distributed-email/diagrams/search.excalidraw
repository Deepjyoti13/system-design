   "roundness": null
  },
  {
   "id": "el",
   "type": "text",
   "x": 30,
   "y": 1808,
   "width": 668,
   "height": 21,
   "strokeColor": "#1e40af",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100067,
   "version": 1,
   "versionNonce": 700469,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "Two details in what gets indexed that are bigger than they look",
   "originalText": "Two details in what gets indexed that are bigger than they look",
   "fontSize": 17,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "x1",
   "type": "text",
   "x": 30,
   "y": 1846,
   "width": 438,
   "height": 17,
   "strokeColor": "#1e40af",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100068,
   "version": 1,
   "versionNonce": 700476,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "HTML must be reduced to plain text before indexing",
   "originalText": "HTML must be reduced to plain text before indexing",
   "fontSize": 14,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "x1n",
   "type": "text",
   "x": 30,
   "y": 1872,
   "width": 919,
   "height": 45,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100069,
   "version": 1,
   "versionNonce": 700483,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "Indexing raw HTML means matching on tag names and CSS class names, so a search for 'table' returns every email containing\none. Extraction also has to handle the tracking pixels, hidden preheader text and invisible white-on-white keyword stuffing\nthat marketing and spam email are full of - some of which is DELIBERATELY trying to pollute the index.",
   "originalText": "Indexing raw HTML means matching on tag names and CSS class names, so a search for 'table' returns every email containing\none. Extraction also has to handle the tracking pixels, hidden preheader text and invisible white-on-white keyword stuffing\nthat marketing and spam email are full of - some of which is DELIBERATELY trying to pollute the index.",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "x2",
   "type": "text",
   "x": 30,
   "y": 1944,
   "width": 507,
   "height": 17,
   "strokeColor": "#b45309",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100070,
   "version": 1,
   "versionNonce": 700490,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "attachment content extraction is a large, separate problem",
   "originalText": "attachment content extraction is a large, separate problem",
   "fontSize": 14,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "x2n",
   "type": "text",
   "x": 30,
   "y": 1970,
   "width": 941,
   "height": 45,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100071,
   "version": 1,
   "versionNonce": 700497,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "Searching inside PDFs and documents is genuinely valuable, and it means running parsers over UNTRUSTED attachments - an attack\nsurface, since document parsers are a historically rich source of memory-safety exploits. That work belongs in a sandboxed\nworker, not in the indexing path, which is why it is an enhancement rather than a given.",
   "originalText": "Searching inside PDFs and documents is genuinely valuable, and it means running parsers over UNTRUSTED attachments - an attack\nsurface, since document parsers are a historically rich source of memory-safety exploits. That work belongs in a sandboxed\nworker, not in the indexing path, which is why it is an enhancement rather than a given.",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  }
 ],
