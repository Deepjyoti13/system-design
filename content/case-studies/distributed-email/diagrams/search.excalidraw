  {
   "id": "an",
   "type": "text",
   "x": 30,
   "y": 350,
   "width": 979,
   "height": 48,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
