   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "mail forwarded on a user's behalf",
   "originalText": "mail forwarded on a user's behalf",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
