  {
   "id": "s3",
   "type": "text",
   "x": 1210,
   "y": 426,
   "width": 385,
   "height": 18,
   "strokeColor": "#047857",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100039,
   "version": 1,
   "versionNonce": 700273,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "DMARC   sets POLICY and demands ALIGNMENT",
   "originalText": "DMARC   sets POLICY and demands ALIGNMENT",
   "fontSize": 15,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
