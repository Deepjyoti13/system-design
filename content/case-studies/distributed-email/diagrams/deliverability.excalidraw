  {
   "id": "an",
   "type": "text",
   "x": 30,
   "y": 244,
   "width": 234,
   "height": 105,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100019,
