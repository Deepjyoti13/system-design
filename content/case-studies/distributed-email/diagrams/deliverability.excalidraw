   "versionNonce": 700595,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "content you did not author and cannot vet, so its complaint rate is outside your control",
   "originalText": "content you did not author and cannot vet, so its complaint rate is outside your control",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "dn",
   "type": "text",
   "x": 30,
   "y": 1480,
   "width": 979,
   "height": 81,
   "strokeColor": "#b91c1c",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100086,
   "version": 1,
   "versionNonce": 700602,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "Reputation is PER-IP, and marketing mail always attracts more complaints than transactional mail. Share the IPs and the\nmarketing complaints degrade the reputation delivering your password resets - so a promotional campaign somebody marks as\nspam makes 2FA codes land in spam folders. A catastrophic coupling between a low-stakes system and a critical one, caused\nentirely by an IP-assignment decision. Separation means a bad campaign damages only the bulk pool - and it hands the load\nshedder its ordering for free, since bulk can be delayed behind transactional under overload.",
   "originalText": "Reputation is PER-IP, and marketing mail always attracts more complaints than transactional mail. Share the IPs and the\nmarketing complaints degrade the reputation delivering your password resets - so a promotional campaign somebody marks as\nspam makes 2FA codes land in spam folders. A catastrophic coupling between a low-stakes system and a critical one, caused\nentirely by an IP-assignment decision. Separation means a bad campaign damages only the bulk pool - and it hands the load\nshedder its ordering for free, since bulk can be delayed behind transactional under overload.",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "d5",
   "type": "line",
   "x": 30,
   "y": 1584,
   "width": 1680,
   "height": 0,
   "strokeColor": "#cbd5e1",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
