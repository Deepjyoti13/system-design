   "opacity": 100,
   "angle": 0,
   "seed": 100033,
   "version": 1,
   "versionNonce": 700231,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "selector._domainkey.example.com. TXT\n  \"v=DKIM1; k=rsa; p=MIGfMA0GCSq...\"",
   "originalText": "selector._domainkey.example.com. TXT\n  \"v=DKIM1; k=rsa; p=MIGfMA0GCSq...\"",
   "fontSize": 11,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "dkim",
   "lineHeight": 1.25
  },
  {
   "id": "s2n",
   "type": "text",
   "x": 620,
   "y": 518,
   "width": 442,
   "height": 90,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100034,
   "version": 1,
   "versionNonce": 700238,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "The sender signs selected headers and the body with a\nprivate key; the receiver fetches the public key from DNS\nand verifies. So the message carries proof of origin\nINDEPENDENT of which server delivered it - which is exactly\nwhat fixes forwarding, and exactly why DKIM exists: SPF's\nIP-based model could not survive how mail actually moves.",
   "originalText": "The sender signs selected headers and the body with a\nprivate key; the receiver fetches the public key from DNS\nand verifies. So the message carries proof of origin\nINDEPENDENT of which server delivered it - which is exactly\nwhat fixes forwarding, and exactly why DKIM exists: SPF's\nIP-based model could not survive how mail actually moves.",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "g2",
   "type": "rectangle",
   "x": 620,
   "y": 618,
   "width": 520,
   "height": 44,
   "strokeColor": "#b91c1c",
   "backgroundColor": "#fecaca",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100035,
   "version": 1,
   "versionNonce": 700245,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": [
    {
     "id": "g2_t",
