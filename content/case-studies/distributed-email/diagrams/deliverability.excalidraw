  },
  {
   "id": "el",
   "type": "text",
   "x": 30,
   "y": 1602,
   "width": 942,
   "height": 21,
   "strokeColor": "#1e40af",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100088,
   "version": 1,
   "versionNonce": 700616,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "Without a feedback loop you cannot tell 'delivered to the inbox' from 'delivered to spam'",
   "originalText": "Without a feedback loop you cannot tell 'delivered to the inbox' from 'delivered to spam'",
   "fontSize": 17,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "en",
   "type": "text",
   "x": 30,
   "y": 1640,
   "width": 1011,
   "height": 65,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100089,
   "version": 1,
   "versionNonce": 700623,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "The provider's spam decision is INVISIBLE otherwise: a message accepted with 250 OK and then filed in spam looks like a\nsuccessful delivery from your side. So an FBL feed is not a monitoring nicety - it is the input to an automated response, and\nthe threshold everyone works to is a complaint rate below ~0.1%, one per thousand delivered. Above that, providers throttle\nor block.",
   "originalText": "The provider's spam decision is INVISIBLE otherwise: a message accepted with 250 OK and then filed in spam looks like a\nsuccessful delivery from your side. So an FBL feed is not a monitoring nicety - it is the input to an automated response, and\nthe threshold everyone works to is a complaint rate below ~0.1%, one per thousand delivered. Above that, providers throttle\nor block.",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "fbl",
   "type": "rectangle",
   "x": 30,
   "y": 1730,
   "width": 900,
   "height": 90,
   "strokeColor": "#1e293b",
   "backgroundColor": "#1e293b",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100090,
   "version": 1,
   "versionNonce": 700630,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": [
