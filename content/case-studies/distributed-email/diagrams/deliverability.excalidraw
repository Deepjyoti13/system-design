     "id": "fbl_t",
     "type": "text"
    }
   ],
   "link": null,
   "locked": false,
   "roundness": {
    "type": 3
   }
  },
  {
   "id": "fbl_t",
   "type": "text",
   "x": 38,
   "y": 1752,
   "width": 884,
   "height": 45,
   "strokeColor": "#ffffff",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100091,
   "version": 1,
   "versionNonce": 700637,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "complaint rate rising on an IP        ->  reduce its volume, investigate the campaign\na single account generating complaints ->  suspend it immediately\nhard bounces (5xx: no such user)      ->  remove the address PERMANENTLY, from all lists",
   "originalText": "complaint rate rising on an IP        ->  reduce its volume, investigate the campaign\na single account generating complaints ->  suspend it immediately\nhard bounces (5xx: no such user)      ->  remove the address PERMANENTLY, from all lists",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "fbl",
   "lineHeight": 1.25
  },
  {
   "id": "en2",
   "type": "text",
   "x": 960,
   "y": 1730,
   "width": 591,
   "height": 90,
   "strokeColor": "#b45309",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100092,
   "version": 1,
   "versionNonce": 700644,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "That last rule matters more than it looks. Repeatedly sending to addresses that\ndo not exist is one of the strongest spam signals there is, because legitimate\nsenders maintain their lists and spammers work from purchased ones. So bounce\nhandling is not cleanup - it is reputation management, and a system that\nignores hard bounces will be classified as a spammer on the strength of that\nalone.",
   "originalText": "That last rule matters more than it looks. Repeatedly sending to addresses that\ndo not exist is one of the strongest spam signals there is, because legitimate\nsenders maintain their lists and spammers work from purchased ones. So bounce\nhandling is not cleanup - it is reputation management, and a system that\nignores hard bounces will be classified as a spammer on the strength of that\nalone.",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "d6",
   "type": "line",
   "x": 30,
   "y": 1856,
   "width": 1680,
   "height": 0,
   "strokeColor": "#cbd5e1",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
