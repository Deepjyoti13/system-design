   }
  },
  {
   "id": "g2_t",
   "type": "text",
   "x": 628,
   "y": 632,
   "width": 504,
   "height": 16,
   "strokeColor": "#374151",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100036,
   "version": 1,
   "versionNonce": 700252,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "the gap:  it says nothing about POLICY",
   "originalText": "the gap:  it says nothing about POLICY",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "g2",
   "lineHeight": 1.25
  },
  {
   "id": "g2n",
   "type": "text",
   "x": 620,
   "y": 674,
   "width": 398,
   "height": 45,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100037,
   "version": 1,
   "versionNonce": 700259,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "DKIM proves a signature is valid, but a receiver\nseeing an UNSIGNED message has no way to know whether\nthat domain signs its mail at all.",
   "originalText": "DKIM proves a signature is valid, but a receiver\nseeing an UNSIGNED message has no way to know whether\nthat domain signs its mail at all.",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "ch2",
