   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "the gap:  SPF BREAKS ON FORWARDING",
   "originalText": "the gap:  SPF BREAKS ON FORWARDING",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "g1",
   "lineHeight": 1.25
  },
  {
   "id": "g1n",
   "type": "text",
   "x": 30,
   "y": 634,
   "width": 398,
   "height": 75,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100029,
   "version": 1,
   "versionNonce": 700203,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "If Alice forwards a message to Bob, Bob's server sees\nALICE's server connecting while the message claims to\nbe from the original domain - so SPF fails on a\nperfectly legitimate message. Not an edge case:\nautomatic forwarding is extremely common.",
   "originalText": "If Alice forwards a message to Bob, Bob's server sees\nALICE's server connecting while the message claims to\nbe from the original domain - so SPF fails on a\nperfectly legitimate message. Not an edge case:\nautomatic forwarding is extremely common.",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
