   }
  },
  {
   "id": "rx_t",
   "type": "text",
   "x": 38,
   "y": 1927,
   "width": 884,
   "height": 60,
   "strokeColor": "#ffffff",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100096,
   "version": 1,
   "versionNonce": 700672,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "reject EARLY and CHEAPLY:\n  connection level: IP blocklisted? no reverse DNS? rate-limited?  -> 5xx, before DATA\n  envelope level:   recipient does not exist? SPF hard fail?        -> 5xx, before DATA\nthen accept, and score asynchronously",
   "originalText": "reject EARLY and CHEAPLY:\n  connection level: IP blocklisted? no reverse DNS? rate-limited?  -> 5xx, before DATA\n  envelope level:   recipient does not exist? SPF hard fail?        -> 5xx, before DATA\nthen accept, and score asynchronously",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "rx",
   "lineHeight": 1.25
  },
  {
   "id": "fn",
   "type": "text",
   "x": 960,
   "y": 1912,
   "width": 591,
   "height": 45,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100097,
   "version": 1,
   "versionNonce": 700679,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "Rejecting before accepting the body is what makes spam cheap to refuse: at spam\nvolumes, transferring 50 KB before deciding would mean most of your inbound\nbandwidth is spent on mail you discard.",
   "originalText": "Rejecting before accepting the body is what makes spam cheap to refuse: at spam\nvolumes, transferring 50 KB before deciding would mean most of your inbound\nbandwidth is spent on mail you discard.",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "fn2",
   "type": "text",
   "x": 960,
   "y": 1976,
   "width": 591,
   "height": 90,
   "strokeColor": "#1e40af",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100098,
   "version": 1,
   "versionNonce": 700686,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "And the reciprocal rule: use 4xx for TEMPORARY problems and 5xx for PERMANENT\nones, honestly. A receiver that returns 5xx for a transient issue makes\nlegitimate mail bounce permanently; one that returns 4xx for a permanent\nproblem makes senders retry for days against a nonexistent address. Both damage\nyour standing as a receiver, and both are trivially avoidable by getting the\ncode right.",
   "originalText": "And the reciprocal rule: use 4xx for TEMPORARY problems and 5xx for PERMANENT\nones, honestly. A receiver that returns 5xx for a transient issue makes\nlegitimate mail bounce permanently; one that returns 4xx for a permanent\nproblem makes senders retry for days against a nonexistent address. Both damage\nyour standing as a receiver, and both are trivially avoidable by getting the\ncode right.",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
