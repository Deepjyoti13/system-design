   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "The last row deserves the emphasis: the fastest way to destroy a mail system's reputation is one compromised account sending a\nmillion messages before anyone notices. So per-account send limits are a REPUTATION CONTROL, not an abuse-prevention nicety -\nand they belong on the synchronous send path, where they can actually stop it.",
   "originalText": "The last row deserves the emphasis: the fastest way to destroy a mail system's reputation is one compromised account sending a\nmillion messages before anyone notices. So per-account send limits are a REPUTATION CONTROL, not an abuse-prevention nicety -\nand they belong on the synchronous send path, where they can actually stop it.",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
