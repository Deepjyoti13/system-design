   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "a user's mail lives on a specific server, so that server is a single point of failure for that\nuser, and capacity planning becomes per-user placement.",
   "originalText": "a user's mail lives on a specific server, so that server is a single point of failure for that\nuser, and capacity planning becomes per-user placement.",
