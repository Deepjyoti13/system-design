   "roundness": null
  },
  {
   "id": "el",
   "type": "text",
   "x": 30,
   "y": 1638,
   "width": 1036,
   "height": 21,
   "strokeColor": "#1e40af",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100047,
   "version": 1,
   "versionNonce": 700329,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "SMTP has backpressure built in - which is unusual, and worth exploiting rather than working around",
   "originalText": "SMTP has backpressure built in - which is unusual, and worth exploiting rather than working around",
   "fontSize": 17,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
