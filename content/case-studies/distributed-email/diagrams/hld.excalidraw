   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "The sending server deletes its copy on that reply. Acknowledge first and lose it, and the email is gone with nobody holding a copy and nobody knowing.",
