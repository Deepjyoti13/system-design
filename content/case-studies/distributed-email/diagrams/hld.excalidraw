  {
   "id": "rcv1_t",
   "type": "text",
   "x": 38,
   "y": 463,
   "width": 844,
   "height": 75,
   "strokeColor": "#ffffff",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
