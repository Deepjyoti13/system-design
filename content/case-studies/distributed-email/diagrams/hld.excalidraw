  {
   "id": "ssn",
   "type": "text",
   "x": 880,
   "y": 2094,
   "width": 502,
   "height": 30,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100060,
   "version": 1,
   "versionNonce": 700420,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "deliver to Inbox with a lower confidence flag: a delayed legitimate\nemail is worse than an unfiltered spam one.",
   "originalText": "deliver to Inbox with a lower confidence flag: a delayed legitimate\nemail is worse than an unfiltered spam one.",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "fn",
   "type": "text",
   "x": 30,
   "y": 2148,
   "width": 987,
   "height": 32,
   "strokeColor": "#1e40af",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100061,
   "version": 1,
   "versionNonce": 700427,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "Two scanners, opposite policies, because the ASYMMETRY OF HARM differs. Naming which way each one fails is the whole point\nof putting a circuit breaker around it - a breaker with an unexamined default is just a hidden policy decision.",
   "originalText": "Two scanners, opposite policies, because the ASYMMETRY OF HARM differs. Naming which way each one fails is the whole point\nof putting a circuit breaker around it - a breaker with an unexamined default is just a hidden policy decision.",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "d7",
   "type": "line",
   "x": 30,
   "y": 2210,
   "width": 1680,
