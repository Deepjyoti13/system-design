   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "deliver to quarantine rather than to the inbox: delivering an\nunscanned executable is worse than delaying mail.",
   "originalText": "deliver to quarantine rather than to the inbox: delivering an\nunscanned executable is worse than delaying mail.",
   "fontSize": 12,
