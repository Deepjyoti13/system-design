   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "listing a folder means stat()ing thousands of files; marking one read means rewriting a file.\nEvery operation is random I/O against a 100-150 IOPS drive.",
   "originalText": "listing a folder means stat()ing thousands of files; marking one read means rewriting a file.\nEvery operation is random I/O against a 100-150 IOPS drive.",
