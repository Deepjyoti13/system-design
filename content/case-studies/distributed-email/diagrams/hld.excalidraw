   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "40 billion emails/day is 40 billion files/day. ext4 provisions inodes at format time, so you\nhit a ceiling with free bytes remaining - and fsck time scales with inode count.",
   "originalText": "40 billion emails/day is 40 billion files/day. ext4 provisions inodes at format time, so you\nhit a ceiling with free bytes remaining - and fsck time scales with inode count.",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
