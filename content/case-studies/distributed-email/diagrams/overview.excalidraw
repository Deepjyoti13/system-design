  },
  {
   "id": "apd_30",
   "type": "text",
   "x": 56,
   "y": 1730,
   "width": 390,
   "height": 105,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100102,
   "version": 1,
   "versionNonce": 700714,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "the system has taken the message and will ATTEMPT\ndelivery; it cannot promise the recipient's server\nwill accept it. Delivery may take seconds or, with\nretries against an unavailable destination, days.\nReporting 200 would claim a guarantee SMTP\nfundamentally cannot provide - and a bounce arriving\nfour hours later is a normal outcome, not an error.",
   "originalText": "the system has taken the message and will ATTEMPT\ndelivery; it cannot promise the recipient's server\nwill accept it. Delivery may take seconds or, with\nretries against an unavailable destination, days.\nReporting 200 would claim a guarantee SMTP\nfundamentally cannot provide - and a bounce arriving\nfour hours later is a normal outcome, not an error.",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
