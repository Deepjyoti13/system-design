   ],
   "roundness": null
  },
  {
   "id": "cl",
   "type": "text",
   "x": 30,
   "y": 808,
   "width": 826,
   "height": 21,
   "strokeColor": "#1e40af",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100053,
   "version": 1,
   "versionNonce": 700371,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "Email is a federated protocol, not a product - so you do not control both ends",
   "originalText": "Email is a federated protocol, not a product - so you do not control both ends",
   "fontSize": 17,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "cn",
   "type": "text",
   "x": 30,
   "y": 846,
   "width": 1019,
   "height": 48,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100054,
   "version": 1,
   "versionNonce": 700378,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "A message leaves your servers and arrives at Gmail, at Outlook, or at a Postfix box somebody runs in their basement, over SMTP\n- a protocol from 1982. You cannot change it, cannot version it, and cannot assume the other side is well-behaved. Whole\nsections of this design exist because of that, and it is what makes email unlike a chat system.",
   "originalText": "A message leaves your servers and arrives at Gmail, at Outlook, or at a Postfix box somebody runs in their basement, over SMTP\n- a protocol from 1982. You cannot change it, cannot version it, and cannot assume the other side is well-behaved. Whole\nsections of this design exist because of that, and it is what makes email unlike a chat system.",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "ph30",
   "type": "text",
   "x": 30,
   "y": 924,
   "width": 68,
   "height": 16,
   "strokeColor": "#1e40af",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
