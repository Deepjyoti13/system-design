   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "1  separate content from per-recipient state",
   "originalText": "1  separate content from per-recipient state",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "idd_30",
   "type": "text",
   "x": 56,
   "y": 1320,
   "width": 405,
   "height": 60,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100077,
   "version": 1,
   "versionNonce": 700539,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "the body and attachments are stored once, content-\naddressed; each recipient gets a small metadata row\npointing at them, carrying their own read flag, folder\nand labels. The 4x storage win.",
   "originalText": "the body and attachments are stored once, content-\naddressed; each recipient gets a small metadata row\npointing at them, carrying their own read flag, folder\nand labels. The 4x storage win.",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "id_450",
