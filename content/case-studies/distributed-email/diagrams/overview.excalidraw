   "versionNonce": 700574,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "3  accept the mail, THEN process it",
   "originalText": "3  accept the mail, THEN process it",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "idd_870",
   "type": "text",
   "x": 896,
   "y": 1320,
   "width": 413,
   "height": 90,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100083,
   "version": 1,
   "versionNonce": 700581,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "inbound SMTP is acknowledged as soon as the message is\ndurably queued; spam checks, indexing and fan-out\nhappen asynchronously. Under SMTP, accepting a message\nmeans TAKING RESPONSIBILITY for it - so the queue write\nmust be durable BEFORE the acknowledgement, and\neverything after can be retried.",
   "originalText": "inbound SMTP is acknowledged as soon as the message is\ndurably queued; spam checks, indexing and fan-out\nhappen asynchronously. Under SMTP, accepting a message\nmeans TAKING RESPONSIBILITY for it - so the queue write\nmust be durable BEFORE the acknowledgement, and\neverything after can be retried.",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
