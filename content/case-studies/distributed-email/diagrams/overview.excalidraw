  },
  {
   "id": "bn2",
   "type": "text",
   "x": 30,
   "y": 716,
   "width": 1011,
   "height": 48,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100051,
   "version": 1,
   "versionNonce": 700357,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "1B users x 10 sent/day = 10 BILLION emails sent/day (~116,000 sends/sec), and 1B x 40 received = 40 BILLION recipient copies.\nThe metadata itself is small by comparison - 40 billion rows/day at ~500 bytes is 20 TB/day - but it is the part that must be\nQUERYABLE, which is why the schema separates it from the content entirely.",
   "originalText": "1B users x 10 sent/day = 10 BILLION emails sent/day (~116,000 sends/sec), and 1B x 40 received = 40 BILLION recipient copies.\nThe metadata itself is small by comparison - 40 billion rows/day at ~500 bytes is 20 TB/day - but it is the part that must be\nQUERYABLE, which is why the schema separates it from the content entirely.",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "d3",
   "type": "line",
   "x": 30,
   "y": 790,
   "width": 1680,
   "height": 0,
   "strokeColor": "#cbd5e1",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100052,
   "version": 1,
   "versionNonce": 700364,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "points": [
