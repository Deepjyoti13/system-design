  },
  {
   "id": "idn_450",
   "type": "text",
   "x": 476,
   "y": 1294,
   "width": 278,
   "height": 16,
   "strokeColor": "#1e40af",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100079,
   "version": 1,
   "versionNonce": 700553,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "2  partition everything by user_id",
   "originalText": "2  partition everything by user_id",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "idd_450",
   "type": "text",
   "x": 476,
   "y": 1320,
   "width": 413,
   "height": 90,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100080,
   "version": 1,
   "versionNonce": 700560,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "almost every operation - fetch a folder, mark read,\nsearch, delete - is scoped to ONE user and never spans\nusers. So every operation is single-partition with no\ncross-node coordination. The cost: a shared mailbox\ngenuinely owned by several users does not fit, and this\ndesign accepts that rather than paying for it.",
   "originalText": "almost every operation - fetch a folder, mark read,\nsearch, delete - is scoped to ONE user and never spans\nusers. So every operation is single-partition with no\ncross-node coordination. The cost: a shared mailbox\ngenuinely owned by several users does not fit, and this\ndesign accepts that rather than paying for it.",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
