   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "two reasons: a 25 MB upload should not block\ncomposing, and the hash is what enables the dedup\nworth 1 PB/day. A client re-attaching a file the\nserver already has can skip the upload entirely.",
   "originalText": "two reasons: a 25 MB upload should not block\ncomposing, and the hash is what enables the dedup\nworth 1 PB/day. A client re-attaching a file the\nserver already has can skip the upload entirely.",
   "fontSize": 12,
   "fontFamily": 3,
