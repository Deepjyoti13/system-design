   "link": null,
   "locked": false
  },
  {
   "id": "idn_30",
   "type": "text",
   "x": 56,
   "y": 1294,
   "width": 358,
   "height": 16,
   "strokeColor": "#1e40af",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
