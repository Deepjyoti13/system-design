   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "That single fact drives the engine choice, and it is the most commonly missed point about email search: an index optimized for\nquery latency at the cost of write amplification is exactly the wrong trade here.",
   "originalText": "That single fact drives the engine choice, and it is the most commonly missed point about email search: an index optimized for\nquery latency at the cost of write amplification is exactly the wrong trade here.",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
