   "text": "4  treat deliverability as an engineering problem",
   "originalText": "4  treat deliverability as an engineering problem",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "idd_1290",
   "type": "text",
   "x": 1316,
   "y": 1320,
   "width": 420,
   "height": 90,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
