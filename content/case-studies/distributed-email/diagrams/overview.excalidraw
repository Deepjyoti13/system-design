   "version": 1,
   "versionNonce": 700602,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "standing up an SMTP server is trivial; getting mail into\nan inbox rather than a spam folder is a months-long\nreputation exercise - dedicated IPs, gradual warm-up,\nSPF/DKIM/DMARC, feedback loops with the large providers.\nAn interviewer asking 'how do you build Gmail' is asking\nabout this whether they know it or not.",
   "originalText": "standing up an SMTP server is trivial; getting mail into\nan inbox rather than a spam folder is a months-long\nreputation exercise - dedicated IPs, gradual warm-up,\nSPF/DKIM/DMARC, feedback loops with the large providers.\nAn interviewer asking 'how do you build Gmail' is asking\nabout this whether they know it or not.",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
