    { "type": "text", "id": "caption1", "x": 20, "y": 498, "width": 940, "height": 20,
      "text": "The matchmaker never scans every waiting player -- only the ones already inside the current window.",
      "originalText": "The matchmaker never scans every waiting player -- only the ones already inside the current window.",
      "fontSize": 14, "fontFamily": 3, "textAlign": "center", "verticalAlign": "top",
      "strokeColor": "#1e293b", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 20080, "version": 1, "versionNonce": 30080, "isDeleted": false, "groupIds": [],
      "boundElements": null, "link": null, "locked": false, "lineHeight": 1.25 },
    { "type": "text", "id": "caption2", "x": 20, "y": 521, "width": 940, "height": 20,
      "text": "It widens the window on a timer, and stops the instant two players' windows overlap.",
      "originalText": "It widens the window on a timer, and stops the instant two players' windows overlap.",
      "fontSize": 14, "fontFamily": 3, "textAlign": "center", "verticalAlign": "top",
      "strokeColor": "#1e293b", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 20081, "version": 1, "versionNonce": 30081, "isDeleted": false, "groupIds": [],
      "boundElements": null, "link": null, "locked": false, "lineHeight": 1.25 },
    { "type": "text", "id": "final_caption", "x": 20, "y": 554, "width": 940, "height": 20,
      "text": "A narrow window is fairer; a wide window is faster -- widening on a clock gets both, in the right order.",
      "originalText": "A narrow window is fairer; a wide window is faster -- widening on a clock gets both, in the right order.",
      "fontSize": 14, "fontFamily": 3, "textAlign": "center", "verticalAlign": "top",
      "strokeColor": "#1e40af", "backgroundColor": "transparent", "fillStyle": "solid",
