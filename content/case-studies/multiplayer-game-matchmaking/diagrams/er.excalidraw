  },
  {
   "id": "shd_600",
   "type": "text",
   "x": 626,
   "y": 1600,
   "width": 450,
   "height": 60,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
