   "versionNonce": 700819,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "a game's full move history stays on ONE shard, so 'this\ngame's moves, in order' and the crash-recovery replay are\nalways single-shard operations - the same reasoning behind\nsharding messages by conversation_id.",
   "originalText": "a game's full move history stays on ONE shard, so 'this\ngame's moves, in order' and the crash-recovery replay are\nalways single-shard operations - the same reasoning behind\nsharding messages by conversation_id.",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
