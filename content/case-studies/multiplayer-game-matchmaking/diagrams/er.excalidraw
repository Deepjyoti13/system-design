   "locked": false,
   "text": "Indexes - each matching one query that actually runs",
   "originalText": "Indexes - each matching one query that actually runs",
   "fontSize": 17,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
