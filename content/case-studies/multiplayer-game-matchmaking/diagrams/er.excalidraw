   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "games and moves  ->  by game_id",
   "originalText": "games and moves  ->  by game_id",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
