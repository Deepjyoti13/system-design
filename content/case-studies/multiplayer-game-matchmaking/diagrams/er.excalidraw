   "locked": false,
   "text": "The other side: the matchmaking pool, which is not a database table at all",
   "originalText": "The other side: the matchmaking pool, which is not a database table at all",
   "fontSize": 17,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
