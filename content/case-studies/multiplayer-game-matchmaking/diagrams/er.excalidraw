  },
  {
   "id": "pool_t",
   "type": "text",
   "x": 38,
   "y": 683,
   "width": 884,
   "height": 75,
   "strokeColor": "#ffffff",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
