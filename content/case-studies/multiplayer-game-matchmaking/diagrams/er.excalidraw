   "text": "the pool  ->  by time_control, then rating band",
   "originalText": "the pool  ->  by time_control, then rating band",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
