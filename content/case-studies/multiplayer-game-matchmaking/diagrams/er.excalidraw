   "version": 1,
   "versionNonce": 700840,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "unlike a merchant-keyed payments ledger, a rating lookup is\nalways single-player and never needs colocating with\nanything else - so an arbitrary, evenly-distributing hash is\nthe right choice here rather than a compromise.",
   "originalText": "unlike a merchant-keyed payments ledger, a rating lookup is\nalways single-player and never needs colocating with\nanything else - so an arbitrary, evenly-distributing hash is\nthe right choice here rather than a compromise.",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
