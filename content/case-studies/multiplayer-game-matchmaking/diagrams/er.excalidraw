   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100123,
   "version": 1,
   "versionNonce": 700861,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "a correctness partition first (never match a blitz player\nfrom a classical pool), a capacity partition second.",
   "originalText": "a correctness partition first (never match a blitz player\nfrom a classical pool), a capacity partition second.",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "en",
   "type": "text",
   "x": 30,
   "y": 1682,
   "width": 1027,
   "height": 48,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100124,
   "version": 1,
   "versionNonce": 700868,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "And the replica-versus-shard distinction once more: replicas solve read throughput for profile pages and rating-history graphs;\nsharding solves the write volume and per-game locality that games and moves actually need. Reaching for one when the other is\nthe real bottleneck is the mistake to avoid.",
   "originalText": "And the replica-versus-shard distinction once more: replicas solve read throughput for profile pages and rating-history graphs;\nsharding solves the write volume and per-game locality that games and moves actually need. Reaching for one when the other is\nthe real bottleneck is the mistake to avoid.",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
