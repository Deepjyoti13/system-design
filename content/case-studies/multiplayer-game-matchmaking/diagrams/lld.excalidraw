  {
   "id": "tick_t",
   "type": "text",
   "x": 38,
   "y": 531,
   "width": 884,
   "height": 180,
   "strokeColor": "#ffffff",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100033,
   "version": 1,
   "versionNonce": 700231,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "MatchFormationService.tick():\n    for ticket in pool.allWaitingSortedByWaitTime():   # oldest first - FAIRNESS\n        window = widen(ticket.wait_seconds)\n        for candidate in pool.findCandidates(ticket.player_id,\n                                            ticket.rating, window):\n            if candidate.player_id == ticket.player_id: continue\n            if pool.removeBoth(ticket.player_id,\n                               candidate.player_id):   # ATOMIC CONDITIONAL\n                game_id  = allocateGame(ticket, candidate)\n                instance = sessionRouter.assign(game_id)\n                notify(both players, game_id, instance)\n                break    # this ticket is resolved - on to the next",
   "originalText": "MatchFormationService.tick():\n    for ticket in pool.allWaitingSortedByWaitTime():   # oldest first - FAIRNESS\n        window = widen(ticket.wait_seconds)\n        for candidate in pool.findCandidates(ticket.player_id,\n                                            ticket.rating, window):\n            if candidate.player_id == ticket.player_id: continue\n            if pool.removeBoth(ticket.player_id,\n                               candidate.player_id):   # ATOMIC CONDITIONAL\n                game_id  = allocateGame(ticket, candidate)\n                instance = sessionRouter.assign(game_id)\n                notify(both players, game_id, instance)\n                break    # this ticket is resolved - on to the next",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "tick",
   "lineHeight": 1.25
  },
