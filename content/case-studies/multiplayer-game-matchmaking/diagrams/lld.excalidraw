   }
  },
  {
   "id": "elo_t",
   "type": "text",
   "x": 38,
   "y": 1297,
   "width": 844,
   "height": 48,
   "strokeColor": "#ffffff",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100064,
   "version": 1,
   "versionNonce": 700448,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "E_A  = 1 / (1 + 10^((R_B - R_A) / 400))        # a SMOOTH function of the gap\nS_A  = 1 (win) | 0.5 (draw) | 0 (loss)\nR_A' = R_A + K * (S_A - E_A)",
   "originalText": "E_A  = 1 / (1 + 10^((R_B - R_A) / 400))        # a SMOOTH function of the gap\nS_A  = 1 (win) | 0.5 (draw) | 0 (loss)\nR_A' = R_A + K * (S_A - E_A)",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "elo",
   "lineHeight": 1.25
  },
  {
   "id": "dn",
   "type": "text",
   "x": 920,
   "y": 1266,
   "width": 614,
   "height": 60,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100065,
   "version": 1,
   "versionNonce": 700455,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "The K-FACTOR controls how much a single game can move a rating: a new, provisional\nplayer uses a LARGER K, because their early games should correct a bad initial\nestimate fast; an established player uses a smaller one, because a single upset\nshould not swing a stable rating wildly.",
   "originalText": "The K-FACTOR controls how much a single game can move a rating: a new, provisional\nplayer uses a LARGER K, because their early games should correct a bad initial\nestimate fast; an established player uses a smaller one, because a single upset\nshould not swing a stable rating wildly.",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "dn2",
   "type": "text",
   "x": 920,
   "y": 1346,
   "width": 606,
   "height": 60,
   "strokeColor": "#047857",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100066,
   "version": 1,
   "versionNonce": 700462,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "Both ratings update from the same game in ONE call, because E_A + E_B = 1 and the\ntwo deltas are equal and opposite - the same reasoning a double-entry ledger uses\nfor a debit and a credit always summing to zero, applied to a rating exchange\ninstead of money.",
   "originalText": "Both ratings update from the same game in ONE call, because E_A + E_B = 1 and the\ntwo deltas are equal and opposite - the same reasoning a double-entry ledger uses\nfor a debit and a credit always summing to zero, applied to a rating exchange\ninstead of money.",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
