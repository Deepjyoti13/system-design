   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "A wider window trades match quality for wait time -\nand the trade only ever moves in one direction, which\nis what keeps it predictable.",
   "originalText": "A wider window trades match quality for wait time -\nand the trade only ever moves in one direction, which\nis what keeps it predictable.",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "bn2",
   "type": "text",
   "x": 30,
   "y": 756,
   "width": 1027,
   "height": 48,
   "strokeColor": "#047857",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100052,
   "version": 1,
   "versionNonce": 700364,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "pool.removeBoth() is the ENTIRE concurrency-safety mechanism for matchmaking, deliberately mirroring the job scheduler's atomic\nclaim: many MatchFormationService instances run this tick concurrently, and for a given pair of players only ONE instance's\nremoveBoth call can succeed.",
   "originalText": "pool.removeBoth() is the ENTIRE concurrency-safety mechanism for matchmaking, deliberately mirroring the job scheduler's atomic\nclaim: many MatchFormationService instances run this tick concurrently, and for a given pair of players only ONE instance's\nremoveBoth call can succeed.",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
