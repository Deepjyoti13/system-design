    { "type": "text", "id": "final_caption1", "x": 20, "y": 618, "width": 1260, "height": 20,
      "text": "Matchmaking is stateless and resolves in seconds; the Game Server fleet is stateful and holds one board for the life of a game.",
      "originalText": "Matchmaking is stateless and resolves in seconds; the Game Server fleet is stateful and holds one board for the life of a game.",
      "fontSize": 14, "fontFamily": 3, "textAlign": "center", "verticalAlign": "top",
      "strokeColor": "#1e293b", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 40180, "version": 1, "versionNonce": 50180, "isDeleted": false, "groupIds": [],
      "boundElements": null, "link": null, "locked": false, "lineHeight": 1.25 },
    { "type": "text", "id": "final_caption2", "x": 20, "y": 641, "width": 1260, "height": 20,
      "text": "Session Router is the seam between them -- the one deliberate exception to this guide's stateless-behind-a-load-balancer default.",
      "originalText": "Session Router is the seam between them -- the one deliberate exception to this guide's stateless-behind-a-load-balancer default.",
