   "version": 1,
   "versionNonce": 700546,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "What gets shed under overload, in order",
   "originalText": "What gets shed under overload, in order",
   "fontSize": 14,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "shn",
   "type": "text",
   "x": 30,
   "y": 1814,
   "width": 995,
   "height": 113,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100079,
   "version": 1,
   "versionNonce": 700553,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "1  search and browse            served from a longer-TTL cache: staler data, no extra database load\n2  availability checks          rate-limited per user. Somebody refreshing a sold-out hotel every second is pure load.\n3  new reservations             503 with Retry-After - safe, because the client's reservation_id makes the retry free\n4  NEVER shed cancellations     refusing a cancellation holds inventory hostage and creates a support case AND a lost sale.\n                                Same inversion the stock exchange makes about order cancels: under stress, letting people\n                                WITHDRAW matters more than letting them commit.\n5  NEVER shed confirming a paid reservation                                                    the money has already moved.",
   "originalText": "1  search and browse            served from a longer-TTL cache: staler data, no extra database load\n2  availability checks          rate-limited per user. Somebody refreshing a sold-out hotel every second is pure load.\n3  new reservations             503 with Retry-After - safe, because the client's reservation_id makes the retry free\n4  NEVER shed cancellations     refusing a cancellation holds inventory hostage and creates a support case AND a lost sale.\n                                Same inversion the stock exchange makes about order cancels: under stress, letting people\n                                WITHDRAW matters more than letting them commit.\n5  NEVER shed confirming a paid reservation                                                    the money has already moved.",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
