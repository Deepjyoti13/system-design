   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "hotel and room-type detail: near-static, cached with a long TTL, and the highest-volume read path",
   "originalText": "hotel and room-type detail: near-static, cached with a long TTL, and the highest-volume read path",
   "fontSize": 11,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "sn2",
   "type": "text",
   "x": 710,
   "y": 186,
   "width": 658,
   "height": 41,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100024,
   "version": 1,
   "versionNonce": 700168,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "per-date pricing. Its data changes daily and is owned by a DIFFERENT TEAM (revenue management)\nwith its own tooling and approval flow - an ownership difference that is a stronger argument for\nthe boundary than any technical one",
   "originalText": "per-date pricing. Its data changes daily and is owned by a DIFFERENT TEAM (revenue management)\nwith its own tooling and approval flow - an ownership difference that is a stronger argument for\nthe boundary than any technical one",
   "fontSize": 11,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "sn3",
   "type": "text",
