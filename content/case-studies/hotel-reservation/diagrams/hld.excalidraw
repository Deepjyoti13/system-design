   "roundness": null
  },
  {
   "id": "dl",
   "type": "text",
   "x": 30,
   "y": 1244,
   "width": 509,
   "height": 21,
   "strokeColor": "#1e40af",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100062,
   "version": 1,
   "versionNonce": 700434,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "The other three paths - each with one idea in it",
   "originalText": "The other three paths - each with one idea in it",
   "fontSize": 17,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "rp",
   "type": "text",
   "x": 30,
   "y": 1282,
   "width": 438,
   "height": 17,
   "strokeColor": "#1e40af",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100063,
   "version": 1,
   "versionNonce": 700441,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "availability check   ~300/sec, from a READ REPLICA",
   "originalText": "availability check   ~300/sec, from a READ REPLICA",
   "fontSize": 14,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "rpn",
   "type": "text",
   "x": 30,
   "y": 1308,
   "width": 524,
   "height": 105,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100064,
   "version": 1,
   "versionNonce": 700448,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "Deliberately from a replica. Availability shown to a browsing user is\nallowed to be slightly stale, because the authoritative check happens\nAGAIN inside the booking transaction. DISPLAYING availability and\nGUARANTEEING availability are two different operations, and conflating\nthem would push all read traffic onto the primary for no benefit.\nThe cost is that a user can see '1 room left' and then lose the race -\nwhich is exactly what the 409 is for.",
   "originalText": "Deliberately from a replica. Availability shown to a browsing user is\nallowed to be slightly stale, because the authoritative check happens\nAGAIN inside the booking transaction. DISPLAYING availability and\nGUARANTEEING availability are two different operations, and conflating\nthem would push all read traffic onto the primary for no benefit.\nThe cost is that a user can see '1 room left' and then lose the race -\nwhich is exactly what the 409 is for.",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "cx",
   "type": "text",
   "x": 600,
   "y": 1282,
   "width": 385,
   "height": 17,
   "strokeColor": "#047857",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100065,
   "version": 1,
   "versionNonce": 700455,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "cancellation   guarded, therefore idempotent",
   "originalText": "cancellation   guarded, therefore idempotent",
   "fontSize": 14,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "cxc",
   "type": "rectangle",
   "x": 600,
   "y": 1308,
   "width": 520,
   "height": 90,
   "strokeColor": "#1e293b",
   "backgroundColor": "#1e293b",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100066,
   "version": 1,
   "versionNonce": 700462,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": [
    {
     "id": "cxc_t",
     "type": "text"
    }
   ],
   "link": null,
   "locked": false,
   "roundness": {
    "type": 3
   }
  },
  {
   "id": "cxc_t",
   "type": "text",
   "x": 608,
   "y": 1325,
   "width": 504,
   "height": 55,
   "strokeColor": "#ffffff",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100067,
   "version": 1,
   "versionNonce": 700469,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "UPDATE reservation SET status='cancelled'\n WHERE reservation_id=? AND status='confirmed'\n  -> 0 rows => already cancelled or never confirmed\nUPDATE room_type_inventory SET total_reserved = ... - :n",
   "originalText": "UPDATE reservation SET status='cancelled'\n WHERE reservation_id=? AND status='confirmed'\n  -> 0 rows => already cancelled or never confirmed\nUPDATE room_type_inventory SET total_reserved = ... - :n",
   "fontSize": 11,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "cxc",
   "lineHeight": 1.25
  },
  {
   "id": "cxn",
   "type": "text",
   "x": 600,
   "y": 1412,
   "width": 465,
   "height": 75,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100068,
   "version": 1,
   "versionNonce": 700476,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "The AND status='confirmed' guard is what makes cancellation\nidempotent: a double-click releases inventory once, not twice.\nWithout it, two cancellations decrement inventory twice and\nsilently manufacture availability - a bug that manifests as\nOVERSELLING WITH NO OVERSELL IN THE LOGS.",
   "originalText": "The AND status='confirmed' guard is what makes cancellation\nidempotent: a double-click releases inventory once, not twice.\nWithout it, two cancellations decrement inventory twice and\nsilently manufacture availability - a bug that manifests as\nOVERSELLING WITH NO OVERSELL IN THE LOGS.",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "hz",
   "type": "text",
   "x": 1180,
   "y": 1282,
   "width": 299,
   "height": 17,
   "strokeColor": "#b45309",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100069,
   "version": 1,
   "versionNonce": 700483,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "horizon extension   a nightly cron",
   "originalText": "horizon extension   a nightly cron",
   "fontSize": 14,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "hzn",
   "type": "text",
   "x": 1180,
   "y": 1308,
   "width": 413,
   "height": 135,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100070,
   "version": 1,
   "versionNonce": 700490,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "The booking horizon is finite, so rows are pre-created\nand the far edge is extended daily: for each (hotel,\nroom_type), INSERT a row for today + 2 years.\n\nA booking beyond the horizon returns 422 rather than\nsilently creating rows - because an inventory row\nimplicitly asserts a total_inventory, and inventing one\nfor a date nobody has planned for is worse than\nrefusing.",
   "originalText": "The booking horizon is finite, so rows are pre-created\nand the far edge is extended daily: for each (hotel,\nroom_type), INSERT a row for today + 2 years.\n\nA booking beyond the horizon returns 422 rather than\nsilently creating rows - because an inventory row\nimplicitly asserts a total_inventory, and inventing one\nfor a date nobody has planned for is worse than\nrefusing.",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "d5",
   "type": "line",
   "x": 30,
   "y": 1500,
   "width": 1680,
   "height": 0,
   "strokeColor": "#cbd5e1",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100071,
   "version": 1,
   "versionNonce": 700497,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "points": [
    [
     0,
     0
    ],
    [
     1680,
     0
    ]
   ],
   "roundness": null
  },
  {
   "id": "el",
   "type": "text",
   "x": 30,
   "y": 1518,
   "width": 1015,
   "height": 21,
   "strokeColor": "#1e40af",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100072,
   "version": 1,
   "versionNonce": 700504,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "Low throughput, high contention on a few keys - the opposite of every other design in this guide",
   "originalText": "Low throughput, high contention on a few keys - the opposite of every other design in this guide",
   "fontSize": 17,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "en",
   "type": "text",
   "x": 30,
   "y": 1556,
   "width": 1019,
   "height": 48,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100073,
   "version": 1,
   "versionNonce": 700511,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "Aggregate load is trivial: 3 writes/sec, 3,000 reads/sec. The genuine peak is CONTENTION, NOT VOLUME - a popular resort during\na holiday week means many users converging on the SAME INVENTORY ROWS. Backpressure therefore appears on one contended row's\nlock queue, and no amount of sharding helps, because the contention is on a SINGLE LOGICAL KEY.",
   "originalText": "Aggregate load is trivial: 3 writes/sec, 3,000 reads/sec. The genuine peak is CONTENTION, NOT VOLUME - a popular resort during\na holiday week means many users converging on the SAME INVENTORY ROWS. Backpressure therefore appears on one contended row's\nlock queue, and no amount of sharding helps, because the contention is on a SINGLE LOGICAL KEY.",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "m1",
   "type": "text",
   "x": 30,
   "y": 1626,
   "width": 503,
   "height": 16,
   "strokeColor": "#047857",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100074,
   "version": 1,
   "versionNonce": 700518,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "mitigation 1   shorten the transaction to the absolute minimum",
   "originalText": "mitigation 1   shorten the transaction to the absolute minimum",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "m1n",
   "type": "text",
   "x": 30,
   "y": 1650,
   "width": 800,
   "height": 15,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100075,
   "version": 1,
   "versionNonce": 700525,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "which is exactly why payment is outside it: the lock is held for the duration of one UPDATE - microseconds.",
   "originalText": "which is exactly why payment is outside it: the lock is held for the duration of one UPDATE - microseconds.",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "m2",
   "type": "text",
   "x": 30,
   "y": 1686,
   "width": 648,
   "height": 16,
   "strokeColor": "#b45309",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100076,
   "version": 1,
   "versionNonce": 700532,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "mitigation 2   split a room type's inventory into N sub-counters, summed on read",
   "originalText": "mitigation 2   split a room type's inventory into N sub-counters, summed on read",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
