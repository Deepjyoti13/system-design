  {
   "id": "fn",
   "type": "text",
   "x": 30,
   "y": 2178,
   "width": 1019,
   "height": 65,
   "strokeColor": "#1e40af",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
