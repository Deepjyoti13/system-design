   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "One BEGIN ... COMMIT gives the double-booking guarantee for free:\nno protocol, no coordinator, no compensation logic, and no window\nof inconsistency.",
