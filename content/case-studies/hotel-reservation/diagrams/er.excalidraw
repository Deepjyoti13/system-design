   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "WHERE hotel_id = 245 AND room_type_id = 1001 AND date >= '2026-06-01' AND date < '2026-06-04'",
   "originalText": "WHERE hotel_id = 245 AND room_type_id = 1001 AND date >= '2026-06-01' AND date < '2026-06-04'",
