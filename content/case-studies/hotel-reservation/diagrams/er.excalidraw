  },
  {
   "id": "good_t",
   "type": "text",
   "x": 38,
   "y": 1184,
   "width": 744,
   "height": 16,
   "strokeColor": "#374151",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100131,
   "version": 1,
   "versionNonce": 700917,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "date LAST   ->   one B-tree descent plus a short sequential scan",
   "originalText": "date LAST   ->   one B-tree descent plus a short sequential scan",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "good",
   "lineHeight": 1.25
  },
  {
   "id": "goodn",
   "type": "text",
   "x": 30,
   "y": 1228,
   "width": 539,
   "height": 75,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100132,
   "version": 1,
   "versionNonce": 700924,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "All of one room type's dates are physically contiguous, so a stay of any\nlength is one descent and a short scan - true for BOTH the availability\nread and the booking UPDATE, which is why the booking transaction is\nshort enough to make locking a non-issue. The range scan also gives lock\nordering by date for free.",
   "originalText": "All of one room type's dates are physically contiguous, so a stay of any\nlength is one descent and a short scan - true for BOTH the availability\nread and the booking UPDATE, which is why the booking transaction is\nshort enough to make locking a non-issue. The range scan also gives lock\nordering by date for free.",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "bad",
   "type": "rectangle",
   "x": 860,
   "y": 1170,
   "width": 760,
   "height": 44,
   "strokeColor": "#b91c1c",
   "backgroundColor": "#fecaca",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100133,
   "version": 1,
   "versionNonce": 700931,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": [
    {
     "id": "bad_t",
     "type": "text"
    }
   ],
   "link": null,
   "locked": false,
   "roundness": {
