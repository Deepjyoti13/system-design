   }
  },
  {
   "id": "notaken_t",
   "type": "text",
   "x": 38,
   "y": 801,
   "width": 744,
   "height": 30,
   "strokeColor": "#ffffff",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100123,
   "version": 1,
   "versionNonce": 700861,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "-- the design NOT taken\nCREATE TABLE room_night (hotel_id, room_id, date, reservation_id NULL, ...);",
   "originalText": "-- the design NOT taken\nCREATE TABLE room_night (hotel_id, room_id, date, reservation_id NULL, ...);",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "notaken",
   "lineHeight": 1.25
  },
  {
   "id": "bn",
   "type": "text",
   "x": 30,
   "y": 868,
   "width": 1003,
   "height": 65,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100124,
   "version": 1,
   "versionNonce": 700868,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "Guests book a room TYPE, and the front desk assigns a specific room at check-in - so which physical room is involved is\nunknown at booking time and irrelevant until arrival. Modelling per-room would force the booking transaction to PICK a room:\na scan plus a decision, with two concurrent bookings contending over arbitrary specific rows. Worse, assigning room 412 at\nbooking time removes the front desk's flexibility to reshuffle for maintenance, adjacency requests or an early checkout.",
   "originalText": "Guests book a room TYPE, and the front desk assigns a specific room at check-in - so which physical room is involved is\nunknown at booking time and irrelevant until arrival. Modelling per-room would force the booking transaction to PICK a room:\na scan plus a decision, with two concurrent bookings contending over arbitrary specific rows. Worse, assigning room 412 at\nbooking time removes the front desk's flexibility to reshuffle for maintenance, adjacency requests or an early checkout.",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "bn2",
   "type": "text",
   "x": 30,
   "y": 962,
   "width": 955,
   "height": 65,
   "strokeColor": "#047857",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100125,
   "version": 1,
   "versionNonce": 700875,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "Modelling it as a counter makes the booking a single arithmetic update - and that is precisely what makes the atomic\nconditional UPDATE available as the concurrency mechanism. THE DATA MODEL CHOICE IS WHAT UNLOCKED THE SIMPLEST CORRECT\nCONCURRENCY CONTROL. The room table still exists, because check-in and housekeeping need it; it just isn't involved in\nbooking.",
   "originalText": "Modelling it as a counter makes the booking a single arithmetic update - and that is precisely what makes the atomic\nconditional UPDATE available as the concurrency mechanism. THE DATA MODEL CHOICE IS WHAT UNLOCKED THE SIMPLEST CORRECT\nCONCURRENCY CONTROL. The room table still exists, because check-in and housekeeping need it; it just isn't involved in\nbooking.",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
