   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "all bookings for peak season concentrate on one shard, and the\ncurrent date's shard takes every check-in query. A hotspot on both axes.",
   "originalText": "all bookings for peak season concentrate on one shard, and the\ncurrent date's shard takes every check-in query. A hotspot on both axes.",
   "fontSize": 12,
