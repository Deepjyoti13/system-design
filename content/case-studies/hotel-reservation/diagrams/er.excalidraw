  {
   "id": "edn",
   "type": "text",
   "x": 1020,
   "y": 610,
   "width": 614,
   "height": 105,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100119,
   "version": 1,
   "versionNonce": 700833,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "end_date is EXCLUSIVE: 2026-06-01 to 2026-06-04 is THREE nights, and the guest\nchecks out on the 4th. Not pedantry - it removes a class of off-by-one bug.\nHalf-open intervals make the predicate date >= start AND date < end with no -1\nanywhere, make the night count a plain subtraction, and make two consecutive stays\nNOT overlap when one's end equals the other's start. An inclusive end_date needs\ndate <= end - 1 in every query, and somebody eventually forgets the -1 and\nreserves a room for the checkout night.",
   "originalText": "end_date is EXCLUSIVE: 2026-06-01 to 2026-06-04 is THREE nights, and the guest\nchecks out on the 4th. Not pedantry - it removes a class of off-by-one bug.\nHalf-open intervals make the predicate date >= start AND date < end with no -1\nanywhere, make the night count a plain subtraction, and make two consecutive stays\nNOT overlap when one's end equals the other's start. An inclusive end_date needs\ndate <= end - 1 in every query, and somebody eventually forgets the -1 and\nreserves a room for the checkout night.",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
