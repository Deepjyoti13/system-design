   "versionNonce": 700938,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "date FIRST   ->   14 separate index probes for a 14-night stay",
   "originalText": "date FIRST   ->   14 separate index probes for a 14-night stay",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "bad",
   "lineHeight": 1.25
  },
  {
   "id": "badn",
   "type": "text",
   "x": 860,
   "y": 1228,
   "width": 539,
   "height": 75,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100135,
   "version": 1,
   "versionNonce": 700945,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "Reverse the order and one room type's nights scatter across the index by\ndate - so the UPDATE locks 14 rows in unpredictable physical locations,\nwhich is exactly the deadlock exposure that pessimistic locking warns\nabout. The same key order that makes the read fast is the one that makes\nthe write safe.",
   "originalText": "Reverse the order and one room type's nights scatter across the index by\ndate - so the UPDATE locks 14 rows in unpredictable physical locations,\nwhich is exactly the deadlock exposure that pessimistic locking warns\nabout. The same key order that makes the read fast is the one that makes\nthe write safe.",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "d4",
