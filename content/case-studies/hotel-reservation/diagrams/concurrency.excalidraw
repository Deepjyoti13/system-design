   }
  },
  {
   "id": "o2c_t",
   "type": "text",
   "x": 888,
   "y": 699,
   "width": 784,
   "height": 151,
   "strokeColor": "#ffffff",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100029,
   "version": 1,
   "versionNonce": 700203,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "SELECT total_reserved, version FROM room_type_inventory\n WHERE hotel_id=245 AND room_type_id=1001 AND date='2026-06-01';\n-- -> 99, version 42\n\n-- decide in application code: 99 + 1 <= 110  ok\n\nUPDATE room_type_inventory\n   SET total_reserved = 100, version = 43\n WHERE hotel_id=245 AND ... AND version = 42;   -- the GUARD\n\n-- affected rows == 0  =>  someone else won  =>  retry or 409",
   "originalText": "SELECT total_reserved, version FROM room_type_inventory\n WHERE hotel_id=245 AND room_type_id=1001 AND date='2026-06-01';\n-- -> 99, version 42\n\n-- decide in application code: 99 + 1 <= 110  ok\n\nUPDATE room_type_inventory\n   SET total_reserved = 100, version = 43\n WHERE hotel_id=245 AND ... AND version = 42;   -- the GUARD\n\n-- affected rows == 0  =>  someone else won  =>  retry or 409",
   "fontSize": 11,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "o2c",
   "lineHeight": 1.25
  },
  {
   "id": "o2n",
   "type": "text",
   "x": 880,
   "y": 872,
   "width": 777,
   "height": 150,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100030,
   "version": 1,
   "versionNonce": 700210,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "CHECKING THE AFFECTED ROW COUNT IS THE ENTIRE MECHANISM - forgetting to check it is how this pattern\nsilently fails in real codebases, because the UPDATE 'succeeds' having changed nothing. Use a version\nINTEGER, not a timestamp: timestamps suffer clock skew between application servers and insufficient\nresolution, so two updates in the same millisecond look unchanged.\n\nNo locks, so readers never block, and it is faster than pessimistic when conflicts are rare - which\ndescribes the vast majority of this system's traffic, since most hotels on most dates have plenty of\nrooms. But it degrades badly under high contention, because transactions repeatedly do work and throw it\naway. A ROLLBACK STORM is worse than a lock queue: burning CPU to make no progress - and that is exactly\nthe peak-season hot-row scenario.",
   "originalText": "CHECKING THE AFFECTED ROW COUNT IS THE ENTIRE MECHANISM - forgetting to check it is how this pattern\nsilently fails in real codebases, because the UPDATE 'succeeds' having changed nothing. Use a version\nINTEGER, not a timestamp: timestamps suffer clock skew between application servers and insufficient\nresolution, so two updates in the same millisecond look unchanged.\n\nNo locks, so readers never block, and it is faster than pessimistic when conflicts are rare - which\ndescribes the vast majority of this system's traffic, since most hotels on most dates have plenty of\nrooms. But it degrades badly under high contention, because transactions repeatedly do work and throw it\naway. A ROLLBACK STORM is worse than a lock queue: burning CPU to make no progress - and that is exactly\nthe peak-season hot-row scenario.",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "o3",
   "type": "text",
   "x": 30,
   "y": 1060,
   "width": 542,
   "height": 17,
   "strokeColor": "#1e40af",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100031,
   "version": 1,
   "versionNonce": 700217,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "3   a database constraint - move the invariant into the schema",
   "originalText": "3   a database constraint - move the invariant into the schema",
   "fontSize": 14,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "o3c",
   "type": "rectangle",
