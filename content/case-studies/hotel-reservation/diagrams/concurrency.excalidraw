  },
  {
   "id": "ran",
   "type": "text",
   "x": 30,
   "y": 208,
   "width": 435,
   "height": 30,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100007,
   "version": 1,
   "versionNonce": 700049,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "The user hits Book twice, or the browser resubmits after a\ntimeout. Two IDENTICAL requests arrive.",
   "originalText": "The user hits Book twice, or the browser resubmits after a\ntimeout. Two IDENTICAL requests arrive.",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "ras",
