  },
  {
   "id": "o3c_t",
   "type": "text",
   "x": 38,
   "y": 1112,
   "width": 784,
   "height": 41,
   "strokeColor": "#ffffff",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100033,
   "version": 1,
   "versionNonce": 700231,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "ALTER TABLE room_type_inventory\n  ADD CONSTRAINT check_overbooking\n  CHECK (total_reserved <= total_inventory * 1.10);",
   "originalText": "ALTER TABLE room_type_inventory\n  ADD CONSTRAINT check_overbooking\n  CHECK (total_reserved <= total_inventory * 1.10);",
   "fontSize": 11,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "o3c",
   "lineHeight": 1.25
  },
  {
   "id": "o3n",
   "type": "text",
   "x": 30,
   "y": 1192,
   "width": 770,
   "height": 105,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100034,
   "version": 1,
   "versionNonce": 700238,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "No SELECT, no version column, no explicit lock: a single UPDATE is atomic and takes its own brief row\nlock automatically, so the stale-read window is gone because there is no separate read. The simplest\ncorrect thing - and, importantly, THE INVARIANT IS ENFORCED AGAINST EVERY CODE PATH, including a buggy\nnew service, a data migration, or a manual UPDATE during an incident. It is the only option that cannot\nbe bypassed by forgetting to use it. Against that: constraints are not version-controlled alongside\napplication code the way logic is, not every database supports CHECK with expressions, and it yields a\ngeneric constraint violation rather than a domain error, so the application must translate it.",
   "originalText": "No SELECT, no version column, no explicit lock: a single UPDATE is atomic and takes its own brief row\nlock automatically, so the stale-read window is gone because there is no separate read. The simplest\ncorrect thing - and, importantly, THE INVARIANT IS ENFORCED AGAINST EVERY CODE PATH, including a buggy\nnew service, a data migration, or a manual UPDATE during an incident. It is the only option that cannot\nbe bypassed by forgetting to use it. Against that: constraints are not version-controlled alongside\napplication code the way logic is, not every database supports CHECK with expressions, and it yields a\ngeneric constraint violation rather than a domain error, so the application must translate it.",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "o4",
   "type": "text",
   "x": 880,
   "y": 1060,
   "width": 594,
   "height": 17,
   "strokeColor": "#047857",
   "backgroundColor": "transparent",
