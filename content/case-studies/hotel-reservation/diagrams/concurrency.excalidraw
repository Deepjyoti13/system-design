   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100028,
   "version": 1,
   "versionNonce": 700196,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": [
