   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "No isolation level below SERIALIZABLE prevents this - so 'we use transactions' is not an answer",
   "originalText": "No isolation level below SERIALIZABLE prevents this - so 'we use transactions' is not an answer",
   "fontSize": 22,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "s",
   "type": "text",
   "x": 30,
   "y": 52,
   "width": 1262,
   "height": 17,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100002,
   "version": 1,
   "versionNonce": 700014,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "The danger lives in the GAP between the SELECT and the UPDATE, where application code decided on data that went stale before it was written back.",
   "originalText": "The danger lives in the GAP between the SELECT and the UPDATE, where application code decided on data that went stale before it was written back.",
   "fontSize": 14,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
