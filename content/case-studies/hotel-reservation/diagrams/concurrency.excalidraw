  {
   "id": "rbn",
   "type": "text",
   "x": 910,
   "y": 208,
   "width": 502,
   "height": 30,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100015,
   "version": 1,
   "versionNonce": 700105,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "Two different people submit bookings for the last available room at\nthe same instant.",
   "originalText": "Two different people submit bookings for the last available room at\nthe same instant.",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
