  {
   "id": "rbs_t",
   "type": "text",
   "x": 918,
   "y": 279,
   "width": 754,
   "height": 150,
   "strokeColor": "#ffffff",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100017,
   "version": 1,
   "versionNonce": 700119,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "-- transaction 1                      -- transaction 2\nSELECT total_reserved ...             SELECT total_reserved ...\n  -- reads 99                           -- ALSO reads 99\n\n-- app: 99 + 1 <= 110? yes            -- app: 99 + 1 <= 110? yes\n\nUPDATE ... SET total_reserved = 100   UPDATE ... SET total_reserved = 100\nCOMMIT;                               COMMIT;\n\n-- two reservations, and total_reserved says 100.",
   "originalText": "-- transaction 1                      -- transaction 2\nSELECT total_reserved ...             SELECT total_reserved ...\n  -- reads 99                           -- ALSO reads 99\n\n-- app: 99 + 1 <= 110? yes            -- app: 99 + 1 <= 110? yes\n\nUPDATE ... SET total_reserved = 100   UPDATE ... SET total_reserved = 100\nCOMMIT;                               COMMIT;\n\n-- two reservations, and total_reserved says 100.",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "rbs",
   "lineHeight": 1.25
  },
  {
   "id": "rbl",
   "type": "text",
   "x": 910,
   "y": 466,
   "width": 255,
   "height": 17,
   "strokeColor": "#b91c1c",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100018,
