  {
   "id": "o4c_t",
   "type": "text",
   "x": 888,
   "y": 1099,
   "width": 784,
   "height": 68,
   "strokeColor": "#ffffff",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100037,
   "version": 1,
   "versionNonce": 700259,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "UPDATE room_type_inventory\n   SET total_reserved = total_reserved + :n\n WHERE hotel_id = :hotel AND room_type_id = :type\n   AND date >= :start AND date < :end\n   AND total_reserved + :n <= total_inventory * 1.10;   -- the RULE",
   "originalText": "UPDATE room_type_inventory\n   SET total_reserved = total_reserved + :n\n WHERE hotel_id = :hotel AND room_type_id = :type\n   AND date >= :start AND date < :end\n   AND total_reserved + :n <= total_inventory * 1.10;   -- the RULE",
   "fontSize": 11,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "o4c",
   "lineHeight": 1.25
  },
  {
   "id": "o4n",
   "type": "text",
   "x": 880,
   "y": 1192,
   "width": 777,
   "height": 150,
   "strokeColor": "#047857",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100038,
   "version": 1,
   "versionNonce": 700266,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "Not in the standard three, and often the best answer. NO READ-THEN-WRITE GAP, so the lost update is\nstructurally impossible rather than detected. No version column to maintain and no retry loop to write\nor tune. The business rule AND the atomicity are the same expression, so you cannot forget to apply the\noverbooking limit - it is the thing making the write conditional. And the affected-row count carries the\nmulti-night semantics for free: fewer rows updated than nights requested means some night was full,\nwhich is exactly what the 409 needs.\n\nThis applies here only because inventory is a COUNTER, not a unique resource. A seat-booking system,\nwhere each seat is a distinct resource with a binary state, cannot use it and has to fall back to\nlocking a specific row.",
   "originalText": "Not in the standard three, and often the best answer. NO READ-THEN-WRITE GAP, so the lost update is\nstructurally impossible rather than detected. No version column to maintain and no retry loop to write\nor tune. The business rule AND the atomicity are the same expression, so you cannot forget to apply the\noverbooking limit - it is the thing making the write conditional. And the affected-row count carries the\nmulti-night semantics for free: fewer rows updated than nights requested means some night was full,\nwhich is exactly what the 409 needs.\n\nThis applies here only because inventory is a COUNTER, not a unique resource. A seat-booking system,\nwhere each seat is a distinct resource with a binary state, cannot use it and has to fall back to\nlocking a specific row.",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
