   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "Two races that get conflated constantly - and need completely different mechanisms",
   "originalText": "Two races that get conflated constantly - and need completely different mechanisms",
   "fontSize": 17,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
