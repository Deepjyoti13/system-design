  {
   "id": "ras_t",
   "type": "text",
   "x": 38,
   "y": 269,
   "width": 764,
   "height": 60,
   "strokeColor": "#ffffff",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100009,
   "version": 1,
   "versionNonce": 700063,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "form loads   ->  client generates reservation_id = '13422445-...'\nsubmit #1    ->  INSERT INTO reservation (...)  ->  OK\nsubmit #2    ->  INSERT INTO reservation (...)  ->  UNIQUE VIOLATION\n                 -> handler catches it, returns the ORIGINAL reservation",
   "originalText": "form loads   ->  client generates reservation_id = '13422445-...'\nsubmit #1    ->  INSERT INTO reservation (...)  ->  OK\nsubmit #2    ->  INSERT INTO reservation (...)  ->  UNIQUE VIOLATION\n                 -> handler catches it, returns the ORIGINAL reservation",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "ras",
   "lineHeight": 1.25
  },
  {
   "id": "ral",
   "type": "text",
   "x": 30,
   "y": 356,
   "width": 186,
   "height": 17,
   "strokeColor": "#047857",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100010,
   "version": 1,
   "versionNonce": 700070,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "solved by IDEMPOTENCY",
   "originalText": "solved by IDEMPOTENCY",
   "fontSize": 14,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "ral2",
   "type": "text",
   "x": 30,
   "y": 382,
   "width": 517,
   "height": 165,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100011,
   "version": 1,
   "versionNonce": 700077,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "Two details make it work. The id is generated by the CLIENT before\nthe first attempt - if the server minted it on receipt, each retry\nwould get a fresh id and look like a new booking; the id has to be\nborn with the FORM, not with the request. And it is a UNIQUE\nCONSTRAINT, not a SELECT first: checking 'does this id exist?' before\ninserting is a check-then-act race, and only the database's unique\nindex can serialize that decision.\n\nDisabling the button client-side is worth doing and is NOT a\nsolution: it fails with JavaScript off, on a double-tap that fires\nbefore the handler, and on a browser-level resubmit.",
   "originalText": "Two details make it work. The id is generated by the CLIENT before\nthe first attempt - if the server minted it on receipt, each retry\nwould get a fresh id and look like a new booking; the id has to be\nborn with the FORM, not with the request. And it is a UNIQUE\nCONSTRAINT, not a SELECT first: checking 'does this id exist?' before\ninserting is a check-then-act race, and only the database's unique\nindex can serialize that decision.\n\nDisabling the button client-side is worth doing and is NOT a\nsolution: it fails with JavaScript off, on a double-tap that fires\nbefore the handler, and on a browser-level resubmit.",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
