   "versionNonce": 700126,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "solved by CONCURRENCY CONTROL",
   "originalText": "solved by CONCURRENCY CONTROL",
   "fontSize": 14,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "rbl2",
   "type": "text",
   "x": 910,
   "y": 492,
   "width": 547,
   "height": 60,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100019,
   "version": 1,
   "versionNonce": 700133,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "One booking has silently vanished from the count, so the hotel will sell\nthat room again. And READ COMMITTED and REPEATABLE READ both PERMIT this,\nbecause nothing was read inconsistently - both transactions read a\ngenuinely-committed 99.",
   "originalText": "One booking has silently vanished from the count, so the hotel will sell\nthat room again. And READ COMMITTED and REPEATABLE READ both PERMIT this,\nbecause nothing was read inconsistently - both transactions read a\ngenuinely-committed 99.",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "an",
   "type": "text",
   "x": 30,
   "y": 556,
   "width": 1003,
   "height": 32,
   "strokeColor": "#1e40af",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100020,
   "version": 1,
   "versionNonce": 700140,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "A is solved by idempotency. B is solved by concurrency control. NEITHER MECHANISM SOLVES THE OTHER, and shipping only one of\nthem leaves a real bug.",
   "originalText": "A is solved by idempotency. B is solved by concurrency control. NEITHER MECHANISM SOLVES THE OTHER, and shipping only one of\nthem leaves a real bug.",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
