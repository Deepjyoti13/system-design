   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "4   the atomic conditional UPDATE - put the rule in the WHERE clause",
   "originalText": "4   the atomic conditional UPDATE - put the rule in the WHERE clause",
   "fontSize": 14,
