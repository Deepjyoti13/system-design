   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100102,
   "version": 1,
   "versionNonce": 700714,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "And why not SERIALIZABLE? It would work - it prevents the lost update outright. But it costs throughput across EVERY\ntransaction in the database, not just contended ones; in PostgreSQL it is implemented optimistically, so you still get\nserialization failures and still need retry handling; and it is a blunt global setting for a problem localized to one row's\nupdate. Option 4 solves it for the price of one WHERE clause.",
   "originalText": "And why not SERIALIZABLE? It would work - it prevents the lost update outright. But it costs throughput across EVERY\ntransaction in the database, not just contended ones; in PostgreSQL it is implemented optimistically, so you still get\nserialization failures and still need retry handling; and it is a blunt global setting for a problem localized to one row's\nupdate. Option 4 solves it for the price of one WHERE clause.",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
