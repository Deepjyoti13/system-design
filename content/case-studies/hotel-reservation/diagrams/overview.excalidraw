  {
   "id": "cl",
   "type": "text",
   "x": 30,
   "y": 818,
   "width": 520,
   "height": 21,
   "strokeColor": "#1e40af",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100048,
   "version": 1,
   "versionNonce": 700336,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "Guests do not book a room. They book a room TYPE.",
   "originalText": "Guests do not book a room. They book a room TYPE.",
   "fontSize": 17,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "c1",
   "type": "text",
   "x": 30,
   "y": 856,
   "width": 995,
   "height": 32,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100049,
   "version": 1,
   "versionNonce": 700343,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "You reserve 'a king room with a city view' and the front desk assigns room 412 when you arrive. That is how hotels actually\nwork - and it differs from Airbnb (you book a specific listing) and from ticket booking (you book seat J14).",
   "originalText": "You reserve 'a king room with a city view' and the front desk assigns room 412 when you arrive. That is how hotels actually\nwork - and it differs from Airbnb (you book a specific listing) and from ticket booking (you book seat J14).",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "unit",
   "type": "rectangle",
   "x": 30,
   "y": 916,
   "width": 760,
   "height": 66,
   "strokeColor": "#1e3a5f",
   "backgroundColor": "#3b82f6",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100050,
   "version": 1,
   "versionNonce": 700350,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": [
    {
     "id": "unit_t",
     "type": "text"
    }
   ],
   "link": null,
   "locked": false,
   "roundness": {
    "type": 3
   }
  },
  {
   "id": "unit_t",
   "type": "text",
   "x": 38,
   "y": 931,
   "width": 744,
   "height": 35,
   "strokeColor": "#374151",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100051,
   "version": 1,
   "versionNonce": 700357,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "the unit of inventory is NOT a room:\nit is a (hotel, room_type, date) triple carrying a COUNT",
   "originalText": "the unit of inventory is NOT a room:\nit is a (hotel, room_type, date) triple carrying a COUNT",
   "fontSize": 14,
   "fontFamily": 3,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "unit",
   "lineHeight": 1.25
  },
  {
   "id": "c2",
   "type": "text",
   "x": 830,
   "y": 916,
   "width": 632,
   "height": 48,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100052,
   "version": 1,
   "versionNonce": 700364,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "So the schema tracks HOW MANY of this type are taken on this date, rather than\nWHICH rooms are occupied - and the concurrency control therefore protects a\nCOUNTER, not a row-level status flag.",
   "originalText": "So the schema tracks HOW MANY of this type are taken on this date, rather than\nWHICH rooms are occupied - and the concurrency control therefore protects a\nCOUNTER, not a row-level status flag.",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
