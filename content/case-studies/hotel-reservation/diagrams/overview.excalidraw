  {
   "id": "invn",
   "type": "text",
   "x": 1250,
   "y": 254,
   "width": 271,
   "height": 150,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100023,
   "version": 1,
   "versionNonce": 700161,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "NOT reserved <= total. The hotel\ndeliberately WANTS to oversell:\ncancellations are predictable in\naggregate, so selling 110% of\ncapacity means fuller hotels.\n\nWhich makes the invariant a business\nrule that has to live somewhere\ntrustworthy - and that is a schema\nquestion, not an application one.",
   "originalText": "NOT reserved <= total. The hotel\ndeliberately WANTS to oversell:\ncancellations are predictable in\naggregate, so selling 110% of\ncapacity means fuller hotels.\n\nWhich makes the invariant a business\nrule that has to live somewhere\ntrustworthy - and that is a schema\nquestion, not an application one.",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
