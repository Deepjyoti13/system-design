   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "That difference is why this design's locking discussion looks nothing like the seat-booking one. Protecting a BUDGET admits\nsolutions that protecting a unique resource does not - an atomic conditional increment, a CHECK constraint - and the room-type\nmodelling decision is what makes them available.",
   "originalText": "That difference is why this design's locking discussion looks nothing like the seat-booking one. Protecting a BUDGET admits\nsolutions that protecting a unique resource does not - an atomic conditional increment, a CHECK constraint - and the room-type\nmodelling decision is what makes them available.",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
