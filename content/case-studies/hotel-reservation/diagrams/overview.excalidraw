   "link": null,
   "locked": false,
   "text": "availability returns a PER-NIGHT breakdown, not a boolean",
   "originalText": "availability returns a PER-NIGHT breakdown, not a boolean",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "apd_600",
   "type": "text",
   "x": 626,
   "y": 1534,
   "width": 517,
   "height": 60,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100075,
   "version": 1,
   "versionNonce": 700525,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "a four-night stay can fail on exactly one night, and telling the user\n'not available' without saying WHICH NIGHT is a bad product. It also\nmeans the response carries the per-night rate, which the\ndaily-changing-prices requirement demands anyway.",
   "originalText": "a four-night stay can fail on exactly one night, and telling the user\n'not available' without saying WHICH NIGHT is a bad product. It also\nmeans the response carries the per-night rate, which the\ndaily-changing-prices requirement demands anyway.",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
