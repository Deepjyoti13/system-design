    }
   ],
   "link": null,
   "locked": false,
   "roundness": {
    "type": 3
   }
  },
  {
   "id": "dont_t",
   "type": "text",
   "x": 1058,
   "y": 649,
   "width": 614,
   "height": 18,
   "strokeColor": "#374151",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100045,
   "version": 1,
   "versionNonce": 700315,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "So: DO NOT DISTRIBUTE THIS SYSTEM",
   "originalText": "So: DO NOT DISTRIBUTE THIS SYSTEM",
   "fontSize": 15,
   "fontFamily": 3,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "dont",
   "lineHeight": 1.25
  },
  {
   "id": "dontn",
   "type": "text",
   "x": 1050,
   "y": 692,
   "width": 539,
   "height": 105,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100046,
   "version": 1,
   "versionNonce": 700322,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "One relational database with ACID transactions handles the entire\nworkload with orders of magnitude of headroom - and ACID is precisely\nthe tool the double-booking problem needs. The interesting engineering\nis the choice among locking strategies, not sharding. (An interviewer\nwill pivot to 'now make it Booking.com': the answer is sharding by\nhotel_id plus a CDC-fed cache - but reaching for it at 3 reservations/\nsec would be building infrastructure for a problem that does not exist.)",
   "originalText": "One relational database with ACID transactions handles the entire\nworkload with orders of magnitude of headroom - and ACID is precisely\nthe tool the double-booking problem needs. The interesting engineering\nis the choice among locking strategies, not sharding. (An interviewer\nwill pivot to 'now make it Booking.com': the answer is sharding by\nhotel_id plus a CDC-fed cache - but reaching for it at 3 reservations/\nsec would be building infrastructure for a problem that does not exist.)",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "d3",
