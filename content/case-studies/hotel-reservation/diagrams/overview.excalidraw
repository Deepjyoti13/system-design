  {
   "id": "apd_30",
   "type": "text",
   "x": 56,
   "y": 1534,
   "width": 509,
   "height": 90,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
