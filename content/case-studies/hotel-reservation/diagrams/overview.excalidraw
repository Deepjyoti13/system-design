   "text": "BEGIN;\n  UPDATE room_type_inventory SET total_reserved = total_reserved + n\n   WHERE ... AND total_reserved + n <= total_inventory * 1.10;\nCOMMIT;",
   "originalText": "BEGIN;\n  UPDATE room_type_inventory SET total_reserved = total_reserved + n\n   WHERE ... AND total_reserved + n <= total_inventory * 1.10;\nCOMMIT;",
