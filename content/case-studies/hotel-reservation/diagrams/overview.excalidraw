   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "at peak season, losing the race for the last room is a normal thing\nthat happens to real users. It must not be logged as an error or\nalerted on.",
   "originalText": "at peak season, losing the race for the last room is a normal thing\nthat happens to real users. It must not be logged as an error or\nalerted on.",
