  {
   "id": "an",
   "type": "text",
   "x": 30,
   "y": 318,
   "width": 592,
   "height": 81,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100019,
   "version": 1,
   "versionNonce": 700133,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "Both requests read the inventory, both see one room free, both write a\nreservation - and now the hotel has sold a room it does not have. That is\na double-booking, and it is the kind of bug that produces a furious guest\nstanding in a lobby at 11pm. So the whole case study is about which of\nthese two requests wins, and how that decision is made atomically.",
   "originalText": "Both requests read the inventory, both see one room free, both write a\nreservation - and now the hotel has sold a room it does not have. That is\na double-booking, and it is the kind of bug that produces a furious guest\nstanding in a lobby at 11pm. So the whole case study is about which of\nthese two requests wins, and how that decision is made atomically.",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "lz",
   "type": "text",
   "x": 960,
   "y": 318,
   "width": 234,
   "height": 90,
   "strokeColor": "#b45309",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100020,
   "version": 1,
   "versionNonce": 700140,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "And note: losing the race is a\nNORMAL outcome at peak season,\nnot an error. It must not be\nlogged as one or alerted on - a\nlesson that recurs whenever a\ndesign has a legitimate loser.",
   "originalText": "And note: losing the race is a\nNORMAL outcome at peak season,\nnot an error. It must not be\nlogged as one or alerted on - a\nlesson that recurs whenever a\ndesign has a legitimate loser.",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
