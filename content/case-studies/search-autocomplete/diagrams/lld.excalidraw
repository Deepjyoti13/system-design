    {"id":"title","type":"text","x":30,"y":20,"width":900,"height":34,"strokeColor":"#1e3a5f","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"seed":201,"text":"Search Autocomplete -- LLD: Atomic Snapshot Swap","originalText":"Search Autocomplete -- LLD: Atomic Snapshot Swap","fontSize":26,"fontFamily":3,"textAlign":"left","verticalAlign":"top"},
