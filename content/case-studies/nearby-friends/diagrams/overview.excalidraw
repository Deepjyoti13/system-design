   "versionNonce": 700385,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "40x the write rate. A design that\ntreats 333k writes/sec as the headline\nnumber has mis-identified the problem.",
   "originalText": "40x the write rate. A design that\ntreats 333k writes/sec as the headline\nnumber has mis-identified the problem.",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
