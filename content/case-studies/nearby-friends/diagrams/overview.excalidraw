  {
   "id": "an",
   "type": "text",
   "x": 30,
   "y": 326,
   "width": 1011,
   "height": 65,
   "strokeColor": "#1e40af",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100023,
   "version": 1,
   "versionNonce": 700161,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "A restaurant is written once and read a million times, so you index it heavily and query the index. A person is written every\n30 seconds and read by about 40 people - the write:read ratio is INVERTED, and any index that is expensive to update is\ndisqualified. Which is why there is NO SPATIAL INDEX ANYWHERE on the hot path: a conclusion that looks like an omission until\nyou see the numbers. Distance is a pairwise computation between two known points, 40 times per update.",
   "originalText": "A restaurant is written once and read a million times, so you index it heavily and query the index. A person is written every\n30 seconds and read by about 40 people - the write:read ratio is INVERTED, and any index that is expensive to update is\ndisqualified. Which is why there is NO SPATIAL INDEX ANYWHERE on the hot path: a conclusion that looks like an omission until\nyou see the numbers. Distance is a pairwise computation between two known points, 40 times per update.",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
