  },
  {
   "id": "bn_1130",
   "type": "text",
   "x": 1156,
   "y": 1020,
   "width": 294,
   "height": 16,
   "strokeColor": "#047857",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100072,
