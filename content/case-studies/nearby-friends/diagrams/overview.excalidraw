   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "Filtering happens at the RECEIVING\nend. Filtering at the sender would\nmean the sender's server needs every\nfriend's current position - which\nreintroduces exactly the global state\nthe per-user channel removed.",
   "originalText": "Filtering happens at the RECEIVING\nend. Filtering at the sender would\nmean the sender's server needs every\nfriend's current position - which\nreintroduces exactly the global state\nthe per-user channel removed.",
