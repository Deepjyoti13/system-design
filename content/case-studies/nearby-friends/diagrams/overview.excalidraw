   "versionNonce": 700490,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "rather than a replicated database - and TTL\nexpiry doubles as the 'friends inactive for\n10 minutes disappear' requirement, for free.",
   "originalText": "rather than a replicated database - and TTL\nexpiry doubles as the 'friends inactive for\n10 minutes disappear' requirement, for free.",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
