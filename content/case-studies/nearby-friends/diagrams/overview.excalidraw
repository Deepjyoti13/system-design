   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "no delivery guarantee, no acknowledgements,\nno retry queues, no dead-letter handling.",
   "originalText": "no delivery guarantee, no acknowledgements,\nno retry queues, no dead-letter handling.",
   "fontSize": 12,
   "fontFamily": 3,
