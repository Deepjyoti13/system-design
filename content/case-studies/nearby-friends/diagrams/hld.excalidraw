   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "2 nodes' worth of memory and 133 nodes'\nworth of CPU. A component whose sizing is\ndriven purely by push throughput has\nnothing operationally in common with one\nholding connections.",
   "originalText": "2 nodes' worth of memory and 133 nodes'\nworth of CPU. A component whose sizing is\ndriven purely by push throughput has\nnothing operationally in common with one\nholding connections.",
