   "versionNonce": 700665,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "IS the presence mechanism",
   "originalText": "IS the presence mechanism",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "dn",
   "type": "text",
   "x": 30,
   "y": 1214,
   "width": 1019,
   "height": 65,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100096,
   "version": 1,
   "versionNonce": 700672,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "There is NO heartbeat, no presence service, and no 'user went offline' event to publish. 'Friends inactive for 10 minutes\ndisappear' is satisfied entirely by a TTL that had to exist anyway to bound memory. This is the design's cleanest\nsimplification - and it is only available because lossy, eventual semantics were accepted up front: a presence system with\ndelivery guarantees would need explicit online/offline events, ordering between them, and reconciliation when they are missed.",
   "originalText": "There is NO heartbeat, no presence service, and no 'user went offline' event to publish. 'Friends inactive for 10 minutes\ndisappear' is satisfied entirely by a TTL that had to exist anyway to bound memory. This is the design's cleanest\nsimplification - and it is only available because lossy, eventual semantics were accepted up front: a presence system with\ndelivery guarantees would need explicit online/offline events, ordering between them, and reconciliation when they are missed.",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "d5",
