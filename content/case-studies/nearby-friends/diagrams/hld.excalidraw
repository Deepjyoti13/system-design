  },
  {
   "id": "shd0",
   "type": "text",
   "x": 60,
   "y": 1638,
   "width": 628,
   "height": 30,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
