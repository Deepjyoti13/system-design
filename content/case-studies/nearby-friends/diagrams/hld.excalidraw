   "versionNonce": 700280,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "6   for each LOCAL client who is a friend of {uid}:\n        d = haversine(client.lastKnownPos, update.pos)\n        d <= client.radius  ?  send on that socket  :  drop",
   "originalText": "6   for each LOCAL client who is a friend of {uid}:\n        d = haversine(client.lastKnownPos, update.pos)\n        d <= client.radius  ?  send on that socket  :  drop",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "st6",
   "lineHeight": 1.25
  },
  {
   "id": "st6n",
   "type": "text",
