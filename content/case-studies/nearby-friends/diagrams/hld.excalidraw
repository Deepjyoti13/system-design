  {
   "id": "fn",
   "type": "text",
   "x": 30,
   "y": 1854,
   "width": 1011,
   "height": 81,
   "strokeColor": "#1e40af",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100119,
   "version": 1,
   "versionNonce": 700833,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "And the load profile is unusually benign: 333k/sec comes from a fixed 30-second timer over a slowly-varying population, so\nthere is no thundering-herd shape to absorb - the diurnal curve moves it maybe 3x. The real variable is the FAN-OUT\nMULTIPLIER, and it is a SOCIAL parameter, not a technical one. If average friend counts rise, or an evening peak lifts the\nonline fraction from 10% to 25%, the push rate moves proportionally while the write rate does not budge. You can be perfectly\nprovisioned for writes and 2.5x under-provisioned for pushes, from a change in user behaviour with no change in traffic.",
   "originalText": "And the load profile is unusually benign: 333k/sec comes from a fixed 30-second timer over a slowly-varying population, so\nthere is no thundering-herd shape to absorb - the diurnal curve moves it maybe 3x. The real variable is the FAN-OUT\nMULTIPLIER, and it is a SOCIAL parameter, not a technical one. If average friend counts rise, or an evening peak lifts the\nonline fraction from 10% to 25%, the push rate moves proportionally while the write rate does not budge. You can be perfectly\nprovisioned for writes and 2.5x under-provisioned for pushes, from a change in user behaviour with no change in traffic.",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
