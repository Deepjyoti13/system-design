   "versionNonce": 700763,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "if a user has not moved appreciably, publishing changes nothing on any screen.\nThe cheapest saving available, and it should be on permanently, not only under load.",
   "originalText": "if a user has not moved appreciably, publishing changes nothing on any screen.\nThe cheapest saving available, and it should be on permanently, not only under load.",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
