   "locked": false,
   "text": "REST servers are STATELESS",
   "originalText": "REST servers are STATELESS",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "spd_450",
   "type": "text",
   "x": 476,
   "y": 680,
   "width": 323,
   "height": 60,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
