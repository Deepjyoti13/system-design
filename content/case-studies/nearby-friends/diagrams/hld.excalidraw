   "versionNonce": 700742,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "Backpressure hits the pub/sub nodes' CPU first - and the strongest lever costs nothing to build",
   "originalText": "Backpressure hits the pub/sub nodes' CPU first - and the strongest lever costs nothing to build",
   "fontSize": 17,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
