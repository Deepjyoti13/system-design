   "versionNonce": 700385,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "WS servers are STATEFUL",
   "originalText": "WS servers are STATEFUL",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "spd_30",
   "type": "text",
   "x": 56,
   "y": 680,
   "width": 323,
   "height": 105,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100056,
   "version": 1,
   "versionNonce": 700392,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "~100k live TCP connections each, plus per\nconnection a subscription set and a small\nfriends'-last-position cache. That state is\nbound to the connection, so they cannot be\nrecycled like a stateless tier: scale-in\nneeds DRAINING and a deploy means 100,000\nclients reconnecting.",
   "originalText": "~100k live TCP connections each, plus per\nconnection a subscription set and a small\nfriends'-last-position cache. That state is\nbound to the connection, so they cannot be\nrecycled like a stateless tier: scale-in\nneeds DRAINING and a deploy means 100,000\nclients reconnecting.",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
