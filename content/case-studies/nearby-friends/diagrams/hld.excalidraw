   "versionNonce": 700287,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "Filtering at the receiver costs 40 haversines spread over ~40 servers, each of which\nalready holds the relevant client's last position.",
   "originalText": "Filtering at the receiver costs 40 haversines spread over ~40 servers, each of which\nalready holds the relevant client's last position.",
