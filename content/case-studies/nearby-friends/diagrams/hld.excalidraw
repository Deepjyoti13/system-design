   "opacity": 100,
   "angle": 0,
   "seed": 100059,
   "version": 1,
   "versionNonce": 700413,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "friends, profile, settings, history. Mixing\nthese into the WS tier would impose\nconnection-draining semantics on every\nordinary HTTP deploy.",
   "originalText": "friends, profile, settings, history. Mixing\nthese into the WS tier would impose\nconnection-draining semantics on every\nordinary HTTP deploy.",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
