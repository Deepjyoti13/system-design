  {
   "id": "pivot",
   "type": "text",
   "x": 392,
   "y": 268,
   "width": 301,
   "height": 105,
   "strokeColor": "#047857",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100025,
   "version": 1,
   "versionNonce": 700175,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "Step 3 is the pivot: ONE publish per\nupdate, not 40 sends. The publisher does\nnot know or care who is listening - no\nfriend-list lookup, no connection\nregistry, no fan-out loop on the sender.\nThe pub/sub layer's ROUTING TABLE is\nthe fan-out.",
   "originalText": "Step 3 is the pivot: ONE publish per\nupdate, not 40 sends. The publisher does\nnot know or care who is listening - no\nfriend-list lookup, no connection\nregistry, no fan-out loop on the sender.\nThe pub/sub layer's ROUTING TABLE is\nthe fan-out.",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
