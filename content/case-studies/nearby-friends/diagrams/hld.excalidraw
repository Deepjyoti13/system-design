  },
  {
   "id": "sdn",
   "type": "text",
   "x": 690,
   "y": 522,
   "width": 331,
   "height": 41,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100050,
   "version": 1,
   "versionNonce": 700350,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "holds the channel -> node hash ring so every WS\nserver can compute which pub/sub node owns a\nchannel. Cached in-process, refreshed on change.",
   "originalText": "holds the channel -> node hash ring so every WS\nserver can compute which pub/sub node owns a\nchannel. Cached in-process, refreshed on change.",
   "fontSize": 11,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "nosep",
   "type": "text",
   "x": 1096,
   "y": 494,
   "width": 435,
   "height": 75,
   "strokeColor": "#b45309",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100051,
   "version": 1,
   "versionNonce": 700357,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "Deliberately NOT separated: there is no 'location service'\nbetween the WS server and the cache. The WS server writes\nthe cache and publishes directly. An intermediate service\nwould add a hop to a path that runs 333,000 times a second\nin order to do nothing but forward.",
   "originalText": "Deliberately NOT separated: there is no 'location service'\nbetween the WS server and the cache. The WS server writes\nthe cache and publishes directly. An intermediate service\nwould add a hop to a path that runs 333,000 times a second\nin order to do nothing but forward.",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
