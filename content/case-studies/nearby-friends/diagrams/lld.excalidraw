   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "One makes fire-and-forget impossible to accidentally undo; the other makes a global connection registry impossible to reintroduce.",
   "originalText": "One makes fire-and-forget impossible to accidentally undo; the other makes a global connection registry impossible to reintroduce.",
   "fontSize": 14,
