  {
   "id": "cl",
   "type": "text",
   "x": 30,
   "y": 990,
   "width": 520,
   "height": 21,
   "strokeColor": "#1e40af",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100029,
   "version": 1,
   "versionNonce": 700203,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "The two hot paths - 333,000/sec in, 13.3M/sec out",
   "originalText": "The two hot paths - 333,000/sec in, 13.3M/sec out",
   "fontSize": 17,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "olu",
   "type": "rectangle",
   "x": 30,
   "y": 1028,
   "width": 820,
   "height": 210,
   "strokeColor": "#1e293b",
   "backgroundColor": "#1e293b",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100030,
   "version": 1,
   "versionNonce": 700210,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": [
    {
     "id": "olu_t",
     "type": "text"
    }
   ],
   "link": null,
   "locked": false,
   "roundness": {
    "type": 3
   }
  },
  {
   "id": "olu_t",
   "type": "text",
   "x": 38,
   "y": 1030,
   "width": 804,
   "height": 206,
   "strokeColor": "#ffffff",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100031,
   "version": 1,
   "versionNonce": 700217,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "onLocationUpdate(conn, msg):                     # 333,000/sec\n    pos = Position(msg.lat, msg.lng, msg.ts)\n\n    if not isPlausible(pos, conn.lastSelfPos):   # teleport / spoofing\n        metrics.increment('location.implausible'); return\n\n    if conn.lastSelfPos and\n       haversine(pos, conn.lastSelfPos) < MIN_MOVE_M:\n        conn.lastSelfPos = pos                   # keep the TS fresh\n        return                                   # publish NOTHING\n\n    conn.lastSelfPos = pos\n    locationStore.put(conn.userId, pos, ttl=600s)   # TTL = presence\n    historySink.append(conn.userId, pos)            # async, droppable\n    bus.publish(channel(conn.userId), encode(pos))  # ONE. No ack.",
   "originalText": "onLocationUpdate(conn, msg):                     # 333,000/sec\n    pos = Position(msg.lat, msg.lng, msg.ts)\n\n    if not isPlausible(pos, conn.lastSelfPos):   # teleport / spoofing\n        metrics.increment('location.implausible'); return\n\n    if conn.lastSelfPos and\n       haversine(pos, conn.lastSelfPos) < MIN_MOVE_M:\n        conn.lastSelfPos = pos                   # keep the TS fresh\n        return                                   # publish NOTHING\n\n    conn.lastSelfPos = pos\n    locationStore.put(conn.userId, pos, ttl=600s)   # TTL = presence\n    historySink.append(conn.userId, pos)            # async, droppable\n    bus.publish(channel(conn.userId), encode(pos))  # ONE. No ack.",
   "fontSize": 11,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "olu",
   "lineHeight": 1.25
  },
  {
   "id": "ofu",
   "type": "rectangle",
   "x": 880,
   "y": 1028,
   "width": 800,
   "height": 210,
   "strokeColor": "#1e293b",
   "backgroundColor": "#1e293b",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
