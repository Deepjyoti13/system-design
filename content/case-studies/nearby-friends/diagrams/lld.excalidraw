  {
   "id": "ofu_t",
   "type": "text",
   "x": 888,
   "y": 1030,
   "width": 784,
   "height": 206,
   "strokeColor": "#ffffff",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100033,
   "version": 1,
   "versionNonce": 700231,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "onFriendUpdate(friendId, pos):                   # 13.3M/sec\n    for conn in registry.localConnectionsInterestedIn(friendId):\n        prev = conn.friendPositions.get(friendId)\n        if prev and pos.ts <= prev.ts: continue   # out of order\n\n        conn.friendPositions[friendId] = pos      # cache ALWAYS\n        d = haversine(conn.lastSelfPos, pos)\n\n        if d > conn.radius:\n            if prev and\n               haversine(conn.lastSelfPos, prev) <= conn.radius:\n                conn.send({type: 'friend_left', user_id: friendId})\n            continue\n\n        conn.trySend({type: 'friend_location', ..., distance_m: d})",
   "originalText": "onFriendUpdate(friendId, pos):                   # 13.3M/sec\n    for conn in registry.localConnectionsInterestedIn(friendId):\n        prev = conn.friendPositions.get(friendId)\n        if prev and pos.ts <= prev.ts: continue   # out of order\n\n        conn.friendPositions[friendId] = pos      # cache ALWAYS\n        d = haversine(conn.lastSelfPos, pos)\n\n        if d > conn.radius:\n            if prev and\n               haversine(conn.lastSelfPos, prev) <= conn.radius:\n                conn.send({type: 'friend_left', user_id: friendId})\n            continue\n\n        conn.trySend({type: 'friend_location', ..., distance_m: d})",
   "fontSize": 11,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "ofu",
   "lineHeight": 1.25
  },
  {
