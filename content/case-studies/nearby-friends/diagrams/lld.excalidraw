   "y": 1576,
   "width": 190,
   "height": 18,
   "strokeColor": "#047857",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100045,
   "version": 1,
   "versionNonce": 700315,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "needs no lock at all",
   "originalText": "needs no lock at all",
   "fontSize": 15,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "nl2",
   "type": "text",
   "x": 30,
   "y": 1602,
   "width": 584,
   "height": 120,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100046,
   "version": 1,
   "versionNonce": 700322,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "publishing an update      one PUBLISH to the user's own channel. No shared\n                          structure is touched, and there is nothing to be\n                          consistent ABOUT - a subscriber gets it or does not.\ndistance computation      a pure function of two positions.\nthe location cache        each key is written only by the ONE server holding\n                          that user's connection, and SET is atomic. Readers\n                          see old or new, both acceptable inside 30 seconds.\nout-of-order updates      resolved by timestamp, not by locking or sequencing.",
   "originalText": "publishing an update      one PUBLISH to the user's own channel. No shared\n                          structure is touched, and there is nothing to be\n                          consistent ABOUT - a subscriber gets it or does not.\ndistance computation      a pure function of two positions.\nthe location cache        each key is written only by the ONE server holding\n                          that user's connection, and SET is atomic. Readers\n                          see old or new, both acceptable inside 30 seconds.\nout-of-order updates      resolved by timestamp, not by locking or sequencing.",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
