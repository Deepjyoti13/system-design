   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "a 500 km jump in 30 s is GPS error or SPOOFING. Publishing it shows a friend teleporting -\nand spoofing is a real privacy attack: claiming to be near you to see who is around.",
   "originalText": "a 500 km jump in 30 s is GPS error or SPOOFING. Publishing it shows a friend teleporting -\nand spoofing is a real privacy attack: claiming to be near you to see who is around.",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
