   "version": 1,
   "versionNonce": 700434,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "blocking would stall the shared onFriendUpdate loop and penalise every other client.\nA queued stale position is worse than none.",
   "originalText": "blocking would stall the shared onFriendUpdate loop and penalise every other client.\nA queued stale position is worse than none.",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
