  },
  {
   "id": "ec1",
   "type": "text",
   "x": 700,
   "y": 2002,
   "width": 628,
   "height": 30,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
