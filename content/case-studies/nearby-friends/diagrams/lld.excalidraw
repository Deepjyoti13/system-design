  {
   "id": "oc_t",
   "type": "text",
   "x": 38,
   "y": 611,
   "width": 804,
   "height": 180,
   "strokeColor": "#ffffff",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100017,
   "version": 1,
   "versionNonce": 700119,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "onConnect(socket):\n    userId = authenticate(socket)\n    displaced = registry.add(userId, socket)\n    if displaced: displaced.close(SUPERSEDED)     # the reconnect race\n\n    friends = friendGraph.friendsOf(userId)        # ~400; connect-time ONLY\n    byNode  = groupBy(friends, f -> router.nodeFor(channel(f)))\n    for node, channels in byNode:\n        bus.subscribe(channels, conn.onFriendUpdate)   # ONE req per NODE\n\n    positions = locationStore.getMany(friends)     # ONE MGET, not 400 GETs\n    -> compute distances, send { type: 'init', friends: nearby }",
   "originalText": "onConnect(socket):\n    userId = authenticate(socket)\n    displaced = registry.add(userId, socket)\n    if displaced: displaced.close(SUPERSEDED)     # the reconnect race\n\n    friends = friendGraph.friendsOf(userId)        # ~400; connect-time ONLY\n    byNode  = groupBy(friends, f -> router.nodeFor(channel(f)))\n    for node, channels in byNode:\n        bus.subscribe(channels, conn.onFriendUpdate)   # ONE req per NODE\n\n    positions = locationStore.getMany(friends)     # ONE MGET, not 400 GETs\n    -> compute distances, send { type: 'init', friends: nearby }",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "oc",
   "lineHeight": 1.25
  },
