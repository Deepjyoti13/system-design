   "versionNonce": 700287,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "the friend_left edge is easy to miss and very visible when missing",
   "originalText": "the friend_left edge is easy to miss and very visible when missing",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "dtd2",
   "type": "text",
   "x": 56,
   "y": 1446,
   "width": 896,
   "height": 45,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100042,
   "version": 1,
   "versionNonce": 700294,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "if a friend walks out of range, a naive 'continue' means the client never hears about it - so the friend stays FROZEN on\nscreen at their last in-range position, forever, looking present. The in-range to out-of-range TRANSITION has to be an\nexplicit message. This is the classic bug in any radius-filtered push feed.",
   "originalText": "if a friend walks out of range, a naive 'continue' means the client never hears about it - so the friend stays FROZEN on\nscreen at their last in-range position, forever, looking present. The in-range to out-of-range TRANSITION has to be an\nexplicit message. This is the classic bug in any radius-filtered push feed.",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "d4",
