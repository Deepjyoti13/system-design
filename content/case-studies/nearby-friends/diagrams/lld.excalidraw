  {
   "id": "reg_t",
   "type": "text",
   "x": 718,
   "y": 166,
   "width": 764,
   "height": 60,
   "strokeColor": "#ffffff",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100009,
   "version": 1,
   "versionNonce": 700063,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "interface ConnectionRegistry               # PER-SERVER, not global\n    add(userId, conn) -> Connection?       # the displaced older session\n    localConnectionsInterestedIn(friendId) -> List<Connection>\n    remove(userId)",
   "originalText": "interface ConnectionRegistry               # PER-SERVER, not global\n    add(userId, conn) -> Connection?       # the displaced older session\n    localConnectionsInterestedIn(friendId) -> List<Connection>\n    remove(userId)",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "reg",
   "lineHeight": 1.25
  },
  {
   "id": "regn",
   "type": "text",
   "x": 710,
   "y": 258,
   "width": 621,
   "height": 60,
   "strokeColor": "#047857",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100010,
   "version": 1,
   "versionNonce": 700070,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "The method is localConnectionsInterestedIn, and the NAME IS DOING WORK: it can only\nanswer about clients on THIS server. Making the interface incapable of answering\nglobally means nobody can quietly reintroduce the 333,000-lookups/sec global\n'who is connected where' registry that the whole channel design exists to avoid.",
   "originalText": "The method is localConnectionsInterestedIn, and the NAME IS DOING WORK: it can only\nanswer about clients on THIS server. Making the interface incapable of answering\nglobally means nobody can quietly reintroduce the 333,000-lookups/sec global\n'who is connected where' registry that the whole channel design exists to avoid.",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "bus",
   "type": "rectangle",
   "x": 30,
   "y": 386,
   "width": 640,
   "height": 90,
   "strokeColor": "#1e293b",
   "backgroundColor": "#1e293b",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
