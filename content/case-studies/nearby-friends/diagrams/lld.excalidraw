   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "the publish is what friends see; a cache miss only affects the next client to call init.\nFailing the whole update to protect a cache write would be backwards.",
   "originalText": "the publish is what friends see; a cache miss only affects the next client to call init.\nFailing the whole update to protect a cache write would be backwards.",
