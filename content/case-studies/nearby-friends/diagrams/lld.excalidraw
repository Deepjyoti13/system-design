   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "A 3x reduction per connection - and fewer in\npractice, since friends cluster. Fleet-wide that\nturns 4 BILLION subscriptions into ~1.3 billion\nrequests, which is the difference between a mass\nreconnect being slow and being an outage.",
   "originalText": "A 3x reduction per connection - and fewer in\npractice, since friends cluster. Fleet-wide that\nturns 4 BILLION subscriptions into ~1.3 billion\nrequests, which is the difference between a mass\nreconnect being slow and being an outage.",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "od",
