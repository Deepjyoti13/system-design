   "link": null,
   "locked": false
  },
  {
   "id": "dtn2",
   "type": "text",
   "x": 56,
   "y": 1424,
   "width": 535,
   "height": 16,
   "strokeColor": "#b91c1c",
   "backgroundColor": "transparent",
