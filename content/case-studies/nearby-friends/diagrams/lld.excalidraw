  {
   "id": "conn_t",
   "type": "text",
   "x": 38,
   "y": 173,
   "width": 624,
   "height": 105,
   "strokeColor": "#ffffff",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100006,
   "version": 1,
   "versionNonce": 700042,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "class Connection:\n    userId\n    socket\n    friends:         Set<UserId>            # ~400, read ONCE at connect\n    friendPositions: Map<UserId, Position>  # last known - even if FAR\n    lastSelfPos:     Position\n    radius:          meters                 # per-user, configurable",
   "originalText": "class Connection:\n    userId\n    socket\n    friends:         Set<UserId>            # ~400, read ONCE at connect\n    friendPositions: Map<UserId, Position>  # last known - even if FAR\n    lastSelfPos:     Position\n    radius:          meters                 # per-user, configurable",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "conn",
   "lineHeight": 1.25
  },
  {
   "id": "connn",
   "type": "text",
   "x": 30,
   "y": 318,
   "width": 904,
   "height": 45,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100007,
   "version": 1,
   "versionNonce": 700049,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "Positions are cached even for friends who are out of range, for two reasons: the departure check below needs the PREVIOUS\nposition to know a transition happened, and a client that stops receiving updates can still render a friend at their last\nknown place with an honest timestamp.",
   "originalText": "Positions are cached even for friends who are out of range, for two reasons: the departure check below needs the PREVIOUS\nposition to know a transition happened, and a client that stops receiving updates can still render a friend at their last\nknown place with an honest timestamp.",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "reg",
   "type": "rectangle",
