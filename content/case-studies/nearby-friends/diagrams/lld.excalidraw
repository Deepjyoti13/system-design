   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "Almost nothing here is a race - which is the real payoff of the requirements",
   "originalText": "Almost nothing here is a race - which is the real payoff of the requirements",
   "fontSize": 17,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "nl",
