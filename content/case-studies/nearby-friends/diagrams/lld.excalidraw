  {
   "id": "s",
   "type": "text",
   "x": 30,
   "y": 52,
   "width": 1132,
   "height": 17,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
