  },
  {
   "id": "tld0",
   "type": "text",
   "x": 54,
   "y": 554,
   "width": 297,
   "height": 41,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100045,
   "version": 1,
   "versionNonce": 700315,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "10M x ~100 B ~= 1 GB - and it CANNOT grow,\nregardless of how many of the 1B registered\nusers exist.",
   "originalText": "10M x ~100 B ~= 1 GB - and it CANNOT grow,\nregardless of how many of the 1B registered\nusers exist.",
   "fontSize": 11,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
