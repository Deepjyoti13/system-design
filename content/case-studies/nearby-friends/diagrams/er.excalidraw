   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "a deletion request must remove rows from Cassandra (spread across bucket partitions), the Kafka backlog, the object-storage\narchive and any warehouse copy. Cassandra deletes are TOMBSTONES that reclaim no space until compaction, so 'deleted' and\n'gone' differ by a compaction cycle. None of this is modelled.",
   "originalText": "a deletion request must remove rows from Cassandra (spread across bucket partitions), the Kafka backlog, the object-storage\narchive and any warehouse copy. Cassandra deletes are TOMBSTONES that reclaim no space until compaction, so 'deleted' and\n'gone' differ by a compaction cycle. None of this is modelled.",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
