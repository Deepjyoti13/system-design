   "version": 1,
   "versionNonce": 700735,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "that is a lot of permanently-retained location data collected without a specific use - a privacy liability as much as a cost\none. A defensible design would down-sample hard (one point per 5 minutes instead of per 30 seconds cuts it 10x) and set a\nretention limit derived from an actual use case.",
   "originalText": "that is a lot of permanently-retained location data collected without a specific use - a privacy liability as much as a cost\none. A defensible design would down-sample hard (one point per 5 minutes instead of per 30 seconds cuts it 10x) and set a\nretention limit derived from an actual use case.",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
