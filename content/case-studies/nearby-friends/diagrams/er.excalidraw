  {
   "id": "cl",
   "type": "text",
   "x": 30,
   "y": 1114,
   "width": 204,
   "height": 21,
   "strokeColor": "#1e40af",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100092,
   "version": 1,
   "versionNonce": 700644,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "Deliberately absent",
   "originalText": "Deliberately absent",
   "fontSize": 17,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "cn",
   "type": "text",
   "x": 30,
   "y": 1148,
   "width": 987,
   "height": 97,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100093,
   "version": 1,
   "versionNonce": 700651,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "no geospatial index on live positions   an index updated 333,000 times a second costs more than 40 pairwise haversines\nno index on ts in the live cache        freshness is enforced by the TTL, not by a query\nno secondary index on location_history  a Cassandra secondary index on a high-cardinality column is a known anti-pattern;\n                                        analytics queries go to the warehouse copy, not to Cassandra\nno friend_count on users               tempting for whale detection, but it would need maintaining on every friendship\n                                        change to answer an operational question a periodic batch job answers just as well",
   "originalText": "no geospatial index on live positions   an index updated 333,000 times a second costs more than 40 pairwise haversines\nno index on ts in the live cache        freshness is enforced by the TTL, not by a query\nno secondary index on location_history  a Cassandra secondary index on a high-cardinality column is a known anti-pattern;\n                                        analytics queries go to the warehouse copy, not to Cassandra\nno friend_count on users               tempting for whale detection, but it would need maintaining on every friendship\n                                        change to answer an operational question a periodic batch job answers just as well",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "d4",
   "type": "line",
   "x": 30,
   "y": 1270,
   "width": 1680,
   "height": 0,
   "strokeColor": "#cbd5e1",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
