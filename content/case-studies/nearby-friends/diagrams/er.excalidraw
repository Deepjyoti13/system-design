   "locked": false,
   "text": "1.15 TB/day of precise location history has no stated purpose beyond 'analytics and ML'",
   "originalText": "1.15 TB/day of precise location history has no stated purpose beyond 'analytics and ML'",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "gd1",
   "type": "text",
   "x": 56,
   "y": 1866,
   "width": 926,
   "height": 45,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
