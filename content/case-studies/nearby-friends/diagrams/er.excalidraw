   "versionNonce": 700693,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "What you'd revisit - and two of these are privacy, not performance",
   "originalText": "What you'd revisit - and two of these are privacy, not performance",
   "fontSize": 17,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "g0",
