      "boundElements": null, "link": null, "locked": false, "lineHeight": 1.25 },
    { "type": "text", "id": "final_caption2", "x": 80, "y": 748, "width": 1000, "height": 20,
      "text": "watching only the node ahead of you is what keeps a release cheap no matter how deep the queue gets.",
