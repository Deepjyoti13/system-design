    { "type": "text", "id": "final_caption1", "x": 80, "y": 730, "width": 1000, "height": 20,
      "text": "Sequential ephemeral nodes turn lock contention into a strict, fair order --",
      "originalText": "Sequential ephemeral nodes turn lock contention into a strict, fair order --",
      "fontSize": 14, "fontFamily": 3, "textAlign": "center", "verticalAlign": "top",
