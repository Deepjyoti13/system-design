   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100051,
   "version": 1,
   "versionNonce": 700357,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "create() times out with no response",
   "originalText": "create() times out with no response",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "erd1",
   "type": "text",
   "x": 56,
   "y": 1388,
   "width": 934,
   "height": 75,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100052,
   "version": 1,
   "versionNonce": 700364,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "genuinely ambiguous - the same shape as a payments processor call: the leader may have committed the create and failed over\nbefore the ack reached the client. Blindly retrying is UNSAFE, because it could produce a SECOND sequential node for the same\nlogical attempt, leaving the client waiting behind its own abandoned node. The safe recovery is embedding a client-generated\nidentifier (the session id) in the node's data at creation time, then on a timeout re-listing children and looking for a node\nalready carrying that identifier before ever calling create() again.",
   "originalText": "genuinely ambiguous - the same shape as a payments processor call: the leader may have committed the create and failed over\nbefore the ack reached the client. Blindly retrying is UNSAFE, because it could produce a SECOND sequential node for the same\nlogical attempt, leaving the client waiting behind its own abandoned node. The safe recovery is embedding a client-generated\nidentifier (the session id) in the node's data at creation time, then on a timeout re-listing children and looking for a node\nalready carrying that identifier before ever calling create() again.",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "er2",
   "type": "ellipse",
   "x": 30,
   "y": 1496,
   "width": 12,
   "height": 12,
   "strokeColor": "#b91c1c",
   "backgroundColor": "#b91c1c",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
