   }
  },
  {
   "id": "ft_t",
   "type": "text",
   "x": 38,
   "y": 390,
   "width": 1164,
   "height": 16,
   "strokeColor": "#ffffff",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100021,
   "version": 1,
   "versionNonce": 700147,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "the fencing token IS the sequence number:  fencingToken = parseSequenceNumber(myPath)  ->  12",
   "originalText": "the fencing token IS the sequence number:  fencingToken = parseSequenceNumber(myPath)  ->  12",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "ft",
   "lineHeight": 1.25
  },
  {
   "id": "an2",
   "type": "text",
   "x": 30,
   "y": 440,
   "width": 1011,
   "height": 81,
   "strokeColor": "#1e40af",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100022,
   "version": 1,
   "versionNonce": 700154,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "No separate token-issuing step is needed. The leader already assigns those numbers monotonically, as part of the single\nglobally-ordered write path - so acquire() just SURFACES the number the coordination service was already generating. Whatever\ndownstream resource the lock protects should receive that token with every write and REJECT any write carrying a lower token\nthan the highest it has already seen. That is where a real system's fencing token actually comes from, rather than a value\ninvented at the call site.",
   "originalText": "No separate token-issuing step is needed. The leader already assigns those numbers monotonically, as part of the single\nglobally-ordered write path - so acquire() just SURFACES the number the coordination service was already generating. Whatever\ndownstream resource the lock protects should receive that token with every write and REJECT any write carrying a lower token\nthan the highest it has already seen. That is where a real system's fencing token actually comes from, rather than a value\ninvented at the call site.",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "d2",
