  },
  {
   "id": "cn",
   "type": "text",
   "x": 30,
   "y": 1132,
   "width": 1011,
   "height": 65,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100044,
   "version": 1,
   "versionNonce": 700308,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "A client library that reconnects after EXPIRED gets a BRAND-NEW session, never a resumed one - and must treat every ephemeral\nnode and every watch it previously held as gone. Modelling that as an enforced enum rather than a boolean is what makes 'a\nclient can never assume its old session's ephemeral nodes still exist after expiry' a CHECKABLE RULE instead of a convention\nevery caller has to remember.",
   "originalText": "A client library that reconnects after EXPIRED gets a BRAND-NEW session, never a resumed one - and must treat every ephemeral\nnode and every watch it previously held as gone. Modelling that as an enforced enum rather than a boolean is what makes 'a\nclient can never assume its old session's ephemeral nodes still exist after expiry' a CHECKABLE RULE instead of a convention\nevery caller has to remember.",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
