   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "the session expires mid-wait",
   "originalText": "the session expires mid-wait",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "erd2",
   "type": "text",
   "x": 56,
   "y": 1518,
   "width": 926,
   "height": 45,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100055,
   "version": 1,
   "versionNonce": 700385,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "onSessionExpired is a HARD SIGNAL, not a retryable error: every ephemeral node and every watch that session owned is already\ngone server-side by the time it fires. The correct response is starting over with a fresh acquire() on a new session, never\nassuming any prior state - predecessor watches, the client's own myPath - is still valid.",
   "originalText": "onSessionExpired is a HARD SIGNAL, not a retryable error: every ephemeral node and every watch that session owned is already\ngone server-side by the time it fires. The correct response is starting over with a fresh acquire() on a new session, never\nassuming any prior state - predecessor watches, the client's own myPath - is still valid.",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "d5",
   "type": "line",
   "x": 30,
   "y": 1610,
   "width": 1680,
