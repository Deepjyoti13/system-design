  {
   "id": "an",
   "type": "text",
   "x": 30,
   "y": 290,
   "width": 1019,
   "height": 48,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100019,
   "version": 1,
   "versionNonce": 700133,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "Each waiter watches exactly ONE node: the one immediately ahead of it. So a release fires exactly one notification, to exactly\none waiter, in strict arrival order - and a 10,000-deep queue releases with one wake-up rather than 10,000. Watching the\nHOLDER instead would wake every waiter on every release: a thundering herd proportional to queue depth.",
   "originalText": "Each waiter watches exactly ONE node: the one immediately ahead of it. So a release fires exactly one notification, to exactly\none waiter, in strict arrival order - and a 10,000-deep queue releases with one wake-up rather than 10,000. Watching the\nHOLDER instead would wake every waiter on every release: a thundering herd proportional to queue depth.",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "ft",
   "type": "rectangle",
   "x": 30,
   "y": 376,
   "width": 1180,
   "height": 44,
   "strokeColor": "#1e293b",
   "backgroundColor": "#1e293b",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100020,
   "version": 1,
   "versionNonce": 700140,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": [
    {
     "id": "ft_t",
     "type": "text"
    }
   ],
   "link": null,
