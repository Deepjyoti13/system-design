   "versionNonce": 700336,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "the predecessor is deleted between getChildren and exists(watch=true)",
   "originalText": "the predecessor is deleted between getChildren and exists(watch=true)",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "erd0",
   "type": "text",
   "x": 56,
   "y": 1294,
   "width": 911,
   "height": 45,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100049,
   "version": 1,
   "versionNonce": 700343,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "a real and common race: the node immediately ahead is released in the gap. exists() returning 'not found' here is NOT an\nerror - it means the wait condition already resolved, so the loop rechecks immediately instead of waiting on a watch event\nthat will never arrive, because nothing is watching a node that no longer exists.",
   "originalText": "a real and common race: the node immediately ahead is released in the gap. exists() returning 'not found' here is NOT an\nerror - it means the wait condition already resolved, so the loop rechecks immediately instead of waiting on a watch event\nthat will never arrive, because nothing is watching a node that no longer exists.",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
