   "roundness": null
  },
  {
   "id": "hl",
   "type": "text",
   "x": 30,
   "y": 1848,
   "width": 899,
   "height": 21,
   "strokeColor": "#1e40af",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100057,
   "version": 1,
   "versionNonce": 700399,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "Writes are linearizable. Reads are deliberately not - and sync() is the escape hatch.",
   "originalText": "Writes are linearizable. Reads are deliberately not - and sync() is the escape hatch.",
   "fontSize": 17,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "cw",
   "type": "rectangle",
   "x": 30,
   "y": 1886,
   "width": 780,
   "height": 50,
   "strokeColor": "#047857",
   "backgroundColor": "#a7f3d0",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100058,
   "version": 1,
   "versionNonce": 700406,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": [
    {
     "id": "cw_t",
     "type": "text"
    }
   ],
   "link": null,
   "locked": false,
   "roundness": {
    "type": 3
   }
  },
  {
   "id": "cw_t",
   "type": "text",
   "x": 38,
   "y": 1903,
   "width": 764,
   "height": 16,
   "strokeColor": "#374151",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100059,
   "version": 1,
   "versionNonce": 700413,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "the tree, WRITES   ->   LINEARIZABLE, full stop",
   "originalText": "the tree, WRITES   ->   LINEARIZABLE, full stop",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "cw",
   "lineHeight": 1.25
  },
  {
   "id": "cwn",
   "type": "text",
   "x": 30,
   "y": 1946,
   "width": 584,
   "height": 60,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100060,
   "version": 1,
   "versionNonce": 700420,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "Every write is ordered by exactly one leader and becomes visible only once a\nMAJORITY has durably logged it. 'A majority cannot exist on two sides of a\npartition' is not an abstraction here - it is the literal mechanism preventing\ntwo clients from both being told they hold the same lock.",
   "originalText": "Every write is ordered by exactly one leader and becomes visible only once a\nMAJORITY has durably logged it. 'A majority cannot exist on two sides of a\npartition' is not an abstraction here - it is the literal mechanism preventing\ntwo clients from both being told they hold the same lock.",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "cr",
   "type": "rectangle",
   "x": 880,
   "y": 1886,
   "width": 800,
   "height": 50,
   "strokeColor": "#b45309",
   "backgroundColor": "#fef3c7",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100061,
   "version": 1,
   "versionNonce": 700427,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": [
    {
     "id": "cr_t",
     "type": "text"
    }
   ],
   "link": null,
   "locked": false,
   "roundness": {
    "type": 3
   }
  },
  {
   "id": "cr_t",
   "type": "text",
   "x": 888,
   "y": 1903,
   "width": 784,
   "height": 16,
   "strokeColor": "#374151",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100062,
   "version": 1,
   "versionNonce": 700434,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "reads from your connected replica   ->   SEQUENTIAL, not linearizable",
   "originalText": "reads from your connected replica   ->   SEQUENTIAL, not linearizable",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "cr",
   "lineHeight": 1.25
  },
  {
   "id": "crn",
   "type": "text",
   "x": 880,
   "y": 1946,
   "width": 599,
   "height": 90,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100063,
   "version": 1,
   "versionNonce": 700441,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "A client's own reads never go backward in time, but may not yet reflect a write\nanother client had acknowledged microseconds earlier. An explicit, named trade:\nforcing every read through the leader or a majority would collapse read\nthroughput to the WRITE ceiling - the opposite of what a workload with far more\nreads and watches than writes needs. A client that genuinely cannot tolerate the\ngap calls sync() first, trading latency for an on-demand linearizable read.",
   "originalText": "A client's own reads never go backward in time, but may not yet reflect a write\nanother client had acknowledged microseconds earlier. An explicit, named trade:\nforcing every read through the leader or a majority would collapse read\nthroughput to the WRITE ceiling - the opposite of what a workload with far more\nreads and watches than writes needs. A client that genuinely cannot tolerate the\ngap calls sync() first, trading latency for an on-demand linearizable read.",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "hn",
   "type": "text",
   "x": 30,
   "y": 2050,
   "width": 1019,
   "height": 32,
   "strokeColor": "#1e40af",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100064,
   "version": 1,
   "versionNonce": 700448,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "And sessions and watches are in-memory, per-connection state, never replicated the way znode data is. Losing a replica's watch\nregistrations on failover is fine BY CONSTRUCTION - nothing durable was ever at risk.",
   "originalText": "And sessions and watches are in-memory, per-connection state, never replicated the way znode data is. Losing a replica's watch\nregistrations on failover is fine BY CONSTRUCTION - nothing durable was ever at risk.",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "d9",
   "type": "line",
   "x": 30,
   "y": 2106,
   "width": 1680,
   "height": 0,
   "strokeColor": "#cbd5e1",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100065,
   "version": 1,
   "versionNonce": 700455,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "points": [
    [
     0,
     0
    ],
    [
     1680,
     0
    ]
   ],
   "roundness": null
  },
  {
   "id": "il",
   "type": "text",
   "x": 30,
   "y": 2124,
   "width": 1036,
   "height": 21,
   "strokeColor": "#1e40af",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100066,
   "version": 1,
   "versionNonce": 700462,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "There is no sharding key - and the read-replica story is inverted from every other case study here",
   "originalText": "There is no sharding key - and the read-replica story is inverted from every other case study here",
   "fontSize": 17,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "in",
   "type": "text",
   "x": 30,
   "y": 2162,
   "width": 1011,
   "height": 65,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100067,
   "version": 1,
   "versionNonce": 700469,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "A single cluster's tree is NEVER sharded, because the linearizable-write guarantee is scoped to exactly one consensus group.\nSplitting the tree across two independently-elected clusters would mean giving up any atomic guarantee between the halves - a\nlock in one and a lock in the other could never be acquired as a single unit. Real deployments scale by running MULTIPLE\nINDEPENDENT CLUSTERS, one per logical blast radius (per region, or per major subsystem), never by sharding one namespace.",
   "originalText": "A single cluster's tree is NEVER sharded, because the linearizable-write guarantee is scoped to exactly one consensus group.\nSplitting the tree across two independently-elected clusters would mean giving up any atomic guarantee between the halves - a\nlock in one and a lock in the other could never be acquired as a single unit. Real deployments scale by running MULTIPLE\nINDEPENDENT CLUSTERS, one per logical blast radius (per region, or per major subsystem), never by sharding one namespace.",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "v1",
   "type": "rectangle",
   "x": 30,
   "y": 2260,
   "width": 780,
   "height": 50,
   "strokeColor": "#b91c1c",
   "backgroundColor": "#fecaca",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100068,
   "version": 1,
   "versionNonce": 700476,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": [
    {
     "id": "v1_t",
     "type": "text"
    }
   ],
   "link": null,
   "locked": false,
   "roundness": {
    "type": 3
   }
  },
  {
   "id": "v1_t",
   "type": "text",
   "x": 38,
   "y": 2277,
   "width": 764,
   "height": 16,
   "strokeColor": "#374151",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100069,
   "version": 1,
   "versionNonce": 700483,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "adding replicas to the VOTING set   ->   LOWERS write throughput",
   "originalText": "adding replicas to the VOTING set   ->   LOWERS write throughput",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "v1",
   "lineHeight": 1.25
  },
  {
   "id": "v1n",
   "type": "text",
   "x": 30,
   "y": 2320,
   "width": 450,
   "height": 15,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100070,
   "version": 1,
   "versionNonce": 700490,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "a majority takes longer to assemble as the voting set grows.",
   "originalText": "a majority takes longer to assemble as the voting set grows.",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "v2",
   "type": "rectangle",
   "x": 880,
   "y": 2260,
   "width": 800,
   "height": 50,
   "strokeColor": "#047857",
   "backgroundColor": "#a7f3d0",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100071,
   "version": 1,
   "versionNonce": 700497,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": [
    {
     "id": "v2_t",
     "type": "text"
    }
   ],
   "link": null,
   "locked": false,
   "roundness": {
    "type": 3
   }
  },
  {
   "id": "v2_t",
   "type": "text",
   "x": 888,
   "y": 2277,
   "width": 784,
   "height": 16,
   "strokeColor": "#374151",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100072,
   "version": 1,
   "versionNonce": 700504,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "a NON-VOTING OBSERVER   ->   the only lever that adds read throughput",
   "originalText": "a NON-VOTING OBSERVER   ->   the only lever that adds read throughput",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "v2",
   "lineHeight": 1.25
  },
  {
   "id": "v2n",
   "type": "text",
   "x": 880,
   "y": 2320,
   "width": 591,
   "height": 30,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100073,
   "version": 1,
   "versionNonce": 700511,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "explicitly excluded from the quorum count, replicating the committed log purely\nto serve reads - so it costs nothing in write latency.",
   "originalText": "explicitly excluded from the quorum count, replicating the committed log purely\nto serve reads - so it costs nothing in write latency.",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  }
