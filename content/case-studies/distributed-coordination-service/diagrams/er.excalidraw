   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "Every znode carries a monotonic version - so the version check IS the concurrency control",
   "originalText": "Every znode carries a monotonic version - so the version check IS the concurrency control",
   "fontSize": 17,
