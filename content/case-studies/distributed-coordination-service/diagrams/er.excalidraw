   }
  },
  {
   "id": "mem_t",
   "type": "text",
   "x": 38,
   "y": 619,
   "width": 764,
   "height": 16,
   "strokeColor": "#374151",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100018,
   "version": 1,
   "versionNonce": 700126,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "the IN-MEMORY TREE   ->   serves every read, on every replica, instantly",
   "originalText": "the IN-MEMORY TREE   ->   serves every read, on every replica, instantly",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "mem",
   "lineHeight": 1.25
  },
  {
   "id": "wal",
   "type": "rectangle",
   "x": 880,
   "y": 602,
   "width": 800,
   "height": 50,
   "strokeColor": "#1e3a5f",
   "backgroundColor": "#3b82f6",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100019,
   "version": 1,
   "versionNonce": 700133,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": [
    {
     "id": "wal_t",
     "type": "text"
    }
   ],
   "link": null,
   "locked": false,
   "roundness": {
