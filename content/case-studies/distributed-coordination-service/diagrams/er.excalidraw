   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "There is no relational schema here - the 'database' is a few megabytes of tree, held in RAM on every replica",
   "originalText": "There is no relational schema here - the 'database' is a few megabytes of tree, held in RAM on every replica",
   "fontSize": 22,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "s",
   "type": "text",
   "x": 30,
   "y": 52,
   "width": 1323,
   "height": 17,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100002,
   "version": 1,
   "versionNonce": 700014,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "That is not a simplification. A coordination service's correctness comes from WHO GETS TO AGREE ON AN ORDER, not from how the bytes happen to be stored.",
   "originalText": "That is not a simplification. A coordination service's correctness comes from WHO GETS TO AGREE ON AN ORDER, not from how the bytes happen to be stored.",
   "fontSize": 14,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
