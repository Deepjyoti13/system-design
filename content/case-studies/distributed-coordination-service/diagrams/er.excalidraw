   }
  },
  {
   "id": "wal_t",
   "type": "text",
   "x": 888,
   "y": 619,
   "width": 784,
   "height": 16,
   "strokeColor": "#374151",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100020,
   "version": 1,
   "versionNonce": 700140,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "the WAL + periodic snapshots   ->   exists ONLY so a crashed replica can rebuild",
   "originalText": "the WAL + periodic snapshots   ->   exists ONLY so a crashed replica can rebuild",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "wal",
   "lineHeight": 1.25
  },
  {
   "id": "bn",
   "type": "text",
   "x": 30,
   "y": 672,
   "width": 1019,
   "height": 65,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100021,
   "version": 1,
   "versionNonce": 700147,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "Every write already pays the most expensive step this system has: a consensus round trip to a majority of replicas, each doing\nits own disk fsync. Adding a second layer of indirection on top - a query planner, a disk-resident B-tree, a page cache -\nwould only slow down the one operation that is already the bottleneck. And a coordination service's entire value is answering\n'what is the current state' INSTANTLY, from memory, on every replica.",
   "originalText": "Every write already pays the most expensive step this system has: a consensus round trip to a majority of replicas, each doing\nits own disk fsync. Adding a second layer of indirection on top - a query planner, a disk-resident B-tree, a page cache -\nwould only slow down the one operation that is already the bottleneck. And a coordination service's entire value is answering\n'what is the current state' INSTANTLY, from memory, on every replica.",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "d3",
