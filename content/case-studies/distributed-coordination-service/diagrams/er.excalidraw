  {
   "id": "cl",
   "type": "text",
   "x": 30,
   "y": 788,
   "width": 942,
   "height": 21,
   "strokeColor": "#1e40af",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
