   "text": "setData(path, data, expectedVersion)   ->  fails outright if the node's\ndelete(path, expectedVersion)              current version does not match\n                                           what the caller last saw",
   "originalText": "setData(path, data, expectedVersion)   ->  fails outright if the node's\ndelete(path, expectedVersion)              current version does not match\n                                           what the caller last saw",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "ver",
   "lineHeight": 1.25
  },
  {
   "id": "cn",
   "type": "text",
   "x": 960,
   "y": 826,
   "width": 584,
   "height": 75,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100026,
   "version": 1,
   "versionNonce": 700182,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "The same UPDATE ... WHERE status = ? discipline the payments and job-scheduler\ndesigns use for their conditional writes, pushed down to the level of a single\nnode: a client can safely say 'apply this only if nobody has touched this node\nsince I last read it' WITHOUT taking out a separate lock. Enforced by the\nleader's single write path, not by application code racing to check first.",
   "originalText": "The same UPDATE ... WHERE status = ? discipline the payments and job-scheduler\ndesigns use for their conditional writes, pushed down to the level of a single\nnode: a client can safely say 'apply this only if nobody has touched this node\nsince I last read it' WITHOUT taking out a separate lock. Enforced by the\nleader's single write path, not by application code racing to check first.",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
