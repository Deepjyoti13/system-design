   "roundness": null
  },
  {
   "id": "el",
   "type": "text",
   "x": 30,
   "y": 1168,
   "width": 467,
   "height": 21,
   "strokeColor": "#1e40af",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100043,
   "version": 1,
   "versionNonce": 700301,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "Why watches are one-shot and never persisted",
   "originalText": "Why watches are one-shot and never persisted",
   "fontSize": 17,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "w1",
   "type": "rectangle",
   "x": 30,
   "y": 1206,
   "width": 780,
   "height": 50,
   "strokeColor": "#b91c1c",
   "backgroundColor": "#fecaca",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100044,
   "version": 1,
   "versionNonce": 700308,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": [
    {
     "id": "w1_t",
     "type": "text"
    }
   ],
   "link": null,
   "locked": false,
   "roundness": {
    "type": 3
   }
  },
  {
   "id": "w1_t",
   "type": "text",
   "x": 38,
   "y": 1223,
   "width": 764,
   "height": 16,
   "strokeColor": "#374151",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100045,
   "version": 1,
   "versionNonce": 700315,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "a watch that stayed registered forever",
   "originalText": "a watch that stayed registered forever",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "w1",
   "lineHeight": 1.25
  },
  {
   "id": "w1n",
   "type": "text",
   "x": 30,
   "y": 1266,
   "width": 576,
   "height": 75,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100046,
   "version": 1,
   "versionNonce": 700322,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "would have to catch a reconnecting client up on every change it missed -\nincluding changes it may no longer care about. And concretely, for the lock\nqueue: if watches re-fired automatically, EVERY waiter behind a released lock\nwould wake on EVERY release, not just the one directly behind the departing\nholder. Exactly the thundering herd the design exists to avoid.",
   "originalText": "would have to catch a reconnecting client up on every change it missed -\nincluding changes it may no longer care about. And concretely, for the lock\nqueue: if watches re-fired automatically, EVERY waiter behind a released lock\nwould wake on EVERY release, not just the one directly behind the departing\nholder. Exactly the thundering herd the design exists to avoid.",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "w2",
   "type": "rectangle",
   "x": 880,
   "y": 1206,
   "width": 800,
   "height": 50,
   "strokeColor": "#047857",
   "backgroundColor": "#a7f3d0",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100047,
   "version": 1,
   "versionNonce": 700329,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": [
    {
     "id": "w2_t",
     "type": "text"
    }
   ],
   "link": null,
   "locked": false,
   "roundness": {
    "type": 3
   }
  },
  {
   "id": "w2_t",
   "type": "text",
   "x": 888,
   "y": 1223,
   "width": 784,
   "height": 16,
   "strokeColor": "#374151",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100048,
   "version": 1,
   "versionNonce": 700336,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "one-shot: fires once, must be explicitly re-registered",
   "originalText": "one-shot: fires once, must be explicitly re-registered",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "w2",
   "lineHeight": 1.25
  },
  {
   "id": "w2n",
   "type": "text",
   "x": 880,
   "y": 1266,
   "width": 591,
   "height": 90,
   "strokeColor": "#047857",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100049,
   "version": 1,
   "versionNonce": 700343,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "keeps notification cost proportional to WATCHERS ACTIVE RIGHT NOW, rather than\nevery subscription ever made minus the ones explicitly cancelled. And because a\nwatch is never written to the WAL or included in a snapshot, a failover loses\nnothing that mattered: the client library detects the disconnect and\nre-establishes session and watches fresh against whichever replica it\nreconnects to.",
   "originalText": "keeps notification cost proportional to WATCHERS ACTIVE RIGHT NOW, rather than\nevery subscription ever made minus the ones explicitly cancelled. And because a\nwatch is never written to the WAL or included in a snapshot, a failover loses\nnothing that mattered: the client library detects the disconnect and\nre-establishes session and watches fresh against whichever replica it\nreconnects to.",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
