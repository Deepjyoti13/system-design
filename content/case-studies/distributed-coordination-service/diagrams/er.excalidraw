   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "watch:                      IN-MEMORY ONLY\n    path, sessionId, kind: DATA | CHILDREN\n    never written to the WAL, never in a snapshot",
   "originalText": "watch:                      IN-MEMORY ONLY\n    path, sessionId, kind: DATA | CHILDREN\n    never written to the WAL, never in a snapshot",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "wtch",
   "lineHeight": 1.25
  },
  {
   "id": "an2",
   "type": "text",
   "x": 30,
   "y": 490,
   "width": 1019,
   "height": 32,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100014,
   "version": 1,
   "versionNonce": 700098,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "The session row is what a session-expiry sweep reads to know EXACTLY what to delete - which is the whole reason it carries its\nown list of owned ephemeral paths rather than making expiry scan the tree.",
   "originalText": "The session row is what a session-expiry sweep reads to know EXACTLY what to delete - which is the whole reason it carries its\nown list of owned ephemeral paths rather than making expiry scan the tree.",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "d2",
   "type": "line",
   "x": 30,
   "y": 546,
   "width": 1680,
   "height": 0,
   "strokeColor": "#cbd5e1",
   "backgroundColor": "transparent",
