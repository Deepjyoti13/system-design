   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "/\n|- /locks\n|   |- /locks/lock-0000000012    EPHEMERAL_SEQUENTIAL\n|   +- /locks/lock-0000000013    EPHEMERAL_SEQUENTIAL\n|- /election\n|   +- /election/candidate-0007  EPHEMERAL_SEQUENTIAL\n+- /members\n    |- /members/node-a           EPHEMERAL\n    +- /members/node-b           EPHEMERAL",
   "originalText": "/\n|- /locks\n|   |- /locks/lock-0000000012    EPHEMERAL_SEQUENTIAL\n|   +- /locks/lock-0000000013    EPHEMERAL_SEQUENTIAL\n|- /election\n|   +- /election/candidate-0007  EPHEMERAL_SEQUENTIAL\n+- /members\n    |- /members/node-a           EPHEMERAL\n    +- /members/node-b           EPHEMERAL",
