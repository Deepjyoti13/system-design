{"type": "excalidraw", "version": 2, "source": "kvdiag", "elements": [{"id": "title", "type": "text", "x": 30, "y": 10, "text": "Per-Key Record: Value, Vector Clock, and Replica Placement", "originalText": "Per-Key Record: Value, Vector Clock, and Replica Placement", "fontSize": 22, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#1e3a5f", "backgroundColor": "transparent", "opacity": 100, "seed": 461434, "width": 765.6, "height": 28.6}, {"id": "subtitle", "type": "text", "x": 30, "y": 42, "text": "There's no relational schema here -- this is what each of a key's N replicas stores locally", "originalText": "There's no relational schema here -- this is what each of a key's N replicas stores locally", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#64748b", "backgroundColor": "transparent", "opacity": 100, "seed": 182747, "width": 764.4, "height": 18.2}, {"id": "boxA_head", "type": "rectangle", "x": 60, "y": 160, "width": 440, "height": 40, "strokeColor": "#1e3a5f", "backgroundColor": "#93c5fd", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "seed": 281705, "roundness": {"type": 3}}, {"id": "boxA_headt", "type": "text", "x": 75, "y": 172, "text": "Key Record (local to each of N replicas)", "originalText": "Key Record (local to each of N replicas)", "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "opacity": 100, "seed": 247739, "width": 410, "height": 16.900000000000002}, {"id": "boxA_body", "type": "rectangle", "x": 60, "y": 200, "width": 440, "height": 180, "strokeColor": "#1e3a5f", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "seed": 292333, "roundness": {"type": 3}}, {"id": "boxA_f1", "type": "text", "x": 75, "y": 215, "text": "key        : string (opaque id)", "originalText