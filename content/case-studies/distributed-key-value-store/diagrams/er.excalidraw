ontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#64748b", "backgroundColor": "transparent", "opacity": 100, "seed": 375261, "width": 93.6, "height": 15.600000000000001}, {"id": "banner", "type": "rectangle", "x": 40, "y": 660, "width": 1440, "height": 46, "strokeColor": "#64748b", "backgroundColor": "#1e293b", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "seed": 481779, "roundness": {"type": 3}}, {"id": "bannert", "type": "text", "x": 60, "y": 675, "text": "The ring IS the index -- placement and lookup are the same computation. No secondary index needed, cross-ref Consistent Hashing.", "originalText": "The ring IS the index -- placement and lookup are the same computation. No secondary index needed, cross-ref Consistent Hashing.", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#a7f3d0", "backgroundColor": "transparent", "opacity": 100, "seed": 324986, "width": 1400, "height": 18.2}], "appState": {"viewBackgroundColor": "#ffffff"}}