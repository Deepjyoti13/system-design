t", "opacity": 100, "seed": 675493, "width": 57.599999999999994, "height": 20.8}, {"id": "nodeB2_v", "type": "text", "x": 650, "y": 410, "text": "value = 42", "originalText": "value = 42", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "opacity": 100, "seed": 115935, "width": 84.0, "height": 18.2}, {"id": "nodeC2_t", "type": "text", "x": 950, "y": 385, "text": "Node C", "originalText": "Node C", "fontSize": 16, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "opacity": 100, "seed": 243057, "width": 57.599999999999994, "height": 20.8}, {"id": "nodeC2_v", "type": "text", "x": 950, "y": 410, "text": "value = 42", "originalText": "value = 42", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "opacity": 100, "seed": 865159, "width": 84.0, "height": 18.2}, {"id": "ra1", "type": "arrow", "x": 160, "y": 400, "width": 455, "height": 5, "points": [[0, 0], [455, -5]], "strokeColor": "#047857", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "seed": 465153, "startArrowhead": null, "endArrowhead": "triangle"}, {"id": "ra2", "type": "arrow", "x": 160, "y": 415, "width": 755, "height": 15, "points": [[0, 0], [755, -15]], "strokeColor": "#047857", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "seed": 593388, "startArrowhead": null, "endArrowhead": "triangle"}, {"id": "read_note", "type": "text", "x": 40, "y": 480, "text": "Node B answers both the write and this read: the shared replica is what guarantees the read sees value=42.", "originalText": "Node B answers both the write and this read: the shared replica is what guarantees the read sees value=42.", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#64748b", "backgroundColor": "transparent", "opacity": 100, "seed": 977296, "width": 890.4, "height": 18.2}, {"id": "evbox", "type": "rectangle", "x": 40, "y": 540, "width": 1080, "height": 90, "strokeColor": "#64748b", "backgroundColor": "#1e293b", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "seed": 748066, "roundness": {"type": 3}}, {"id": "ev1", "type": "text", "x": 60, "y": 555, "text": "W + R = 2 + 2 = 4 > N = 3.  By the pigeonhole principle, the write set and the read set", "originalText": "W + R = 2 + 2 = 4 > N = 3.  By the pigeonhole principle, the write set and the read set", "fontSize": 15, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#a7f3d0", "backgroundColor": "transparent", "opacity": 100, "seed": 476377, "width": 783.0, "height": 19.5}, {"id": "ev2", "type": "text", "x": 60, "y": 580, "text": "cannot be fully disjoint -- they must share at least one node, and that node has the latest value.", "originalText": "cannot be fully disjoint -- they must share at least one node, and that node has the latest value.", "fontSize": 15, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#a7f3d0", "backgroundColor": "transparent", "opacity": 100, "seed": 639786, "width": 882.0, "height": 19.5}], "appState": {"viewBackgroundColor": "#ffffff"}}