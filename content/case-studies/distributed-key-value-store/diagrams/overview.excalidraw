{"type": "excalidraw", "version": 2, "source": "kvdiag", "elements": [{"id": "title", "type": "text", "x": 40, "y": 30, "text": "One Value, Three Homes", "originalText": "One Value, Three Homes", "fontSize": 28, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#1e3a5f", "backgroundColor": "transparent", "opacity": 100, "seed": 564714, "width": 369.59999999999997, "height": 36.4}, {"id": "subtitle", "type": "text", "x": 40, "y": 68, "text": "A write reaches 2 of 3 copies; a later read queries a different 2 of 3 -- and still finds it.", "originalText": "A write reaches 2 of 3 copies; a later read queries a different 2 of 3 -- and still finds it.", "fontSize": 15, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#64748b", "backgroundColor": "transparent", "opacity": 100, "seed": 702379, "width": 837.0, "height": 19.5}, {"id": "write_label", "type": "text", "x": 40, "y": 130, "text": "WRITE  (W = 2 of N = 3)", "originalText": "WRITE  (W = 2 of N = 3)", "fontSize": 17, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#1e3a5f", "backgroundColor": "transparent", "opacity": 100, "seed": 976892, "width": 234.6, "height": 22.1}, {"id": "client1", "type": "ellipse", "x": 40, "y": 170, "width": 120, "height": 70, "strokeColor": "#1e3a5f", "backgroundColor": "#93c5fd", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "seed": 664884}, {"id": "client1_t", "type": "text", "x": 60, "y": 195, "text": "Client", "originalText": "Client", "fontSize": 16, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "opacity": 100, "seed": 684054, "width": 57.599999999999994, "height": 20.8}, {"id": "nodeA", "type": "rectangle", "x": 320, "y": 160, "width": 200, "height": 90, "strokeColor": "#047857", "backgroundColor": "#a7f3d0", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "ro