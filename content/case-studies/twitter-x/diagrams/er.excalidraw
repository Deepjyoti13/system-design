      "strokeColor": "#4ade80", "backgroundColor": "transparent", "opacity": 100, "roughness": 0 },
    { "id": "t_s5", "type": "text", "x": 1020, "y": 545, "width": 420, "height": 16,
      "text": "NOT a table in the relational store --", "originalText": "NOT a table in the relational store --",
