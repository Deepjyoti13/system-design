    { "id": "t_b1", "type": "text", "x": 65, "y": 838, "width": 1500, "height": 18,
      "text": "posts + retweets: strongly consistent at write time -- UNIQUE(retweeter_id, original_post_id) is the concurrency guarantee, not app code.",
      "originalText": "posts + retweets: strongly consistent at write time -- UNIQUE(retweeter_id, original_post_id) is the concurrency guarantee, not app code.",
      "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#22c55e", "backgroundColor": "transparent", "opacity": 100, "roughness": 0 },
    { "id": "t_b2", "type": "text", "x": 65, "y": 866, "width": 1200, "height": 18,
      "text": "search index: eventually consistent, ~2s -- separate, tighter lag budget than feed_items' own tolerance.",
      "originalText": "search index: eventually consistent, ~2s -- separate, tighter lag budget than feed_items' own tolerance.",
      "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#22c55e", "backgroundColor": "transparent", "opacity": 100, "roughness": 0 },
    { "id": "t_b3", "type": "text", "x": 65, "y": 894, "width": 1300, "height": 18,
      "text": "retweets sharded by original_post_id, not retweeter_id -- keeps one viral post's retweets on a single shard.",
      "originalText": "retweets sharded by original_post_id, not retweeter_id -- keeps one viral post's retweets on a single shard.",
      "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#22c55e", "backgroundColor": "transparent", "opacity": 100, "roughness": 0 },
    { "id": "t_b4", "type": "text", "x": 65, "y": 922, "width": 1300, "height": 18,
      "text": "media (object storage): write-once immutable bytes -- posts.media_url pointer is strongly consistent.",
      "originalText": "media (object storage): write-once immutable bytes -- posts.media_url pointer is strongly consistent.",
      "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#22c55e", "backgroundColor": "transparent", "opacity": 100, "roughness": 0 },

    { "id": "t_footer", "type": "text", "x": 40, "y": 990, "width": 1560, "height": 20,
      "text": "Three stores, three consistency models -- none of them entangled with each other's guarantees.",
      "originalText": "Three stores, three consistency models -- none of them entangled with each other's guarantees.",
