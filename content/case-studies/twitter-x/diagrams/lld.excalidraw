      "text": "strategy = PushFanout if followGraphRepo.followerCount(retweeter_id) < THRESHOLD else PullMerge",
      "originalText": "strategy = PushFanout if followGraphRepo.followerCount(retweeter_id) < THRESHOLD else PullMerge",
