      "strokeColor": "#4ade80", "backgroundColor": "transparent", "opacity": 100, "roughness": 0 },
    { "id": "t_ev3", "type": "text", "x": 65, "y": 828, "width": 1500, "height": 16,
      "text": "# SAME interface PostService.publish() already calls -- invoked a SECOND time, keyed on the RETWEETER",
