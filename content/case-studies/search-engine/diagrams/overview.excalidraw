    { "type": "text", "id": "final_caption", "x": 70, "y": 730, "width": 760, "height": 44,
      "text": "Term-partitioning, per-shard bounded timeouts, and query-result caching all exist for one reason:\nprotect this 200ms budget, no matter how much of the web sits behind it.",
      "originalText": "Term-partitioning, per-shard bounded timeouts, and query-result caching all exist for one reason:\nprotect this 200ms budget, no matter how much of the web sits behind it.",
