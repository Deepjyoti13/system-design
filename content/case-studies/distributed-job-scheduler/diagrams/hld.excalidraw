{"type": "excalidraw", "version": 2, "source": "field-guide", "elements": [{"id": "title", "type": "text", "x": 40, "y": 30, "width": 811, "height": 31, "text": "One Leader Per Shard, Then an Atomic Claim", "originalText": "One Leader Per Shard, Then an Atomic Claim", "fontSize": 25, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#1971c2", "backgroundColor": "transparent", "opacity": 100, "seed": 61675}, {"id": "subtitle", "type": "text", "x": 40, "y": 70, "width": 1263, "height": 20, "text": "Leader election reduces how OFTEN two schedulers race; the atomic claim is what prevents a double-trigger when they do", "originalText": "Leader election reduces how OFTEN two schedulers race; the atomic claim is what prevents a double-trigger when they do", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#5c6470", "backgroundColor": "transparent", "opacity": 100, "seed": 85088}, {"id": "jobstore", "type": "rectangle", "x": 40, "y": 150, "width": 260, "height": 110, "strokeColor": "#5c6470", "backgroundColor": "#f1f3f5", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "seed": 42352, "roundness": {"type": 3}}, {"id": "jobstore_t", "type": "text", "x": 56, "y": 166, "width": 237, "height": 21, "text": "Job Store (Shard 1)", "originalText": "Job Store (Shard 1)", "fontSize": 15, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#33373d", "backgroundColor": "transparent", "opacity": 100, "seed": 82275}, {"id": "jobstore_t2", "type": "text", "x": 56, "y": 194, "width": 222, "height": 18, "text": "next_run_time <= NOW()", "originalText": "next_run_time <= NOW()", "fontSize": 12, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#33373d", "backgroundColor": "transparent", "opacity": 100, "seed": 4279}, {"id": "jobstore_t3", "type": "text", "x": 56, "y": 212, "width": 168, "height": 18, "text": "AND status='due'", "originalText": "AND status='due'", "fontSize": 12, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#33373d", "backgroundColor": "transparent", "opacity": 100, "seed": 31362}, {"id": "leader", "type": "rectangle", "x": 380, "y": 130, "width": 220, "height": 70, "strokeColor": "#2f9e44", "backgroundColor": "#d3f9d8", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "seed": 36826, "roundness": {"type": 3}}, {"id": "leader_t", "type": "text", "x": 396, "y": 148, "width": 213, "height": 20, "text": "Scheduler (LEADER)", "originalText": "Scheduler (LEADER)", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#1a5c2e", "backgroundColor": "transparent", "opacity": 100, "seed": 77918}, {"id": "leader_t2", "type": "text", "x": 396, "y": 170, "width": 213, "height": 17, "text": "holds lease for Shard 1", "originalText": "holds lease for Shard 1", "fontSize": 11, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#1a5c2e", "backgroundColor": "transparent", "opacity": 100, "seed": 29256}, {"id": "standby", "type": "rectangle", "x": 380, "y": 220, "width": 220, "height": 60, "strokeColor": "#adb5bd", "backgroundColor": "#f1f3f5", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "seed": 67732, "roundness": {"type": 3}}, {"id": "standby_t", "type": "text", "x": 396, "y": 236, "width": 209, "height": 19, "text": "Scheduler (standby)", "originalText": "Scheduler (standby)", "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#5c6470", "backgroundColor": "transparent", "opacity": 100, "seed": 70700}, {"id": "standby_t2", "type": "text", "x": 396, "y": 256, "width": 288, "height": 17, "text": "does nothing until lease expires", "originalText": "does nothing until lease expires", "fontSize": 11, "fontFamily": 3, "textAlign": "left", "verticalAlig