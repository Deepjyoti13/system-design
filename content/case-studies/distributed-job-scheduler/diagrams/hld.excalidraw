 197, "height": 17, "text": "(scales independently", "originalText": "(scales independently", "fontSize": 11, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#1e3a5f", "backgroundColor": "transparent", "opacity": 100, "seed": 92015}, {"id": "workers_t6", "type": "text", "x": 936, "y": 212, "width": 205, "height": 17, "text": "of scheduler capacity)", "originalText": "of scheduler capacity)", "fontSize": 11, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#1e3a5f", "backgroundColor": "transparent", "opacity": 100, "seed": 71253}, {"id": "a_queue_workers", "type": "arrow", "x": 860, "y": 165, "width": 60, "height": 1, "points": [[0, 0], [60, 0]], "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "seed": 83494, "startArrowhead": null, "endArrowhead": "triangle"}, {"id": "runs", "type": "rectangle", "x": 920, "y": 280, "width": 220, "height": 70, "strokeColor": "#c2255c", "backgroundColor": "#ffe0eb", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "seed": 49679, "roundness": {"type": 3}}, {"id": "runs_t", "type": "text", "x": 936, "y": 298, "width": 139, "height": 20, "text": "Run History", "originalText": "Run History", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#8a1a45", "backgroundColor": "transparent", "opacity": 100, "seed": 43908}, {"id": "runs_t2", "type": "text", "x": 936, "y": 320, "width": 222, "height": 17, "text": "(job_id, run_id, status)", "originalText": "(job_id, run_id, status)", "fontSize": 11, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#8a1a45", "backgroundColor": "transparent", "opacity": 100, "seed": 85458}, {"id": "a_workers_runs", "type": "arrow", "x": 1010, "y": 230, "width": 1, "height": 50, "points": [[0, 0], [0, 50]], "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "seed": 21246, "startArrowhead": null, "endArrowhead": "triangle"}, {"id": "evidence_box", "type": "rectangle", "x": 40, "y": 400, "width": 1597, "height": 80, "strokeColor": "#1e1e1e", "backgroundColor": "#0d1117", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "seed": 41507, "roundness": {"type": 3}}, {"id": "evidence_l0", "type": "text", "x": 60, "y": 416, "width": 1168, "height": 20, "text": "Only the current LEADER for a shard scans it for due jobs -- but leadership alone isn't the safety mechanism.", "originalText": "Only the current LEADER for a shard scans it for due jobs -- but leadership alone isn't the safety mechanism.", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#7ee787", "backgroundColor": "transparent", "opacity": 100, "seed": 36676}, {"id": "evidence_l1", "type": "text", "x": 60, "y": 444, "width": 1557, "height": 20, "text": "The claim itself is a conditional update whose WHERE clause checks the row's OWN current status, closing the race even during a brief split-brain.", "originalText": "The claim itself is a conditional update whose WHERE clause checks the row's OWN current status, closing the race even during a brief split-brain.", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#7ee787", "backgroundColor": "transparent", "opacity": 100, "seed": 52094}], "appState": {"viewBackgroundColor": "#ffffff"}}