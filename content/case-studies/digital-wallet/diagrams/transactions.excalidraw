   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "Each partition's local transaction begins and ends in\nmicroseconds. A coordinator crash leaves NO ONE blocked -\njust an unfinished transfer that a recovery worker drives\nto a terminal state.\n\nThe cost: the intermediate state is VISIBLE.",
   "originalText": "Each partition's local transaction begins and ends in\nmicroseconds. A coordinator crash leaves NO ONE blocked -\njust an unfinished transfer that a recovery worker drives\nto a terminal state.\n\nThe cost: the intermediate state is VISIBLE.",
