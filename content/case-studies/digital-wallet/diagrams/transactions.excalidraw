   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "CREDIT FIRST    C can spend $10 that A still has.",
   "originalText": "CREDIT FIRST    C can spend $10 that A still has.",
   "fontSize": 14,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "an",
   "type": "text",
   "x": 30,
   "y": 282,
   "width": 1043,
   "height": 81,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100019,
   "version": 1,
   "versionNonce": 700133,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "A temporary DEFICIT is recoverable; a temporary SURPLUS is exploitable. If both spend, the system has paid out money it never\nhad - a mint, and unrecoverable, because you cannot claw back a completed downstream payment.\n\nThe consequence people miss: this also FORBIDS running the two legs in parallel, since parallelism would create a window\nwhere the credit might land first. A real latency cost paid for a correctness reason - and a constraint on ANY protocol you pick.",
   "originalText": "A temporary DEFICIT is recoverable; a temporary SURPLUS is exploitable. If both spend, the system has paid out money it never\nhad - a mint, and unrecoverable, because you cannot claw back a completed downstream payment.\n\nThe consequence people miss: this also FORBIDS running the two legs in parallel, since parallelism would create a window\nwhere the credit might land first. A real latency cost paid for a correctness reason - and a constraint on ANY protocol you pick.",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
