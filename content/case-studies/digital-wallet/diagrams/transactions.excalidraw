   "link": null,
   "locked": false,
   "text": "LOCKS HELD, uncommitted",
   "originalText": "LOCKS HELD, uncommitted",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "p1c",
