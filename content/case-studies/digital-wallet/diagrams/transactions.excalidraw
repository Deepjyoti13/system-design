   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "In 2PC phase 1 leaves transactions UNCOMMITTED. In TC/C it fully commits.",
   "originalText": "In 2PC phase 1 leaves transactions UNCOMMITTED. In TC/C it fully commits.",
   "fontSize": 22,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "s",
   "type": "text",
   "x": 30,
   "y": 52,
   "width": 889,
   "height": 17,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100002,
   "version": 1,
   "versionNonce": 700014,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "That one difference is why 2PC blocks on a coordinator crash and TC/C does not - nothing is ever held.",
   "originalText": "That one difference is why 2PC blocks on a coordinator crash and TC/C does not - nothing is ever held.",
   "fontSize": 14,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
