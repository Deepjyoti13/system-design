   "locked": false,
   "text": "# WRONG - non-deterministic on replay\napply(event):\n    if now() - account.last_active > 90 days: dormant = true\n    if fraudService.check(event): account.frozen = true",
   "originalText": "# WRONG - non-deterministic on replay\napply(event):\n    if now() - account.last_active > 90 days: dormant = true\n    if fraudService.check(event): account.frozen = true",
