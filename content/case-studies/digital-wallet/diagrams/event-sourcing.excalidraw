  {
   "id": "dn",
   "type": "text",
   "x": 850,
   "y": 768,
   "width": 769,
   "height": 130,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100062,
   "version": 1,
   "versionNonce": 700434,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "Each projection is an independent FOLD of the same events into whatever shape its queries want.\n\n  read models scale independently of the write path\n  a projection bug is fixable retroactively: fix, drop, replay\n  NEW read models can be built for data that PREDATES them - a monthly-statement feature\n  invented today works for the last three years. Commercially this is often worth more\n  than the auditing.\n  the read side is fully EXPENDABLE: if projections fail, transfers keep working",
   "originalText": "Each projection is an independent FOLD of the same events into whatever shape its queries want.\n\n  read models scale independently of the write path\n  a projection bug is fixable retroactively: fix, drop, replay\n  NEW read models can be built for data that PREDATES them - a monthly-statement feature\n  invented today works for the last three years. Commercially this is often worth more\n  than the auditing.\n  the read side is fully EXPENDABLE: if projections fail, transfers keep working",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "dn2",
   "type": "text",
   "x": 850,
   "y": 928,
   "width": 914,
   "height": 32,
   "strokeColor": "#b45309",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100063,
   "version": 1,
   "versionNonce": 700441,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "The cost is a real user-facing problem: a user completes a transfer, refreshes, and sees their OLD balance.\nHandled by exposing as_of_sequence, and by reading the write path directly for the one account they just touched.",
   "originalText": "The cost is a real user-facing problem: a user completes a transfer, refreshes, and sees their OLD balance.\nHandled by exposing as_of_sequence, and by reading the write path directly for the one account they just touched.",
