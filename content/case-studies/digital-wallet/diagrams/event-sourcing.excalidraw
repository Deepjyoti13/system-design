   "versionNonce": 700161,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "# RIGHT - the decision was made ONCE, and recorded\nhandle(command):                      # runs once; may be non-deterministic\n    dormant = now() - account.last_active > 90 days\n    frozen  = fraudService.check(command)\n    emit Debited(..., at=now(), dormant_at_time=dormant)\n\napply(event):                         # pure function of (state, event)\n    account.balance -= event.amount",
   "originalText": "# RIGHT - the decision was made ONCE, and recorded\nhandle(command):                      # runs once; may be non-deterministic\n    dormant = now() - account.last_active > 90 days\n    frozen  = fraudService.check(command)\n    emit Debited(..., at=now(), dormant_at_time=dormant)\n\napply(event):                         # pure function of (state, event)\n    account.balance -= event.amount",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "right",
   "lineHeight": 1.25
  },
  {
