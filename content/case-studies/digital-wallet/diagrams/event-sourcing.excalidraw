   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "past tense           CANNOT fail - it happened\nDETERMINISTIC        a recorded fact\n                     no decision left in it\n\ndurable? YES - the source of truth",
   "originalText": "past tense           CANNOT fail - it happened\nDETERMINISTIC        a recorded fact\n                     no decision left in it\n\ndurable? YES - the source of truth",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "an",
   "type": "text",
   "x": 30,
   "y": 348,
   "width": 463,
   "height": 81,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100014,
   "version": 1,
   "versionNonce": 700098,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "Replaying 'transfer $10' re-evaluates 'does A have $10?'\nagainst whatever state exists now, and might call a fraud\nAPI that answers differently. That does not reconstruct\nhistory - it RE-DECIDES it. Replaying Debited(A, 10)\nalways subtracts 10.",
   "originalText": "Replaying 'transfer $10' re-evaluates 'does A have $10?'\nagainst whatever state exists now, and might call a fraud\nAPI that answers differently. That does not reconstruct\nhistory - it RE-DECIDES it. Replaying Debited(A, 10)\nalways subtracts 10.",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
