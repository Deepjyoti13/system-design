  {
   "id": "right_t",
   "type": "text",
   "x": 868,
   "y": 280,
   "width": 764,
   "height": 120,
   "strokeColor": "#047857",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
