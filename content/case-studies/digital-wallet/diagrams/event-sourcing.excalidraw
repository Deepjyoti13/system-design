  {
   "id": "cn",
   "type": "text",
   "x": 30,
   "y": 636,
   "width": 995,
   "height": 48,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100045,
   "version": 1,
   "versionNonce": 700315,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "Facts do not change, so history cannot be rewritten. Conclusions are recomputable, so a bug in the folding logic is fixable\nRETROACTIVELY - fix the code and replay. Under a balance-storing schema, a bug that produced a wrong balance is permanent,\nbecause the inputs are gone.",
   "originalText": "Facts do not change, so history cannot be rewritten. Conclusions are recomputable, so a bug in the folding logic is fixable\nRETROACTIVELY - fix the code and replay. Under a balance-storing schema, a bug that produced a wrong balance is permanent,\nbecause the inputs are gone.",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
