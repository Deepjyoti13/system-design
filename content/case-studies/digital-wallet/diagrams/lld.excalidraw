   "version": 1,
   "versionNonce": 700210,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "Event Sourcing          state as a fold over an immutable log\nCQRS                    separate write model and read projections\nState Machine Replication   Raft replicates the LOG, and every replica applies it deterministically to reach identical\n                        state - so the determinism rule is not fussiness, it is what makes SMR sound\nCompensating Transaction    TC/C's Cancel phase\nTombstone               the out-of-order cancel flag: a marker for an operation that has not arrived yet\nSingle-threaded event loop   one thread, lock-free, pinned",
   "originalText": "Event Sourcing          state as a fold over an immutable log\nCQRS                    separate write model and read projections\nState Machine Replication   Raft replicates the LOG, and every replica applies it deterministically to reach identical\n                        state - so the determinism rule is not fussiness, it is what makes SMR sound\nCompensating Transaction    TC/C's Cancel phase\nTombstone               the out-of-order cancel flag: a marker for an operation that has not arrived yet\nSingle-threaded event loop   one thread, lock-free, pinned",
   "fontSize": 13,
