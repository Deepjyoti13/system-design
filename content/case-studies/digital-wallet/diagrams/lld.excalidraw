   "versionNonce": 700042,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "interface CommandHandler\n  handle(cmd, state: StateView) -> Result<List<Event>, Rejection>\n\nread-only StateView. May call a fraud service,\nread the clock, generate a UUID. Runs ONCE.",
   "originalText": "interface CommandHandler\n  handle(cmd, state: StateView) -> Result<List<Event>, Rejection>\n\nread-only StateView. May call a fraud service,\nread the clock, generate a UUID. Runs ONCE.",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "h",
   "lineHeight": 1.25
  },
  {
   "id": "a",
   "type": "rectangle",
   "x": 570,
   "y": 146,
   "width": 480,
   "height": 120,
   "strokeColor": "#047857",
   "backgroundColor": "#a7f3d0",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100007,
   "version": 1,
   "versionNonce": 700049,
   "isDeleted": false,
