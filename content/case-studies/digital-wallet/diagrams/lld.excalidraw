   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "two debits on one account   the single-threaded leader serializes them; the\n                            second validates against updated state\nbalance reads               served from projections - separate processes\nlog appends                 one writer per partition by construction\ncross-partition transfers   TC/C's committed local transactions replace\n                            the distributed lock a 2PC design would need",
   "originalText": "two debits on one account   the single-threaded leader serializes them; the\n                            second validates against updated state\nbalance reads               served from projections - separate processes\nlog appends                 one writer per partition by construction\ncross-partition transfers   TC/C's committed local transactions replace\n                            the distributed lock a 2PC design would need",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
