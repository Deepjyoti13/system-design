   "version": 1,
   "versionNonce": 700154,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "Concurrency: the design ELIMINATES the intra-process race rather than guarding it",
   "originalText": "Concurrency: the design ELIMINATES the intra-process race rather than guarding it",
   "fontSize": 17,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "nl",
   "type": "text",
   "x": 30,
   "y": 666,
   "width": 190,
   "height": 18,
   "strokeColor": "#047857",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100023,
   "version": 1,
   "versionNonce": 700161,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "Needs no lock at all",
   "originalText": "Needs no lock at all",
   "fontSize": 15,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "nl2",
   "type": "text",
   "x": 30,
   "y": 692,
   "width": 562,
   "height": 90,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
