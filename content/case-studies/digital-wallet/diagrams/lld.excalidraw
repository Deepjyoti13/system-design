  {
   "id": "bl",
   "type": "text",
   "x": 30,
   "y": 384,
   "width": 657,
   "height": 21,
   "strokeColor": "#1e40af",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100011,
   "version": 1,
   "versionNonce": 700077,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "Four optimizations, in order of impact - 1,000 TPS to ~100,000",
   "originalText": "Four optimizations, in order of impact - 1,000 TPS to ~100,000",
   "fontSize": 17,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "on_30",
   "type": "text",
   "x": 30,
   "y": 422,
   "width": 186,
   "height": 35,
   "strokeColor": "#1e40af",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100012,
   "version": 1,
   "versionNonce": 700084,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "1. sequential append,\n    not random update",
   "originalText": "1. sequential append,\n    not random update",
   "fontSize": 14,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "od_30",
   "type": "text",
   "x": 30,
   "y": 474,
   "width": 323,
   "height": 60,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100013,
   "version": 1,
   "versionNonce": 700091,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "~150 MB/s vs ~0.6 MB/s. At 200 bytes/event\nthat is 750,000 events/sec theoretical, so\nTHE DISK STOPS BEING THE BOTTLENECK - which\ntells you to optimize CPU and network next.",
   "originalText": "~150 MB/s vs ~0.6 MB/s. At 200 bytes/event\nthat is 750,000 events/sec theoretical, so\nTHE DISK STOPS BEING THE BOTTLENECK - which\ntells you to optimize CPU and network next.",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "on_450",
   "type": "text",
   "x": 450,
   "y": 422,
   "width": 168,
   "height": 35,
   "strokeColor": "#1e40af",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100014,
   "version": 1,
   "versionNonce": 700098,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "2. state in memory,\n    not on disk",
   "originalText": "2. state in memory,\n    not on disk",
   "fontSize": 14,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "od_450",
   "type": "text",
   "x": 450,
   "y": 474,
   "width": 301,
   "height": 60,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100015,
   "version": 1,
   "versionNonce": 700105,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "100M accounts x 64 bytes = 6.4 GB per\npartition. No disk read to validate.\nOnly safe because state is DERIVABLE - a\nconventional design cannot do this.",
   "originalText": "100M accounts x 64 bytes = 6.4 GB per\npartition. No disk read to validate.\nOnly safe because state is DERIVABLE - a\nconventional design cannot do this.",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "on_870",
   "type": "text",
   "x": 870,
   "y": 422,
   "width": 194,
   "height": 17,
   "strokeColor": "#1e40af",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100016,
   "version": 1,
   "versionNonce": 700112,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "3. mmap the event file",
   "originalText": "3. mmap the event file",
   "fontSize": 14,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "od_870",
   "type": "text",
   "x": 870,
   "y": 474,
   "width": 338,
   "height": 60,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100017,
   "version": 1,
   "versionNonce": 700119,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "An append becomes a memcpy: 100k syscalls/sec\nremoved. Acceptable ONLY because durability\ncomes from Raft replication rather than a\nlocal fsync.",
   "originalText": "An append becomes a memcpy: 100k syscalls/sec\nremoved. Acceptable ONLY because durability\ncomes from Raft replication rather than a\nlocal fsync.",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "on_1290",
   "type": "text",
   "x": 1290,
   "y": 422,
   "width": 194,
   "height": 35,
   "strokeColor": "#1e40af",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100018,
   "version": 1,
   "versionNonce": 700126,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "4. ONE thread,\n    pinned to one core",
   "originalText": "4. ONE thread,\n    pinned to one core",
   "fontSize": 14,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "od_1290",
   "type": "text",
   "x": 1290,
   "y": 474,
   "width": 331,
   "height": 60,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100019,
   "version": 1,
   "versionNonce": 700133,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "No locks, no context switches, hot cache -\nand SERIAL EXECUTION BECOMES THE CONCURRENCY\nCONTROL. Multi-core capacity comes from many\npartitions per machine.",
   "originalText": "No locks, no context switches, hot cache -\nand SERIAL EXECUTION BECOMES THE CONCURRENCY\nCONTROL. Multi-core capacity comes from many\npartitions per machine.",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "bn",
   "type": "text",
   "x": 30,
   "y": 552,
   "width": 987,
   "height": 32,
   "strokeColor": "#1e40af",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100020,
   "version": 1,
   "versionNonce": 700140,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "The reframe worth leading with: this is not a sharding problem, it is a 'make one node fast enough that you barely need to\nshard' problem. 2,000 nodes becomes 20 partitions - 60 machines at RF 3.",
   "originalText": "The reframe worth leading with: this is not a sharding problem, it is a 'make one node fast enough that you barely need to\nshard' problem. 2,000 nodes becomes 20 partitions - 60 machines at RF 3.",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
