   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "handle() may do anything. apply() must be pure. The types enforce it.",
   "originalText": "handle() may do anything. apply() must be pure. The types enforce it.",
   "fontSize": 22,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "s",
   "type": "text",
   "x": 30,
   "y": 52,
   "width": 1054,
   "height": 17,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100002,
   "version": 1,
   "versionNonce": 700014,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "A single combined process(command) would leave nothing preventing an apply-time clock read - a bug silent until an audit.",
   "originalText": "A single combined process(command) would leave nothing preventing an apply-time clock read - a bug silent until an audit.",
   "fontSize": 14,
   "fontFamily": 3,
   "textAlign": "left",
