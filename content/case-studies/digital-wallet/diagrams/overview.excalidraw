   "locked": false,
   "text": "BEGIN ... COMMIT cannot span this",
   "originalText": "BEGIN ... COMMIT cannot span this",
   "fontSize": 14,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
