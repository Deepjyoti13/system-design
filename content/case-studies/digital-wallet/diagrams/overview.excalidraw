   }
  },
  {
   "id": "float_t",
   "type": "text",
   "x": 38,
   "y": 779,
   "width": 484,
   "height": 21,
   "strokeColor": "#374151",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100053,
   "version": 1,
   "versionNonce": 700371,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "0.1 + 0.2 != 0.3",
   "originalText": "0.1 + 0.2 != 0.3",
   "fontSize": 17,
   "fontFamily": 3,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "float",
   "lineHeight": 1.25
  },
  {
   "id": "fl",
   "type": "text",
   "x": 560,
   "y": 758,
   "width": 777,
   "height": 65,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100054,
   "version": 1,
   "versionNonce": 700378,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "IEEE-754 binary floating point cannot represent 0.10 exactly. Accumulate that across a billion\ntransactions and balances drift with no bug to point at - the error is in the REPRESENTATION,\nso every arithmetic operation contributes a little. Amounts are integer minor units, on the wire\nas decimal strings. The most common correctness error in a money system, and entirely avoidable.",
   "originalText": "IEEE-754 binary floating point cannot represent 0.10 exactly. Accumulate that across a billion\ntransactions and balances drift with no bug to point at - the error is in the REPRESENTATION,\nso every arithmetic operation contributes a little. Amounts are integer minor units, on the wire\nas decimal strings. The most common correctness error in a money system, and entirely avoidable.",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  }
