  {
   "id": "bn2",
   "type": "text",
   "x": 810,
   "y": 306,
   "width": 552,
   "height": 65,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100034,
   "version": 1,
   "versionNonce": 700238,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "2,000 database nodes each holding a shard of the world's money -\neach needing backups, failover, schema migrations, and participation\nin distributed transactions - is not an architecture, it is an\noperations disaster.",
   "originalText": "2,000 database nodes each holding a shard of the world's money -\neach needing backups, failover, schema migrations, and participation\nin distributed transactions - is not an architecture, it is an\noperations disaster.",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "res",
