   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "33x fewer, achieved by\nchanging the storage model,\nnot by buying hardware",
   "originalText": "33x fewer, achieved by\nchanging the storage model,\nnot by buying hardware",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
