   "versionNonce": 700392,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "assume it SUCCEEDED, mark complete\n-> if it actually failed, the recipient was credited\nwithout the sender being debited.   ALSO A MINT.",
   "originalText": "assume it SUCCEEDED, mark complete\n-> if it actually failed, the recipient was credited\nwithout the sender being debited.   ALSO A MINT.",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "t2",
   "lineHeight": 1.25
  },
  {
