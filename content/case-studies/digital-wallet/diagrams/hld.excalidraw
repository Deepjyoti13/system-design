  {
   "id": "rn",
   "type": "text",
   "x": 30,
   "y": 748,
   "width": 737,
   "height": 65,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100070,
   "version": 1,
   "versionNonce": 700490,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "This path is why balance queries can be orders of magnitude more frequent than transfers\nwithout touching the write path at all. as_of_sequence exposes the consistency boundary\nrather than hiding it - a bare balance is ambiguous, because the client cannot tell whether\nit reflects the transfer they just made.",
   "originalText": "This path is why balance queries can be orders of magnitude more frequent than transfers\nwithout touching the write path at all. as_of_sequence exposes the consistency boundary\nrather than hiding it - a bare balance is ambiguous, because the client cannot tell whether\nit reflects the transfer they just made.",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "gl",
   "type": "text",
   "x": 880,
   "y": 644,
   "width": 320,
   "height": 21,
   "strokeColor": "#1e40af",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100071,
   "version": 1,
   "versionNonce": 700497,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "Graceful degradation, in order",
   "originalText": "Graceful degradation, in order",
   "fontSize": 17,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "gn",
   "type": "text",
   "x": 880,
   "y": 682,
   "width": 568,
   "height": 113,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100072,
   "version": 1,
   "versionNonce": 700504,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "follower dies          Raft continues on quorum. No impact.\nLEADER dies            new leader in seconds; replays its log tail\n                       to rebuild in-memory state.\npartition loses quorum WRITES STOP. Deliberate: accepting writes\n                       without quorum risks losing acknowledged money.\ncoordinator dies       recovery workers pick up stuck transfers.\nread models fail       queries degrade; TRANSFERS CONTINUE.",
   "originalText": "follower dies          Raft continues on quorum. No impact.\nLEADER dies            new leader in seconds; replays its log tail\n                       to rebuild in-memory state.\npartition loses quorum WRITES STOP. Deliberate: accepting writes\n                       without quorum risks losing acknowledged money.\ncoordinator dies       recovery workers pick up stuck transfers.\nread models fail       queries degrade; TRANSFERS CONTINUE.",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "gn2",
   "type": "text",
   "x": 880,
   "y": 830,
   "width": 640,
   "height": 16,
   "strokeColor": "#047857",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100073,
   "version": 1,
   "versionNonce": 700511,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "That last line is the nice property of CQRS: the read side is fully expendable.",
   "originalText": "That last line is the nice property of CQRS: the read side is fully expendable.",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  }
