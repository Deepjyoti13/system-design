   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "NOT a rollback. The Debited event\nstays in the log FOREVER and a new\noffsetting event is appended beside\nit - so the audit trail shows what\nactually happened: a debit and a\nreversal. A mechanism that erased\nhistory would be disqualifying here.",
   "originalText": "NOT a rollback. The Debited event\nstays in the log FOREVER and a new\noffsetting event is appended beside\nit - so the audit trail shows what\nactually happened: a debit and a\nreversal. A mechanism that erased\nhistory would be disqualifying here.",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
