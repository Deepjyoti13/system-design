  {
   "id": "pn",
   "type": "text",
   "x": 940,
   "y": 340,
   "width": 368,
   "height": 120,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100074,
   "version": 1,
   "versionNonce": 700518,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "This records the coordinator's INTENT AND BELIEF.\nThe events log records what HAPPENED. They can\ndisagree - that is the whole point of UNCERTAIN.\n\nA timeout is resolved by reading applied_legs on\nthe partition, never by trusting phase_status. If\nit were authoritative, a timeout would have to be\nread as success or failure - and both mint money.",
   "originalText": "This records the coordinator's INTENT AND BELIEF.\nThe events log records what HAPPENED. They can\ndisagree - that is the whole point of UNCERTAIN.\n\nA timeout is resolved by reading applied_legs on\nthe partition, never by trusting phase_status. If\nit were authoritative, a timeout would have to be\nread as success or failure - and both mint money.",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
