   "seed": 100114,
   "version": 1,
   "versionNonce": 700798,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "Inverted from most designs: expensive guarantees are bought only on the ~200k events/sec write path, never on the far larger\nread volume. That is what makes the throughput numbers work.",
   "originalText": "Inverted from most designs: expensive guarantees are bought only on the ~200k events/sec write path, never on the far larger\nread volume. That is what makes the throughput numbers work.",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  }
