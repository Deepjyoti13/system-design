  {
   "id": "en",
   "type": "text",
   "x": 30,
   "y": 430,
   "width": 390,
   "height": 240,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100031,
   "version": 1,
   "versionNonce": 700217,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "sequence is monotonic WITHIN a partition, not\nglobally - a global sequence would need cross-\npartition coordination on every event, the exact\nbottleneck being eliminated. Per-partition is FREE\n(the Raft leader assigns it) and SUFFICIENT, because\nthe only ordering that must be total is one\nACCOUNT's - and an account never moves partitions.\n\noccurred_at is stamped ONCE at command time and\nstored IN the row, so replay uses the recorded\nvalue. amount_minor is an integer.\n\nNo UPDATE or DELETE grant on this table, ever.\nCompensation appends a new row with compensates_leg\nset. Enforcing append-only in PERMISSIONS rather\nthan by convention is how you keep it true at 3am.",
   "originalText": "sequence is monotonic WITHIN a partition, not\nglobally - a global sequence would need cross-\npartition coordination on every event, the exact\nbottleneck being eliminated. Per-partition is FREE\n(the Raft leader assigns it) and SUFFICIENT, because\nthe only ordering that must be total is one\nACCOUNT's - and an account never moves partitions.\n\noccurred_at is stamped ONCE at command time and\nstored IN the row, so replay uses the recorded\nvalue. amount_minor is an integer.\n\nNo UPDATE or DELETE grant on this table, ever.\nCompensation appends a new row with compensates_leg\nset. Enforcing append-only in PERMISSIONS rather\nthan by convention is how you keep it true at 3am.",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
