   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "The events table IS the double-entry ledger",
   "originalText": "The events table IS the double-entry ledger",
   "fontSize": 17,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
