   "text": "Where the guarantees go - and note the inversion",
   "originalText": "Where the guarantees go - and note the inversion",
   "fontSize": 17,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
