  },
  {
   "id": "sql",
   "type": "rectangle",
   "x": 30,
   "y": 756,
   "width": 820,
   "height": 128,
   "strokeColor": "#1e293b",
   "backgroundColor": "#1e293b",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100108,
   "version": 1,
   "versionNonce": 700756,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": [
    {
     "id": "sql_t",
     "type": "text"
    }
   ],
   "link": null,
   "locked": false,
   "roundness": {
    "type": 3
   }
  },
  {
   "id": "sql_t",
   "type": "text",
   "x": 38,
   "y": 775,
   "width": 804,
   "height": 90,
   "strokeColor": "#ffffff",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100109,
   "version": 1,
   "versionNonce": 700763,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "SELECT transaction_id,\n       SUM(CASE WHEN event_type = DEBITED\n                THEN -amount_minor ELSE amount_minor END) AS net\nFROM events WHERE currency = 'USD'\nGROUP BY transaction_id\nHAVING net <> 0;        -- MUST return zero rows",
   "originalText": "SELECT transaction_id,\n       SUM(CASE WHEN event_type = DEBITED\n                THEN -amount_minor ELSE amount_minor END) AS net\nFROM events WHERE currency = 'USD'\nGROUP BY transaction_id\nHAVING net <> 0;        -- MUST return zero rows",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "sql",
   "lineHeight": 1.25
  },
  {
   "id": "dn",
   "type": "text",
   "x": 890,
   "y": 756,
   "width": 689,
   "height": 162,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100110,
   "version": 1,
   "versionNonce": 700770,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "A Debited row and a Credited row are the two halves of one entry - which is why\nthere is no separate ledger table to disagree with it.\n\nThe qualification matters: during TC/C's window an in-flight transaction legitimately\nsums non-zero. So the check runs against TERMINAL transactions at a COMMITTED\nSEQUENCE POSITION, never as a live scan. Under that qualification, a single non-zero\nrow is created or destroyed money.\n\nThe honest gap: nothing in this design runs it on a schedule with an alert. Writing\ndown an invariant without automating its check is how it quietly stops being true.",
   "originalText": "A Debited row and a Credited row are the two halves of one entry - which is why\nthere is no separate ledger table to disagree with it.\n\nThe qualification matters: during TC/C's window an in-flight transaction legitimately\nsums non-zero. So the check runs against TERMINAL transactions at a COMMITTED\nSEQUENCE POSITION, never as a live scan. Under that qualification, a single non-zero\nrow is created or destroyed money.\n\nThe honest gap: nothing in this design runs it on a schedule with an alert. Writing\ndown an invariant without automating its check is how it quietly stops being true.",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "d3",
   "type": "line",
   "x": 30,
   "y": 908,
   "width": 1680,
   "height": 0,
   "strokeColor": "#cbd5e1",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
