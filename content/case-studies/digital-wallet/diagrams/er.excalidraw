   "version": 1,
   "versionNonce": 700791,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "events                        LINEARIZABLE within a partition (Raft quorum)   <- the strongest guarantee, on an append-only log\napplied_legs / cancelled_legs LINEARIZABLE, same log - committed atomically with the event they describe\ncross-partition (a transfer)  EVENTUAL, bounded by the deadline - TC/C's deliberate concession\nphase_status / idempotency    strong, read-your-writes - a stale read double-compensates or mints\nbalances / history            EVENTUAL, ms to seconds - staleness exposed via as_of_sequence\nsnapshots                     no guarantee needed - derivable from the log",
   "originalText": "events                        LINEARIZABLE within a partition (Raft quorum)   <- the strongest guarantee, on an append-only log\napplied_legs / cancelled_legs LINEARIZABLE, same log - committed atomically with the event they describe\ncross-partition (a transfer)  EVENTUAL, bounded by the deadline - TC/C's deliberate concession\nphase_status / idempotency    strong, read-your-writes - a stale read double-compensates or mints\nbalances / history            EVENTUAL, ms to seconds - staleness exposed via as_of_sequence\nsnapshots                     no guarantee needed - derivable from the log",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "cn2",
   "type": "text",
