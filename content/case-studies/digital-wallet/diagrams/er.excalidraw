  {
   "id": "in",
   "type": "text",
   "x": 500,
   "y": 400,
   "width": 390,
   "height": 120,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100055,
   "version": 1,
   "versionNonce": 700385,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "Why these MUST be in the replicated log rather than\nlocal bookkeeping: applied_legs is what makes a leg\nidempotent. If it lived in the leader's memory, then\non failover the NEW leader would have no record and\nwould happily apply a retried leg a second time.\n\ncancelled_legs is the out-of-order tombstone - a\nmarker for an operation that has not arrived yet.",
   "originalText": "Why these MUST be in the replicated log rather than\nlocal bookkeeping: applied_legs is what makes a leg\nidempotent. If it lived in the leader's memory, then\non failover the NEW leader would have no record and\nwould happily apply a retried leg a second time.\n\ncancelled_legs is the out-of-order tombstone - a\nmarker for an operation that has not arrived yet.",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
