   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "Reads target 99.99%, writes 99.9%. A link that already exists is worth more than a new one is to accept - so under pressure the\nsystem sheds analytics first, then rejects creates, and never sheds redirects. Route-level tier splitting is what makes that possible.",
   "originalText": "Reads target 99.99%, writes 99.9%. A link that already exists is worth more than a new one is to accept - so under pressure the\nsystem sheds analytics first, then rejects creates, and never sheds redirects. Route-level tier splitting is what makes that possible.",
