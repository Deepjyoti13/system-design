  },
  {
   "id": "bwhy",
   "type": "text",
   "x": 640,
   "y": 236,
   "width": 592,
   "height": 48,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100046,
   "version": 1,
   "versionNonce": 700322,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "Refill early, never on exhaustion. A synchronous refill puts a ~5ms etcd\nround trip in front of one unlucky create - and does it while holding the\nmutex, so every concurrent creator on that instance stalls behind it.",
   "originalText": "Refill early, never on exhaustion. A synchronous refill puts a ~5ms etcd\nround trip in front of one unlucky create - and does it while holding the\nmutex, so every concurrent creator on that instance stalls behind it.",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "bm",
   "type": "text",
   "x": 640,
   "y": 306,
   "width": 376,
   "height": 18,
   "strokeColor": "#1e40af",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100047,
   "version": 1,
   "versionNonce": 700329,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "What the only mutex in the design guards",
   "originalText": "What the only mutex in the design guards",
   "fontSize": 15,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
