   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "next_  /  end_\nan integer pair",
   "originalText": "next_  /  end_\nan integer pair",
   "fontSize": 14,
   "fontFamily": 3,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "mtx",
   "lineHeight": 1.25
  },
  {
   "id": "bml",
   "type": "text",
   "x": 960,
   "y": 336,
   "width": 278,
   "height": 48,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100050,
   "version": 1,
   "versionNonce": 700350,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "Held for hundreds of nanoseconds,\nno I/O inside it. This is the ONLY\ngenuine intra-process race here.",
   "originalText": "Held for hundreds of nanoseconds,\nno I/O inside it. This is the ONLY\ngenuine intra-process race here.",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "bcross",
   "type": "text",
   "x": 640,
   "y": 424,
   "width": 273,
   "height": 18,
   "strokeColor": "#1e40af",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100051,
   "version": 1,
   "versionNonce": 700357,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "And what needs no lock at all",
   "originalText": "And what needs no lock at all",
   "fontSize": 15,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "bcross2",
   "type": "text",
   "x": 640,
   "y": 452,
   "width": 535,
   "height": 65,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100052,
   "version": 1,
   "versionNonce": 700364,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "Minting across instances     disjoint pre-allocated blocks\nClaiming a custom alias      UNIQUE index on code\nAllocating the next block    compare-and-swap, retried\nCache writes                 identical bytes; the row is immutable",
   "originalText": "Minting across instances     disjoint pre-allocated blocks\nClaiming a custom alias      UNIQUE index on code\nAllocating the next block    compare-and-swap, retried\nCache writes                 identical bytes; the row is immutable",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "bcross3",
   "type": "text",
   "x": 640,
   "y": 548,
   "width": 664,
   "height": 32,
   "strokeColor": "#1e40af",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100053,
   "version": 1,
   "versionNonce": 700371,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "Cross-process races belong to the database. Intra-process races belong to a mutex.\nTelling them apart is most of what concurrency design is.",
   "originalText": "Cross-process races belong to the database. Intra-process races belong to a mutex.\nTelling them apart is most of what concurrency design is.",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
