   "locked": false,
   "text": "refill fires HERE, at 10,000 remaining",
   "originalText": "refill fires HERE, at 10,000 remaining",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
