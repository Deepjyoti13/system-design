  {
   "id": "cnote",
   "type": "text",
   "x": 30,
   "y": 788,
   "width": 1027,
   "height": 32,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100077,
   "version": 1,
   "versionNonce": 700539,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "The TTL clamp is what makes read-time expiry correct in the presence of a cache: a flat 1-hour entry on a link expiring in five\nminutes would keep serving it for 55 minutes past its expiry. One min() call.",
   "originalText": "The TTL clamp is what makes read-time expiry correct in the presence of a cache: a flat 1-hour entry on a link expiring in five\nminutes would keep serving it for 55 minutes past its expiry. One min() call.",
