": "#1e3a5f", "backgroundColor": "transparent", "opacity": 100, "seed": 2, "width": 200, "height": 17}, {"id": "fw_post_label_l0", "type": "text", "x": 630, "y": 220, "text": "~100 more", "originalText": "~100 more", "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "middle", "strokeColor": "#b91c1c", "backgroundColor": "transparent", "opacity": 100, "seed": 2, "width": 200, "height": 17}, {"id": "fw_post_label_l1", "type": "text", "x": 630, "y": 237, "text": "@ 1:01", "originalText": "@ 1:01", "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "middle", "strokeColor": "#b91c1c", "backgroundColor": "transparent", "opacity": 100, "seed": 2, "width": 200, "height": 17}, {"id": "fw_post_label_l2", "type": "text", "x": 630, "y": 254, "text": "(window 2, allowed)", "originalText": "(window 2, allowed)", "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "middle", "strokeColor": "#b91c1c", "backgroundColor": "transparent", "opacity": 100, "seed": 2, "width": 200, "height": 17}, {"id": "fw_evidence", "type": "rectangle", "x": 60, "y": 440, "width": 900, "height": 140, "strokeColor": "#0f172a", "backgroundColor": "#1e293b", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "seed": 1, "roundness": {"type": 3}}, {"id": "fw_evidence_text", "type": "text", "x": 80, "y": 460, "text": "Counter for window 1 resets to 0 the instant 1:00 ticks over.\n100 requests at 0:59 + 100 requests at 1:01 = 200 requests\nin a ~2-second span -- every single one allowed, because each\nlanded under the 100-limit of ITS OWN window.", "originalText": "Counter for window 1 resets to 0 the instant 1:00 ticks over.\n100 requests at 0:59 + 100 requests at 1:01 = 200 requests\nin a ~2-second span -- every single one allowed, because each\nlanded under the 100-limit of ITS OWN window.", "fontSize": 15, "fontFamily": 3, "textAlign": "left", "verticalAlign": "middle", "strokeColor": "#22c55e", "backgroundColor": "transparent", "opacity": 100, "seed": 2, "width": 860, "height": 110}, {"id": "fw_verdict", "type": "text", "x": 60, "y": 600, "text": "The limit is real per-window, but the window edges are not a real time boundary to the client.", "originalText": "The limit is real per-window, but the window edges are not a real time boundary to the client.", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "middle", "strokeColor": "#b91c1c", "backgroundColor": "transparent", "opacity": 100, "seed": 2, "width": 900, "height": 18.2}, {"id": "tb_header", "type": "text", "x": 1180, "y": 140, "text": "Token Bucket", "originalText": "Token Bucket", "fontSize": 20, "fontFamily": 3, "textAlign": "left", "verticalAlign": "middle", "strokeColor": "#1e40af", "backgroundColor": "transparent", "opacity": 100, "seed": 2, "width": 500, "height": 26.0}, {"id": "tb_sub", "type": "text", "x": 1180, "y": 172, "text": "100-token bucket, refills ~1.67/s (100/min)", "originalText": "100-token bucket, refills ~1.67/s (100/min)", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "middle", "strokeColor": "#64748b", "backgroundColor": "transparent", "opacity": 100, "seed": 2, "width": 460, "height": 18.2}, {"id": "tb_refill_arrow", "type": "arrow", "x": 1295, "y": 205, "points": [[0, 0], [0, 40]], "width": 1, "height": 41, "strokeColor": "#047857", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "seed": 4, "startArrowhead": null, "endArrowhead": "arrow"}, {"id": "tb_refill_label", "type": "text", "x": 1315, "y": 213, "text": "refill 1.67/s", "originalText": "refill 1.67/s", "fontSize": 12, "fontFamily": 3, "textAlign": "left", "verticalAlign": "middle", "strokeColor": "#047857", "backgroundColor": "transparent", "opacity": 100, "seed": 2, "width": 140, "height": 15.600000000000001}, {"id": "tb_bucket", "type": "rectangle", "x": 1220, "y": 245, "width": 150, "height": 150, "strokeColor": "#1e40af", "backgroundColor": "#dbeafe", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "seed": 1, "roundness": {"type": 3}}, {"id": "tb_bucket_label", "type": "text", "x": 1230, "y": 300, "text": "bucket:\n100 tok max", "originalText": "bucket:\n100 tok max", "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "middle", "strokeColor": "#1e3a5f", "backgroundColor": "transparent", "opacity": 100, "seed": 2, "width": 130, "height": 45}, {"id": "tb_out_arrow", "type": "arrow", "x": 1370, "y": 320, "points": [[0, 0], [150, 0]], "width": 151, "height": 1, "strokeColor": "#1e3a5f", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "seed": 4, "startArrowhead": null, "endArrowhead": "arrow"}, {"id": "tb_out_label", "type": "text", "x": 1375, "y": 335, "text": "1 token per request", "originalText": "1 token per request", "fontSize": 12, "fontFamily": 3, "textAlign": "left", "verticalAlign": "middle", "strokeColor": "#1e3a5f", "backgroundColor": "transparent", "opacity": 100, "seed": 2, "width": 220, "height": 15.600000000000001}, {"id": "tb_axis", "type": "line", "x": 1180, "y": 470, "points": [[0, 0], [900, 0]], "width": 901, "height": 1, "strokeColor": "#334155", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "seed": 5}, {"id": "tb_dot_pre_0", "type": "ellipse", "x": 1560, "y": 460, "width": 12, "height": 12, "strokeColor": "#1e3a5f", "backgroundColor": "#93c5fd", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "seed": 3}, {"id": "tb_dot_pre_1", "type": "ellipse", "x": 1574, "y": 460, "width": 12, "height": 12, "strokeColor": "#1e3a5f", "backgroundColor": "#93c5fd", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "seed": 3}, {"id": "tb_dot_pre_2", "type": "ellipse", "x": 1588, "y": 460, "width": 12, "height": 12, "strokeColor": "#1e3a5f", "backgroundColor": "#93c5fd", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "seed": 3}, {"id": "tb_dot_pre_3", "type": "ellipse", "x": 1602, "y": 460, "width": 12, "height": 12, "strokeColor": "#1e3a5f", "backgroundColor": "#93c5fd", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "seed": 3}, {"id": "tb_dot_pre_4", "type": "ellipse", "x": 1616, "y": 460, "width": 12, "height": 12, "strokeColor": "#1e3a5f", "backgroundColor": "#93c5fd", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "seed": 3}, {"id": "tb_dot_pre_5", "type": "ellipse", "x": 1630, "y": 460, "width": 12, "height": 12, "strokeColor": "#1e3a5f", "backgroundColor": "#93c5fd", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "seed": 3}, {"id": "tb_dot_post_0", "type": "ellipse", "x": 1800, "y": 460, "width": 12, "height": 12, "strokeColor": "#b45309", "backgroundColor": "#fde68a", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "seed": 3}, {"id": "tb_dot_post_1", "type": "ellipse", "x": 1814, "y": 460, "width": 12, "height": 12, "strokeColor": "#b45309", "backgroundColor": "#fde68a", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "seed": 3}, {"id": "tb_dot_post_2", "type": "ellipse", "x": 1828, "y": 460, "width": 12, "height": 12, "strokeColor": "#b45309", "backgroundColor": "#fde68a", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "seed": 3}, {"id": "tb_dot_post_3", "type": "ellipse", "x": 1842, "y": 460, "width": 12, "height": 12, "strokeColor": "#b45309", "backgroundColor": "#fde68a", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "seed": 3}, {"id": "tb_dot_post_4", "type": "ellipse", "x": 1856, "y": 460, "width": 12, "height": 12, "strokeColor": "#b45309", "backgroundColor": "#fde68a", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "seed": 3}, {"id": "tb_dot_post_5", "type": "ellipse", "x": 1870, "y": 460, "width": 12, "height": 12, "strokeColor": "#b45309", "backgroundColor": "#fde68a", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "seed": 3}, {"id": "tb_pre_label", "type": "text", "x": 1565, "y": 420, "text": "100 pass", "originalText": "100 pass", "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "middle", "strokeColor": "#1e3a5f", "backgroundColor": "transparent", "opacity": 100, "seed": 2, "width": 120, "height": 16.900000000000002}, {"id": "tb_post_label", "type": "text", "x": 1795, "y": 420, "text": "throttled", "originalText": "throttled", "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "middle", "strokeColor": "#b45309", "backgroundColor": "transparent", "opacity": 100, "seed": 2, "width": 130, "height": 16.900000000000002}, {"id": "tb_evidence", "type": "rectangle", "x": 1180, "y": 560, "width": 780, "height": 140, "strokeColor": "#0f172a", "backgroundColor": "#1e293b", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "seed": 1, "roundness": {"type": 3}}, {"id": "tb_evidence_text", "type": "text", "x": 1200, "y": 580, "text": "The bucket does not care about wall-clock window edges.\nIt only has 100 tokens to give out, ever, until they refill.\nA burst that empties it is throttled immediately -- the next\nrequest waits for a token, spaced ~0.6s apart at the refill rate.", "originalText": "The bucket does not care about wall-clock window edges.\nIt only has 100 tokens to give out, ever, until they refill.\nA burst that empties it is throttled immediately -- the next\nrequest waits for a token, spaced ~0.6s apart at the refill rate.", "fontSize": 15, "fontFamily": 3, "textAlign": "left", "verticalAlign": "middle", "strokeColor": "#22c55e", "backgroundColor": "transparent", "opacity": 100, "seed": 2, "width": 740, "height": 110}, {"id": "tb_verdict", "type": "text", "x": 1180, "y": 720, "text": "Same burst, no edge case: the limit is enforced against a token count, not a wall-clock window.", "originalText": "Same burst, no edge case: the limit is enforced against a token count, not a wall-clock window.", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "middle", "strokeColor": "#047857", "backgroundColor": "transparent", "opacity": 100, "seed": 2, "width": 780, "height": 18.2}], "appState": {"viewBackgroundColor": "#ffffff"}}