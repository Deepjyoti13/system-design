{"type": "excalidraw", "version": 2, "source": "rate-limiting-gen", "elements": [{"id": "title", "type": "text", "x": 40, "y": 30, "text": "Rate Limiting: the fixed-window boundary bug, and token bucket handling the same burst", "originalText": "Rate Limiting: the fixed-window boundary bug, and token bucket handling the same burst", "fontSize": 24, "fontFamily": 3, "textAlign": "left", "verticalAlign": "middle", "strokeColor": "#1e40af", "backgroundColor": "transparent", "opacity": 100, "seed": 2, "width": 2000, "height": 31.200000000000003}, {"id": "subtitle", "type": "text", "x": 40, "y": 70, "text": "Same client burst, two algorithms -- limit is \"100 requests / 60s\"", "originalText": "Same client burst, two algorithms -- limit is \"100 requests / 60s\"", "fontSize": 15, "fontFamily": 3, "textAlign": "left", "verticalAlign": "middle", "strokeColor": "#64748b", "backgroundColor": "transparent", "opacity": 100, "seed": 2, "width": 1200, "height": 19.5}, {"id": "fw_header", "type": "text", "x": 60, "y": 140, "text": "Fixed Window", "originalText": "Fixed Window", "fontSize": 20, "fontFamily": 3, "textAlign": "left", "verticalAlign": "middle", "strokeColor": "#1e40af", "backgroundColor": "transparent", "opacity": 100, "seed": 2, "width": 500, "height": 26.0}, {"id": "fw_sub", "type": "text", "x": 60, "y": 172, "text": "counter resets to 0 at every 60s boundary", "originalText": "counter resets to 0 at every 60s boundary", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "middle", "strokeColor": "#64748b", "backgroundColor": "transparent", "opacity": 100, "seed": 2, "width": 500, "height": 18.2}, {"id": "fw_axis", "type": "line", "x": 60, "y": 340, "points": [[0, 0], [980, 0]], "width": 981, "height": 1, "strokeColor": "#334155", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "seed": 5}, {"id": "fw_t0", "type": "text", "x": 50, "y": 350, "text": "t=0:00", "origina