    {"type":"rectangle","id":"evidence_box","x":40,"y":670,"width":1580,"height":92,"strokeColor":"#0f172a","backgroundColor":"#1e293b","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":1120,"version":1,"versionNonce":2120,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"roundness":{"type":3}},
    {"type":"text","id":"evidence1","x":60,"y":682,"width":1540,"height":18,"text":"Rule: if W + R > N, every read set and every write set MUST share at least one replica -- here, 2+2=4 > 3.","originalText":"Rule: if W + R > N, every read set and every write set MUST share at least one replica -- here, 2+2=4 > 3.","fontSize":14,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#22c55e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":1121,"version":1,"versionNonce":2121,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.25},
    {"type":"text","id":"evidence2","x":60,"y":704,"width":1540,"height":18,"text":"Any 2-of-3 write set and any 2-of-3 read set intersect in at least one node (pigeonhole: 2+2-3=1 guaranteed overlap).","originalText":"Any 2-of-3 write set and any 2-of-3 read set intersect in at least one node (pigeonhole: 2+2-3=1 guaranteed overlap).","fontSize":14,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#22c55e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":1122,"version":1,"versionNonce":2122,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.25},
    {"type":"text","id":"evidence3","x":60,"y":726,"width":1540,"height":18,"text":"That shared node forces the read to see the latest write -- this is what quorum consistency actually buys you, mechanically.","originalText":"That shared node forces the read to see the latest write -- this is what quorum consistency actually buys you, mechanically.","fontSize":14,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#22c55e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":1123,"version":1,"versionNonce":2123,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.25}
