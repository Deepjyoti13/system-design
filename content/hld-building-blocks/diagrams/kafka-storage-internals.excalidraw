   "locked": false,
   "text": "sendfile(): kernel straight to socket, never through user space",
   "rawText": "sendfile(): kernel straight to socket, never through user space",
   "originalText": "sendfile(): kernel straight to socket, never through user space",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
