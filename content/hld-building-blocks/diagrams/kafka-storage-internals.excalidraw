   "lineHeight": 1.25,
   "baseline": 12
  },
  {
   "type": "text",
   "id": "gen00061",
   "x": 80,
   "y": 640,
   "width": 604.8,
   "height": 30.0,
   "strokeColor": "#374151",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 484059,
   "version": 1,
   "versionNonce": 6390469,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": [],
   "link": null,
   "locked": false,
   "text": "JVM heap stays small - a few GB even on a 128 GB box; the rest of RAM is page cache.\nA consumer far enough behind reads cold data from disk, so lag is self-reinforcing.",
   "rawText": "JVM heap stays small - a few GB even on a 128 GB box; the rest of RAM is page cache.\nA consumer far enough behind reads cold data from disk, so lag is self-reinforcing.",
   "originalText": "JVM heap stays small - a few GB even on a 128 GB box; the rest of RAM is page cache.\nA consumer far enough behind reads cold data from disk, so lag is self-reinforcing.",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "baseline": 12
  },
  {
   "type": "text",
   "id": "gen00062",
   "x": 1090,
   "y": 530,
   "width": 179.4,
   "height": 81.25,
   "strokeColor": "#b91c1c",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 491978,
   "version": 1,
   "versionNonce": 6495198,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": [],
   "link": null,
   "locked": false,
   "text": "TLS breaks zero-copy:\nbytes must enter user\nspace to be encrypted.\nA real throughput cost,\nnot a free checkbox.",
   "rawText": "TLS breaks zero-copy:\nbytes must enter user\nspace to be encrypted.\nA real throughput cost,\nnot a free checkbox.",
   "originalText": "TLS breaks zero-copy:\nbytes must enter user\nspace to be encrypted.\nA real throughput cost,\nnot a free checkbox.",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "baseline": 13
  }
