   "versionNonce": 4714805,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": [],
   "link": null,
   "locked": false,
   "text": "lookup: binary-search the index, jump to the nearest earlier byte position,\nthen scan forward a few KB. A dense index would not fit in memory.",
   "rawText": "lookup: binary-search the index, jump to the nearest earlier byte position,\nthen scan forward a few KB. A dense index would not fit in memory.",
   "originalText": "lookup: binary-search the index, jump to the nearest earlier byte position,\nthen scan forward a few KB. A dense index would not fit in memory.",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "baseline": 12
  },
  {
   "type": "text",
   "id": "gen00046",
   "x": 590,
   "y": 356,
   "width": 604.8,
   "height": 30.0,
   "strokeColor": "#b91c1c",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 365274,
   "version": 1,
   "versionNonce": 4819534,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": [],
   "link": null,
   "locked": false,
   "text": "Retention deletes WHOLE segments. A 1 GB segment that takes 10 days to fill\nkeeps data well past a 7-day retention, because it cannot be deleted until it rolls.",
   "rawText": "Retention deletes WHOLE segments. A 1 GB segment that takes 10 days to fill\nkeeps data well past a 7-day retention, because it cannot be deleted until it rolls.",
   "originalText": "Retention deletes WHOLE segments. A 1 GB segment that takes 10 days to fill\nkeeps data well past a 7-day retention, because it cannot be deleted until it rolls.",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "baseline": 12
  },
