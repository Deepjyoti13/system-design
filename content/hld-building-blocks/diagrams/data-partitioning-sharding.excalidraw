h": 633.64, "height": 18.2}, {"id": "lp_ev4", "type": "text", "x": 80, "y": 484, "text": "write throughput or total storage ceiling.", "originalText": "write throughput or total storage ceiling.", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#22c55e", "backgroundColor": "transparent", "opacity": 100, "seed": 26, "width": 364.56, "height": 18.2}, {"id": "rp_header", "type": "text", "x": 1140, "y": 130, "text": "Sharding", "originalText": "Sharding", "fontSize": 20, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#1e40af", "backgroundColor": "transparent", "opacity": 100, "seed": 27, "width": 99.2, "height": 26.0}, {"id": "rp_sub1", "type": "text", "x": 1140, "y": 165, "text": "Each node holds only 1/3 of the dataset", "originalText": "Each node holds only 1/3 of the dataset", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#64748b", "backgroundColor": "transparent", "opacity": 100, "seed": 28, "width": 338.52, "height": 18.2}, {"id": "rp_sub2", "type": "text", "x": 1140, "y": 184, "text": "Both reads AND writes are distributed", "originalText": "Both reads AND writes are distributed", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#64748b", "backgroundColor": "transparent", "opacity": 100, "seed": 29, "width": 321.16, "height": 18.2}, {"id": "rp_s1", "type": "rectangle", "x": 1180, "y": 250, "width": 220, "height": 100, "strokeColor": "#1e3a5f", "backgroundColor": "#60a5fa", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "seed": 30}, {"id": "rp_s1_t1", "type": "text", "x": 1200, "y": 268, "text": "Shard 1", "originalText": "Shard 1", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#374151", "backgroundColor": "transparent", "opacity": 100, "seed": 31, "width": 60.76, "height": 18.2}, {"id": "rp_s1_t2", "t