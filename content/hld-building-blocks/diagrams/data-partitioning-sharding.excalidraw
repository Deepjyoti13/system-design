: "#60a5fa", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "seed": 38}, {"id": "rp_s3_t1", "type": "text", "x": 1760, "y": 268, "text": "Shard 3", "originalText": "Shard 3", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#374151", "backgroundColor": "transparent", "opacity": 100, "seed": 39, "width": 60.76, "height": 18.2}, {"id": "rp_s3_t2", "type": "text", "x": 1760, "y": 292, "text": "tenant_id % 3 == 2", "originalText": "tenant_id % 3 == 2", "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#374151", "backgroundColor": "transparent", "opacity": 100, "seed": 40, "width": 145.08, "height": 16.900000000000002}, {"id": "rp_s3_t3", "type": "text", "x": 1760, "y": 312, "text": "~1/3 of dataset", "originalText": "~1/3 of dataset", "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#374151", "backgroundColor": "transparent", "opacity": 100, "seed": 41, "width": 120.9, "height": 16.900000000000002}, {"id": "rp_writes_label", "type": "text", "x": 1140, "y": 205, "text": "writes routed directly to the owning shard by hash(shard key) -- no shared bottleneck", "originalText": "writes routed directly to the owning shard by hash(shard key) -- no shared bottleneck", "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#c2410c", "backgroundColor": "transparent", "opacity": 100, "seed": 42, "width": 685.1, "height": 16.900000000000002}, {"id": "rp_w1", "type": "arrow", "x": 1285, "y": 225, "points": [[0, 0], [0, 20]], "strokeColor": "#c2410c", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "seed": 43, "width": 0, "height": 20, "startArrowhead": null, "endArrowhead": "arrow"}, {"id": "rp_w2", "type": "arrow", "x": 1565, "y": 225, "points": [[0, 0], [0, 20]], "strokeColor": "#c2410c", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "seed": 44, "width": 0, "height": 20, "startArrowhead": null, "endArrowhead": "arrow"}, {"id": "rp_w3", "type": "arrow", "x": 1845, "y": 225, "points": [[0, 0], [0, 20]], "strokeColor": "#c2410c", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "seed": 45, "width": 0, "height": 20, "startArrowhead": null, "endArrowhead": "arrow"}, {"id": "rp_evidence", "type": "rectangle", "x": 1140, "y": 400, "width": 820, "height": 120, "strokeColor": "#1e293b", "backgroundColor": "#1e293b", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "seed": 46}, {"id": "rp_ev1", "type": "text", "x": 1160, "y": 415, "text": "Each node holds ~33% of the data.", "originalText": "Each node holds ~33% of the data.", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#22c55e", "backgroundColor": "transparent", "opacity": 100, "seed": 47, "width": 286.44, "height": 18.2}, {"id": "rp_ev2", "type": "text", "x": 1160, "y": 438, "text": "Writes: routed by shard key -- 3x the write-throughput ceiling. Storage: 3x too.", "originalText": "Writes: routed by shard key -- 3x the write-throughput ceiling. Storage: 3x too.", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#22c55e", "backgroundColor": "transparent", "opacity": 100, "seed": 48, "width": 694.4, "height": 18.2}, {"id": "rp_ev3", "type": "text", "x": 1160, "y": 461, "text": "Cost: a query needing data from >1 shard (a cross-shard join, a global scan)", "originalText": "Cost: a query needing data from >1 shard (a cross-shard join, a global scan)", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#22c55e", "backgroundColor": "transparent", "opacity": 100, "seed": 49, "width": 659.68, "height": 18.2}, {"id": "rp_ev4", "type": "text", "x": 1160, "y": 484, "text": "must fan out to every shard and merge results -- a single node never had to do this.", "originalText": "must fan out to every shard and merge results -- a single node never had to do this.", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#22c55e", "backgroundColor": "transparent", "opacity": 100, "seed": 50, "width": 729.12, "height": 18.2}, {"id": "footer", "type": "text", "x": 60, "y": 545, "text": "Replication multiplies READ capacity. Sharding multiplies WRITE capacity and STORAGE. They solve different problems -- and can be combined (shard the data, then replicate each shard).", "originalText": "Replication multiplies READ capacity. Sharding multiplies WRITE capacity and STORAGE. They solve different problems -- and can be combined (shard the data, then replicate each shard).", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#1e40af", "backgroundColor": "transparent", "opacity": 100, "seed": 51, "width": 1800, "height": 18.2}], "appState": {"viewBackgroundColor": "#ffffff"}}