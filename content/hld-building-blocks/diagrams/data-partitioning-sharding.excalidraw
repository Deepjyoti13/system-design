{"type": "excalidraw", "version": 2, "source": "field-guide-gen", "elements": [{"id": "title", "type": "text", "x": 40, "y": 30, "text": "Data Partitioning & Sharding: replication multiplies reads, sharding multiplies both", "originalText": "Data Partitioning & Sharding: replication multiplies reads, sharding multiplies both", "fontSize": 22, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#1e40af", "backgroundColor": "transparent", "opacity": 100, "seed": 2, "width": 1145.76, "height": 28.6}, {"id": "subtitle", "type": "text", "x": 40, "y": 68, "text": "Same 3-node cluster, two different splits of the data", "originalText": "Same 3-node cluster, two different splits of the data", "fontSize": 15, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#64748b", "backgroundColor": "transparent", "opacity": 100, "seed": 3, "width": 492.9, "height": 19.5}, {"id": "lp_header", "type": "text", "x": 60, "y": 130, "text": "Replication", "originalText": "Replication", "fontSize": 20, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#1e40af", "backgroundColor": "transparent", "opacity": 100, "seed": 4, "width": 136.4, "height": 26.0}, {"id": "lp_sub1", "type": "text", "x": 60, "y": 165, "text": "Every node holds the FULL dataset", "originalText": "Every node holds the FULL dataset", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#64748b", "backgroundColor": "transparent", "opacity": 100, "seed": 5, "width": 286.44, "height": 18.2}, {"id": "lp_sub2", "type": "text", "x": 60, "y": 184, "text": "Only reads are distributed across nodes", "originalText": "Only reads are distributed across nodes", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#64748b", "backgroundColor": "transparent", "opacity": 100, "seed": 6, "width": 338.52, "height": 18.2}, {"id": "lp_primary", "type": "rectangle", "x": 100, "y": 250, "