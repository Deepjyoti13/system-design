    {"type":"rectangle","id":"evidA","x":320,"y":280,"width":420,"height":140,"strokeColor":"#1e293b","backgroundColor":"#1e293b","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":70,"version":1,"versionNonce":70,"isDeleted":false,"groupIds":[],"boundElements":[{"id":"evidA-text","type":"text"}],"link":null,"locked":false,"roundness":{"type":3}},
    {"type":"text","id":"evidA-text","x":336,"y":296,"width":388,"height":108,"text":"FORWARD PROXY hides the CLIENT\nfrom the server. The SaaS's servers\nsee this proxy's IP -- never the\nlaptop's. Enables: egress policy,\nclient anonymity, shared caching.","originalText":"FORWARD PROXY hides the CLIENT\nfrom the server. The SaaS's servers\nsee this proxy's IP -- never the\nlaptop's. Enables: egress policy,\nclient anonymity, shared caching.","fontSize":15,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#4ade80","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":71,"version":1,"versionNonce":71,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":"evidA","lineHeight":1.3},

    {"type":"rectangle","id":"evidB","x":820,"y":280,"width":700,"height":140,"strokeColor":"#1e293b","backgroundColor":"#1e293b","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":80,"version":1,"versionNonce":80,"isDeleted":false,"groupIds":[],"boundElements":[{"id":"evidB-text","type":"text"}],"link":null,"locked":false,"roundness":{"type":3}},
    {"type":"text","id":"evidB-text","x":836,"y":296,"width":668,"height":108,"text":"REVERSE PROXY hides the SERVER(S) from the client. The laptop\nsees one SaaS endpoint -- never which of N backends answered.\nEnables: TLS termination in one place, path/header routing, and\nbackend topology (scaling included) fully invisible to the client.","originalText":"REVERSE PROXY hides the SERVER(S) from the client. The laptop\nsees one SaaS endpoint -- never which of N backends answered.\nEnables: TLS termination in one place, path/header routing, and\nbackend topology (scaling included) fully invisible to the client.","fontSize":15,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#4ade80","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":81,"version":1,"versionNonce":81,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":"evidB","lineHeight":1.3},

    {"type":"rectangle","id":"callout","x":320,"y":450,"width":1200,"height":90,"strokeColor":"#b45309","backgroundColor":"#fef3c7","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":90,"version":1,"versionNonce":90,"isDeleted":false,"groupIds":[],"boundElements":[{"id":"callout-text","type":"text"}],"link":null,"locked":false,"roundness":{"type":3}},
    {"type":"text","id":"callout-text","x":344,"y":472,"width":1152,"height":48,"text":"One proxy's client is another proxy's disguise: the reverse proxy's \"client\" IS the\nforward proxy's IP -- it never sees the real laptop at all.","originalText":"One proxy's client is another proxy's disguise: the reverse proxy's \"client\" IS the\nforward proxy's IP -- it never sees the real laptop at all.","fontSize":17,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#78350f","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":91,"version":1,"versionNonce":91,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":"callout","lineHeight":1.3}
