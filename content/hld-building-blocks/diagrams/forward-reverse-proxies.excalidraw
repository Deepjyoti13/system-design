    {"type":"text","id":"lbl1","x":205,"y":140,"width":180,"height":36,"text":"sees: real laptop IP","originalText":"sees: real laptop IP","fontSize":13,"fontFamily":3,"textAlign":"center","verticalAlign":"top","strokeColor":"#64748b","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":60,"version":1,"versionNonce":60,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.25},
    {"type":"text","id":"lbl2","x":625,"y":132,"width":230,"height":56,"text":"the public internet --\norigin now sees the\nPROXY's IP, not the laptop's","originalText":"the public internet --\norigin now sees the\nPROXY's IP, not the laptop's","fontSize":13,"fontFamily":3,"textAlign":"center","verticalAlign":"top","strokeColor":"#64748b","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":61,"version":1,"versionNonce":61,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.25},
