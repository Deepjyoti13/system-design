    {"id":"arrow_async_label","type":"text","x":555,"y":292,"width":175,"height":18,"text":"async: fire-and-forget","originalText":"async: fire-and-forget","fontSize":13,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#dc2626","backgroundColor":"transparent","opacity":100,"seed":25},

    {"id":"evidenceA_box","type":"rectangle","x":40,"y":400,"width":900,"height":140,"strokeColor":"#1e293b","backgroundColor":"#1e293b","fillStyle":"solid","strokeWidth":1,"roughness":0,"opacity":100,"seed":30},
    {"id":"evA_l1","type":"text","x":60,"y":415,"width":830,"height":18,"text":"SYNC: confirms only after a replica acks -- write is durable on 2 nodes before the client hears","originalText":"SYNC: confirms only after a replica acks -- write is durable on 2 nodes before the client hears","fontSize":14,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#4ade80","backgroundColor":"transparent","opacity":100,"seed":31},
    {"id":"evA_l2","type":"text","x":60,"y":438,"width":700,"height":18,"text":"success. Cost: every write pays the replica's round trip, permanently.","originalText":"success. Cost: every write pays the replica's round trip, permanently.","fontSize":14,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#4ade80","backgroundColor":"transparent","opacity":100,"seed":32},
    {"id":"evA_l3","type":"text","x":60,"y":470,"width":830,"height":18,"text":"ASYNC: confirms before the replica has it. If the leader crashes between confirm and replicate,","originalText":"ASYNC: confirms before the replica has it. If the leader crashes between confirm and replicate,","fontSize":14,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#f87171","backgroundColor":"transparent","opacity":100,"seed":33},
    {"id":"evA_l4","type":"text","x":60,"y":493,"width":830,"height":18,"text":"that write is gone -- despite the client being told it succeeded. That's replication lag's real cost.","originalText":"that write is gone -- despite the client being told it succeeded. That's replication lag's real cost.","fontSize":14,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#f87171","backgroundColor":"transparent","opacity":100,"seed":34},

