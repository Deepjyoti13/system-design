    {"id":"majority_label","type":"text","x":60,"y":735,"width":400,"height":20,"text":"3 of 5 = MAJORITY -> can elect a new leader","originalText":"3 of 5 = MAJORITY -> can elect a new leader","fontSize":15,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#047857","backgroundColor":"transparent","opacity":100,"seed":62},
    {"id":"minority_label","type":"text","x":610,"y":735,"width":340,"height":20,"text":"2 of 5 = minority -> cannot reach quorum","originalText":"2 of 5 = minority -> cannot reach quorum","fontSize":15,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#dc2626","backgroundColor":"transparent","opacity":100,"seed":63},

    {"id":"evidenceB_box","type":"rectangle","x":40,"y":800,"width":920,"height":140,"strokeColor":"#1e293b","backgroundColor":"#1e293b","fillStyle":"solid","strokeWidth":1,"roughness":0,"opacity":100,"seed":70},
    {"id":"evB_l1","type":"text","x":60,"y":815,"width":730,"height":18,"text":"Raft/Paxos rule: a decision is final only once a MAJORITY of all nodes agrees to it.","originalText":"Raft/Paxos rule: a decision is final only once a MAJORITY of all nodes agrees to it.","fontSize":14,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#4ade80","backgroundColor":"transparent","opacity":100,"seed":71},
    {"id":"evB_l2","type":"text","x":60,"y":840,"width":750,"height":18,"text":"The 3-node side has a majority -- it can elect a new leader and keep accepting writes.","originalText":"The 3-node side has a majority -- it can elect a new leader and keep accepting writes.","fontSize":14,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#4ade80","backgroundColor":"transparent","opacity":100,"seed":72},
    {"id":"evB_l3","type":"text","x":60,"y":872,"width":730,"height":18,"text":"The 2-node side (with the old leader) can never reach majority while partitioned --","originalText":"The 2-node side (with the old leader) can never reach majority while partitioned --","fontSize":14,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#f87171","backgroundColor":"transparent","opacity":100,"seed":73},
    {"id":"evB_l4","type":"text","x":60,"y":895,"width":800,"height":18,"text":"it can't confirm new writes as leader, so two conflicting leaders can never both be active.","originalText":"it can't confirm new writes as leader, so two conflicting leaders can never both be active.","fontSize":14,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#f87171","backgroundColor":"transparent","opacity":100,"seed":74}
