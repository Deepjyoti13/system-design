 "txt37", "x": 1210.0, "y": 234.0, "width": 200, "height": 19, "text": "own copy", "originalText": "own copy", "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#047857", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 32562, "version": 1, "versionNonce": 23563, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25}, {"type": "text", "id": "txt38", "x": 840, "y": 360, "width": 700, "height": 19, "text": "One message, EVERY subscriber gets its own copy \u2014 good for \"many systems must all react.\"", "originalText": "One message, EVERY subscriber gets its own copy \u2014 good for \"many systems must all react.\"", "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#64748b", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 91619, "version": 1, "versionNonce": 31995, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25}, {"type": "rectangle", "id": "r39", "x": 40, "y": 420, "width": 1500, "height": 150, "strokeColor": "#1e293b", "backgroundColor": "#1e293b", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 10729, "version": 1, "versionNonce": 75291, "isDeleted": false, "groupIds": [], "boundElements": [], "link": null, "locked": false, "roundness": {"type": 3}}, {"type": "text", "id": "txt40", "x": 60, "y": 435, "width": 1450, "height": 20, "text": "ORDERING: a Kafka-style partition preserves order only WITHIN a partition, not across partitions.", "originalText": "ORDERING: a Kafka-style partition preserves order only WITHIN a partition, not across partitions.", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#22c55e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 39355, "version": 1, "versionNonce": 68839, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25}, {"type": "text", "id": "txt41", "x": 60, "y": 460, "width": 1450, "height": 20, "text": "Partition by user_id when \"this user's events stay in order\" matters \u2014 cross-user ordering is not guaranteed by default.", "originalText": "Partition by user_id when \"this user's events stay in order\" matters \u2014 cross-user ordering is not guaranteed by default.", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#22c55e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 64896, "version": 1, "versionNonce": 45021, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25}, {"type": "text", "id": "txt42", "x": 60, "y": 495, "width": 1450, "height": 20, "text": "ACK TIMING: ack-on-receive can LOSE a message if the consumer crashes mid-process.", "originalText": "ACK TIMING: ack-on-receive can LOSE a message if the consumer crashes mid-process.", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#f87171", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 95610, "version": 1, "versionNonce": 58830, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25}, {"type": "text", "id": "txt43", "x": 60, "y": 520, "width": 1450, "height": 20, "text": "ack-on-process-complete can REDELIVER a message if the consumer crashes after finishing but before acking.", "originalText": "ack-on-process-complete can REDELIVER a message if the consumer crashes after finishing but before acking.", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#f87171", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 37741, "version": 1, "versionNonce": 79818, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25}, {"type": "text", "id": "txt44", "x": 60, "y": 545, "width": 1450, "height": 20, "text": "Real systems pick at-least-once (ack-on-process-complete) + an idempotent consumer, rather than chasing exactly-once delivery.", "originalText": "Real systems pick at-least-once (ack-on-process-complete) + an idempotent consumer, rather than chasing exactly-once delivery.", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#22c55e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 9595, "version": 1, "versionNonce": 15476, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25}], "appState": {"viewBackgroundColor": "#ffffff"}}