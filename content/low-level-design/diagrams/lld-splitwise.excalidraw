{"type": "text", "id": "t2083", "x": 850, "y": 610, "width": 700, "height": 18, "text": "Greedy settle-up: match the biggest debtor to the biggest creditor,", "originalText": "Greedy settle-up: match the biggest debtor to the biggest creditor,", "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#64748b", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 2084, "version": 1, "versionNonce": 2085, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25},
{"type": "text", "id": "t2086", "x": 850, "y": 628, "width": 700, "height": 18, "text": "transfer min(|debt|,|credit|), drop whichever hits zero, repeat.", "originalText": "transfer min(|debt|,|credit|), drop whichever hits zero, repeat.", "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#64748b", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 2087, "version": 1, "versionNonce": 2088, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25},
{"type": "text", "id": "t2089", "x": 850, "y": 646, "width": 700, "height": 18, "text": "Alice needed zero transactions despite being in 3 of the raw IOUs.", "originalText": "Alice needed zero transactions despite being in 3 of the raw IOUs.", "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#22c55e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 2090, "version": 1, "versionNonce": 2091, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25}

