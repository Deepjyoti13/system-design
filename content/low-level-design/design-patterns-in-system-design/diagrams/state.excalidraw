    { "type": "text", "id": "final_caption", "x": 20, "y": 400, "width": 950, "height": 44,
      "text": "The transition is enforced as a conditional write -- UPDATE ... SET status='succeeded' WHERE status='processing'.\nA free-text status column would let 'refunded' happen before 'succeeded', or the same transition apply twice.",
