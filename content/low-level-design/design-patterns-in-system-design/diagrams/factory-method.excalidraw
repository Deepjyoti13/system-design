    { "type": "text", "id": "final_caption", "x": 20, "y": 630, "width": 960, "height": 64,
      "text": "OrchestrationService calls factory.create(providerType) and stores the result\nas a plain ProcessorClient -- it never sees StripeProcessorClient or\nAdyenProcessorClient by name, and never changes when a third provider is added.",
