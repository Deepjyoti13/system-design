    { "type": "text", "id": "title", "x": 20, "y": 18, "width": 760, "height": 33,
      "text": "Factory Method -- One Interface, the Right Concrete Class", "originalText": "Factory Method -- One Interface, the Right Concrete Class",
      "fontSize": 23, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
