    {"type":"text","id":"l_sess","x":1150,"y":330,"width":300,"height":35,"text":"any server reads the SAME\nsession — a reroute doesn't log you out","originalText":"any server reads the SAME\nsession — a reroute doesn't log you out","fontSize":12,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#7c2d12","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":126,"version":1,"versionNonce":127,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"lineHeight":1.3},

    {"type":"rectangle","id":"evidence","x":60,"y":420,"width":540,"height":215,"strokeColor":"#0f172a","backgroundColor":"#1e293b","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":130,"version":1,"versionNonce":131,"isDeleted":false,"groupIds":[],"boundElements":[{"id":"evidence_t","type":"text"}],"link":null,"locked":false,"roundness":{"type":3}},
    {"type":"text","id":"evidence_t","x":80,"y":440,"width":500,"height":135,"text":"Connection cost, cross-region RTT = 50ms:\n\nTCP handshake (SYN, SYN-ACK, ACK)  ~1.5 RTT  = 75ms\nTLS 1.3 handshake (1 RTT, 0-RTT resume possible) = +50ms\nTLS 1.2 handshake (2 RTT, full)               = +100ms\n\nHTTP/1.1 keep-alive & HTTP/2 reuse ONE connection —\nyou pay this once per connection, not once per request.\nHTTP/3 (QUIC) folds the TCP+TLS cost into one exchange.","originalText":"Connection cost, cross-region RTT = 50ms:\n\nTCP handshake (SYN, SYN-ACK, ACK)  ~1.5 RTT  = 75ms\nTLS 1.3 handshake (1 RTT, 0-RTT resume possible) = +50ms\nTLS 1.2 handshake (2 RTT, full)               = +100ms\n\nHTTP/1.1 keep-alive & HTTP/2 reuse ONE connection —\nyou pay this once per connection, not once per request.\nHTTP/3 (QUIC) folds the TCP+TLS cost into one exchange.","fontSize":13,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#4ade80","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":132,"version":1,"versionNonce":133,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":"evidence","lineHeight":1.4},

    {"type":"rectangle","id":"broken","x":660,"y":420,"width":540,"height":215,"strokeColor":"#b91c1c","backgroundColor":"#fee2e2","fillStyle":"solid","strokeWidth":2,"strokeStyle":"dashed","roughness":0,"opacity":100,"angle":0,"seed":140,"version":1,"versionNonce":141,"isDeleted":false,"groupIds":[],"boundElements":[{"id":"broken_t","type":"text"}],"link":null,"locked":false,"roundness":{"type":3}},
    {"type":"text","id":"broken_t","x":680,"y":440,"width":500,"height":135,"text":"What breaks without statelessness:\n\nServer A holds your session in its own process memory.\nLoad balancer reroutes your NEXT request to Server B\n(A got slow, or restarted for a deploy) —\nB has never heard of your session. You're logged out.\n\nFix: either sticky sessions (fragile, undoes the point\nof load balancing) or a shared store, as at left.","originalText":"What breaks without statelessness:\n\nServer A holds your session in its own process memory.\nLoad balancer reroutes your NEXT request to Server B\n(A got slow, or restarted for a deploy) —\nB has never heard of your session. You're logged out.\n\nFix: either sticky sessions (fragile, undoes the point\nof load balancing) or a shared store, as at left.","fontSize":13,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#7f1d1d","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":142,"version":1,"versionNonce":143,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":"broken","lineHeight":1.4}
  ],
