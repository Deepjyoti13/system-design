    {"type":"text","id":"title","x":60,"y":40,"width":1300,"height":35,"text":"Client-Server Model — connection lifecycle and where statelessness matters","originalText":"Client-Server Model — connection lifecycle and where statelessness matters","fontSize":26,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#1e40af","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":1,"version":1,"versionNonce":2,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"lineHeight":1.25},
    {"type":"text","id":"subtitle","x":60,"y":82,"width":1300,"height":25,"text":"Every request pays for a connection before it pays for anything else — and every app server behind the load balancer must be interchangeable.","originalText":"Every request pays for a connection before it pays for anything else — and every app server behind the load balancer must be interchangeable.","fontSize":15,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#64748b","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":3,"version":1,"versionNonce":4,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"lineHeight":1.25},

