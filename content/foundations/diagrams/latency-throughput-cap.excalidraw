    {"type":"text","id":"cp_outcome_t","x":100,"y":530,"width":580,"height":70,"text":"Node A blocks/rejects the write — it cannot confirm B\nhas acknowledged, so it refuses rather than risk two\nnodes disagreeing on the value of x.","originalText":"Node A blocks/rejects the write — it cannot confirm B\nhas acknowledged, so it refuses rather than risk two\nnodes disagreeing on the value of x.","fontSize":15,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#7f1d1d","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":1023,"version":1,"versionNonce":2023,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":"cp_outcome","lineHeight":1.3},

    {"type":"text","id":"cp_summary","x":80,"y":650,"width":650,"height":80,"text":"Chooses Consistency over Availability: correctness of every\nread is preserved, at the cost of the write not going through\nduring the partition.","originalText":"Chooses Consistency over Availability: correctness of every\nread is preserved, at the cost of the write not going through\nduring the partition.","fontSize":15,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#3b82f6","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":1024,"version":1,"versionNonce":2024,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"lineHeight":1.3},

