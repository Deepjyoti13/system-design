eed": 13, "width": 200.26, "height": 22.1}, {"id": "val3", "type": "text", "x": 1233.8558006070425, "y": 381.0, "text": "~0.5 ms (500,000 ns)", "originalText": "~0.5 ms (500,000 ns)", "fontSize": 15, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#374151", "backgroundColor": "transparent", "opacity": 100, "seed": 14, "width": 186.0, "height": 19.5}, {"id": "bar4", "type": "rectangle", "x": 420, "y": 444, "width": 1144.6527762677954, "height": 46, "strokeColor": "#b91c1c", "backgroundColor": "#fecaca", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "seed": 15}, {"id": "name4", "type": "text", "x": 40, "y": 457.0, "text": "Cross-continent RTT", "originalText": "Cross-continent RTT", "fontSize": 17, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#1e293b", "backgroundColor": "transparent", "opacity": 100, "seed": 16, "width": 200.26, "height": 22.1}, {"id": "val4", "type": "text", "x": 1580.6527762677954, "y": 457.0, "text": "~150 ms (150,000,000 ns)", "originalText": "~150 ms (150,000,000 ns)", "fontSize": 15, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#374151", "backgroundColor": "transparent", "opacity": 100, "seed": 17, "width": 223.2, "height": 19.5}, {"id": "evbox", "type": "rectangle", "x": 40, "y": 540, "width": 1550, "height": 110, "strokeColor": "#1e293b", "backgroundColor": "#1e293b", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "seed": 18}, {"id": "ev1", "type": "text", "x": 60, "y": 560, "text": "RAM is roughly 1,000x faster than an SSD random read (100 ns vs 100,000 ns).", "originalText": "RAM is roughly 1,000x faster than an SSD random read (100 ns vs 100,000 ns).", "fontSize": 16, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#22c55e", "backgroundColor": "transparent", "opacity": 100, "seed": 19, "width": 753.92, "height": 20.8}, {"id": "ev2", "type": "text", "x": 60, "y": 595, "text": "A same-datacenter round trip is roughly 300x faster than a cross-continent one (0.5 ms vs 150 ms).", "originalText": "A same-datacenter round trip is roughly 300x faster than a cross-continent one (0.5 ms vs 150 ms).", "fontSize": 16, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#22c55e", "backgroundColor": "transparent", "opacity": 100, "seed": 20, "width": 972.16, "height": 20.8}, {"id": "ev3", "type": "text", "x": 60, "y": 625, "text": "The gap, not the absolute number, is what should drive a caching or CDN decision.", "originalText": "The gap, not the absolute number, is what should drive a caching or CDN decision.", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#94a3b8", "backgroundColor": "transparent", "opacity": 100, "seed": 21, "width": 703.08, "height": 18.2}], "appState": {"viewBackgroundColor": "#ffffff"}}