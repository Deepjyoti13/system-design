   "text": "App 2 crashes \u2014 nothing is lost",
   "rawText": "App 2 crashes \u2014 nothing is lost",
   "originalText": "App 2 crashes \u2014 nothing is lost",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "baseline": 13
  },
  {
   "type": "text",
   "id": "gen00042",
   "x": 730,
   "y": 600,
   "width": 351.0,
   "height": 65.0,
   "strokeColor": "#374151",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 333598,
   "version": 1,
   "versionNonce": 4400618,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": [],
   "link": null,
   "locked": false,
   "text": "\u00b7 the next request just lands on App 1 or 3\n\u00b7 autoscaling and rolling deploys are trivial\n\u00b7 cost: one network hop per request, and the\n  store is now on the critical path",
   "rawText": "\u00b7 the next request just lands on App 1 or 3\n\u00b7 autoscaling and rolling deploys are trivial\n\u00b7 cost: one network hop per request, and the\n  store is now on the critical path",
   "originalText": "\u00b7 the next request just lands on App 1 or 3\n\u00b7 autoscaling and rolling deploys are trivial\n\u00b7 cost: one network hop per request, and the\n  store is now on the critical path",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "baseline": 13
  },
  {
   "type": "text",
   "id": "gen00043",
   "x": 50,
   "y": 762,
   "width": 1083.6,
   "height": 17.5,
   "strokeColor": "#1e40af",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 341517,
   "version": 1,
   "versionNonce": 4505347,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": [],
   "link": null,
   "locked": false,
   "text": "\"Stateless\" never means the state disappeared \u2014 it means it moved somewhere shared and durable, so any server is interchangeable.",
   "rawText": "\"Stateless\" never means the state disappeared \u2014 it means it moved somewhere shared and durable, so any server is interchangeable.",
   "originalText": "\"Stateless\" never means the state disappeared \u2014 it means it moved somewhere shared and durable, so any server is interchangeable.",
