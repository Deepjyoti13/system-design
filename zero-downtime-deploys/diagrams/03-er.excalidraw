, "originalText": "Query pattern: 'read the current state of everything, right now' and", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#22c55e", "backgroundColor": "transparent", "opacity": 100, "seed": 34}, {"id": "t34", "type": "text", "x": 261.0, "y": 452.0, "width": 602, "height": 18, "text": "'atomically update one instance's state' -- never joins or analytics.", "originalText": "'atomically update one instance's state' -- never joins or analytics.", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#22c55e", "backgroundColor": "transparent", "opacity": 100, "seed": 35}, {"id": "t35", "type": "text", "x": 269.5, "y": 470.0, "width": 585, "height": 18, "text": "Two controllers must never disagree about which batch is in flight,", "originalText": "Two controllers must never disagree about which batch is in flight,", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#22c55e", "backgroundColor": "transparent", "opacity": 100, "seed": 36}, {"id": "t36", "type": "text", "x": 265.0, "y": 488.0, "width": 594, "height": 18, "text": "the same correctness bar Replication & Consensus needs for a leader.", "originalText": "the same correctness bar Replication & Consensus needs for a leader.", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#22c55e", "backgroundColor": "transparent", "opacity": 100, "seed": 37}, {"id": "t37", "type": "text", "x": 256.5, "y": 506.0, "width": 611, "height": 18, "text": "That's why this is etcd-class (consensus-backed), not a relational DB.", "originalText": "That's why this is etcd-class (consensus-backed), not a relational DB.", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#22c55e", "backgroundColor": "transparent", "opacity": 100, "seed": 38}], "appState": {"viewBackgroundColor": "#ffffff"}}